# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# scratch logs at the repo root kept getting committed and served (build-log.txt,
# debug_log.txt, nlm_status.txt, public/sanity.log). Nothing ships a log.
/*.log
/*log*.txt
public/**/*.log

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store


# Local Netlify folder
.netlify
.wrangler/

# Local R2 Staging (Do not commit)
R2_MIRROR/
data_source/mined_assets/
r2_backup_excluded/
public/assets/r2/
scripts/bin/
ffmpeg_temp/
public/assets/

# session WIP / preview scratch (do not ship)
scripts/_roundtrip_out/
src/pages/spike/

# Claude Code: keep the preview config + the shared hooks, ignore local settings.
# settings.json carries the session-capture hooks (global_agent#321) and the
# astro output:"static" guard - both must be TRACKED or a worktree session
# inherits neither (a worktree materializes tracked files only), and a
# settings.json pointing at an unmaterialized guard script would block every
# edit. settings.local.json stays ignored: that one is per-machine.
.claude/*
!.claude/launch.json
!.claude/settings.json
!.claude/hooks/
# Python bytecode cache
__pycache__/
*.pyc
