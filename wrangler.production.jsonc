{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eriknorris",
  "main": "./scripts/worker-entry.mjs",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "eriknorris.com/*",
      "zone_name": "eriknorris.com"
    },
    {
      "pattern": "www.eriknorris.com/*",
      "zone_name": "eriknorris.com"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/_server-islands/*",
      "/_image",
      "/assets/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "PROJECTS",
      "bucket_name": "assets-eriknorris-com"
    }
  ]
}
