---
import siteData from "@config/siteData.json";

const { status } = siteData;

// Determine environment and version info
const isDev = import.meta.env.DEV;
const commitSha = import.meta.env.CF_PAGES_COMMIT_SHA || import.meta.env.GITHUB_SHA || "HEAD";
const shortSha = commitSha.substring(0, 7);

let badgeText = "";
let badgeColor = "";

if (status?.type === "under-construction") {
	if (isDev) {
		badgeText = "LOCAL DEV";
		badgeColor = "text-amber-500/80";
	} else {
		badgeText = `UNDER CONSTRUCTION: ${shortSha}`;
		badgeColor = "text-red-500/80";
	}
} else if (status?.type === "maintenance") {
	badgeText = "MAINTENANCE";
	badgeColor = "text-red-600";
}

const showBadge = status?.type !== "production" && badgeText !== "";
---

{
	showBadge && (
		<span
			class={`hidden font-mono text-[10px] font-bold tracking-wider sm:inline-block ${badgeColor}`}
			title={`Commit: ${commitSha}`}
		>
			[ {badgeText} ]
		</span>
	)
}
