---
interface Props {
	mode?: "stealth" | "standard" | "fleet" | "tactical" | "archive" | "projects";
	class?: string;
	hideLogo?: boolean;
}

const { mode = "standard", class: className, hideLogo = false } = Astro.props;
// import logo from "@assets/branding/EN_logo_white_1024.png";
---

<nav
	id="universal-hud"
	data-mode={mode}
	class:list={[
		"fixed top-0 left-0 z-100 grid w-full grid-cols-[1fr_auto_1fr] items-center px-6 py-4 transition-all duration-500",
		"border-b border-white/0", // Start transparent
		className,
	]}
>
	<!-- LEFT SLOT: Identity / Context -->
	<div class="flex items-center gap-4 justify-self-start">
		<a
			href="/"
			class={`group flex items-center gap-2 transition-opacity hover:opacity-80 ${hideLogo ? "pointer-events-none" : ""}`}
		>
			{!hideLogo && <img src="/assets/branding/logo.png" alt="EN Logo" class="h-8 w-auto" />}
			{
				mode === "projects" && (
					<span class="font-mono text-xs font-bold tracking-widest text-white/50">PROJECTS</span>
				)
			}
			<slot name="left" />
		</a>
	</div>

	<!-- CENTER SLOT: Telemetry / Controls / Nav -->
	<div
		id="hud-center"
		class="hidden items-center justify-center justify-self-center transition-all duration-300 md:flex"
	>
		<slot name="center" />
	</div>

	<!-- RIGHT SLOT: System / Actions -->
	<div class="flex items-center gap-4 justify-self-end">
		<slot name="right" />

		<!-- Mobile toggle: only rendered when a page provides a working one.
		     No default fallback — an inert menu button is worse than none (contract §E). -->
		<slot name="mobile-toggle" />
	</div>

	<!-- DEFAULT SLOT (For Drawers / Overlays) -->
	<slot />
</nav>

<script>
	const hud = document.getElementById("universal-hud");

	// Scroll Logic: Reactive Canopy
	// Standard: transparent 0-20px, black glass beyond (readable).
	// Stealth: transparent over the intro/hero (0-200px, matching the intro
	// fade distance), glass beyond — so the HUD never floats transparent
	// over long-form body text (contract §E).
	const updateHud = () => {
		if (!hud) return;

		const y = window.scrollY;
		const threshold = hud.dataset.mode === "stealth" ? 200 : 20;
		const isScrolled = y > threshold;

		if (isScrolled) {
			hud.classList.add("bg-black/80", "backdrop-blur-md", "border-white/10");
			hud.classList.remove("border-white/0");
		} else {
			hud.classList.remove("bg-black/80", "backdrop-blur-md", "border-white/10");
			hud.classList.add("border-white/0");
		}
	};

	window.addEventListener("scroll", updateHud);
	// Init on load
	updateHud();

	// Mobile Logic would go here (integrating existing MobileNav)
</script>

<style>
	/* Mode-Specific Tweaks if needed */
	[data-mode="tactical"] {
		/* Specific tactical styling overrides */
	}
</style>
