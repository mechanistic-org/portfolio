---
// components
import NavLink from "@components/Nav/NavLink.astro";
import NavDropdown from "@components/Nav/NavDropdown.astro";
import MobileNav from "@components/Nav/MobileNav/MobileNav.astro";
import SiteLogo from "@components/SiteLogo/SiteLogo.astro";
import Button from "@components/Button/Button.astro";
import SocialCloud from "@components/SocialCloud/SocialCloud.astro";
import ThemeToggle from "@components/ThemeToggle/ThemeToggle.astro";

// data
import navData from "@config/navData.json";
// console.log(JSON.stringify(navData, null, 2));
---

<div
	id="nav__container"
	class="fixed top-0 left-0 z-30 flex w-full flex-col bg-transparent py-1 duration-500"
	transition:name={`nav`}
>
	<div class="mx-auto flex w-full">
		<div class="site-container flex h-16 w-full items-center">
			<header class="flex w-full items-center gap-2">
				<!-- Left: Logo -->
				<div class="flex flex-1 justify-start">
					<SiteLogo />
				</div>

				<!-- Center: Desktop Nav -->
				<div class="flex flex-1 items-center justify-center gap-4">
					<nav class="hidden md:block">
						<ul class="flex h-fit items-center px-4">
							{
								// if dropdown exists, setup the dropdown, otherwise it is just a link
								navData.map((navItem) =>
									"dropdown" in navItem ? (
										// non-mobile dropdown menu
										<NavDropdown navItem={navItem} />
									) : (
										// normal nav link
										<NavLink {navItem} />
									),
								)
							}
						</ul>
					</nav>

					<button
						id="search-trigger"
						class="hover:text-primary-600 text-foreground hidden items-center justify-center transition-colors md:flex"
						aria-label="Search"
						title="Press Ctrl+K"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg
						>
					</button>
				</div>

				<!-- Right: Socials & Toggle -->
				<div class="flex flex-1 items-center justify-end gap-4">
					<div class="hidden md:block">
						<SocialCloud />
					</div>

					<ThemeToggle />

					<!-- mobile nav menu, only load on small screens where it is visible -->
					<div class="flex items-center gap-4 md:hidden">
						<MobileNav />
					</div>
				</div>
			</header>
		</div>
	</div>
</div>

<script>
	/* When the user scrolls down, hide the navbar. When the user scrolls up a bit, show the navbar */
	const initNavbar = () => {
		const navbar = document.getElementById("nav__container") as HTMLInputElement;

		if (navbar !== null) {
			let prevScrollpos = window.scrollY;
			let scrollUpDistance = 0;
			let scrollDownDistance = 0;
			const scrollHandler = () => {
				const currentScrollPos = window.scrollY;

				if (prevScrollpos > currentScrollPos) {
					scrollDownDistance = 0;
					scrollUpDistance = scrollUpDistance + prevScrollpos - currentScrollPos;
					// only show the navbar if we've scrolled up a little bit. debouncing
					if (scrollUpDistance > 50) {
						navbar.style.top = "0px";
					}
				} else {
					scrollUpDistance = 0;
					scrollDownDistance = scrollDownDistance + currentScrollPos - prevScrollpos;
					// only hide the navbar if we've scrolled down a little bit. debouncing
					if (scrollDownDistance > 50) {
						navbar.style.top = "-100px";
					}
				}
				prevScrollpos = currentScrollPos;
			};

			// Add passive event listener for better performance
			window.addEventListener("scroll", scrollHandler, { passive: true });
		}
	};

	initNavbar();

	document.addEventListener("astro:after-swap", initNavbar);

	// Search Trigger Logic
	const initSearchTrigger = () => {
		const searchTrigger = document.getElementById("search-trigger");
		if (searchTrigger) {
			searchTrigger.addEventListener("click", () => {
				window.dispatchEvent(new CustomEvent("open-command-menu"));
			});
		}
	};

	// Run on initial load
	initSearchTrigger();

	// Run on view transitions
	document.addEventListener("astro:after-swap", initSearchTrigger);
</script>
