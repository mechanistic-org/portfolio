---
const { currentRealm = "identity" } = Astro.props;
import { Icon } from "astro-icon/components";
import SonicHeartbeat from "@components/Audio/SonicHeartbeat";
---

<nav
	id="hyperspace-nav"
	class="fixed bottom-0 left-0 z-100 flex w-full items-center justify-between border-t border-transparent bg-transparent px-6 py-4 transition-all duration-500 md:top-0 md:bottom-auto md:border-t-0"
>
	<!-- Left: Branding (EN Logo) -->
	<div class="flex items-center gap-4">
		<a href="/">
			<img
				src="/assets/branding/EN_logo_white_1024.png"
				alt="EN Logo"
				class="h-8 w-auto opacity-80 transition-opacity hover:opacity-100"
			/>
		</a>
	</div>

	<!-- Center: The Jump Drive (Desktop) -->
	<div
		class="hidden items-center justify-center gap-1 rounded-full border border-white/10 bg-black/50 p-1 backdrop-blur-sm md:flex"
	>
		<a
			href="/projects"
			class="hover:text-primary-500! rounded-full px-4 py-1 font-mono text-xs tracking-wider text-neutral-500 uppercase transition-all duration-300 hover:bg-white/5"
		>
			Work
		</a>
		<a
			href="/about"
			class="hover:text-primary-500! rounded-full px-4 py-1 font-mono text-xs tracking-wider text-neutral-500 uppercase transition-all duration-300 hover:bg-white/5"
		>
			About
		</a>

		<div class="mx-1 h-3 w-px bg-white/20"></div>
		<button
			id="hud-search-trigger"
			class="group hover:text-primary-500! flex items-center justify-center rounded-full p-1 text-neutral-500 transition-colors duration-300 hover:bg-white/5"
			aria-label="Search"
		>
			<Icon name="tabler:search" class="h-4 w-4" />
		</button>
	</div>

	<script>
		const searchBtn = document.getElementById("hud-search-trigger");
		searchBtn?.addEventListener("click", () => {
			window.dispatchEvent(new CustomEvent("open-command-menu"));
		});

		// Scroll-Aware Visibility & Active State Logic (Refactored for Body Scroll)
		const nav = document.getElementById("hyperspace-nav");
		// Container is now just a wrapper, we track window scroll
		const links = document.querySelectorAll("[data-nav-target]");
		const sections = document.querySelectorAll("section[id]");

		if (nav) {
			const handleScroll = () => {
				const scrollY = window.scrollY;
				const threshold = window.innerHeight * 0.5; // Fade in halfway through Realm I

				if (scrollY > threshold) {
					// Scrolled State: Active Glass
					nav.classList.add("bg-black/90", "backdrop-blur-md", "border-white/10");
					nav.classList.remove("bg-transparent", "border-transparent");
				} else {
					// Top State: Fully Transparent
					nav.classList.remove("bg-black/90", "backdrop-blur-md", "border-white/10");
					nav.classList.add("bg-transparent", "border-transparent");
				}
			};

			window.addEventListener("scroll", handleScroll, { passive: true });
			// Init check
			handleScroll();

			// SCROLL SPY - Uses IntersectionObserver on window viewport
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							const id = entry.target.id;
							links.forEach((link) => {
								if (link.getAttribute("data-nav-target") === id) {
									// Add Active Classes
									link.classList.add("bg-primary-500", "text-white", "font-bold");
									link.classList.remove(
										"text-neutral-500",
										"hover:text-primary-500!",
										"hover:bg-white/5",
									);
								} else {
									// Remove Active Classes
									link.classList.remove("bg-primary-500", "text-white", "font-bold");
									link.classList.add(
										"text-neutral-500",
										"hover:text-primary-500!",
										"hover:bg-white/5",
									);
								}
							});
						}
					});
				},
				{
					root: null, // Default is viewport (which is correct for Body Scroll)
					rootMargin: "-25% 0px -25% 0px",
					threshold: 0,
				},
			);

			sections.forEach((section) => observer.observe(section));
		}
	</script>

	<!-- Right: Comm Channels -->
	<div class="flex items-center gap-4">
		<!-- Left: Identity -->
		<a href="/" class="group flex items-center gap-3">
			<div class="relative h-8 w-8 overflow-hidden rounded-full border border-white/20 bg-black">
				<!-- Brand Logo or Avatar -->
				<div class="flex h-full w-full items-center justify-center text-[10px] text-white">EN</div>
			</div>
			<div class="flex flex-col">
				<span
					class="group-hover:text-primary font-mono text-xs font-bold tracking-widest text-white uppercase"
					>Erik Norris</span
				>
				<span class="font-mono text-[9px] text-neutral-500">/// SYSTEM ARCHITECT</span>
			</div>
		</a>
	</div>

	<div class="flex items-center gap-3 text-neutral-500">
		<a
			href="https://github.com/eriknorris"
			target="_blank"
			rel="noopener noreferrer"
			class="hover:text-primary-500! transition-colors duration-300 hover:scale-110"
		>
			<Icon name="tabler:brand-github" class="h-5 w-5" />
		</a>
		<a
			href="https://linkedin.com/in/eriknorris"
			target="_blank"
			rel="noopener noreferrer"
			class="hover:text-primary-500! transition-colors duration-300 hover:scale-110"
		>
			<Icon name="tabler:brand-linkedin" class="h-5 w-5" />
		</a>
		<a
			href="mailto:erik@example.com"
			class="hover:text-primary-500! transition-colors duration-300 hover:scale-110"
		>
			<Icon name="tabler:mail" class="h-5 w-5" />
		</a>

		{/* Global Audio (Identity Overview) */}
		<div class="mx-1 h-4 w-px bg-white/20"></div>
		<SonicHeartbeat client:load audioUrl="/assets/r2/identity/identity-overview.m4a" />

		<div class="mx-1 h-4 w-px bg-white/20"></div>
		<a
			href="https://resume.eriknorris.com"
			target="_blank"
			rel="noopener noreferrer"
			class="group hover:text-primary-500! flex items-center gap-2 transition-colors duration-300"
		>
			<Icon
				name="tabler:file-text"
				class="h-5 w-5 transition-transform duration-300 group-hover:scale-110"
			/>
			<span class="hidden font-mono text-xs md:inline">RESUME</span>
		</a>
	</div>
</nav>

<style>
	/* smooth scroll behavior for anchor links */
	html {
		scroll-behavior: smooth;
	}
</style>
