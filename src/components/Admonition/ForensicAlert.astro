---
interface Props {
	variant?: "tip" | "caution" | "danger" | "info";
}

const { variant = "info" } = Astro.props;

const icons = {
	tip: "💡",
	caution: "⚠️",
	danger: "🛑",
	info: "ℹ️",
};

const iconChar = icons[variant] || "ℹ️";
---

<div
	class:list={[
		"forensic-alert dark dark:bg-base-800/70 dark:text-base-200 my-6 border-l-4 px-4 py-3",
		{
			"border-success text-success-foreground bg-success/10 alert-success": variant === "tip",
		},
		{
			"border-warning text-foreground bg-warning/10 alert-warning": variant === "caution",
		},
		{
			"border-error text-error-foreground bg-error/10 alert-error": variant === "danger",
		},
		{
			"border-info text-info-foreground bg-info/10 alert-info": variant === "info",
		},
	]}
>
	<div class="not-content flex items-center gap-2 pb-2">
		<span class="text-xl">{iconChar}</span>
		<p class="font-bold">{(variant || "INFO").toUpperCase()}</p>
	</div>
	<div class="alert-content">
		<slot />
	</div>
</div>

<style>
	/* Scoped styles to ensure safety */
	.forensic-alert {
		font-family: inherit;
	}
	.alert-content p {
		margin-top: 0.5em;
		margin-bottom: 0.5em;
	}
</style>
