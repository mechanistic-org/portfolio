---
interface Props {
	cast: {
		name: string;
		role: string;
		org: string;
	}[];
}

const { cast } = Astro.props;
---

<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
	{
		cast && cast.length > 0 ? (
			cast.map((member) => (
				<div class="bg-card/30 border-border group hover:bg-card/50 relative flex flex-col overflow-hidden rounded-lg border p-4 transition-colors">
					<div class="mb-1 flex items-center justify-between">
						<h3 class="text-foreground font-mono text-sm font-bold">{member.name}</h3>
						{member.org && (
							<span class="bg-muted text-muted-foreground rounded px-1.5 py-0.5 font-mono text-[10px] tracking-wider uppercase">
								{member.org}
							</span>
						)}
					</div>
					<p class="text-muted-foreground text-xs">{member.role}</p>

					{/* Hover Effect */}
					<div class="bg-primary absolute inset-x-0 bottom-0 h-0.5 scale-x-0 transition-transform duration-300 group-hover:scale-x-100" />
				</div>
			))
		) : (
			<div class="text-muted-foreground col-span-full py-8 text-center font-mono text-sm">
				// NO PERSONNEL RECORDS FOUND //
			</div>
		)
	}
</div>
