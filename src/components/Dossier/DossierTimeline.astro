---
import { formatDate } from "@/js/textUtils";

interface Props {
	timeline: {
		date: string | Date;
		title: string;
		subtitle?: string;
		phase?: string;
		status?: string;
	}[];
}

const { timeline } = Astro.props;

// Sort by date (Oldest first for chronology? Or Newest first?)
// Usually chronologies are Top=Oldest, Bottom=Newest.
// Let's sort:
// Sort by date with safety check
const safeTimeline = Array.isArray(timeline) ? timeline : [];
const sortedTimeline = [...safeTimeline].sort((a, b) => {
	return new Date(a.date).getTime() - new Date(b.date).getTime();
});
---

<div class="relative flex flex-col gap-8 pl-4">
	{
		sortedTimeline && sortedTimeline.length > 0 ? (
			<>
				{/* Vertical Line */}
				<div class="bg-border absolute top-2 bottom-0 left-[23px] w-px" />

				{sortedTimeline.map((event) => {
					const isCritical = event.status === "Critical" || event.status === "Failure";
					const isMilestone = event.status === "Milestone" || event.status === "Completed";

					return (
						<div class="group relative flex gap-6">
							{/* Dot */}
							<div class="bg-background ring-border group-hover:ring-primary relative z-10 mt-1.5 ml-[15px] flex h-4 w-4 shrink-0 items-center justify-center rounded-full ring-2 transition-colors">
								<div
									class={`h-2 w-2 rounded-full ${isCritical ? "animate-pulse bg-red-500" : isMilestone ? "bg-emerald-500" : "bg-muted-foreground"}`}
								/>
							</div>

							{/* Content */}
							<div class="flex flex-col gap-1">
								<div class="flex items-baseline gap-3">
									<span class="text-foreground font-mono text-xs font-bold">
										{formatDate(event.date)}
									</span>
									{event.phase && (
										<span class="bg-muted text-muted-foreground rounded px-1.5 py-0.5 font-mono text-[10px] tracking-wider uppercase">
											{event.phase}
										</span>
									)}
								</div>
								<h3 class="text-foreground font-bold">{event.title}</h3>
								{event.subtitle && <p class="text-muted-foreground text-sm">{event.subtitle}</p>}
							</div>
						</div>
					);
				})}
			</>
		) : (
			<div class="text-muted-foreground py-8 text-center font-mono text-sm">
				// CHRONOLOGY UNKNOWN //
			</div>
		)
	}
</div>
