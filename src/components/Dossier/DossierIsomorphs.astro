---
import IsomorphicCard from "../Forensics/IsomorphicCard";

interface Props {
	isomorphics: any[];
}

const { isomorphics = [] } = Astro.props;
---

<div class="space-y-6">
	<div class="mb-4">
		<h3 class="font-mono text-sm tracking-widest text-orange-500 uppercase">
			Structural Isomorphism
		</h3>
		<p class="text-xs text-neutral-500">
			Mapping physical engineering constraints to digital architecture paradigms.
		</p>
	</div>

	{
		isomorphics.map((iso) => (
			<IsomorphicCard
				client:load
				label={iso.label}
				hardware_point={iso.hardware_point}
				software_point={iso.software_point}
				principle={iso.principle}
			/>
		))
	}
</div>
