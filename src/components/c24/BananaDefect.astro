---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;

// Extract the 'Side Cap Crisis' sticky data
const sideCapCrisis = project.data.cyberspace?.stickies.find(
  (sticky) => sticky.id === '02_side_cap_crisis'
);

// We need the images for the left sticky pane
const forensicImages = sideCapCrisis?.data?.images || [];

// And the deck for the right scrolling pane
const narrativeBlocks = sideCapCrisis?.deck || [];
---

<section class="relative border-b border-slate-800 bg-slate-950 font-mono text-slate-300" id="defects">
  <div class="flex flex-col md:flex-row">
    
    {/* Left: Sticky Image Pane (The Forensic Evidence) */}
    <div class="md:sticky md:top-0 h-[50vh] md:h-screen w-full md:w-1/2 overflow-hidden border-r border-slate-800 p-8 flex flex-col">
      <div class="mb-4 flex items-center justify-between border-b border-slate-800 pb-2">
        <span class="text-xs font-bold uppercase tracking-widest text-[#5a95ed]">Forensic Visual Evidence</span>
        <span class="text-xs text-slate-500">P/N 9440-55165</span>
      </div>
      
      <div class="relative flex-grow items-center justify-center p-4">
        {forensicImages.length > 0 && (
           <img 
             src={forensicImages[0].src} 
             alt={forensicImages[0].alt}
             class="h-full w-full object-contain mix-blend-screen opacity-90 border border-slate-800 p-2"
           />
        )}
        
        {/* brutalist crosshairs */}
        <div class="absolute top-0 left-0 h-4 w-4 border-t border-l border-slate-500"></div>
        <div class="absolute top-0 right-0 h-4 w-4 border-t border-r border-slate-500"></div>
        <div class="absolute bottom-0 left-0 h-4 w-4 border-b border-l border-slate-500"></div>
        <div class="absolute bottom-0 right-0 h-4 w-4 border-b border-r border-slate-500"></div>
      </div>
      
      <div class="mt-4 text-xs text-slate-500 flex justify-between">
         <span>FIG 01. GAP ANALYSIS</span>
         <span>DEV: +2.27mm</span>
      </div>
    </div>

    {/* Right: Scrolling Narrative (The Case Study) */}
    <div class="w-full md:w-1/2 p-8 md:p-24 space-y-32">
      
      <div class="mb-12 border-l-2 border-[#5a95ed] pl-6">
        <h2 class="font-sans text-3xl font-bold uppercase tracking-tight text-slate-100">
          The Banana Defect
        </h2>
        <p class="mt-2 text-sm text-slate-400">Thermodynamic Warping Resolution</p>
      </div>

      {narrativeBlocks.map((block, index) => (
        <div class="space-y-4">
          <div class="flex items-center gap-4">
            <span class="bg-slate-900 px-2 py-1 text-xs font-bold text-[#5a95ed]">
              0{index + 1}
            </span>
            <h3 class="font-sans text-xl font-bold text-slate-200">
              {block.title}
            </h3>
          </div>
          
          <div class="prose prose-invert prose-slate prose-sm max-w-none border-l border-slate-800 pl-6 text-slate-400 marker:text-slate-600">
             {/* Using dangerouslySetInnerHTML because the body is markdown that needs rendering, 
                 but for a quick prototype we'll just dump the string. In a real astro component 
                 you might process this with a markdown compiler or leave it as pure text if it's simple.*/}
             <p set:html={block.body.replace(/\n\n/g, '<br/><br/>').replace(/\*/g, '')} />
          </div>
        </div>
      ))}

      <div class="pb-32 pt-16">
         <div class="border border-slate-800 bg-slate-900/50 p-6">
            <h4 class="mb-4 text-xs font-bold uppercase tracking-widest text-[#5a95ed]">Heuristic Impact</h4>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <div class="text-[10px] text-slate-500">Metric</div>
                <div class="text-sm text-slate-200">Flatness Deviation</div>
              </div>
              <div>
                <div class="text-[10px] text-slate-500">Result</div>
                <div class="text-sm font-bold text-emerald-500">2.50mm &rarr; &lt;0.50mm</div>
              </div>
            </div>
         </div>
      </div>

    </div>
  </div>
</section>
