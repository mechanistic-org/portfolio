---
import clientList from "@config/clients.json";
import Marquee from "@components/Marquee/Marquee";
const marqueeList = [
	...clientList,
	...clientList,
	...clientList,
	...clientList,
	...clientList,
	...clientList,
]; // Infinite loop (6x)
---

<div class="w-full border-y border-neutral-800 bg-neutral-900/50 py-6">
	<Marquee client:load speed={1}>
		{
			marqueeList.map((client) => (
				<div class="flex min-w-0 flex-[0_0_auto] items-center gap-4 pl-12 opacity-50 grayscale transition-all hover:opacity-100 hover:grayscale-0">
					{client.logo ? (
						<img
							src={client.logo}
							alt={client.name}
							class="h-8 w-auto object-contain"
							loading="lazy"
						/>
					) : (
						<span class="text-xl font-bold tracking-widest text-neutral-500 uppercase select-none">
							{client.name}
						</span>
					)}
				</div>
			))
		}
	</Marquee>
</div>
