---
import { Image } from "astro:assets";

// data
import siteData from "@config/siteData.json";
---

<a class="primary-focus group/navlink relative block h-10 w-40" href="/" aria-label="Home">
	<img
		src="/assets/branding/EN_wordmark_H_black_1200.svg"
		alt="Erik Norris"
		class="logo-light absolute inset-0 h-full w-full object-contain"
	/>
	<img
		src="/assets/branding/EN_wordmark_H_white_1200.svg"
		alt="Erik Norris"
		class="logo-dark absolute inset-0 h-full w-full object-contain"
	/>
</a>

<style>
	/* Default: Light Mode */
	.logo-light {
		display: block;
	}
	.logo-dark {
		display: none;
	}

	/* Dark Mode */
	:global(.dark) .logo-light {
		display: none;
	}
	:global(.dark) .logo-dark {
		display: block;
	}
</style>
