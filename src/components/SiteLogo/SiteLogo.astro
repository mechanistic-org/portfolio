---
import { Image } from "astro:assets";
---

<a
	class="primary-focus group/navlink relative block flex h-full w-40 items-center justify-center"
	href="/"
	aria-label="Home"
	id="site-logo-container"
>
	<!-- Dark Mode Logo (Default for 'System' aesthetic) -->
	<img
		src="/assets/branding/EN_logo_white_1200.svg"
		alt="Erik Norris Logo"
		class="hidden h-[70%] w-auto object-contain transition-transform duration-300 group-hover/navlink:scale-105 dark:block"
	/>

	<!-- Light Mode Logo -->
	<img
		src="/assets/branding/EN_logo_black_1200.svg"
		alt="Erik Norris Logo"
		class="block h-[70%] w-auto object-contain transition-transform duration-300 group-hover/navlink:scale-105 dark:hidden"
	/>
</a>

<style>
	/* 
	 * Ensure the logo color matches the text/theme.
	 * The 'dark' class is typically controlled by the Tailwind 'darkMode' config or a parent class.
	 */
</style>
