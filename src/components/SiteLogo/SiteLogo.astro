---
import { Image } from "astro:assets";

// data
import siteData from "@config/siteData.json";
---

<a
	class="primary-focus group/navlink relative block h-full w-40"
	href="/"
	aria-label="Home"
	id="site-logo-container"
>
	<model-viewer
		id="nav-logo-3d"
		src="/assets/r2/_site/en_logo.glb"
		alt="Erik Norris 3D Logo"
		class="h-full w-full"
		disable-zoom
		camera-controls
		shadow-intensity="1"
		environment-image="neutral"
		tone-mapping="commerce"
		exposure="1.2"
		interaction-prompt="none"
		camera-orbit="0deg 90deg 55%"
		min-camera-orbit="-30deg 60deg 55%"
		max-camera-orbit="30deg 110deg 55%"
		interpolation-decay="200"
		style="--poster-color: transparent; background-color: transparent; --progress-bar-color: #2E5CFF; --progress-bar-height: 2px;"
	>
		<!-- No Poster: Immediate load preferred for Logo -->
	</model-viewer>
</a>

<script>
	const modelViewer = document.querySelector("#nav-logo-3d") as any;
	const container = document.querySelector("#site-logo-container");

	if (modelViewer && container) {
		// "Happy Wiggle" Animation on Enter
		container.addEventListener("mouseenter", () => {
			// Only wiggle if we aren't currently being interacted with (optional check, but simple wiggle is fine)
			// We strictly target the orbit we want, letting interpolation-decay smooth it out.

			const currentOrbit = modelViewer.getCameraOrbit();
			const radius = currentOrbit.radius || "55%"; // Fallback if parsed weirdly, but usually returns obj

			// Frame 1: Tilt Left
			modelViewer.cameraOrbit = `-15deg 90deg ${radius}m`;

			setTimeout(() => {
				// Frame 2: Tilt Right
				modelViewer.cameraOrbit = `15deg 90deg ${radius}m`;
			}, 200);

			setTimeout(() => {
				// Frame 3: Back to Center
				modelViewer.cameraOrbit = `0deg 90deg ${radius}m`;
			}, 400);
		});
	}
</script>

<style>
	/* Logo specific overrides if needed */
</style>
