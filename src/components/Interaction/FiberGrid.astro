---

---

<canvas id="fiber-canvas" class="pointer-events-none fixed inset-0 z-0"></canvas>

<script>
	// --- CONFIGURATION ---
	const CONFIG = {
		// Grid Geometry
		gridSize: 40,
		gridWidth: 80, // More lines
		gridDepth: 80,
		gridSpacing: 100, // World units between lines (Square grid)

		// Camera
		horizon: 200, // Lower horizon (0 = center, positive = down)
		perspective: 800, // Higher = Flatter/Telephoto, Lower = Fisheye/Distorted
		cameraY: 300, // Camera height above floor

		// Movement
		speed: 2.0, // Scroll speed

		// Visuals
		color: { r: 0, g: 133, b: 202 },
		opacity: 0.3,
		starCount: 200,

		// Physics (The "Living" Part)
		gravityStrength: 0.6, // Strength of pull
		gravityRadius: 300, // Size of influence
		purrSpeed: 0.005, // Speed of the pulsation
	};

	// --- STATE ---
	/** @type {HTMLCanvasElement} */
	let canvas;
	/** @type {CanvasRenderingContext2D} */
	let ctx;
	let width, height;
	let cx, cy;
	let mouse = { x: -1000, y: -1000 };
	let scrollOffset = 0;
	let animationFrame;

	/** @type {Array<{x: number, y: number, z: number, size: number}>} */
	let stars = [];

	// Cleanup function to remove listeners
	function cleanup() {
		if (animationFrame) cancelAnimationFrame(animationFrame);
		window.removeEventListener("resize", resize);
		window.removeEventListener("mousemove", updateMouse);
	}

	function updateMouse(e) {
		mouse.x = e.clientX;
		mouse.y = e.clientY;
	}

	function init() {
		// @ts-ignore
		canvas = document.getElementById("fiber-canvas");
		if (!canvas) return;
		ctx = canvas.getContext("2d");

		// Resize immediately
		resize();
		window.addEventListener("resize", resize);
		window.addEventListener("mousemove", updateMouse);

		// Init Stars
		stars = [];
		for (let i = 0; i < CONFIG.starCount; i++) {
			stars.push({
				x: (Math.random() - 0.5) * 6000,
				y: (Math.random() - 0.5) * 3000 - 1000, // Bias upwards (Sky)
				z: Math.random() * 3000 + 100,
				size: Math.random() * 1.5 + 0.5,
			});
		}

		loop();
	}

	function resize() {
		width = window.innerWidth;
		height = window.innerHeight;
		if (canvas) {
			canvas.width = width;
			canvas.height = height;
		}
		cx = width / 2;
		cy = height / 2;
	}

	function project(x, y, z) {
		// Perspective Projection
		// Scale = f / (f + z)
		// We shift Z so that it's relative to the camera
		const depth = z;
		if (depth < 0) return { x: 0, y: 0, scale: 0 }; // Behind camera

		const scale = CONFIG.perspective / (CONFIG.perspective + depth);
		const px = cx + x * scale;
		// Y is offset by horizon
		const py = cy + CONFIG.horizon + y * scale;

		// Wait, if y is positive (floor), `y * scale` pushes it down from vanishing point.
		// Vanishing point is at (cx, cy + horizon).

		return { x: px, y: py, scale: scale };
	}

	function update() {
		scrollOffset = (scrollOffset + CONFIG.speed) % CONFIG.gridSpacing;
	}

	function draw() {
		// Clear
		ctx.clearRect(0, 0, width, height);
		const time = Date.now();

		// --- 1. STARS (Background) ---
		ctx.fillStyle = `rgba(255, 255, 255, 0.8)`;
		stars.forEach((star) => {
			const p = project(star.x, star.y, star.z);
			if (p.scale > 0) {
				const flicker = (Math.sin(time * 0.002 + star.x) + 1) / 2;
				ctx.globalAlpha = flicker * 0.7 + 0.3;
				ctx.beginPath();
				ctx.arc(p.x, p.y, star.size * p.scale, 0, Math.PI * 2);
				ctx.fill();
			}
		});
		ctx.globalAlpha = 1;

		// --- 2. GRID (Foreground) ---
		ctx.strokeStyle = `rgba(${CONFIG.color.r}, ${CONFIG.color.g}, ${CONFIG.color.b}, ${CONFIG.opacity})`;
		ctx.fillStyle = `rgba(${CONFIG.color.r}, ${CONFIG.color.g}, ${CONFIG.color.b}, ${CONFIG.opacity * 2})`;

		const points = [];
		const rows = CONFIG.gridDepth;
		const cols = CONFIG.gridWidth;
		const spacing = CONFIG.gridSpacing;
		const widthOffset = (cols * spacing) / 2;

		// Purr Logic (Breathing gravity)
		const purrFactor = 1 + Math.sin(time * CONFIG.purrSpeed) * 0.2; // +/- 20% strength
		const currentGravity = CONFIG.gravityStrength * purrFactor;

		for (let z = 0; z < rows; z++) {
			for (let x = 0; x <= cols; x++) {
				let wx = x * spacing - widthOffset;
				let wz = z * spacing - scrollOffset;
				let wy = CONFIG.cameraY;

				// --- PHYSICS ---
				let p = project(wx, wy, wz);

				const dx = mouse.x - p.x;
				const dy = mouse.y - p.y;
				const dist = Math.sqrt(dx * dx + dy * dy);

				if (dist < CONFIG.gravityRadius) {
					// Attraction
					const pull = 1 - dist / CONFIG.gravityRadius;
					const force = pull * currentGravity * p.scale * 100;

					const angle = Math.atan2(dy, dx);
					p.x += Math.cos(angle) * force;
					p.y += Math.sin(angle) * force;
				}

				points.push({ x: p.x, y: p.y, z: wz, scale: p.scale });
			}
		}

		// Draw Lines
		const rowStep = cols + 1;
		ctx.beginPath();

		// Horizontal (Along X)
		for (let r = 0; r < rows; r++) {
			for (let c = 0; c < cols; c++) {
				const p1 = points[r * rowStep + c];
				const p2 = points[r * rowStep + c + 1];
				if (p1.z < 10 || p1.scale > 10) continue;
				ctx.moveTo(p1.x, p1.y);
				ctx.lineTo(p2.x, p2.y);
			}
		}

		// Vertical (Along Z)
		for (let c = 0; c <= cols; c++) {
			for (let r = 0; r < rows - 1; r++) {
				const p1 = points[r * rowStep + c];
				const p2 = points[(r + 1) * rowStep + c];
				if (p1.z < 10 || p1.scale > 10) continue;
				ctx.moveTo(p1.x, p1.y);
				ctx.lineTo(p2.x, p2.y);
			}
		}
		ctx.stroke();

		// Draw Active Nodes (Intersections)
		// Only draw some to reduce noise? Or all?
		// User likes dots.
		for (let i = 0; i < points.length; i++) {
			const p = points[i];
			if (p.z < 10 || p.scale > 10) continue;

			// Distance check for "Petting" the machine
			const dx = mouse.x - p.x;
			const dy = mouse.y - p.y;
			const isActive = Math.sqrt(dx * dx + dy * dy) < CONFIG.gravityRadius;
			const isTwinkling = Math.sin(time * 0.005 + i * 0.1) > 0.7;

			if (isActive || isTwinkling) {
				// Color shift on interaction?
				if (isActive) {
					ctx.fillStyle = `rgba(255, 255, 255, 0.9)`; // White hot when touched
				} else {
					ctx.fillStyle = `rgba(${CONFIG.color.r}, ${CONFIG.color.g}, ${CONFIG.color.b}, ${CONFIG.opacity * 2})`;
				}

				const size = (isActive ? 3 : 1.5) * p.scale;
				ctx.beginPath();
				ctx.arc(p.x, p.y, size, 0, Math.PI * 2);
				ctx.fill();
			}
		}
	}

	function loop() {
		update();
		draw();
		animationFrame = requestAnimationFrame(loop);
	}

	// Init on Load and Page Swap
	document.addEventListener("astro:page-load", () => {
		cleanup();
		init();
	});
</script>
