---
import { getCollection } from "astro:content";
import SidebarLink from "./SidebarLink.astro";

// Get all docs
const globDocs = import.meta.glob("../../content/docs/**/*.{md,mdx}", { eager: true });
const allDocs = Object.values(globDocs).map((file: any) => {
	const data = file.frontmatter || {};
	const filenameParts = file.file.split("/");
	const filename = filenameParts[filenameParts.length - 1].replace(/\.(mdx|md)$/, "");
	return {
		slug: data.slug || filename,
		data: data,
	};
});

// Group docs by section (top-level folder)
const docsBySection = allDocs.reduce(
	(acc, doc) => {
		const [section] = doc.slug.split("/");
		if (!acc[section]) {
			acc[section] = [];
		}
		acc[section].push(doc);
		return acc;
	},
	{} as Record<string, typeof allDocs>,
);

// Sort sections (custom order or alphabetical)
// You can customize this array to control section order
const sectionOrder = ["getting-started", "guides", "reference", "other"];
const sections = Object.keys(docsBySection).sort((a, b) => {
	const indexA = sectionOrder.indexOf(a);
	const indexB = sectionOrder.indexOf(b);
	if (indexA !== -1 && indexB !== -1) return indexA - indexB;
	if (indexA !== -1) return -1;
	if (indexB !== -1) return 1;
	return a.localeCompare(b);
});

// Sort docs within sections
sections.forEach((section) => {
	docsBySection[section].sort((a, b) => {
		// Sort by order if available, otherwise title
		const orderA = a.data.sidebar?.order ?? 999;
		const orderB = b.data.sidebar?.order ?? 999;
		if (orderA !== orderB) return orderA - orderB;
		return a.data.title.localeCompare(b.data.title);
	});
});

// Helper to format section title
const formatSectionTitle = (slug: string) => {
	return slug
		.split("-")
		.map((word) => word.charAt(0).toUpperCase() + word.slice(1))
		.join(" ");
};
---

<nav class="sidebar-nav space-y-8">
	{
		sections.map((section) => (
			<div class="sidebar-section">
				<div class="mb-2 px-4 font-sans text-sm font-bold tracking-wide text-neutral-500 uppercase">
					{formatSectionTitle(section)}
				</div>
				<ul class="space-y-1 border-l border-neutral-800">
					{docsBySection[section].map((doc) => (
						<SidebarLink
							link={`/docs/${doc.slug}`}
							text={doc.data.sidebar?.label || doc.data.title}
							badge={doc.data.sidebar?.badge}
						/>
					))}
				</ul>
			</div>
		))
	}
</nav>
