---
import SidebarLink from "./SidebarLink.astro";

import { getCollection } from "astro:content";

// Get all docs
const docsCollection = await getCollection("docs");
const allDocs = docsCollection.map((entry) => {
	// For content collections, the entry has .id and .data.
	// The slug is often derived from the id (file path) or explicitly set.
	// We'll normalize to ensure consistency with the old logic.

	// The slug logic from the component was assuming file paths.
	// Astro v5 content layer uses entry.id as the identifier (path).
	// Let's rely on entry.id as the base slug source if not overridden.

	// We need to clean .mdx/.md extensions if present in ID
	const cleanId = entry.id.replace(/\.(mdx|md)$/i, "");

	return {
		slug: entry.data.slug || cleanId,
		data: entry.data,
	};
});

// Group docs by section (top-level folder)
const docsBySection = allDocs.reduce(
	(acc, doc) => {
		// Use frontmatter group override if available
		if (doc.data.sidebar?.group) {
			const group = doc.data.sidebar.group;
			if (!acc[group]) acc[group] = [];
			acc[group].push(doc);
			return acc;
		}

		const slugParts = doc.slug.split("/");
		// If it's a root file (no slashes), group under "documentation"
		// If it's in a folder, group by that folder name
		const section = slugParts.length > 1 ? slugParts[0] : "documentation";

		if (!acc[section]) {
			acc[section] = [];
		}
		acc[section].push(doc);
		return acc;
	},
	{} as Record<string, typeof allDocs>,
);

// Sort sections (custom order or alphabetical)
// Put "documentation" first, then others
const sectionOrder = [
	"Handbook",
	"System Manual",
	"Design",
	"Workflows",
	"Reference",
	"Prompts",
	"Audits",
	"getting-started",
	"guides",
	"reference",
	"other",
];
const sections = Object.keys(docsBySection).sort((a, b) => {
	// Normalize to lowercase for case-insensitive sort if not in explicit list?
	// But sectionOrder is explicit.
	// Let's handle both cases in the comparator if needed, or just list them.
	// The keys in docsBySection are either folder names (lowercase) or Frontmatter Groups (Capitalized).
	// "design" folder -> key "design". "Audits" folder -> key "audits".
	// "System Manual" -> key "System Manual" (Frontmatter).

	// Let's normalize comparison.
	const normalize = (s: string) => {
		const map: Record<string, string> = {
			design: "Design",
			audits: "Audits",
			reference: "Reference",
		};
		return map[s] || s;
	};

	const indexA = sectionOrder.indexOf(normalize(a));
	const indexB = sectionOrder.indexOf(normalize(b));

	if (indexA !== -1 && indexB !== -1) return indexA - indexB;
	if (indexA !== -1) return -1;
	if (indexB !== -1) return 1;
	return a.localeCompare(b);
});

// Sort docs within sections
sections.forEach((section) => {
	docsBySection[section].sort((a, b) => {
		// Sort by order if available, otherwise title
		const orderA = a.data.sidebar?.order ?? 999;
		const orderB = b.data.sidebar?.order ?? 999;
		if (orderA !== orderB) return orderA - orderB;

		const titleA = a.data.title || a.slug || "Untitled";
		const titleB = b.data.title || b.slug || "Untitled";
		return titleA.localeCompare(titleB);
	});
});

// Helper to format section title
const formatSectionTitle = (slug: string) => {
	// Special case for 'documentation' to ensure it looks nice
	if (slug === "documentation") return "Documentation";

	return slug
		.split("-")
		.map((word) => word.charAt(0).toUpperCase() + word.slice(1))
		.join(" ");
};
---

<nav class="sidebar-nav space-y-4">
	{
		sections.map((section) => (
			<details class="sidebar-section group" open>
				<summary class="mb-2 flex cursor-pointer list-none items-center justify-between px-4 font-sans text-sm font-bold tracking-wide text-neutral-500 uppercase select-none hover:text-neutral-300 [&::-webkit-details-marker]:hidden">
					{formatSectionTitle(section)}
					<span class="transition-transform duration-200 group-open:rotate-90">›</span>
				</summary>
				<ul class="ml-2 space-y-1 border-l border-neutral-800 pl-2 transition-all duration-300 ease-in-out">
					{docsBySection[section].map((doc) => (
						<SidebarLink
							link={`/docs/${doc.slug}`}
							text={doc.data.sidebar?.label || doc.data.title}
						/>
					))}
				</ul>
			</details>
		))
	}
</nav>
