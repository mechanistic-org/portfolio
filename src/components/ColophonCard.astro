---
import { Image } from "astro:assets";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"article"> {
	post: {
		slug: string;
		title: string;
		description?: string;
		pubDate?: string | Date;
		heroImage?: string;
		heroImageAlt?: string;
	};
	class?: string;
}

const { post, class: className, ...rest } = Astro.props as Props;
const { title, description, pubDate, heroImage, heroImageAlt = "", slug } = post;
// An absent publication date stays absent; date-only values render consistently in UTC.
const date = pubDate ? new Date(pubDate) : undefined;
const href = slug.startsWith("/") || slug.startsWith("http") ? slug : `/colophon/${slug}/`;
// Stock placeholders do not explain a system. Preserve purposeful images when supplied.
const meaningfulImage = heroImage && !heroImage.includes("/placeholders/");
---

<article class:list={["colophon-card", className]} {...rest}>
	{
		meaningfulImage && (
			<Image
				class="colophon-card-image"
				src={heroImage}
				alt={heroImageAlt}
				width={800}
				height={450}
			/>
		)
	}
	<div class="colophon-card-copy">
		{
			date && (
				<time datetime={date.toISOString()}>
					{date.toLocaleDateString("en-US", {
						month: "short",
						day: "numeric",
						year: "numeric",
						timeZone: "UTC",
					})}
				</time>
			)
		}
		<h3><a href={href}>{title}</a></h3>
		<p>{description}</p>
	</div>
</article>

<style>
	.colophon-card {
		min-width: 0;
		border-top: 1px solid var(--color-neutral-800);
		padding: 1.5rem 0;
	}
	.colophon-card-image {
		width: 100%;
		height: auto;
		margin-bottom: 1.5rem;
	}
	.colophon-card-copy {
		max-width: 68ch;
	}
	time {
		display: block;
		margin-bottom: 0.75rem;
		color: var(--color-neutral-400);
		font-family: var(--font-mono);
		font-size: 0.75rem;
	}
	h3 {
		margin-bottom: 0.75rem;
		font-size: 1.5rem;
		line-height: 1.25;
		font-weight: 600;
		color: white;
	}
	a {
		text-decoration: underline;
		text-decoration-color: var(--color-neutral-600);
		text-underline-offset: 0.25em;
	}
	a:hover {
		text-decoration-color: var(--color-primary);
	}
	a:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: 6px;
	}
	p {
		color: var(--color-neutral-300);
		line-height: 1.65;
		font-size: 1.0625rem;
	}
</style>
