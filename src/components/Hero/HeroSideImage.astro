---
import SocialCloud from "@components/SocialCloud/SocialCloud.astro";
import siteData from "@config/siteData.json";

const ASSET_DOMAIN = "https://assets.eriknorris.com";
const MODEL_URL = `${ASSET_DOMAIN}/_site/logo.glb`;
// Using your rusty badge as the loading poster
const POSTER_URL = `${ASSET_DOMAIN}/_site/EN_Badge_wire_rusty_1200.png`; 
---

<section id="hero" class="relative flex w-full pb-6">
    <div class="site-container grid items-center gap-10 pt-36 md:grid-cols-3 md:gap-20 md:pt-44">
        
        <div class="mx-auto max-w-lg md:col-span-2 md:ml-0 md:max-w-full flex flex-col gap-6">
            
            <div class="inline-flex items-center gap-2 self-start rounded-full border border-yellow-500/30 bg-yellow-500/10 px-3 py-1 text-xs font-medium text-yellow-500" data-mos="fade-up">
                <span class="relative flex h-2 w-2">
                  <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-yellow-400 opacity-75"></span>
                  <span class="relative inline-flex h-2 w-2 rounded-full bg-yellow-500"></span>
                </span>
                Under Construction / V1 Beta
            </div>

            <h1 class="h1" data-mos="fade-up" data-mos-delay="0.2">
                Hi, I'm {siteData.author.name}
            </h1>
            
            <p class="description text-pretty text-lg text-neutral-400" data-mos="fade-up" data-mos-delay="0.4">
                This is my technical portfolio showcasing my work as a Mechanical Design Engineer. 
                Here you'll find detailed case studies, project overviews, and insights into my design process.
            </p>
            
            <div class="flex gap-4" data-mos="fade-up" data-mos-delay="0.6">
                <SocialCloud />
            </div>
        </div>

        <div class="mx-auto max-w-sm md:col-span-1 md:max-w-full h-[400px] md:h-[500px] relative flex items-center justify-center" data-mos="fade-in" data-mos-delay="0.8">
            
            <script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.4.0/model-viewer.min.js"></script>
            
            <model-viewer 
                src={MODEL_URL}
                poster={POSTER_URL} 
                alt="Erik Norris 3D Logo"
                auto-rotate 
                camera-controls 
                shadow-intensity="1"
                exposure="1"
                /* Tweak these values if the logo looks too small/far away */
                camera-orbit="0deg 90deg 105%" 
                field-of-view="30deg"
                class="w-full h-full"
                style="--poster-color: transparent; background-color: transparent;"
            >
                <div slot="progress-bar" class="absolute top-0 left-0 h-1 w-full bg-transparent">
                    <div class="h-full bg-primary transition-all duration-300" style="width: 0%" id="progress"></div>
                </div>
            </model-viewer>

        </div>
    </div>
</section>

<script>
    const viewer = document.querySelector('model-viewer');
    const progress = document.querySelector('#progress') as HTMLElement;
    if (viewer && progress) {
        viewer.addEventListener('progress', (e) => {
            const event = e as CustomEvent;
            const p = event.detail.totalProgress * 100;
            progress.style.width = `${p}%`;
            if (p === 100) setTimeout(() => { progress.style.opacity = '0'; }, 500);
        });
    }
</script>