---
import siteData from "@config/siteData.json";

const ASSET_DOMAIN = import.meta.env.PROD ? "https://assets.eriknorris.com" : "";
// 1. YOUR 3D LOGO
const MODEL_URL = `${ASSET_DOMAIN}/_site/EN_Logo_MatteCarbon.glb`;

// 2. YOUR PNG POSTER (Transparency Support)
const POSTER_URL = `${ASSET_DOMAIN}/_site/EN_Badge_wire_rusty_1200.png`;
import ScrambleText from "@components/Effects/ScrambleText";
---

<section id="hero" class="relative flex w-full pb-3">
	<div class="site-container grid items-center gap-10 pt-32 md:grid-cols-12 md:gap-8 md:pt-32">
		<!-- Model (Left) - Spans 5 cols, starts at 2 for breathing room -->
		style="width: 0%" id="progress" >
	</div>
</section>

<!-- Text (Right) - Spans 5 cols, starts at 7 -->
<div
	class="parallax-layer mx-auto flex max-w-lg flex-col gap-6 md:col-span-5 md:col-start-7 md:ml-0 md:max-w-full"
	data-speed="1"
>
	<h1 class="h1">
		Hi, I'm&nbsp;<ScrambleText client:load text={siteData.author.name} className="text-primary" />
	</h1>
	<p class="description text-lg text-pretty text-neutral-400">Mechanical Design Engineer</p>

	<div class="mt-2 flex items-center gap-2 font-mono text-xs text-green-500">
		<span class="relative flex h-2 w-2">
			<span
				class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-75"
			></span>
			<span class="relative inline-flex h-2 w-2 rounded-full bg-green-500"></span>
		</span>
		<ScrambleText client:visible text="SYSTEM ONLINE" className="tracking-widest" />
	</div>
</div>

<!-- Scroll Indicator -->
<div
	id="scroll-indicator"
	class="absolute bottom-8 left-1/2 flex -translate-x-1/2 flex-col items-center gap-2 font-mono text-xs text-neutral-500 transition-opacity duration-300"
>
	<span class="animate-bounce">↓</span>
	<span class="tracking-widest uppercase">Scroll to Init</span>
</div>

<script>
	const viewer = document.querySelector("model-viewer");
	const progress = document.querySelector("#progress") as HTMLElement;

	if (viewer && progress) {
		viewer.addEventListener("progress", (e) => {
			const event = e as unknown as CustomEvent;
			const p = event.detail.totalProgress * 100;
			progress.style.width = `${p}%`;
			if (p === 100)
				setTimeout(() => {
					progress.style.opacity = "0";
				}, 500);
		});
	}

	// Parallax Effect
	const hero = document.getElementById("hero");
	const layers = document.querySelectorAll(".parallax-layer") as NodeListOf<HTMLElement>;
	const scrollIndicator = document.getElementById("scroll-indicator");

	if (hero && layers.length > 0) {
		// Mouse Parallax
		hero.addEventListener("mousemove", (e) => {
			const x = (e.clientX / window.innerWidth - 0.5) * 20; // Base range
			const y = (e.clientY / window.innerHeight - 0.5) * 20;

			layers.forEach((layer) => {
				const speed = parseFloat(layer.getAttribute("data-speed") || "1");
				const xOffset = x * speed;
				const yOffset = y * speed;

				// Use CSS variable for mouse offset to combine with scroll
				layer.style.setProperty("--mouse-x", `${xOffset}px`);
				layer.style.setProperty("--mouse-y", `${yOffset}px`);
			});
		});

		// Reset on leave
		hero.addEventListener("mouseleave", () => {
			layers.forEach((layer) => {
				layer.style.setProperty("--mouse-x", "0px");
				layer.style.setProperty("--mouse-y", "0px");
			});
		});

		// Scroll Parallax
		window.addEventListener("scroll", () => {
			const scrollY = window.scrollY;
			const heroHeight = hero.offsetHeight;

			// Fade out scroll indicator
			if (scrollIndicator) {
				const opacity = Math.max(0, 1 - scrollY / 200);
				scrollIndicator.style.opacity = opacity.toString();
			}

			// Parallax layers if visible
			if (scrollY < heroHeight) {
				layers.forEach((layer) => {
					const speed = parseFloat(layer.getAttribute("data-speed") || "1");
					// 3D Model (speed 2) moves slower/negative to feel further away or heavy?
					// Usually foreground moves faster.
					// Let's make text (right side, speed 1) move normally, and model (speed 2) move faster downwards
					const yOffset = scrollY * speed * 0.1;
					layer.style.setProperty("--scroll-y", `${yOffset}px`);
				});
			}
		});
	}
</script>

<style>
	.parallax-layer {
		/* Combine mouse and scroll offsets */
		transform: translate3d(var(--mouse-x, 0), calc(var(--mouse-y, 0) + var(--scroll-y, 0)), 0);
		transition: transform 0.1s linear; /* Smooth mouse, immediate scroll handled by browser? No, linear is better */
		will-change: transform;
	}
</style>
