---
import Layout from "@layouts/BaseLayout.astro";
// Adjusted relative imports for depth 3
import WiggleLogoParallax from "../../components/Deck/WiggleLogoParallax";
import ProjectStrip from "@components/Projects/ProjectStrip";
import MultiverseGraph from "@components/DataViz/MultiverseGraph";
import HyperspaceHUD from "@components/Nav/HyperspaceHUD.astro";
import ScrollyHud from "@components/Scrolly/ScrollyHud.astro";
import DecryptionDossier from "../../components/DataViz/DecryptionDossier";
import ResVizSwarm from "../../components/DataViz/ResVizSwarm";
import WorkRealm from "../../components/Realms/WorkRealm";
import ProjectTunnel from "../../components/Projects/ProjectTunnel";
import SlideProjector from "../../components/Projects/SlideProjector";
import SystemAssembly from "../../components/System/SystemAssembly";
import ArchiveSankey from "../../components/DataViz/ArchiveSankey";
import DatasheetTable from "@components/About/DatasheetTable.astro";
import workHistoryRaw from "@/data/work_history.json";
import { getCollection } from "astro:content";
import multiverseData from "../../data/timeline/multiverse.json";

// Fetch Projects
const allProjects = await getCollection("projects", ({ data }) => !data.draft);
const sortedProjects = allProjects.sort(
	(a, b) => new Date(b.data.date || 0).getTime() - new Date(a.data.date || 0).getTime(),
);

// ABOUT / SPECS DATA
interface Job {
	company: string;
	title: string;
	start: string;
	end: string;
	color: string;
	description: string;
	is_consulting: boolean;
	duration_years?: number;
}

const workHistory = workHistoryRaw as Job[];
const hasHistory = Array.isArray(workHistory) && workHistory.length > 0;

function getHash(str: string) {
	let hash = 0;
	for (let i = 0; i < str.length; i++) {
		hash = (hash << 5) - hash + str.charCodeAt(i);
		hash |= 0;
	}
	return Math.abs(hash).toString(16).substring(0, 7);
}
---

<Layout title="Hyperspace | Erik Norris" description="System Index" hideNav={true}>
	<!-- The HUD is fixed and persistent -->
	<HyperspaceHUD />
	<ScrollyHud
		steps={[
			{ id: "realm-work", label: "Work" },
			{ id: "realm-specs", label: "Specs" },
			{ id: "realm-system", label: "System" },
			{ id: "realm-archive", label: "Archive" },
		]}
	/>

	<!-- SCROLL CONTAINER -->
	<main id="hyperspace-container" class="h-screen w-full overflow-y-scroll bg-black text-white">
		<!-- REALM I: IDENTITY (The Hook) -->
		<section
			id="realm-identity"
			data-step="realm-identity"
			class="relative flex h-screen w-full snap-start flex-col items-center justify-center overflow-hidden"
		>
			<!-- Full Screen Canvas Layer -->
			<div class="absolute inset-0 z-0 h-full w-full">
				<WiggleLogoParallax client:only="react" />
			</div>

			<!-- Text Layer (z-10) -->
			<div class="pointer-events-none z-10 -mt-20 text-center">
				<h1
					class="animate-breathe-glow font-mono text-7xl font-bold tracking-tighter text-white mix-blend-difference md:text-9xl"
				>
					ERIK NORRIS
				</h1>
			</div>
		</section>
		<!-- REALM II: WORK (The Output) -->
		<section
			id="realm-work"
			data-step="realm-work"
			class="relative min-h-[300vh] w-full snap-start border-t border-white/10 bg-black"
		>
			<WorkRealm client:only="react" />
		</section>
		<!-- REALM III: SPECS (The Brain) -->
		<section
			id="realm-specs"
			data-step="realm-specs"
			class="relative min-h-screen w-full snap-start overflow-hidden border-t border-white/10 bg-black"
		>
			{/* BACKGROUND: Fullscreen Visual (Multiverse Graph) */}
			<div class="absolute inset-0 z-0 h-full w-full">
				<MultiverseGraph client:only="react" data={multiverseData} />
				{/* Overlay Gradient to fade into black edges */}
				{
					/* <div
					class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_20%,black_100%)] opacity-80"
				>
				</div> */
				}
			</div>

			{/* FOREGROUND: Floating Interface (Dossier) */}
			{/* Positioned bottom-left, initially minimized */}
			<div class="absolute bottom-12 left-8 z-20">
				<DecryptionDossier client:visible />
			</div>
		</section>
		<!-- REALM IV: SYSTEM (The Machine) -->
		<section
			id="realm-system"
			data-step="realm-system"
			class="relative flex h-screen w-full snap-start items-center justify-center border-t border-white/10 bg-neutral-950"
		>
			<div class="absolute inset-0 z-0"><SystemAssembly client:only="react" /></div>
			<div class="pointer-events-none relative z-10 hidden space-y-8 text-center">
				{/* Hidden: The SystemAssembly component provides its own UI now */}
			</div>
		</section>
		<!-- REALM V: ARCHIVE (The Source) -->
		<!-- REALM V: ARCHIVE (The Source) -->
		<section
			id="realm-archive"
			data-step="realm-archive"
			class="relative z-20 flex h-screen w-full snap-start flex-col items-center justify-center overflow-hidden border-t border-white/10 bg-black"
		>
			<div class="relative h-full w-full max-w-7xl p-8">
				<ArchiveSankey client:only="react" />
			</div>

			<footer
				class="pointer-events-none absolute bottom-4 w-full text-center font-mono text-[10px] text-neutral-800"
			>
				ERIK NORRIS &copy; 2025 // NO FATE BUT WHAT WE MAKE
			</footer>
		</section>
	</main>

	<!-- History/Log Component Inline -->
	{
		/* 
			Refactored "Operational Log"
			- Minimalist, Git-style
			- JetBrains Mono
		*/
	}
	<div class="site-container max-w-5xl px-4 md:px-0">
		<!-- Header -->
		<div class="mb-8 flex items-end justify-between border-b border-neutral-800 pb-2 font-mono">
			<h2 class="text-xl tracking-widest text-white uppercase">
				<span class="text-primary-500 mr-2">///</span>Operational Log
			</h2>
			<div class="text-[10px] text-neutral-600">KERNEL_PANIC_HISTORY</div>
		</div>

		<!-- Log Container -->
		<div class="font-mono text-sm">
			{
				hasHistory ? (
					<div class="space-y-1">
						{/* Minimal list spacing */}
						{workHistory.map((job) => (
							<div class="group flex items-baseline gap-4 py-1 text-neutral-400 transition-colors hover:text-white">
								{/* Hash / ID */}
								<div class="hidden w-20 shrink-0 font-mono text-[10px] text-neutral-600 md:block">
									{getHash(job.company)}
								</div>

								{/* Date */}
								<div class="w-16 shrink-0 text-neutral-500">
									{new Date(job.start).getFullYear()}
								</div>

								{/* Content */}
								<div class="flex-1">
									<span
										class={`font-bold text-white group-hover:text-[${job.color}] transition-colors`}
									>
										{job.company}
									</span>
									<span class="mx-2 text-neutral-700">/</span>
									<span class="text-neutral-300">{job.title}</span>
								</div>
							</div>
						))}
					</div>
				) : (
					<div class="py-4 text-neutral-600">Log empty.</div>
				)
			}
			<div class="mt-4 border-t border-neutral-900 pt-4 text-[10px] text-neutral-700">
				END OF LOG
			</div>
		</div>
	</div>
</Layout>

<style>
	/* Hide scrollbar for immersive feel */
	main::-webkit-scrollbar {
		display: none;
	}
	main {
		-ms-overflow-style: none;
		scrollbar-width: none;
	}

	/* Custom 0.1Hz (10s) Breathing Animation - Calm */
	@keyframes breathe-glow {
		0%,
		100% {
			opacity: 0.9;
			transform: scale(1);
			/* Removed text-shadow to prevent rendering artifacts */
		}
		50% {
			opacity: 1;
			transform: scale(1.03); /* Gentle expansion */
			/* Optional: subtle filter brightness instead of shadow */
			filter: brightness(1.2);
		}
	}

	.animate-breathe-glow {
		animation: breathe-glow 10s ease-in-out infinite;
	}
</style>
