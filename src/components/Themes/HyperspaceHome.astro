---
import Layout from "@layouts/BaseLayout.astro";
import HyperspaceHUD from "@components/Nav/HyperspaceHUD.astro";
import WorkRealm from "../../components/Realms/WorkRealm";
import WiggleLogo3D from "@components/Deck/WiggleLogo3D";
import { getMultiverseData } from "@/utils/getMultiverseData";

const multiverseData = await getMultiverseData();
---

<Layout
	title="Erik Norris | Senior Staff ME / Designer"
	description="System Index"
	hideNav={true}
	starfield={true}
>
	<!-- The HUD is fixed and persistent, wrapper made transparent -->
	<div class="fixed top-0 left-0 z-50 w-full bg-transparent">
		<HyperspaceHUD />
	</div>

	<!-- SCROLL TRACK -->
	<!-- A generic tall element to allow the user to "scroll" which drives the animation -->
	<!-- SCROLL TRACK -->
	<!-- A generic tall element to allow the user to "scroll" which drives the animation -->
	<div
		id="hyperspace-scroll-track"
		class="pointer-events-none relative z-0 h-[200vh] w-full"
		style="background-color: transparent !important;"
	>
	</div>

	<!-- LAYER 2: LOGO (The Overlay) -->
	<!-- Fixed position, sits on top. Fades out on scroll. -->
	<div
		id="logo-layer"
		class="will-change-opacity pointer-events-none fixed inset-0 z-50 flex items-center justify-center transition-opacity duration-75"
	>
		<WiggleLogo3D client:load />

		<!-- Scroll Hint Removed -->
	</div>

	<!-- LAYER 1: WORK REALM (The Underlayer) -->
	<!-- Fixed position, starts visible but its CHILDREN will be offset -->
	<div
		id="work-layer"
		class="fixed inset-0 z-10 h-full w-full bg-transparent transition-opacity duration-300"
	>
		<WorkRealm client:only="react" nodes={multiverseData.nodes} />
	</div>
</Layout>

<script>
	// SCROLL ORCHESTRATOR
	// Drives the parallax transition between Logo and Swarm
	const logo = document.getElementById("logo-layer");
	const work = document.getElementById("work-layer");
	const hint = document.getElementById("scroll-hint");

	// Wait for React to mount and create the columns
	const initScroll = () => {
		const swarmCol = document.getElementById("swarm-col");
		const ficheCol = document.getElementById("fiche-col");

		if (!swarmCol || !ficheCol) {
			requestAnimationFrame(initScroll);
			return;
		}

		// Initialize positions off-screen
		swarmCol.style.opacity = "0"; // Start invisible
		swarmCol.style.transform = "translateY(0)"; // Start in place
		ficheCol.style.transform = `translateX(100vw)`; // Start completely right

		// Use a simpler opacity transition for the container? No, keep it solid black.

		window.addEventListener("scroll", () => {
			if (!logo) return;

			const y = window.scrollY;

			// 1. LOGO FADE (0 -> 300px)
			const logoOpacity = Math.max(0, 1 - y / 300);
			logo.style.opacity = logoOpacity.toString();

			// Z-INDEX FIX: Hide logo layer completely to unblock clicks
			if (y > 300) {
				logo.style.visibility = "hidden";
			} else {
				logo.style.visibility = "visible";
			}

			// Z-INDEX FIX: Disable pointer events on logo layer when it fades out to unblock Swarm
			if (y > 200) {
				logo.style.pointerEvents = "none";
			} else {
				logo.style.pointerEvents = "auto";
			}

			// Hide hint
			if (hint) hint.style.opacity = y > 50 ? "0" : "1";

			// 2. ENTRANCE ANIMATION (0 -> 400px)
			// Fully entered by 400px scroll (Faster Stage Set)
			const progress = Math.min(1, y / 400);

			// Swarm: STAGE IS STATIC, but Fades In (Cross-fade with Logo)
			// Logo Fades Out 0-300. Swarm Fades In 100-400?
			// Or just simple opacity mapping to progress.
			// Let's make it fully visible by 300 to match the trigger.
			const swarmOpacity = Math.min(1, y / 300);
			swarmCol.style.opacity = swarmOpacity.toString();
			// Ensure it is fixed at 0 if we removed the transform in CSS
			swarmCol.style.transform = `translateY(0)`;

			// Fiche: Still slides from right
			const ease = 1 - Math.pow(1 - progress, 2);
			const vw = window.innerWidth;
			const targetFicheX = vw * (1 - ease);
			ficheCol.style.transform = `translateX(${targetFicheX}px)`;

			// 3. AXIS ANIMATION (Slow Entry 300 -> 800px)
			const axis = document.getElementById("swarm-axis");
			if (axis) {
				// If scroll < 300: 0
				// If scroll > 800: 1
				const axisP = Math.max(0, Math.min(1, (y - 300) / 500));
				axis.style.opacity = (axisP * 0.5).toString(); // Max opacity 0.5 as defined in CSS originally
				// Optional: Slide in from right?
				// axis.style.transform = `translateX(${(1 - axisP) * 50}px)`; // Can't easily transform SVG group via standard style unless it has ID styles.
				// SVG transforms are "transform" attribute usually.
				// But modern browsers handle style.transform on SVG.
				// Let's stick to opacity for "come in quite slowly".
				// User said "come in quite slowly from the right".
				// Let's try transform.
				axis.style.transform = `translate(${swarmCol.offsetWidth - 50 + (1 - axisP) * 100}px, 0)`;
				// Wait, the axis group setup in D3 is `translate(${width - 50}, 0)`.
				// If we override style.transform, we break that.
				// WE CANNOT safely change transform of the SVG group created by D3 without losing the D3 position.
				// UNLESS we use opacity only OR target a wrapper.
				// We added id="swarm-axis" to the <g>.
				// Simple opacity is safer.
				axis.style.opacity = axisP.toString();
			}
		});

		// Initial Trigger
		window.dispatchEvent(new Event("scroll"));
	};

	// Start looking for React elements
	initScroll();
</script>

<style is:global>
	/* Ensure Canvas is transparent */
	canvas {
		background-color: transparent !important;
	}

	html {
		scroll-behavior: auto; /* Instant scroll for direct physics mapping */
		height: 100%;
		overflow-x: hidden;
	}
	body {
		background-color: black; /* This is the bottom-most layer. If Starfield fails, we see this. */
		overscroll-behavior: none;
	}
</style>
