---
import Layout from "@layouts/BaseLayout.astro";
import HomeManifesto from "../../components/Home/HomeManifesto.astro";
import HyperspaceHUD from "@components/Nav/HyperspaceHUD.astro";
import ScrollyHud from "@components/Scrolly/ScrollyHud.astro";
import WorkRealm from "../../components/Realms/WorkRealm";
import MultiverseGraph from "@components/DataViz/MultiverseGraph";
import multiverseData from "../../data/timeline/multiverse.json";
---

<Layout title="Erik Norris | Senior Staff ME / Designer" description="System Index" hideNav={true}>
	<!-- The HUD is fixed and persistent -->
	<HyperspaceHUD />
	<script>
		// Force scroll to top on load to ensure proper "Airlock" entry
		if (history.scrollRestoration) {
			history.scrollRestoration = "manual";
		}
		window.onload = function () {
			window.scrollTo(0, 0);
		};
	</script>
	<ScrollyHud
		steps={[
			// Manifesto uses internal IDs, but we track the 'Work' Realm
			{ id: "realm-identity", label: "Identity" },
			{ id: "realm-work", label: "Work" },
			{ id: "realm-specs", label: "About" },
		]}
	/>

	<!-- REALM I: MANIFESTO (The Airlock) -->
	<!-- Removed nested main to prevent double scrollbar and snap issues -->
	<div id="hyperspace-container" class="w-full text-white">
		<HomeManifesto />
	</div>

	<!-- REALM II: WORK (The Output) -->
	<section
		id="realm-work"
		data-step="realm-work"
		class="relative min-h-[300vh] w-full snap-start border-t border-white/10 bg-black"
	>
		<WorkRealm client:only="react" />
	</section>
	<!-- REALM III: SPECS (The Brain) -->
	<section
		id="realm-specs"
		data-step="realm-specs"
		class="relative min-h-screen w-full snap-start overflow-hidden border-t border-white/10 bg-black"
	>
		{/* BACKGROUND: Fullscreen Visual (Multiverse Graph) */}
		<div class="absolute inset-0 z-0 h-full w-full">
			<MultiverseGraph client:only="react" data={multiverseData} />
		</div>

		{/* FOREGROUND: Floating Interface (Dossier) */}
		{
			/* HIDDEN PER USER REQUEST
		<div class="absolute bottom-12 left-8 z-20">
			<DecryptionDossier client:visible />
		</div>
		*/
		}
	</section>

	{/* SUSPENDED REALMS */}
	{/* REALM IV: SYSTEM (The Machine) */}
	{
		/*
	<section
		id="realm-system"
		data-step="realm-system"
		class="relative flex h-screen w-full snap-start items-center justify-center border-t border-white/10 bg-neutral-950"
	>
		<div class="absolute inset-0 z-0"><SystemAssembly client:only="react" /></div>
	</section>
	*/
	}

	{/* REALM V: ARCHIVE (The Source) */}
	{
		/*
	<section
		id="realm-archive"
		data-step="realm-archive"
		class="relative z-20 flex h-screen w-full snap-start flex-col items-center justify-center overflow-hidden border-t border-white/10 bg-black"
	>
		<div class="relative h-full w-full">
			<!-- 3D Site Map (The Ultimate Fat Footer) -->
			<ConstellationEngine client:only="react" data={sitemapData} layout="tectonic" />
		</div>

		<footer
			class="pointer-events-none absolute bottom-4 w-full text-center font-mono text-[10px] text-neutral-800"
		>
			&copy; 2025 Erik Norris
		</footer>
	</section>
	</section>
	*/
	}
</Layout>

<style is:global>
	/* smooth scroll behavior for anchor links */
	html {
		scroll-behavior: smooth;
		scroll-snap-type: y mandatory;
	}

	/* Hide scrollbar for immersive feel */
	html::-webkit-scrollbar,
	body::-webkit-scrollbar {
		display: none;
	}
	html,
	body {
		-ms-overflow-style: none;
		scrollbar-width: none;
		overflow-x: hidden; /* Ensure double scrollbar is dead */
	}
	main {
		-ms-overflow-style: none;
		scrollbar-width: none;
	}

	/* Custom 0.1Hz (10s) Breathing Animation - Calm */
	@keyframes breathe-glow {
		0%,
		100% {
			opacity: 0.9;
			transform: scale(1);
		}
		50% {
			opacity: 1;
			transform: scale(1.03); /* Gentle expansion */
			filter: brightness(1.2);
		}
	}

	.animate-breathe-glow {
		animation: breathe-glow 10s ease-in-out infinite;
	}
</style>
