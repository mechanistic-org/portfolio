---
import { getCollection } from "astro:content";
import Layout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero/HardTechHero.astro";
import ProjectCard from "@components/Projects/ProjectCard.astro";
import ProjectStrip from "@components/Projects/ProjectStrip.tsx";
import Button from "@components/Button/Button.astro";
// Adjusted relative import for themes directory (depth 3)
import ClientGrid from "../../components/Home/Clients.astro";
// Adjusted relative import for themes directory (depth 3)
import SkillsGraph from "../../components/DataViz/SkillsGraph";
// Adjusted relative import for themes directory (depth 3)
import skillsData from "../../data/skills.json";

import ScrollCoordinator from "@components/Effects/ScrollCoordinator.astro";

const allProjects = await getCollection("projects", ({ data }) => !data.draft);
const recentProjects = allProjects.sort(
	(a, b) => new Date(b.data.date || 0).getTime() - new Date(a.data.date || 0).getTime(),
);
---

<Layout
	title="Erik Norris | High-Performance Mechanical Design"
	description="Mechanical Design Engineer Portfolio"
>
	<!-- FIXED BACKGROUND LAYER: D3 Skills Graph -->
	<!-- Initially low opacity, comes into focus as user scrolls -->
	<div
		class="pointer-events-none fixed inset-0 z-0 flex items-end justify-center md:pointer-events-auto"
	>
		<div
			id="d3-stage"
			class="h-[80vh] w-full max-w-[1400px] origin-bottom transition-transform duration-100 ease-linear md:h-screen"
		>
			<SkillsGraph
				client:only="react"
				skillsData={skillsData as any}
				projects={allProjects as any}
			/>
		</div>
	</div>

	<!-- SCROLLABLE CONTENT LAYER -->
	<div class="relative z-10 mb-[50vh]">
		<Hero />

		<!-- The Trust Wall: Hightails it on scroll -->
		<div
			id="trust-wall"
			class="origin-top transition-transform duration-300 ease-out"
			data-scroll-effect="flee"
		>
			<ClientGrid />
		</div>

		<section class="w-full py-8 md:py-16">
			<!-- The Project Strip: Fades and slight parallax -->
			<div
				id="project-strip-container"
				class="transition-opacity duration-300"
				data-scroll-effect="fade-out"
			>
				<ProjectStrip client:visible projects={recentProjects} />
			</div>
		</section>

		<!-- Spacer to allow scrolling "past" the content to reveal the D3 graph fully -->
		<div class="pointer-events-none flex h-[50vh] w-full items-center justify-center">
			<h2
				id="topography-label"
				class="font-mono text-xl font-bold tracking-tighter text-white uppercase opacity-0 transition-opacity duration-500"
				data-scroll-effect="label"
			>
				<span class="text-primary mr-2">///</span>Technical Topography
			</h2>
		</div>
	</div>

	<ScrollCoordinator />
</Layout>
