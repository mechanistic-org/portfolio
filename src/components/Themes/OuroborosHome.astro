---
import Layout from "@layouts/BaseLayout.astro";
import HyperspaceHUD from "@components/Nav/HyperspaceHUD.astro";
import ConstellationEngine from "@components/Constellation/ConstellationEngine";
import multiverseData from "../../data/timeline/multiverse.json";

/**
 * THE OUROBOROS (V6)
 *
 * A non-linear, association-driven navigation experience.
 * Replaces the scrollytelling realms with a unified R3F constellation.
 */
---

<Layout title="Ouroboros | Erik Norris" description="Constellation Engine" hideNav={true}>
	<!-- Persistent HUD -->
	<HyperspaceHUD />

	<!-- THE ENGINE -->
	<main class="relative h-screen w-full overflow-hidden bg-black">
		<ConstellationEngine client:only="react" data={multiverseData} />

		<!-- Instruction Overlay (Temporary?) -->
		<div class="pointer-events-none absolute bottom-24 left-1/2 z-10 -translate-x-1/2 text-center">
			<p class="font-mono text-[10px] tracking-[0.3em] text-white/30 uppercase">
				Scroll to Zoom // Drag to Pan // Click to Access
			</p>
		</div>
	</main>
</Layout>

<style>
	/* Immersive full-screen constraints */
	:global(body) {
		overflow: hidden;
	}
</style>
