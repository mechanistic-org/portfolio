---
import WiggleLogo3D from "@components/Deck/WiggleLogo3D";
import HydeOuroboros from "@components/Visualizations/HydeOuroboros";
import SolarMetrics from "@components/CaseStudy/SolarMetrics";
import SystemOverlay from "@components/Effects/SystemOverlay.astro";
import DisciplineCycler from "./DisciplineCycler";
import BlipvertSubtitle from "./BlipvertSubtitle";
---

<!-- MANIFESTO AIRLOCK --><!-- Snap Container for the Intro Sequence --><!-- MANIFESTO AIRLOCK -->
<div class="relative w-full text-white">
	{/* SLIDE 1: IDENTITY (The Hybrid Bridge) */}
	<section
		id="realm-identity"
		data-step="realm-identity"
		class="relative flex h-screen w-full snap-start flex-col items-center justify-center overflow-hidden bg-black"
	>
		<div class="absolute inset-0 z-0 opacity-50">
			<div class="absolute inset-0 bg-gradient-to-b from-black via-transparent to-black"></div>
		</div>
		<!-- LAYER 1: LOGO (Absolute, Centered) -->
		<div class="absolute inset-0 z-10 flex h-full w-full items-center justify-center">
			<!-- Scale 9.0 WiggleLogo (Now h-full) -->
			<WiggleLogo3D client:visible />
		</div>
		<!-- LAYER 2: TYPOGRAPHY (Absolute, Centered on top) -->
		<div
			class="pointer-events-none absolute inset-0 z-20 flex h-full w-full items-center justify-center text-center mix-blend-difference"
		>
			<h1
				class="animate-breathe-glow text-7xl font-medium text-white md:text-9xl"
				style="font-family: 'Roboto Flex', sans-serif;"
			>
				E<span class="opacity-85">rik</span>
				N<span class="opacity-85">orris</span>
			</h1>
		</div>
		<!-- Scrolldown Hint -->
		<div class="absolute bottom-12 z-20 animate-bounce opacity-30">
			<span class="i-tabler-arrow-down text-2xl"></span>
		</div>
	</section>
	{
		/* THE NEURAL STREAM Pattern: Sticky Stacking ("Card Stack") Each section is Sticky
Top-0 and Full Screen. As you scroll, the next one slides OVER the previous one. */
	}
	{
		/* SLIDE 2:
THE CRUX (Hardware vs Software) */
	}
	{
		/*
        ACCORDION SEQUENCE: The Compressing Dashboard
        Wrapper height = 400vh (defines sequence duration).
        Sticky Container = 100vh.
        Animation: Panels enter, compress neighbors, then spring back.
    */
	}
	<section
		id="manifesto-accordion"
		class="relative z-10 h-[400vh] border-t border-white/10 bg-black"
	>
		<div class="sticky top-0 h-screen w-full overflow-hidden">
			<!-- BACKGROUND -->
			<div class="absolute inset-0 z-0">
				<div
					class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-neutral-900/50 via-black to-black opacity-50"
				>
				</div>
				<div
					class="pointer-events-none absolute inset-0 opacity-10"
					style="background-image: linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px); background-size: 50px 50px;"
				>
				</div>
			</div>

			<!-- THE STAGE (Absolute Panels) -->
			<div id="accordion-stage" class="relative h-full w-full">
				{/* PANEL 1: HARDWARE (Zips in, Elastic) */}
				<div
					id="panel-1"
					class="absolute top-0 left-0 h-full overflow-hidden will-change-transform"
				>
					<!-- BACKGROUND VIZ: Ouroboros (Huge, Interactive, No Frame) -->
					<div
						class="pointer-events-auto absolute inset-0 z-0 flex cursor-pointer items-center justify-center opacity-40 mix-blend-screen"
					>
						<div
							class="animate-spin-slow flex h-[150vh] w-[150vw] origin-center transform items-center justify-center transition-transform duration-[60s] ease-linear"
						>
							<HydeOuroboros client:visible width={1200} height={1200} />
						</div>
					</div>

					<div
						class="pointer-events-none relative z-10 flex h-full w-[100vw] flex-col items-center justify-center p-6 text-center"
					>
						<SystemOverlay title="SYS.HARDWARE" subtitle="CAD_BRIDGE" color="text-white" />
						<div class="flex flex-col items-center justify-center">
							<!-- Cycler handles the "Hardware is..." text -->
							<DisciplineCycler client:visible />

							<div class="mt-8">
								<BlipvertSubtitle client:visible />
							</div>
						</div>
					</div>
				</div>

				{/* PANEL 2: TRUTH (Compresses P1) */}
				<div
					id="panel-2"
					class="absolute top-0 right-0 h-full origin-right overflow-hidden border-l border-white/10 bg-black will-change-transform"
				>
					<div
						class="relative flex h-full w-[100vw] flex-col items-center justify-center p-6 text-center"
					>
						<SystemOverlay title="SYS.TRUTH" subtitle="TELEMETRY" color="text-green-500" />
						<div class="opacity-transition z-10">
							<div
								class="mb-8 scale-90 transform rounded border border-green-500/20 bg-black p-2 shadow-[0_0_50px_rgba(34,197,94,0.15)]"
							>
								<SolarMetrics client:visible />
							</div>
							<h2 class="text-4xl font-bold tracking-tighter whitespace-nowrap text-white">
								The Pursuit of <span class="text-green-500">Truth</span>.
							</h2>
						</div>
					</div>
				</div>

				{/* PANEL 3: VERIFY (Bulldozer from Bottom, Compresses All) */}
				<div
					id="panel-3"
					class="absolute bottom-0 left-0 w-full origin-bottom overflow-hidden border-t border-white/10 bg-neutral-900 will-change-transform"
				>
					<div
						class="relative flex h-[100vh] w-full flex-col items-center justify-center p-6 text-center"
					>
						<SystemOverlay title="SYS.VERIFY" subtitle="HANDSHAKE" color="text-primary-400" />
						<div class="z-10 max-w-4xl space-y-12">
							<h2 class="text-6xl font-black tracking-tighter text-white md:text-8xl">
								Trust.<br />
								<span
									class="from-primary-400 bg-gradient-to-r to-white bg-clip-text text-transparent"
									>Verify.</span
								>
							</h2>

							<div class="pt-8">
								<a href="#realm-work" class="group inline-flex flex-col items-center gap-4">
									<span
										class="border border-white/20 bg-white/5 px-6 py-3 font-mono text-xs tracking-[0.3em] text-white uppercase backdrop-blur-md transition-all group-hover:bg-white group-hover:text-black"
										>ENTER MULTIVERSE</span
									>
									<span
										class="i-tabler-caret-down text-primary-500 text-4xl transition-transform group-hover:translate-y-2"
									></span>
								</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<script>
		const wrapper = document.getElementById("manifesto-accordion");
		const p1 = document.getElementById("panel-1");
		const p2 = document.getElementById("panel-2");
		const p3 = document.getElementById("panel-3");

		if (wrapper && p1 && p2 && p3) {
			// PHYSICS CONSTANTS
			// We animate using 'width' percentages or transforms.

			function update() {
				if (!wrapper || !p1 || !p2 || !p3) return;

				const rect = wrapper.getBoundingClientRect();
				const viewHeight = window.innerHeight;
				const scrollDist = rect.height - viewHeight;
				// Progress 0 (Top) -> 1 (Bottom)
				let progress = -rect.top / scrollDist;
				progress = Math.max(0, Math.min(1, progress));

				// SEQUENCE LOGIC
				// 0.0 - 0.2: P1 enters (Opacity/Scale?) -> Already there on load for impact?
				// Let's assume P1 is default state.

				// 0.2 - 0.45: P2 Enters (Right -> Left). Compresses P1.
				// P2 Width: 0 -> 66%. P1 Width: 100% -> 33%.

				let p1Width = 100;
				let p2Width = 0;
				let p3Height = 0; // P3 comes from bottom

				// PHASE 1: TRANSITION TO DUO (0.1 -> 0.4)
				if (progress > 0.1) {
					// Normalize 0.1->0.4 to 0->1
					const p = Math.min(1, (progress - 0.1) / 0.3);

					// P2 grows to 75% then settles to 60%?
					// User said: "Moves in and compresses first into quarterish (25%) then rebounding to thirds (33%?)"
					// Actually, let's target the exact "Quarter" compression first.

					// Bezier Curve for "Compression -> Rebound"?
					// Simple logic: Go to 75% width (P2), forcing P1 to 25%.

					p2Width = p * 60; // Target 60% for P2, 40% for P1 initially
				}

				// PHASE 2: BULLDOZER (0.5 -> 0.8)
				// P3 Comes from bottom.
				if (progress > 0.5) {
					const p = Math.min(1, (progress - 0.5) / 0.3);
					p3Height = p * 50; // Grow to 50% height? No, user wants "All viewable at once".
					// User said: "Springs back to each thirds in the viewport"
					// So P3 should transform from a "Bottom Sheet" into a "Right Column"?
					// OR: P3 pushes them up?
					// "Third chugs in from bottom... compresses first two... then everything springs back to thirds"
					// This implies the final state is 3 vertical columns side-by-side.

					// Let's animate P3 Height 0->100% simply to reveal it, but we manipulate width/layout.
					// Actually, for "Side by Side", P3 should probably enter from RIGHT as well?
					// "Chugs in from the bottom" is specific.

					// Let's make P3 enter from bottom as an overlay, then "Morph" into the 3rd column.
				}

				// FINAL STATE (0.8 -> 1.0)
				// All 3 panels snap to 33.33% Width, Full Height, Side-by-side.
				// To achieve this transitions from "Bottom Sheet", we need P3 to change positioning.
				// This is tricky with pure CSS transforms.

				// SIMPLIFIED INTERPRETATION for Reliability:
				// 1. P1 (Left) starts 100% width.
				// 2. P2 (Right) enters, squeezes P1.
				// 3. P3 (Bottom) enters, squeezes P1/P2 vertically?
				// 4. "Spring Back": P1, P2, P3 animate to `left: 0, width: 33%`, `left: 33%, width: 33%`, `left: 66%, width: 33%`.

				// Let's drive Styles directly.

				// --- PHASE 1: P2 ENTRY (Right to Left) ---
				// 0.0 -> 0.4
				let p2Progress = 0;
				if (progress >= 0.0 && progress < 0.4) {
					p2Progress = progress / 0.4; // 0->1
				} else if (progress >= 0.4) {
					p2Progress = 1;
				}

				// P2 slides in from right. At 1.0, it takes up 50% (or more).
				// User wants "Compress to quarterish". So P2 takes 75%.
				const p2TargetWidth = 70; // 70% width
				const currentP2Width = p2Progress * p2TargetWidth;

				p2.style.width = `${currentP2Width}%`;
				p1.style.width = `${100 - currentP2Width}%`;
				p3.style.height = `0%`;
				p3.style.width = `100%`; // Full width initially
				p3.style.left = `0`;

				// --- PHASE 2: P3 ENTRY (Bottom Up) ---
				// 0.4 -> 0.7
				if (progress > 0.4) {
					const p3Progress = Math.min(1, (progress - 0.4) / 0.3);
					// P3 rises up. "Compresses first two" (squashes them vertically?).
					// "Until about halfwayish".
					const p3HeightVal = p3Progress * 50; // Max 50% height
					p3.style.height = `${p3HeightVal}%`;

					// While P3 rises, P1 and P2 maintain their widths (30/70).

					// --- PHASE 3: THE SPRING (0.7 -> 0.9) ---
					if (progress > 0.7) {
						const spring = Math.min(1, (progress - 0.7) / 0.2);
						// Morph to Final State:
						// P1: 33.33% Width, 100% Height
						// P2: 33.33% Width, 100% Height
						// P3: 33.33% Width, 100% Height (and moves to right)

						// Interpolate P1 Width: 30% -> 33.33%
						const p1Final = 30 + 3.33 * spring;
						p1.style.width = `${p1Final}%`;

						// Interpolate P2 Width: 70% -> 33.33%
						const p2Final = 70 - 36.66 * spring;
						p2.style.width = `${p2Final}%`;

						// Interpolate P3: Height 50% -> 100%, Width 100% -> 33.33%, Left 0 -> 66.66%??
						// This logic breaks DOM flow if they are absolute.
						// Correct Logic:
						// P3 needs to become the 3rd column.
						// P3 is absolute bottom-left.
						// To become 3rd column, it needs: top:0, right:0, height:100%, width: 33.33%.

						const p3W = 100 - 66.66 * spring; // 100 -> 33.33
						const p3H = 50 + 50 * spring; // 50 -> 100
						const p3L = 0 + 66.66 * spring; // 0 -> 66.66

						// We need to switch p3 anchor from 'bottom-left' to 'top-left' for layout consistency?
						// Or just animate 'left' and 'width'.
						p3.style.height = `${p3H}%`;
						p3.style.width = `${p3W}%`; // Wait, this makes it shrink visually...

						// User wants: "Everything springs back to each thirds".
						// This implies P3 moves into position alongside P1/P2.

						// Let's keep it simple:
						// P3 is Fixed Bottom.
						// AT SPRING: P3 width becomes 33%, Height becomes 100%, Left becomes 66%.
						p3.style.left = `${p3L}%`;
						p3.style.width = `${100 - p3L}%`; // Fill the rest

						// Rebound bounce effect?
						// Use CSS transition for the final snap?
					}
				}
			}

			// Initial call
			// update();
			window.addEventListener("scroll", () => {
				requestAnimationFrame(update);
			});
		}
	</script>
</div>
