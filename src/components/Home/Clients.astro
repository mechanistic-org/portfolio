---
import Marquee from "@components/Marquee/Marquee";
import type { MarqueeItem } from "@components/Marquee/Marquee";
import clientList from "@/config/clients.json";

// Duplicate for marquee loop to ensure enough content
const duplicatedClients = [
	...clientList,
	...clientList,
	...clientList,
	...clientList,
	...clientList,
	...clientList,
];

const marqueeItems: MarqueeItem[] = duplicatedClients.map((client, index) => {
	// 1. Try Manual Upload (Local)
	// Checks if "logo" field is set in clients.json (e.g. "/images/clients/foo.png")
	if (client.logo) {
		return {
			id: `${client.name}-${index}`,
			text: client.name,
			image: client.logo,
			link: `/projects?client=${encodeURIComponent(client.name)}`,
			variant: "logo-only",
		};
	}

	// 2. Try Simple Icons (SVG) - Monochrome Fallback
	if (client.icon) {
		return {
			id: `${client.name}-${index}`,
			text: client.name,
			image: `https://cdn.simpleicons.org/${client.icon}`,
			link: `/projects?client=${encodeURIComponent(client.name)}`,
			variant: "logo-only",
		};
	}

	// 3. Try Clearbit API (if domain exists) - Prioritize Color
	if (client.domain) {
		return {
			id: `${client.name}-${index}`,
			text: client.name,
			image: `https://logo.clearbit.com/${client.domain}`,
			link: `/projects?client=${encodeURIComponent(client.name)}`,
			variant: "logo-only",
		};
	}

	// 4. Fallback to Text
	return {
		id: `${client.name}-${index}`,
		text: client.name,
		image: null,
		link: `/projects?client=${encodeURIComponent(client.name)}`,
	};
});
---

<div class="relative w-full py-3">
	<!-- Gradients removed for transparency -->
	<!-- <div
		class="from-background pointer-events-none absolute top-0 left-0 z-10 h-full w-32 bg-gradient-to-r to-transparent"
	>
	</div>
	<div
		class="from-background pointer-events-none absolute top-0 right-0 z-10 h-full w-32 bg-gradient-to-l to-transparent"
	>
	</div> -->

	<Marquee client:load speed={1} items={marqueeItems} grayscale={false} />
</div>
