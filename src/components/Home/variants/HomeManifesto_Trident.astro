---
import WiggleLogo3D from "@components/Deck/WiggleLogo3D";
import HydeOuroboros from "@components/Visualizations/HydeOuroboros";
import SolarMetrics from "@components/CaseStudy/SolarMetrics";
import SystemOverlay from "@components/Effects/SystemOverlay.astro";
---

<!-- MANIFESTO AIRLOCK --><!-- Snap Container for the Intro Sequence --><!-- MANIFESTO AIRLOCK -->
<div class="relative w-full text-white">
	{/* SLIDE 1: IDENTITY (The Hybrid Bridge) */}
	<section
		id="realm-identity"
		data-step="realm-identity"
		class="relative flex h-screen w-full snap-start flex-col items-center justify-center overflow-hidden bg-black"
	>
		<div class="absolute inset-0 z-0 opacity-50">
			<div class="absolute inset-0 bg-gradient-to-b from-black via-transparent to-black"></div>
		</div>
		<!-- LAYER 1: LOGO (Absolute, Centered) -->
		<div class="absolute inset-0 z-10 flex h-full w-full items-center justify-center">
			<!-- Scale 9.0 WiggleLogo (Now h-full) -->
			<WiggleLogo3D client:visible />
		</div>
		<!-- LAYER 2: TYPOGRAPHY (Absolute, Centered on top) -->
		<div
			class="pointer-events-none absolute inset-0 z-20 flex h-full w-full items-center justify-center text-center mix-blend-difference"
		>
			<h1
				class="animate-breathe-glow text-7xl font-medium text-white md:text-9xl"
				style="font-family: 'Roboto Flex', sans-serif;"
			>
				E<span class="opacity-85">rik</span>
				N<span class="opacity-85">orris</span>
			</h1>
		</div>
		<!-- Scrolldown Hint -->
		<div class="absolute bottom-12 z-20 animate-bounce opacity-30">
			<span class="i-tabler-arrow-down text-2xl"></span>
		</div>
	</section>
	{
		/* THE NEURAL STREAM Pattern: Sticky Stacking ("Card Stack") Each section is Sticky
Top-0 and Full Screen. As you scroll, the next one slides OVER the previous one. */
	}
	{
		/* SLIDE 2:
THE CRUX (Hardware vs Software) */
	}
	{
		/* 
        TRIDENT FLOW: Horizontal Parallax Stream
        Wrapper height = 300vh (defines scroll duration).
        Sticky Container = 100vh.
        Track width = 300vw (3 slides).
    */
	}
	<section id="manifesto-flow" class="relative z-10 h-[300vh] border-t border-white/10 bg-black">
		<div class="sticky top-0 flex h-screen w-full items-center overflow-hidden">
			<!-- BACKGROUND (Parallax optional) -->
			<div class="absolute inset-0 z-0">
				<div
					class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-neutral-900/50 via-black to-black opacity-50"
				>
				</div>
				<div
					class="pointer-events-none absolute inset-0 opacity-10"
					style="background-image: linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px); background-size: 50px 50px;"
				>
				</div>
			</div>

			<!-- THE TRACK -->
			<div id="manifesto-track" class="flex h-full w-[300vw] will-change-transform">
				{/* PANEL 1: HARDWARE */}
				<div
					class="relative flex h-full w-screen flex-col items-center justify-center p-6 md:flex-row md:gap-12"
				>
					<SystemOverlay title="SYS.HARDWARE" subtitle="CAD_BRIDGE" color="text-white" />

					<div class="flex max-w-6xl flex-col items-center gap-8 md:flex-row">
						<div
							class="mb-8 scale-75 opacity-80 mix-blend-screen grayscale transition-all hover:scale-100 hover:grayscale-0 md:mb-0"
						>
							<HydeOuroboros client:visible width={500} height={500} />
						</div>
						<div class="z-10 space-y-6 text-center md:text-left">
							<h2 class="text-5xl font-bold tracking-tighter text-white md:text-7xl">
								Hardware is <span class="text-neutral-500">Hard</span>.
							</h2>
							<p class="text-primary-500 max-w-xl font-mono text-lg">
								> Innovation dies at the interface.<br />
								<span class="mt-4 block text-sm font-bold tracking-widest text-white uppercase">
									>> I speak both.</span
								>
							</p>
						</div>
					</div>
				</div>

				{/* PANEL 2: TRUTH */}
				<div
					class="relative flex h-full w-screen flex-col items-center justify-center bg-black/50 p-6 backdrop-blur-sm"
				>
					<SystemOverlay title="SYS.TRUTH" subtitle="TELEMETRY_ONLINE" color="text-green-500" />

					<div class="z-10 flex max-w-6xl flex-col items-center gap-12 md:flex-row-reverse">
						<div
							class="scale-90 transform rounded border border-green-500/20 bg-black p-2 shadow-[0_0_50px_rgba(34,197,94,0.15)]"
						>
							<SolarMetrics client:visible />
						</div>
						<div class="space-y-6 text-center md:text-right">
							<h2 class="text-5xl font-bold tracking-tighter text-white md:text-7xl">
								Truth is my <br /><span class="text-green-500">Drug</span>.
							</h2>
							<p class="font-mono text-lg text-neutral-400">
								// When I fix it...<br />
								<span class="mt-2 ml-auto block w-fit bg-white px-3 py-1 font-bold text-black"
									>IT STAYS FIXED.</span
								>
							</p>
						</div>
					</div>
				</div>

				{/* PANEL 3: VERIFY */}
				<div
					class="relative flex h-full w-screen flex-col items-center justify-center bg-neutral-900 p-6"
				>
					<SystemOverlay title="SYS.VERIFY" subtitle="HANDSHAKE_READY" color="text-primary-400" />

					<div class="z-10 flex max-w-4xl flex-col items-center space-y-12 text-center">
						<h2 class="text-6xl font-black tracking-tighter text-white md:text-9xl">
							Trust, but<br />
							<span class="from-primary-400 bg-gradient-to-r to-white bg-clip-text text-transparent"
								>Verify.</span
							>
						</h2>
						<p class="text-primary-500 font-mono text-2xl">
							&lt; Lead with the best proof available /&gt;
						</p>

						<div class="animate-pulse pt-8">
							<a href="#realm-work" class="group inline-flex flex-col items-center gap-4">
								<span
									class="border border-white/20 bg-white/5 px-6 py-3 font-mono text-sm tracking-[0.3em] text-white uppercase backdrop-blur-md transition-all group-hover:bg-white group-hover:text-black"
									>ENTER THE MULTIVERSE</span
								>
								<span
									class="i-tabler-caret-down text-primary-500 text-4xl transition-transform group-hover:translate-y-2"
								></span>
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<script>
		// HORIZONTAL SCROLL LERP ENGINE
		const wrapper = document.getElementById("manifesto-flow");
		const track = document.getElementById("manifesto-track");

		if (wrapper && track) {
			let currentScroll = 0;
			let targetScroll = 0;

			// Physics Config
			const ease = 0.05; // 5% catchup per frame = smooth/heavy feel

			function update() {
				// Determine how far down the wrapper we are
				// We want to map [wrapperTop ... wrapperBottom] to [0 ... -200vw]
				// 3 panels = 2 movements of 100vw each = -200vw total travel?
				// Actually 3 panels of 100vw = 300vw width.
				// We want to scroll from 0 to -200vw (showing the last panel).

				const rect = wrapper.getBoundingClientRect();
				const viewHeight = window.innerHeight;
				const scrollDist = rect.height - viewHeight; // Total scrollable distance

				// Progress: 0 at top, 1 at bottom
				// rect.top is 0 when at top of viewport.
				// rect.top is negative as we scroll down.
				let progress = -rect.top / scrollDist;

				// Clamp
				progress = Math.max(0, Math.min(1, progress));

				targetScroll = progress * 200; // 0 to 200vw

				// Lerp
				currentScroll += (targetScroll - currentScroll) * ease;

				// Apply
				track.style.transform = `translateX(-${currentScroll}vw)`;

				requestAnimationFrame(update);
			}

			update();
		}
	</script>
</div>
