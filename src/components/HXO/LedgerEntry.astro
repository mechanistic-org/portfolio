---
const { project } = Astro.props;
const { title, date, client, category } = project.data;
const year = date ? new Date(date).getFullYear() : "####";
---

<a
	href={`/projects/${project.slug}`}
	class="group flex items-baseline gap-6 rounded border-b border-zinc-900/50 p-3 opacity-60 transition-colors last:border-0 hover:bg-zinc-900/50 hover:opacity-100"
>
	<span
		class="w-12 shrink-0 font-mono text-xs text-zinc-600 transition-colors group-hover:text-lime-500/80"
		>{year}</span
	>
	<h3 class="flex-1 truncate text-sm font-medium text-zinc-300 group-hover:text-white">{title}</h3>
	<span class="hidden font-mono text-xs tracking-wider text-zinc-700 uppercase md:block"
		>{category ? category.replace(/_/g, " ") : "Archive"}</span
	>
	<span class="text-xs text-zinc-700 opacity-0 transition-opacity group-hover:opacity-100">→</span>
</a>
