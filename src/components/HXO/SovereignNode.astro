---
import { render } from "astro:content";

const { project } = Astro.props;
const { Content: _ } = await render(project);
const { title, date, client, forensic_summary, metrics, audio_url, toolchain } = project.data;
const year = date ? new Date(date).getFullYear() : "N/A";

// Helper to flatten metrics
const flattenMetrics = (obj: Record<string, any>, prefix = "") => {
	let acc: { key: string; val: string }[] = [];
	if (!obj) return acc;

	for (const [key, val] of Object.entries(obj)) {
		if (key === "quotes" || key === "scars") continue;

		const newKey = prefix ? `${prefix} ${key}` : key;

		if (Array.isArray(val)) {
			// Skip objects in arrays for now unless strictly needed
			if (val.length > 0 && val.every((v) => typeof v !== "object")) {
				acc.push({ key: newKey, val: val.join(", ") });
			}
		} else if (typeof val === "object" && val !== null) {
			acc = acc.concat(flattenMetrics(val, newKey));
		} else {
			acc.push({ key: newKey, val: String(val) });
		}
	}
	return acc;
};

const flatMetrics = metrics ? flattenMetrics(metrics) : [];
---

<article
	class="hxo-node relative border-l-2 border-zinc-800 pb-16 pl-8 transition-colors duration-300 hover:border-lime-400"
>
	<div
		class="absolute top-0 -left-[9px] h-4 w-4 rounded-full border-2 border-zinc-600 bg-zinc-900 transition-colors group-hover:border-lime-400 group-hover:bg-lime-900"
	>
	</div>

	<header class="mb-6">
		<div class="mb-2 flex items-center gap-4">
			<span class="font-mono text-sm tracking-widest text-lime-400">{year}</span>
			{
				client && (
					<span class="font-mono text-xs tracking-wider text-zinc-500 uppercase">
						Client: {client[0]}
					</span>
				)
			}
		</div>
		<h2 class="font-display mb-4 text-3xl font-bold text-white">{title}</h2>

		{
			audio_url && (
				<div class="audio-mini-player mb-6 flex max-w-xl items-center gap-4 rounded-lg border border-zinc-800 bg-zinc-900/50 p-3">
					<button class="play-btn rounded-full bg-lime-500 p-2 text-black transition-colors hover:bg-lime-400">
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="currentColor"
						>
							<path d="M8 5v14l11-7z" />
						</svg>
					</button>
					<div class="flex-1">
						<div class="mb-1 font-mono text-xs tracking-widest text-lime-400 uppercase">
							Forensic Overview
						</div>
						<div class="h-1 w-full overflow-hidden rounded-full bg-zinc-800">
							<div class="h-full w-1/3 bg-lime-500/50" />
						</div>
					</div>
					<span class="font-mono text-xs text-zinc-500">Audio Available</span>
				</div>
			)
		}
	</header>

	<div class="forensic-grid mb-8 grid grid-cols-1 gap-8 md:grid-cols-3">
		<div class="col-span-2 space-y-6">
			<div class="objective">
				<h3 class="mb-2 font-mono text-xs tracking-widest text-zinc-500 uppercase">Objective</h3>
				<p class="leading-relaxed font-light text-zinc-300">
					{forensic_summary?.objective || "Engineering objective data pending..."}
				</p>
			</div>

			{
				(forensic_summary?.friction || forensic_summary?.method) && (
					<div class="conflict-resolution relative rounded-lg border border-zinc-800 bg-zinc-900/40 p-6">
						<div class="absolute top-6 -left-1 h-12 w-1 bg-red-500/50" />
						<div class="mb-4">
							<strong class="mb-1 block text-xs tracking-widest text-red-400 uppercase">
								Critical Friction
							</strong>
							<p class="text-zinc-200">{forensic_summary?.friction}</p>
						</div>
						<div class="relative mt-4 border-t border-zinc-800 pt-4">
							<div class="absolute top-4 -left-[25px] h-12 w-1 bg-emerald-500/50" />
							<strong class="mb-1 block text-xs tracking-widest text-emerald-400 uppercase">
								Method A Resolution
							</strong>
							<p class="text-zinc-200">{forensic_summary?.method}</p>
						</div>
					</div>
				)
			}
		</div>

		<div class="metrics-sidebar space-y-6 border-l border-zinc-800 pl-6">
			<div>
				<h4 class="mb-2 font-mono text-xs tracking-widest text-zinc-500 uppercase">
					Verified Metrics
				</h4>
				<ul class="space-y-3 font-mono text-sm">
					{
						flatMetrics.length > 0 ? (
							flatMetrics.map(({ key, val }) => (
								<li class="mb-2 flex flex-col">
									<span class="text-[10px] tracking-wider text-zinc-600 uppercase">
										{key.replace(/_/g, " ")}
									</span>
									<span class="font-mono text-xs leading-tight wrap-break-word text-lime-300">
										{val}
									</span>
								</li>
							))
						) : (
							<li class="text-xs text-zinc-700 italic">Metrics gathering...</li>
						)
					}
				</ul>
			</div>

			{
				toolchain && (
					<div>
						<h4 class="mb-2 font-mono text-xs tracking-widest text-zinc-500 uppercase">
							Toolchain
						</h4>
						<div class="flex flex-wrap gap-2">
							{toolchain.slice(0, 5).map((t) => (
								<span class="rounded border border-zinc-800 bg-zinc-900 px-2 py-1 font-mono text-[10px] text-zinc-400">
									{t}
								</span>
							))}
						</div>
					</div>
				)
			}
		</div>
	</div>

	<footer class="mt-8 flex items-center justify-between border-t border-zinc-900 pt-4">
		<a
			href={`/projects/${project.slug}`}
			class="group flex items-center gap-2 font-mono text-sm text-lime-400 hover:text-lime-300"
		>
			View Full Technical Documentation
			<span class="transform transition-transform group-hover:translate-x-1">→</span>
		</a>
	</footer>
</article>
