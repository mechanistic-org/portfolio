---
import ForensicDrawer from "./ForensicDrawer.tsx";

interface Props {
	title?: string;
	metrics?: any;
	forensicSummary?: any;
	caseTheory?: any[];
}

const { title, metrics, forensicSummary, caseTheory } = Astro.props;
---

<ForensicDrawer
	client:only="react"
	title={title}
	metrics={metrics}
	forensicSummary={forensicSummary}
	caseTheory={caseTheory}
>
	<slot />
</ForensicDrawer>
