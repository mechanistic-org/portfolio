---
interface Props {
	id: string; // The ID of the stage (e.g. "stage-swarm")
	active?: boolean; // Initial state (usually false)
	overlay?: boolean; // If true, adds a dark overlay
}

const { id, active = false, overlay = false, ...rest } = Astro.props;
---

<div
	id={id}
	{...rest}
	class:list={[
		"pointer-events-none absolute inset-0 flex items-center justify-center transition-opacity duration-700", // Default hidden/non-interactive
		active ? "opacity-100" : "opacity-0",
		overlay ? "bg-black/80" : "bg-transparent",
	]}
	data-scrolly-layer
>
	<slot />
</div>

<style>
	/* 
    The parent component must handle the toggling of opacity/pointer-events 
    via the IntersectionObserver in ScrollyLayout. 
    */
</style>
