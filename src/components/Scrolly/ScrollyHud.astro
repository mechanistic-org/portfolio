---
interface Props {
  steps: { id: string; label: string }[];
  showLabels?: boolean;
}

const { steps, showLabels = false } = Astro.props;
---

<nav class="fixed right-6 top-1/2 z-[100] -translate-y-1/2 hidden md:block group pointer-events-auto scrolly-nav-container">
  <div class="flex flex-col gap-4">
    {steps.map((step) => (
      <a
        href={`#${step.id}`}
        class="nav-dot relative flex items-center justify-end"
        data-target={`${step.id}`}
        aria-label={`Scroll to ${step.label}`}
      >
        <!-- Label (Hover Reveal) -->
        <!-- Label (Hover Reveal) -->
        {showLabels && (
        <span class="mr-4 -translate-x-2 text-xs font-mono text-white opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100 whitespace-nowrap bg-black/50 px-2 py-1 rounded">
          {step.label}
        </span>
        )}
        
        <!-- Dot -->
        <div class="h-2 w-2 rounded-full border border-white/30 bg-white/10 transition-all duration-300 hover:scale-150 hover:bg-white/50 hover:border-white nav-dot-circle shadow-[0_0_10px_rgba(0,0,0,0.3)]"></div>
      </a>
    ))}
  </div>
</nav>

<script>
    function initScrollyHud() {
        const navContainer = document.querySelector('.scrolly-nav-container');
        const dots = document.querySelectorAll('.nav-dot');
        const container = document.getElementById('hyperspace-container');
        
        // 1. INTERSECTION OBSERVER
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                     const id = entry.target.getAttribute('data-step');
                     dots.forEach(dot => {
                         if (dot.getAttribute('data-target') === id) {
                             dot.classList.add('active');
                         } else {
                             dot.classList.remove('active');
                         }
                     });
                }
            });
        }, { 
            root: null, // Use viewport as root (works for full-screen scroll containers too)
            rootMargin: '-40% 0px -40% 0px', 
            threshold: 0 
        });

        const sections = document.querySelectorAll('[data-step]');
        
        if (sections.length === 0) {
             setTimeout(initScrollyHud, 100);
             return;
        }
        sections.forEach(el => observer.observe(el));

        // 2. CLICK HANDLING
        if (navContainer) {
            navContainer.addEventListener('click', (e) => {
                const link = (e.target as HTMLElement).closest('.nav-dot');
                if (!link) return; 

                e.preventDefault();
                const targetId = link.getAttribute('data-target');
                if (!targetId) return;

                let targetEl = document.getElementById(targetId);
                if (!targetEl) targetEl = document.getElementById(`trigger-${targetId}`);
                if (!targetEl) targetEl = document.getElementById(`realm-${targetId}`); 
                
                if (targetEl) {
                    targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        }
    }

    // Start
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initScrollyHud);
    } else {
        initScrollyHud();
    }
</script>

<style>
  /* Active State Logic - FORCED */
  :global(.active) .nav-dot-circle {
    background-color: #2E5CFF !important; /* YinMn Blue */
    border-color: #2E5CFF !important;
    transform: scale(1.6);
    box-shadow: 0 0 15px rgba(46, 92, 255, 0.6) !important;
  }
  
  :global(.active) span {
      color: #2E5CFF !important;
      opacity: 1 !important;
      transform: translateX(0) !important;
      border-color: rgba(46, 92, 255, 0.3) !important;
  }
</style>
