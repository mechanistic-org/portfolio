---
import specs from "@/data/specs.json";

// Group by Category
const categories = [...new Set(specs.map(s => s.category))];
---

<div class="border-2 border-neutral-800 bg-neutral-900/50 p-6 rounded-xl font-mono text-sm">
  <div class="flex justify-between items-end border-b-2 border-neutral-700 pb-4 mb-8">
    <div>
      <h2 class="text-2xl font-bold text-white uppercase tracking-tighter">Erik Norris</h2>
      <p class="text-neutral-400">High-Performance Mechanical Engineer</p>
    </div>
    <div class="text-right hidden sm:block">
      <div class="text-xs text-neutral-500">DOC ID</div>
      <div class="font-bold text-white">EN-SPEC-2025</div>
    </div>
  </div>

  <div class="space-y-8">
    {categories.map((cat) => (
      <div>
        <h3 class="text-xs font-bold text-primary uppercase mb-3 tracking-widest">{cat}</h3>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse min-w-[600px]">
            <thead class="text-xs text-neutral-500 border-b border-neutral-800">
              <tr>
                <th class="py-2 font-normal w-1/4">Parameter</th>
                <th class="py-2 font-normal w-1/6">Typical</th>
                <th class="py-2 font-normal w-1/6">Min / Max</th>
                <th class="py-2 font-normal w-1/6">Unit</th>
                <th class="py-2 font-normal w-1/3">Notes / Condition</th>
              </tr>
            </thead>
            <tbody class="text-neutral-300">
              {specs.filter(s => s.category === cat).map((row) => (
                <tr class="border-b border-neutral-800/50 hover:bg-neutral-800/30 transition-colors">
                  <td class="py-2 font-semibold text-white">{row.parameter}</td>
                  <td class="py-2 font-mono text-primary">{row.typical}</td>
                  <td class="py-2 font-mono text-neutral-500">
                    {row.min && row.max ? `${row.min} / ${row.max}` : '-'}
                  </td>
                  <td class="py-2 text-xs text-neutral-500">{row.unit}</td>
                  <td class="py-2 italic text-neutral-400 text-xs">{row.notes}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    ))}
  </div>

  <div class="text-[10px] text-neutral-600 mt-8 pt-4 border-t border-neutral-800 text-center uppercase">
    * Specifications subject to change without notice. Prototype unit behavior may vary before 0900 hours.
  </div>
</div>
