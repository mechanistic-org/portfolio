---
import CareerTimeline from "../DataViz/CareerTimeline";
import type { CareerNode } from "../../utils/contextRibbon";
interface Props {
	nodes: CareerNode[];
	currentId: string;
}
const { nodes, currentId } = Astro.props;
---

{currentId === "avegant-glyph" ? (
 <CareerTimeline client:load nodes={nodes} currentId={currentId} showNeighborhood={false} focusOverview compact scrubbable />
) : (
 <CareerTimeline nodes={nodes} currentId={currentId} compact />
)}
