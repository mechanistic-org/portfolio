---
import { normalizeCast, groupCast, canLinkCast } from "../../utils/cast.mjs";
import type { CastMember } from "../../utils/cast.mjs";
interface Props { cast: CastMember[]; omit?: string; }
const { cast = [], omit = "Erik Norris" } = Astro.props;
const groups = groupCast(normalizeCast(cast, omit));
---

<div class="cast-roster">
	{groups.map((group) => (
		<section class="cast-roster__section">
			{group.roster === "stakeholder" && <h3 class="cast-roster__label">Wider program</h3>}
			{group.organizations.map(({ org, members }) => (
				<div class:list={["cast-roster__organization", { "cast-roster__organization--team": members.length > 1 }]}>
					<h4>{org}</h4>
					<ul>
						{members.map((member: CastMember) => (
							<li>
								{canLinkCast(member) ? (
									<a href={member.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`${member.name} on LinkedIn`}>{member.name} ↗</a>
								) : member.name !== org && <span class="cast-roster__name">{member.name}</span>}
								<span class="cast-roster__role">{member.role}</span>
							</li>
						))}
					</ul>
				</div>
			))}
		</section>
	))}
</div>

<style>
	.cast-roster { display: grid; gap: 2rem; }
	.cast-roster__section { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); gap: 1.5rem 2rem; }
	.cast-roster__organization--team, .cast-roster__label { grid-column: 1 / -1; }
	.cast-roster__label { font-size: 1.15rem; }
	.cast-roster__organization h4 { margin: 0 0 .6rem; font-size: .85rem; font-family: var(--font-mono); }
	.cast-roster ul { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); gap: .75rem 2rem; }
	.cast-roster li { min-width: 0; padding-bottom: .65rem; border-bottom: 1px solid var(--border); }
	.cast-roster__name, .cast-roster a { display: block; font-size: .95rem; font-weight: 600; }
	.cast-roster a { color: var(--authoring-link); }
	.cast-roster__role { display: block; font-size: .85rem; line-height: 1.5; color: var(--muted-foreground); overflow-wrap: anywhere; }
</style>
