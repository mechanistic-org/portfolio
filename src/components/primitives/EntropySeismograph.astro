---
interface EntropyEvent {
	date: string;
	score: number;
	snippet: string;
	type: string;
	source_ref: string;
	time_delta?: number;
}

interface Props {
	events: EntropyEvent[];
}

const { events } = Astro.props;
const ordered = [...events].sort((a, b) => a.date.localeCompare(b.date));
const start = Date.parse(`${ordered[0]?.date}T00:00:00Z`);
const last = ordered[ordered.length - 1];
const end = Date.parse(`${last?.date}T00:00:00Z`);
const span = Math.max(1, end - start);
const peakScore = Math.max(...ordered.map((event) => event.score));
const peaks = ordered.filter((event) => event.score === peakScore);
const dateLabel = new Intl.DateTimeFormat("en-US", {
	month: "short",
	day: "numeric",
	year: "numeric",
	timeZone: "UTC",
});
const labelDate = (value: string) => dateLabel.format(new Date(`${value}T00:00:00Z`));
const position = (value: string) => ((Date.parse(`${value}T00:00:00Z`) - start) / span) * 100;
---

<section class="entropy" aria-labelledby="entropy-heading" data-entropy={ordered.length}>
	<header>
		<div>
			<span class="kicker">Derived intensity</span>
			<h2 id="entropy-heading">Project entropy</h2>
			<p>
				A scored signal of complexity and recovery pressure over time. The verified chronology above
				remains the documentary record.
			</p>
		</div>
		<div
			class="readout"
			aria-label={`${ordered.length} scored events; peak intensity ${peakScore} of 10`}
		>
			<strong>{peakScore}/10</strong>
			<span>peak · {ordered.length} signals</span>
		</div>
	</header>

	<div
		class="plot"
		role="img"
		aria-label={`Project entropy from ${labelDate(ordered[0].date)} to ${labelDate(last.date)}. Peak intensity ${peakScore} of 10.`}
	>
		<div class="scale" aria-hidden="true"><span>10</span><span>5</span><span>0</span></div>
		<div class="field" aria-hidden="true">
			<div class="guide guide-mid"></div>
			<div class="guide guide-base"></div>
			{
				ordered.map((event) => (
					<span
						class:list={["bar", { peak: event.score === peakScore }]}
						style={`--position:${position(event.date)}%;--magnitude:${Math.max(0, Math.min(10, event.score))}`}
						title={`${labelDate(event.date)} · ${event.score}/10 · ${event.snippet}`}
					/>
				))
			}
		</div>
	</div>
	<div class="range" aria-hidden="true">
		<time datetime={ordered[0].date}>{ordered[0].date.slice(0, 4)}</time>
		<span>elapsed project pressure</span>
		<time datetime={last.date}>{last.date.slice(0, 4)}</time>
	</div>

	<div class="peaks" aria-label="Peak intensity events">
		<span class="peaks-label">Peak records</span>
		{
			peaks.map((event) => (
				<article>
					<time datetime={event.date}>{labelDate(event.date)}</time>
					<strong>{event.score}/10</strong>
					<p>{event.snippet}</p>
				</article>
			))
		}
	</div>

	<details>
		<summary>Scored event index <small>{ordered.length} records</small></summary>
		<div class="table-wrap">
			<table>
				<caption class="sr-only">Project entropy event scores and source references</caption>
				<thead>
					<tr><th>Date</th><th>Score</th><th>Signal</th><th>Source</th></tr>
				</thead>
				<tbody>
					{
						ordered.map((event) => (
							<tr>
								<td>
									<time datetime={event.date}>{event.date}</time>
								</td>
								<td>{event.score}/10</td>
								<td>{event.snippet}</td>
								<td>{event.source_ref}</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</details>
</section>

<style>
	.entropy {
		margin: 1rem 0 2rem;
		border: 1px solid rgba(255, 255, 255, 0.1);
		background: #0a0a0a;
		color: #e0e0e0;
	}

	header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 2rem;
		padding: 1.25rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
	}

	.kicker,
	.readout,
	.range,
	.peaks-label,
	summary,
	th,
	td:first-child,
	td:nth-child(2) {
		font-family: var(--font-mono, "JetBrains Mono", monospace);
	}

	.kicker {
		display: block;
		margin-bottom: 0.35rem;
		color: var(--color-primary-500, #2e5cff);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	h2 {
		margin: 0;
		font-family: var(--font-header, "Barlow Condensed", sans-serif);
		font-size: clamp(1.35rem, 3vw, 2rem);
		line-height: 1;
		text-transform: uppercase;
	}

	header p {
		max-width: 48rem;
		margin: 0.65rem 0 0;
		color: rgba(229, 231, 235, 0.72);
		font-size: 0.85rem;
		line-height: 1.55;
	}

	.readout {
		flex: 0 0 auto;
		min-width: 8.5rem;
		padding-left: 1rem;
		border-left: 1px solid rgba(255, 255, 255, 0.1);
		text-align: right;
	}

	.readout strong {
		display: block;
		color: #f59e0b;
		font-size: 1.35rem;
	}

	.readout span {
		color: rgba(229, 231, 235, 0.55);
		font-size: 0.66rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.plot {
		display: grid;
		grid-template-columns: 2rem minmax(0, 1fr);
		gap: 0.65rem;
		height: 11rem;
		padding: 1.25rem 1.25rem 0;
	}

	.scale {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding-bottom: 1px;
		color: rgba(229, 231, 235, 0.42);
		font: 0.62rem/1 var(--font-mono, "JetBrains Mono", monospace);
		text-align: right;
	}

	.field {
		position: relative;
		min-width: 0;
	}

	.guide {
		position: absolute;
		right: 0;
		left: 0;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
	}

	.guide-mid {
		bottom: 50%;
	}
	.guide-base {
		bottom: 0;
	}

	.bar {
		position: absolute;
		bottom: 1px;
		left: var(--position);
		width: clamp(2px, 0.42vw, 6px);
		height: calc(var(--magnitude) * 10% - 1px);
		min-height: 2px;
		background: var(--color-primary-500, #2e5cff);
		transform: translateX(-50%);
	}

	.bar.peak {
		background: #f59e0b;
		box-shadow:
			0 0 0 1px #0a0a0a,
			0 0 0 2px #f59e0b;
	}

	.range {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.55rem 1.25rem 1rem 3.9rem;
		color: rgba(229, 231, 235, 0.48);
		font-size: 0.62rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.peaks {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		border-top: 1px solid rgba(255, 255, 255, 0.1);
	}

	.peaks-label {
		grid-column: 1 / -1;
		padding: 0.65rem 1rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
		color: rgba(229, 231, 235, 0.52);
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.peaks article {
		position: relative;
		padding: 0.9rem 1rem 1rem;
		border-right: 1px solid rgba(255, 255, 255, 0.1);
	}

	.peaks article:last-child {
		border-right: 0;
	}

	.peaks time,
	.peaks strong {
		font: 700 0.68rem/1.2 var(--font-mono, "JetBrains Mono", monospace);
	}

	.peaks time {
		color: rgba(229, 231, 235, 0.58);
	}
	.peaks strong {
		float: right;
		color: #f59e0b;
	}

	.peaks p {
		margin: 0.55rem 0 0;
		font-size: 0.74rem;
		line-height: 1.45;
	}

	details {
		border-top: 1px solid rgba(255, 255, 255, 0.1);
	}

	summary {
		padding: 0.8rem 1rem;
		cursor: pointer;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	summary:hover,
	summary:focus-visible {
		color: var(--color-primary-500, #2e5cff);
		outline: 1px solid currentColor;
		outline-offset: -1px;
	}

	summary small {
		margin-left: 0.5rem;
		color: rgba(229, 231, 235, 0.45);
		font: inherit;
	}

	.table-wrap {
		overflow-x: auto;
	}

	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.72rem;
	}

	th,
	td {
		padding: 0.65rem 0.8rem;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		text-align: left;
		vertical-align: top;
	}

	th {
		color: rgba(229, 231, 235, 0.5);
		font-size: 0.62rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	td:nth-child(2) {
		color: #f59e0b;
		white-space: nowrap;
	}
	td:last-child {
		color: rgba(229, 231, 235, 0.55);
		font-family: var(--font-mono, monospace);
	}

	@media (max-width: 700px) {
		header {
			flex-direction: column;
			gap: 1rem;
		}
		.readout {
			padding-left: 0;
			border-left: 0;
			text-align: left;
		}
		.plot {
			height: 8.5rem;
			padding-right: 0.8rem;
			padding-left: 0.8rem;
		}
		.range {
			padding-right: 0.8rem;
			padding-left: 3.45rem;
		}
		.range span {
			display: none;
		}
		.peaks {
			grid-template-columns: 1fr;
		}
		.peaks article {
			border-right: 0;
			border-bottom: 1px solid rgba(255, 255, 255, 0.1);
		}
		.peaks article:last-child {
			border-bottom: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		* {
			scroll-behavior: auto !important;
			transition: none !important;
			animation: none !important;
		}
	}
</style>
