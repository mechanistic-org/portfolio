---
/**
 * MediaHeader — the IMDb-title-page top block. Poster/hero + title + meta line +
 * tag chips + a media strip (briefing audio · photo/video counts). Sits above the
 * 3-column body. The top-end reference for every flagship project page.
 */
interface Props {
	title: string;
	meta?: (string | null | undefined)[];
	tags?: string[];
	heroImage?: string;
	description?: string;
	audioUrl?: string;
	photoCount?: number;
	videoCount?: number;
}
const {
	title,
	meta = [],
	tags = [],
	heroImage,
	description,
	audioUrl,
	photoCount,
	videoCount,
} = Astro.props;
const metaParts = meta.filter(Boolean);
---

<header class="border-border mb-10 border-b pb-8">
	<div class="flex flex-col gap-6 sm:flex-row">
		{
			heroImage && (
				<div class="shrink-0 sm:w-72">
					<img
						src={heroImage}
						alt={title}
						class="border-border aspect-[3/2] w-full rounded-lg border object-cover"
					/>
				</div>
			)
		}
		<div class="min-w-0 flex-1">
			<h1 class="h1 mb-2">{title}</h1>
			{
				metaParts.length > 0 && (
					<p class="text-muted-foreground mb-3 font-mono text-xs tracking-wide">
						{metaParts.join("  ·  ")}
					</p>
				)
			}
			{
				description && (
					<p class="text-foreground/90 mb-4 max-w-2xl text-base leading-relaxed md:text-lg">
						{description}
					</p>
				)
			}
			{
				tags.length > 0 && (
					<div class="mb-4 flex flex-wrap gap-2">
						{tags.map((t) => (
							<span class="border-border bg-muted/50 text-muted-foreground rounded-full border px-2.5 py-0.5 font-mono text-[11px] tracking-wide">
								{t}
							</span>
						))}
					</div>
				)
			}
			<div class="text-muted-foreground flex flex-wrap items-center gap-4 font-mono text-[11px]">
				{
					audioUrl && (
						<span class="flex items-center gap-1.5">
							<svg
								class="h-3.5 w-3.5"
								viewBox="0 0 24 24"
								fill="currentColor"
								aria-hidden="true"
							>
								<path d="M8 5v14l11-7z" />
							</svg>
							Briefing
						</span>
					)
				}
				{photoCount != null && <span>{photoCount} photos</span>}
				{videoCount != null && <span>{videoCount} video{videoCount === 1 ? "" : "s"}</span>}
			</div>
		</div>
	</div>
</header>
