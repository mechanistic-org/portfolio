---
interface NavItem {
	href: string;
	title: string;
}
interface Props {
	prev?: NavItem | null;
	next?: NavItem | null;
}
const { prev, next } = Astro.props;
---

{
	(prev || next) && (
		<nav class="project-navigation" aria-label="More projects">
			<div>
				{prev && (
					<a href={prev.href}>
						<span>← Previous</span>
						<strong>{prev.title}</strong>
					</a>
				)}
			</div>
			<a class="all-projects" href="/projects/">
				All work
			</a>
			<div>
				{next && (
					<a class="next-project" href={next.href}>
						<span>Next →</span>
						<strong>{next.title}</strong>
					</a>
				)}
			</div>
		</nav>
	)
}
<style>
	.project-navigation {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: center;
		gap: 1.5rem;
		padding-block: 1rem;
		border-bottom: 1px solid var(--border);
	}
	a {
		display: inline-flex;
		gap: 0.75rem;
		align-items: baseline;
		min-height: 44px;
		padding-block: 0.75rem;
		font-size: 0.875rem;
	}
	a:hover {
		color: var(--primary);
	}
	a:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 3px;
	}
	span,
	.all-projects {
		color: var(--muted-foreground);
		font-size: 0.75rem;
	}
	strong {
		font-weight: 500;
	}
	.project-navigation > div:last-child {
		text-align: right;
	}
	@media (max-width: 600px) {
		a {
			flex-direction: column;
			gap: 0.15rem;
		}
		.next-project {
			align-items: end;
		}
		.project-navigation {
			gap: 0.75rem;
		}
	}
</style>
