---
import ProjectRecord from "./ProjectRecord.astro";
import EntropySeismograph from "../primitives/EntropySeismograph.astro";
import RevMatrix from "../primitives/RevMatrix.astro";
const {
	chronology,
	timelineHref = chronology ? "#chronology-heading" : null,
	entropy = [],
	revisions,
} = Astro.props;
---

{
	timelineHref && (
		<a class="timeline-shortcut" href={timelineHref}>
			Full timeline ↗
		</a>
	)
}
{
	(entropy.length || revisions) && (
		<section class="project-records" aria-label="Project records">
			<p>Project records</p>
			{entropy.length > 0 && (
				<ProjectRecord title="Project entropy" meta={`${entropy.length} scored events`}>
					<EntropySeismograph events={entropy} />
				</ProjectRecord>
			)}
			{revisions && (
				<ProjectRecord title="Part revisions" meta="Drawing and ECO dates">
					<RevMatrix revisions={revisions} />
				</ProjectRecord>
			)}
		</section>
	)
}
<style>
	.timeline-shortcut {
		display: block;
		padding-block: 0.65rem;
		min-height: 44px;
		color: var(--primary);
		font-size: 0.85rem;
	}
	.project-records {
		margin-block: 1.5rem;
	}
	p {
		font: 0.65rem var(--font-mono);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--muted-foreground);
		margin-bottom: 0.5rem;
	}
</style>
