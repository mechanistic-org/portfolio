---
interface Props {
	sectors: string[];
	categories: string[];
	tools: string[];
	clients: string[];
}

const { sectors, categories, tools, clients } = Astro.props;
---

<div class="filter-menu-container group relative inline-block text-left">
	<!-- Trigger -->
	<button
		class="text-primary flex items-center gap-2 font-mono text-sm font-bold tracking-widest uppercase transition-colors hover:text-white"
	>
		VIEW <span
			id="active-filter-count"
			class="bg-primary hidden rounded-full px-1.5 py-0.5 text-[10px] text-black">0</span
		>
		<span class="text-[10px] opacity-50">▼</span>
	</button>

	<!-- Main Dropdown Wrapper (Invisible Bridge) -->
	<div
		class="invisible absolute top-full left-0 z-50 -translate-y-2 pt-2 opacity-0 transition-all duration-200 ease-out group-hover:visible group-hover:translate-y-0 group-hover:opacity-100"
	>
		<!-- Main Dropdown Content -->
		<div
			class="w-48 origin-top-left rounded-lg border border-neutral-800 bg-neutral-900/80 py-2 shadow-2xl backdrop-blur-xl"
		>
			<!-- Collection Sub-Menu -->
			<div class="group/item relative px-2 py-1">
				<button
					class="flex w-full items-center justify-between rounded px-2 py-1.5 text-left font-mono text-xs text-neutral-400 transition-colors hover:bg-neutral-800 hover:text-white"
				>
					<span>Collection</span>
					<span class="text-[10px]">▶</span>
				</button>
				<!-- Flyout Wrapper (Bridge) -->
				<div
					class="invisible absolute top-0 left-full -translate-x-2 pl-2 opacity-0 transition-all duration-200 ease-out group-hover/item:visible group-hover/item:translate-x-0 group-hover/item:opacity-100"
				>
					<!-- Flyout Content -->
					<div
						class="max-h-[60vh] w-56 overflow-y-auto rounded-lg border border-neutral-800 bg-neutral-900/80 p-1 shadow-xl backdrop-blur-xl"
					>
						{
							sectors.map((sector) => (
								<button
									class="filter-btn data-[active=true]:text-primary data-[active=true]:bg-primary/10 block w-full rounded px-2 py-1.5 text-left font-mono text-xs text-neutral-400 transition-colors hover:bg-neutral-800 hover:text-white"
									data-filter={sector}
									data-group="industry"
								>
									{sector}
								</button>
							))
						}
					</div>
				</div>
			</div>

			<!-- Category Sub-Menu -->
			<div class="group/item relative px-2 py-1">
				<button
					class="flex w-full items-center justify-between rounded px-2 py-1.5 text-left font-mono text-xs text-neutral-400 transition-colors hover:bg-neutral-800 hover:text-white"
				>
					<span>Category</span>
					<span class="text-[10px]">▶</span>
				</button>
				<div
					class="invisible absolute top-0 left-full -translate-x-2 pl-2 opacity-0 transition-all duration-200 ease-out group-hover/item:visible group-hover/item:translate-x-0 group-hover/item:opacity-100"
				>
					<div
						class="max-h-[60vh] w-56 overflow-y-auto rounded-lg border border-neutral-800 bg-neutral-900/80 p-1 shadow-xl backdrop-blur-xl"
					>
						{
							categories.map((cat) => (
								<button
									class="filter-btn data-[active=true]:text-primary data-[active=true]:bg-primary/10 block w-full rounded px-2 py-1.5 text-left font-mono text-xs text-neutral-400 transition-colors hover:bg-neutral-800 hover:text-white"
									data-filter={cat}
									data-group="category"
								>
									{cat}
								</button>
							))
						}
					</div>
				</div>
			</div>

			<!-- Client Sub-Menu -->
			<div class="group/item relative px-2 py-1">
				<button
					class="flex w-full items-center justify-between rounded px-2 py-1.5 text-left font-mono text-xs text-neutral-400 transition-colors hover:bg-neutral-800 hover:text-white"
				>
					<span>Client</span>
					<span class="text-[10px]">▶</span>
				</button>
				<div
					class="invisible absolute top-0 left-full -translate-x-2 pl-2 opacity-0 transition-all duration-200 ease-out group-hover/item:visible group-hover/item:translate-x-0 group-hover/item:opacity-100"
				>
					<div
						class="max-h-[60vh] w-56 overflow-y-auto rounded-lg border border-neutral-800 bg-neutral-900/80 p-1 shadow-xl backdrop-blur-xl"
					>
						{
							clients.map((client) => (
								<button
									class="filter-btn data-[active=true]:text-primary data-[active=true]:bg-primary/10 block w-full rounded px-2 py-1.5 text-left font-mono text-xs text-neutral-400 transition-colors hover:bg-neutral-800 hover:text-white"
									data-filter={client}
									data-group="client"
								>
									{client}
								</button>
							))
						}
					</div>
				</div>
			</div>

			<!-- Toolchain Sub-Menu -->
			<div class="group/item relative px-2 py-1">
				<button
					class="flex w-full items-center justify-between rounded px-2 py-1.5 text-left font-mono text-xs text-neutral-400 transition-colors hover:bg-neutral-800 hover:text-white"
				>
					<span>Toolchain</span>
					<span class="text-[10px]">▶</span>
				</button>
				<div
					class="invisible absolute top-0 left-full -translate-x-2 pl-2 opacity-0 transition-all duration-200 ease-out group-hover/item:visible group-hover/item:translate-x-0 group-hover/item:opacity-100"
				>
					<div
						class="max-h-[60vh] w-56 overflow-y-auto rounded-lg border border-neutral-800 bg-neutral-900/80 p-1 shadow-xl backdrop-blur-xl"
					>
						{
							tools.map((tool) => (
								<button
									class="filter-btn data-[active=true]:text-primary data-[active=true]:bg-primary/10 block w-full rounded px-2 py-1.5 text-left font-mono text-xs text-neutral-400 transition-colors hover:bg-neutral-800 hover:text-white"
									data-filter={tool}
									data-group="tool"
								>
									{tool}
								</button>
							))
						}
					</div>
				</div>
			</div>

			<!-- Status Sub-Menu -->
			<div class="group/item relative px-2 py-1">
				<button
					class="flex w-full items-center justify-between rounded px-2 py-1.5 text-left font-mono text-xs text-neutral-400 transition-colors hover:bg-neutral-800 hover:text-white"
				>
					<span>Status</span>
					<span class="text-[10px]">▶</span>
				</button>
				<div
					class="invisible absolute top-0 left-full -translate-x-2 pl-2 opacity-0 transition-all duration-200 ease-out group-hover/item:visible group-hover/item:translate-x-0 group-hover/item:opacity-100"
				>
					<div
						class="w-40 rounded-lg border border-neutral-800 bg-neutral-900/80 p-1 shadow-xl backdrop-blur-xl"
					>
						{
							["Production", "Prototype", "Concept"].map((status) => (
								<button
									class="filter-btn data-[active=true]:text-primary data-[active=true]:bg-primary/10 block w-full rounded px-2 py-1.5 text-left font-mono text-xs text-neutral-400 transition-colors hover:bg-neutral-800 hover:text-white"
									data-filter={status}
									data-group="status"
								>
									{status}
								</button>
							))
						}
					</div>
				</div>
			</div>

			<!-- Divider -->
			<div class="my-1 h-px bg-neutral-800"></div>

			<!-- Reset -->
			<div class="px-2 py-1">
				<button
					id="reset-filters-btn"
					class="group/reset flex w-full items-center justify-between rounded px-2 py-1.5 text-left font-mono text-xs text-neutral-500 transition-colors hover:bg-neutral-800 hover:text-white"
				>
					<span>Reset View</span>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="h-3 w-3 transition-transform group-hover/reset:rotate-180"
					>
						<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74-2.74L3 12"></path>
					</svg>
				</button>
			</div>
		</div>
	</div>
</div>
