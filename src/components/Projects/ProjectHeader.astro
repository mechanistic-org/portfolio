---
import { type CollectionEntry } from "astro:content";

interface Props {
	entry: CollectionEntry<"projects">;
	nextProject?: CollectionEntry<"projects"> | null;
	prevProject?: CollectionEntry<"projects"> | null;
}

const { entry, nextProject, prevProject } = Astro.props;
const data = entry.data as any; // Cast to any to resolve schema type lag

const tools = data.tools || [];
const impact = data.impact;
---

<header class="relative border-b border-white/10 bg-neutral-900/50 pt-32 pb-8">
	<div class="site-container">
		{/* Top Row: Meta & Navigation */}
		<div class="mb-8 flex flex-col items-start justify-between gap-4 md:flex-row md:items-center">
			<div
				class="flex items-center gap-4 font-mono text-xs tracking-widest text-neutral-500 uppercase"
			>
				<span class="text-primary">/// {entry.id}</span>
				<span>::</span>
				<span>{data.category}</span>
				<span>::</span>
				<span>{new Date(data.date).getFullYear()}</span>
			</div>

			{/* Navigation Controls */}
			<div class="flex items-center gap-2">
				{
					prevProject ? (
						<a
							href={`/projects/${prevProject.id}`}
							class="flex h-8 w-8 items-center justify-center rounded border border-white/10 bg-white/5 text-neutral-400 transition-colors hover:border-emerald-500/50 hover:text-white"
							title="Previous"
						>
							←
						</a>
					) : (
						<span class="flex h-8 w-8 cursor-not-allowed items-center justify-center rounded border border-white/5 text-neutral-800">
							←
						</span>
					)
				}

				<a
					href="/projects"
					class="flex h-8 w-8 items-center justify-center rounded border border-white/10 bg-white/5 text-neutral-400 transition-colors hover:border-emerald-500/50 hover:text-white"
					title="Index">▦</a
				>

				{
					nextProject ? (
						<a
							href={`/projects/${nextProject.id}`}
							class="flex h-8 w-8 items-center justify-center rounded border border-white/10 bg-white/5 text-neutral-400 transition-colors hover:border-emerald-500/50 hover:text-white"
							title="Next"
						>
							→
						</a>
					) : (
						<span class="flex h-8 w-8 cursor-not-allowed items-center justify-center rounded border border-white/5 text-neutral-800">
							→
						</span>
					)
				}

				<div class="mx-2 h-8 w-px bg-white/10"></div>

				<a
					href={`/raw/${entry.id}`}
					class="flex h-8 items-center justify-center rounded border border-white/10 bg-black px-3 font-mono text-[10px] text-emerald-500 transition-colors hover:bg-emerald-500/10"
				>
					RAW SOURCE
				</a>
			</div>
		</div>

		{/* Main Row: Title */}
		<div class="mb-12">
			<h1 class="mb-2 font-sans text-4xl font-bold tracking-tighter text-white md:text-6xl">
				{data.title}
			</h1>
			<p
				class="max-w-2xl border-l-2 border-emerald-500/50 py-1 pl-4 font-mono text-sm text-neutral-400 md:text-base"
			>
				{data.description}
			</p>
		</div>

		{/* Spec Sheet Grid */}
		<div class="grid grid-cols-1 gap-8 border-t border-white/10 pt-8 md:grid-cols-3">
			{/* Col 1: BOM (Tools) */}
			<div>
				<h3 class="mb-4 font-mono text-[10px] tracking-widest text-neutral-500 uppercase">
					Bill of Materials
				</h3>
				<ul class="space-y-1 font-mono text-xs text-neutral-300">
					{
						tools.slice(0, 6).map((tool: string) => (
							<li class="flex items-center gap-2">
								<span class="h-1 w-1 rounded-full bg-emerald-500/50" />
								{tool}
							</li>
						))
					}
					{
						tools.length > 6 && (
							<li class="pl-3 text-neutral-600">...and {tools.length - 6} more</li>
						)
					}
				</ul>
			</div>

			{/* Col 2: Performance Metrics */}
			<div>
				<h3 class="mb-4 font-mono text-[10px] tracking-widest text-neutral-500 uppercase">
					Performance Impact
				</h3>
				{
					impact ? (
						<div class="rounded border border-emerald-500/20 bg-emerald-500/5 p-3">
							<p class="font-mono text-xs leading-relaxed text-emerald-400">"{impact}"</p>
						</div>
					) : (
						<div class="font-mono text-xs text-neutral-600 italic">
							No specific telemetry available.
						</div>
					)
				}
			</div>

			{/* Col 3: System Context */}
			<div>
				<h3 class="mb-4 font-mono text-[10px] tracking-widest text-neutral-500 uppercase">
					System Context
				</h3>
				<dl class="grid grid-cols-2 gap-4 font-mono text-xs">
					<div>
						<dt class="block text-[10px] text-neutral-600">ROLE</dt>
						<dd class="text-white">{data.role || "Engineer"}</dd>
					</div>
					<div>
						<dt class="block text-[10px] text-neutral-600">CLIENT</dt>
						<dd class="text-white">{data.employer}</dd>
					</div>
					<div>
						<dt class="block text-[10px] text-neutral-600">REVISION</dt>
						<dd class="text-white">v1.0.4</dd>
					</div>
					<div>
						<dt class="block text-[10px] text-neutral-600">STATUS</dt>
						<dd class="text-emerald-500">{data.statusLabel}</dd>
					</div>
				</dl>
			</div>
		</div>
	</div>

	{/* Grid Overlay */}
	<div class="bg-noise pointer-events-none absolute inset-0 opacity-10 mix-blend-overlay"></div>
</header>
