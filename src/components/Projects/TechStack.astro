---
import { type CollectionEntry } from "astro:content";

interface Props {
	tools: CollectionEntry<"projects">["data"]["tools"];
}

const { tools } = Astro.props;
---

<div class="flex flex-wrap gap-3">
	{
		tools.map((tech) => (
			<li class="border-primary/20 bg-primary/5 text-primary rounded-full border px-2 py-0.5 text-xs font-medium">
				{tech}
			</li>
		))
	}
</div>
