---
interface Props {
	enabled?: boolean;
}

const { enabled = false } = Astro.props;
---

<c24-rail-coordinator data-c24-rails={enabled ? "" : undefined}>
	<slot />
</c24-rail-coordinator>

<script>
	class C24RailCoordinator extends HTMLElement {
		private mediaQuery?: MediaQueryList;
		private observer?: IntersectionObserver;
		private headings: HTMLElement[] = [];
		private panels: HTMLElement[] = [];
		private resizeFrame = 0;

		connectedCallback() {
			if (!this.hasAttribute("data-c24-rails")) return;

			this.mediaQuery = window.matchMedia("(min-width: 1024px)");
			this.mediaQuery.addEventListener("change", this.handleModeChange);
			window.addEventListener("hashchange", this.scheduleUpdate);
			window.addEventListener("resize", this.scheduleUpdate, { passive: true });
			window.addEventListener("scroll", this.scheduleUpdate, { passive: true });
			this.configure();
		}

		disconnectedCallback() {
			this.mediaQuery?.removeEventListener("change", this.handleModeChange);
			window.removeEventListener("hashchange", this.scheduleUpdate);
			window.removeEventListener("resize", this.scheduleUpdate);
			window.removeEventListener("scroll", this.scheduleUpdate);
			this.disconnectObserver();
			cancelAnimationFrame(this.resizeFrame);
		}

		private handleModeChange = () => this.configure();

		// Post-load updates are rAF-gated and can stall in embedded/headless panes that
		// do not composite; that is an intentional tradeoff for real visible-tab browsers.
		private scheduleUpdate = () => {
			cancelAnimationFrame(this.resizeFrame);
			this.resizeFrame = requestAnimationFrame(() => this.updateActiveScene());
		};

		private disconnectObserver() {
			this.observer?.disconnect();
			this.observer = undefined;
		}

		private configure() {
			this.disconnectObserver();
			this.removeAttribute("data-c24-enhanced");

			this.panels = Array.from(this.querySelectorAll<HTMLElement>("[data-c24-rail-scene]"));
			this.panels.forEach((panel) => {
				panel.removeAttribute("data-active");
				panel.removeAttribute("aria-hidden");
			});

			if (!this.mediaQuery?.matches || this.panels.length === 0) return;

			const sceneIds = new Set(this.panels.map((panel) => panel.dataset.c24RailScene));
			this.headings = Array.from(
				this.querySelectorAll<HTMLElement>(".markdown-content h2[id], .markdown-content h3[id]"),
			).filter((heading) => sceneIds.has(heading.id));

			if (this.headings.length === 0) return;

			this.setAttribute("data-c24-enhanced", "");
			this.updateActiveScene();
			this.observer = new IntersectionObserver(this.scheduleUpdate, {
				rootMargin: "-27% 0px -72% 0px",
				threshold: 0,
			});
			this.headings.forEach((heading) => this.observer?.observe(heading));
		}

		private updateActiveScene() {
			if (!this.hasAttribute("data-c24-enhanced") || this.headings.length === 0) return;

			const activationLine = window.innerHeight * 0.28;
			let activeId = this.headings[0].id;
			for (const heading of this.headings) {
				if (heading.getBoundingClientRect().top <= activationLine) activeId = heading.id;
				else break;
			}

			let activeParent = activeId;
			this.panels.forEach((panel) => {
				const isActive = panel.dataset.c24RailScene === activeId;
				panel.toggleAttribute("data-active", isActive);
				panel.setAttribute("aria-hidden", String(!isActive));
				if (isActive) activeParent = panel.dataset.c24Parent || activeId;
			});

			this.querySelectorAll<HTMLAnchorElement>("[data-c24-toc] a[href^='#']").forEach((link) => {
				const isCurrent = link.getAttribute("href") === `#${activeParent}`;
				if (isCurrent) link.setAttribute("aria-current", "location");
				else link.removeAttribute("aria-current");
			});
		}
	}

	if (!customElements.get("c24-rail-coordinator")) {
		customElements.define("c24-rail-coordinator", C24RailCoordinator);
	}
</script>

<style is:global>
	c24-rail-coordinator {
		display: block;
	}

	@media (min-width: 1024px) {
		[data-c24-rails][data-c24-enhanced] [data-c24-rail-sticky] {
			position: sticky;
			top: 6rem;
		}

		[data-c24-rails][data-c24-enhanced] [data-c24-rail-scene] {
			display: none;
		}

		[data-c24-rails][data-c24-enhanced] [data-c24-rail-scene][data-active] {
			display: block;
			animation: c24-rail-enter 180ms ease-out both;
		}
	}

	[data-c24-toc] a[aria-current="location"] {
		color: var(--color-foreground);
	}

	[data-c24-toc] a[aria-current="location"]::before {
		color: var(--color-primary);
		content: "→ ";
	}

	@keyframes c24-rail-enter {
		from {
			opacity: 0;
			transform: translateY(4px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		[data-c24-rails][data-c24-enhanced] [data-c24-rail-scene][data-active] {
			animation: none;
		}
	}
</style>
