---
import { type CollectionEntry } from "astro:content";

interface Props {
	entry?: CollectionEntry<"projects">;
	// Loose props fallback
	title?: string;
	description?: string;
	role?: string;
	client?: string;
	year?: string | number;
	tech?: string[];
	impact?: string;
	statusLabel?: string;
	class?: string;
}

const {
	entry,
	title,
	role,
	client,
	year,
	impact,
	statusLabel,
	class: className = "",
} = Astro.props;

// Normalization Logic: Use entry if available, else use loose props
const data = entry
	? entry.data
	: {
			title: title,
			role: role,
			employer: client, // mapping 'client' prop to 'employer' schema
			date: year ? new Date(year.toString()) : new Date(),
			impact: impact,
			statusLabel: statusLabel || "Prototype",
			teamSize: "Various",
			duration: "Ongoing",
		};

// 1. Core Identification
const id = entry ? entry.id.toUpperCase() : "KITCHEN-SINK";
const date = new Date(data.date).getFullYear();

// 2. Dynamic Spec Map (The "Loop" capacity)
// This can be expanded endlessly from the CSV in the future.
const specs = [
	{ label: "ROLE", value: data.role || "Engineer" },
	{ label: "CLIENT", value: data.employer || "Various" },
	{ label: "DURATION", value: data.duration },
	{ label: "TEAM", value: data.teamSize || "Solo" },
];

// 3. Status Logic
const statusColor =
	data.statusLabel === "Completed"
		? "text-[#2E5CFF]" // Blue
		: data.statusLabel === "In Progress" || data.statusLabel === "Prototype"
			? "text-amber-500"
			: "text-neutral-500";
---

<article
	class:list={[
		"group relative flex flex-col overflow-hidden rounded-sm border border-neutral-800 bg-neutral-950/50 backdrop-blur-sm transition-all hover:border-neutral-700",
		className,
	]}
>
	{/* --- CARD HEADER: IDENTIFICATION --- */}
	<div
		class="flex items-center justify-between border-b border-neutral-800 bg-white/5 px-4 py-3 font-mono text-[10px] tracking-widest text-neutral-500 uppercase"
	>
		<div class="flex items-center gap-2">
			<span
				class="h-1.5 w-1.5 rounded-full bg-neutral-600 transition-colors group-hover:bg-[#2E5CFF]"
			></span>
			<span class="text-neutral-300">{id}</span>
		</div>
		<div class="flex items-center gap-4">
			<span>REV: v1.0.4</span>
			<span class="text-neutral-600">::</span>
			<span>{date}</span>
		</div>
	</div>

	{/* --- CARD BODY: SPEC GRID --- */}
	<div class="grid grid-cols-2 gap-px bg-neutral-800 md:grid-cols-4">
		{
			specs.map((spec) => (
				<div class="flex flex-col justify-center bg-neutral-950 px-4 py-3 pb-4">
					<dt class="mb-1 font-mono text-[9px] tracking-wider text-neutral-600 uppercase">
						{spec.label}
					</dt>
					<dd class="font-mono text-xs font-bold text-neutral-200">{spec.value}</dd>
				</div>
			))
		}
	</div>

	{/* --- CARD FOOTER: IMPACT & STATUS --- */}
	<div class="flex flex-col border-t border-neutral-800 md:flex-row">
		{/* Impact Module */}
		<div
			class="flex flex-1 flex-col justify-center border-b border-neutral-800 px-4 py-4 md:border-r md:border-b-0"
		>
			<dt class="mb-2 font-mono text-[9px] tracking-wider text-[#2E5CFF] uppercase">
				// PERFORMANCE IMPACT
			</dt>
			<dd class="font-mono text-xs leading-relaxed text-neutral-300">
				{data.impact || "Telemetry data unavailable for this revision."}
			</dd>
		</div>

		{/* Status Module (Mini Gauge Concept) */}
		<div class="flex w-full flex-col justify-center bg-neutral-900/30 px-4 py-4 md:w-48">
			<dt class="mb-2 font-mono text-[9px] tracking-wider text-neutral-500 uppercase">
				Current Status
			</dt>
			<dd class={`font-mono text-xs font-bold ${statusColor} flex items-center gap-2`}>
				<span class="relative flex h-2 w-2">
					<span
						class={`animate-ping absolute inline-flex h-full w-full rounded-full opacity-75 bg-current`}
					></span>
					<span class={`relative inline-flex rounded-full h-2 w-2 bg-current`}></span>
				</span>
				{data.statusLabel}
			</dd>
		</div>
	</div>

	{/* --- DECORATIVE CORNERS (The "Tech" Feel) --- */}
	<div
		class="pointer-events-none absolute top-0 left-0 h-2 w-2 border-t border-l border-[#2E5CFF] opacity-0 transition-opacity group-hover:opacity-100"
	>
	</div>
	<div
		class="pointer-events-none absolute top-0 right-0 h-2 w-2 border-t border-r border-[#2E5CFF] opacity-0 transition-opacity group-hover:opacity-100"
	>
	</div>
	<div
		class="pointer-events-none absolute bottom-0 left-0 h-2 w-2 border-b border-l border-[#2E5CFF] opacity-0 transition-opacity group-hover:opacity-100"
	>
	</div>
	<div
		class="pointer-events-none absolute right-0 bottom-0 h-2 w-2 border-r border-b border-[#2E5CFF] opacity-0 transition-opacity group-hover:opacity-100"
	>
	</div>
</article>
