---
import { Icon } from "astro-icon/components";
import ForensicDossier from "./ForensicDossier.astro";
import ProjectMetricsGrid from "./ProjectMetricsGrid.astro";
import SonicHeartbeat from "@components/Audio/SonicHeartbeat";

interface Props {
	entry: any;
}

const { entry } = Astro.props;
const data = entry.data || {};
const metrics = data.metrics || {};
const entropy = data.entropy || [];

// Calculate if we have any malleable payload data to display
const hasData =
	(data.cast && data.cast.length > 0) ||
	(data.bom && data.bom.length > 0) ||
	(data.scars && data.scars.length > 0) ||
	data.timeline !== undefined ||
	(data.forensic_data && Object.keys(data.forensic_data).length > 0) ||
	(metrics && Object.keys(metrics).length > 0) ||
	(data.audio_url);

// Check specific sections
const hasMetrics = metrics && Object.keys(metrics).length > 0;
const hasDossier = (data.cast && data.cast.length > 0) || (data.bom && data.bom.length > 0) || data.timeline || (data.scars && data.scars.length > 0);
---

{
	hasData && (
		<section class="relative z-10 w-full bg-black/50 border-y border-white/10 backdrop-blur-md py-12 md:py-16 my-12" id="deep-data-hud">
			<div class="site-container max-w-6xl">
				
				{/* Section Header */}
				<div class="flex items-center gap-4 mb-10 pb-4 border-b border-white/5">
					<Icon name="tabler:database-export" class="h-6 w-6 text-[#2E5CFF]" />
					<div>
						<h2 class="font-mono text-sm tracking-widest text-[#2E5CFF] font-bold uppercase flex items-center gap-3">
							Deep Data HUD
							<span class="flex h-2 w-2 items-center justify-center">
								<span class="absolute inline-flex h-2 w-2 animate-ping rounded-full bg-[#2E5CFF] opacity-75" />
								<span class="relative inline-flex h-1 w-1 rounded-full bg-[#2E5CFF]" />
							</span>
						</h2>
						<p class="font-mono text-[10px] text-neutral-500 uppercase mt-1">
							Malleable Forensic Payload Matrix
						</p>
					</div>
				</div>

				<div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
					
					{/* LEFT COLUMN: Metrics & Audio */}
					<div class="lg:col-span-5 flex flex-col gap-10">
						
						{/* Sonic Heartbeat (Tribunal Podcast) */}
						{data.audio_url && (
							<div class="flex flex-col gap-4 bg-white/5 border border-white/10 p-6 rounded-lg">
								<h3 class="font-mono text-[10px] font-bold tracking-widest text-[#2E5CFF] uppercase flex items-center gap-2">
									Tribunal Podcast
								</h3>
								<div class="mt-2 text-[#2E5CFF]">
									<SonicHeartbeat client:only="react" audioUrl={data.audio_url} />
								</div>
								<p class="text-xs text-neutral-400 italic mt-2 border-l border-[#2E5CFF]/30 pl-3">
									Synthesized audio overview of project kinematics and execution history.
								</p>
							</div>
						)}

						{/* Core Metrics */}
						{hasMetrics && (
							<div class="flex flex-col gap-4">
								<h3 class="font-mono text-[10px] font-bold tracking-widest text-[#2E5CFF] uppercase">
									Core Metrics & Economics
								</h3>
								<div class="bg-black/40 border border-white/5 rounded-lg p-6">
									<ProjectMetricsGrid data={data} metrics={metrics} />
								</div>
							</div>
						)}
					</div>

					{/* RIGHT COLUMN: Scars, BOM, Dossier */}
					<div class="lg:col-span-7">
						{hasDossier && (
							<div class="flex flex-col gap-4">
								<h3 class="font-mono text-[10px] font-bold tracking-widest text-[#2E5CFF] uppercase">
									Forensic Records & Scars
								</h3>
								<div class="bg-black/40 border border-white/5 rounded-lg p-6">
									<ForensicDossier
										cast={data.cast}
										bom={data.bom}
										timeline={data.timeline}
										scars={data.scars}
									/>
								</div>
							</div>
						)}
					</div>

				</div>
			</div>
		</section>
	)
}
