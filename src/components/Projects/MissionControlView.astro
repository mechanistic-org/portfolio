---
import ClientFilterGrid from "./ClientFilterGrid.astro";

interface Props {
	sectors: string[];
	categories: string[];
	tools: string[];
	clients: string[];
}

const { sectors, categories, tools, clients } = Astro.props;
---

<!-- MISSION CONTROL DASHBOARD -->
<div
	class="mission-control w-full rounded-2xl border border-white/5 bg-black/20 p-6 backdrop-blur-sm md:p-8"
>
	<!-- Header -->
	<div class="mb-8 flex items-center justify-between border-b border-white/5 pb-4">
		<div class="flex items-center gap-3">
			<span class="i-tdesign-control-platform text-primary text-xl"></span>
			<h2 class="text-sm font-bold tracking-widest text-white uppercase">Mission Control</h2>
		</div>
		<div class="flex items-center gap-4">
			<span class="text-[10px] tracking-widest text-neutral-500 uppercase"
				>System Status: <span class="text-emerald-500">ONLINE</span></span
			>
			<button
				id="reset-filters-btn"
				class="rounded border border-white/5 px-2 py-1 text-[10px] tracking-wider text-neutral-600 uppercase transition-colors hover:border-red-500/30 hover:text-red-400"
			>
				Reset Filters
			</button>
		</div>
	</div>

	<div class="grid gap-8 lg:grid-cols-12">
		<!-- FAILSAFE / SECTORS (Left Col) -->
		<div class="space-y-8 border-r border-white/5 pr-6 lg:col-span-3">
			<!-- Sector -->
			<div>
				<h3
					class="mb-3 flex items-center gap-2 text-[10px] font-bold tracking-widest text-neutral-500 uppercase"
				>
					<span class="i-tdesign-chart-pie"></span> Sector
				</h3>
				<div class="flex flex-wrap gap-2">
					<button
						class="filter-btn hover:border-primary/50 data-[active=true]:bg-primary rounded border border-white/5 bg-neutral-900 px-3 py-1 text-xs text-neutral-400 transition-colors data-[active=true]:text-black"
						data-group="industry"
						data-filter="all"
						data-active="true">ALL</button
					>
					{
						sectors.map((s) => (
							<button
								class="filter-btn hover:border-primary/50 data-[active=true]:bg-primary rounded border border-white/5 bg-neutral-900 px-3 py-1 text-xs text-neutral-400 transition-colors data-[active=true]:text-black"
								data-group="industry"
								data-filter={s}
							>
								{s}
							</button>
						))
					}
				</div>
			</div>

			<!-- Category -->
			<div>
				<h3
					class="mb-3 flex items-center gap-2 text-[10px] font-bold tracking-widest text-neutral-500 uppercase"
				>
					<span class="i-tdesign-layers"></span> Category
				</h3>
				<div class="flex flex-wrap gap-2">
					<button
						class="filter-btn hover:border-primary/50 data-[active=true]:bg-primary rounded border border-white/5 bg-neutral-900 px-3 py-1 text-xs text-neutral-400 transition-colors data-[active=true]:text-black"
						data-group="category"
						data-filter="all"
						data-active="true">ALL</button
					>
					{
						categories.map((c) => (
							<button
								class="filter-btn hover:border-primary/50 data-[active=true]:bg-primary rounded border border-white/5 bg-neutral-900 px-3 py-1 text-xs text-neutral-400 transition-colors data-[active=true]:text-black"
								data-group="category"
								data-filter={c}
							>
								{c}
							</button>
						))
					}
				</div>
			</div>

			<!-- Phase -->
			<div>
				<h3
					class="mb-3 flex items-center gap-2 text-[10px] font-bold tracking-widest text-neutral-500 uppercase"
				>
					<span class="i-tdesign-time"></span> Phase
				</h3>
				<div class="flex flex-wrap gap-2">
					<button
						class="filter-btn hover:border-primary/50 data-[active=true]:bg-primary rounded border border-white/5 bg-neutral-900 px-3 py-1 text-xs text-neutral-400 transition-colors data-[active=true]:text-black"
						data-group="status"
						data-filter="all"
						data-active="true">ALL</button
					>
					{
						["Production", "Prototype", "Concept"].map((s) => (
							<button
								class="filter-btn hover:border-primary/50 data-[active=true]:bg-primary rounded border border-white/5 bg-neutral-900 px-3 py-1 text-xs text-neutral-400 transition-colors data-[active=true]:text-black"
								data-group="status"
								data-filter={s}
							>
								{s}
							</button>
						))
					}
				</div>
			</div>
		</div>

		<!-- GLOBAL CLIENT MATRIX (Center Col) -->
		<div class="lg:col-span-9">
			<h3
				class="mb-4 flex items-center gap-2 text-[10px] font-bold tracking-widest text-neutral-500 uppercase"
			>
				<span class="i-tdesign-usergroup"></span> Client Matrix
			</h3>
			<ClientFilterGrid activeClient="all" />
		</div>
	</div>
</div>

<script>
	// Internal Logic for Mobile expansion?
	// For now, it's static.
	// The parent page handles the filter clicks via class Delegation.
</script>
