---
interface Props {
	models: {
		id: string;
		title: string;
		caption?: string;
		src: string;
		cameraOrbit?: string;
		fieldOfView?: string;
	}[];
}
const { models } = Astro.props;
---

{
	models.map((model) => (
		<section class="model-evidence" data-project-model={model.id}>
			<h2>{model.title}</h2>
			{model.caption && <p>{model.caption}</p>}
			<details data-model-disclosure>
				<summary>Explore the 3D model</summary>
				<div class="model-evidence__viewer" data-model-frame hidden>
					<model-viewer
						src={model.src}
						alt={model.title}
						camera-controls
						touch-action="pan-y"
						camera-orbit={model.cameraOrbit}
						field-of-view={model.fieldOfView}
						loading="lazy"
					/>
				</div>
				<p data-model-status aria-live="polite" />
				<a href={model.src}>Open model file ↗</a>
			</details>
		</section>
	))
}

<script>
	function connectModels() {
		for (const disclosure of document.querySelectorAll<HTMLDetailsElement>(
			"[data-model-disclosure]",
		)) {
			if (disclosure.dataset.bound) continue;
			disclosure.dataset.bound = "true";
			disclosure.addEventListener("toggle", async () => {
				if (!disclosure.open || disclosure.dataset.loaded) return;
				const frame = disclosure.querySelector<HTMLElement>("[data-model-frame]")!;
				const status = disclosure.querySelector<HTMLElement>("[data-model-status]")!;
				status.textContent = "Loading model…";
				try {
					await import("@google/model-viewer");
					const viewer = disclosure.querySelector("model-viewer")!;
					viewer.addEventListener(
						"load",
						() => {
							status.textContent = "";
						},
						{ once: true },
					);
					viewer.addEventListener(
						"error",
						() => {
							status.textContent = "The preview is unavailable. The model file is linked below.";
						},
						{ once: true },
					);
					frame.hidden = false;
					disclosure.dataset.loaded = "true";
				} catch {
					status.textContent = "The preview is unavailable. The model file is linked below.";
				}
			});
		}
	}
	connectModels();
	document.addEventListener("astro:page-load", connectModels);
</script>

<style>
	.model-evidence {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid var(--border);
	}
	.model-evidence h2 {
		font-family: var(--font-header);
		font-size: 2rem;
	}
	.model-evidence p {
		color: var(--muted-foreground);
		line-height: 1.55;
	}
	.model-evidence summary,
	.model-evidence a {
		display: block;
		min-height: 44px;
		padding: 0.75rem;
		color: var(--primary);
		cursor: pointer;
	}
	.model-evidence summary:focus-visible,
	.model-evidence a:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 2px;
	}
	.model-evidence__viewer {
		height: clamp(280px, 55vw, 500px);
		border: 1px solid var(--border);
		background: var(--card);
	}
	model-viewer {
		display: block;
		width: 100%;
		height: 100%;
	}
</style>
