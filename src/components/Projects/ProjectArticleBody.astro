---
import { normalizeProjectBody } from "../../utils/inlineArticle";
interface Props {
	beforeId?: string;
}
const { beforeId } = Astro.props;
// Both slots are already rendered Astro content. Split at a validated heading
// during the static build, so placement and article order also work without JS.
const article = normalizeProjectBody(await Astro.slots.render("default"));
const escapedId = (beforeId ?? "").replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
const heading = new RegExp(`<h[23]\\b[^>]*\\bid="${escapedId}"[^>]*>`).exec(article);
if (beforeId && !heading) throw new Error(`Project model placement: heading ${beforeId} not found`);
---

<Fragment set:html={article.slice(0, heading?.index ?? article.length)} />
<slot name="model" />
<Fragment set:html={article.slice(heading?.index ?? article.length)} />
