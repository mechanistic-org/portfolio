---
interface Props {
	enabled?: boolean;
	anchors?: string[];
}

const { enabled = false, anchors = [] } = Astro.props;
---

<project-rail-coordinator
	data-project-rails={enabled ? "" : undefined}
	data-rail-anchors={JSON.stringify(anchors)}
>
	<slot />
</project-rail-coordinator>

<script>
	class ProjectRailCoordinator extends HTMLElement {
		private mediaQuery?: MediaQueryList;
		private observer?: IntersectionObserver;
		private headings: HTMLElement[] = [];
		private panels: HTMLElement[] = [];
		private resizeFrame = 0;

		connectedCallback() {
			if (!this.hasAttribute("data-project-rails")) return;

			this.mediaQuery = window.matchMedia("(min-width: 1024px)");
			this.mediaQuery.addEventListener("change", this.handleModeChange);
			window.addEventListener("hashchange", this.scheduleUpdate);
			window.addEventListener("resize", this.scheduleUpdate, { passive: true });
			window.addEventListener("scroll", this.scheduleUpdate, { passive: true });
			this.configure();
		}

		disconnectedCallback() {
			this.mediaQuery?.removeEventListener("change", this.handleModeChange);
			window.removeEventListener("hashchange", this.scheduleUpdate);
			window.removeEventListener("resize", this.scheduleUpdate);
			window.removeEventListener("scroll", this.scheduleUpdate);
			this.disconnectObserver();
			cancelAnimationFrame(this.resizeFrame);
		}

		private handleModeChange = () => this.configure();

		// Post-load updates are rAF-gated and can stall in embedded/headless panes that
		// do not composite; that is an intentional tradeoff for real visible-tab browsers.
		private scheduleUpdate = () => {
			cancelAnimationFrame(this.resizeFrame);
			this.resizeFrame = requestAnimationFrame(() => this.updateActiveScene());
		};

		private disconnectObserver() {
			this.observer?.disconnect();
			this.observer = undefined;
		}

		private configure() {
			this.disconnectObserver();
			this.removeAttribute("data-project-enhanced");

			this.panels = Array.from(this.querySelectorAll<HTMLElement>("[data-project-rail-scene]"));
			this.panels.forEach((panel) => {
				panel.removeAttribute("data-active");
				panel.removeAttribute("aria-hidden");
				panel.removeAttribute("inert");
			});

			if (!this.mediaQuery?.matches || this.panels.length === 0) return;

			const sceneIds = new Set<string>(JSON.parse(this.dataset.railAnchors || "[]"));
			this.headings = Array.from(
				this.querySelectorAll<HTMLElement>(".markdown-content h2[id], .markdown-content h3[id]"),
			).filter((heading) => sceneIds.has(heading.id));

			if (this.headings.length === 0) return;

			this.setAttribute("data-project-enhanced", "");
			this.updateActiveScene();
			this.observer = new IntersectionObserver(this.scheduleUpdate, {
				rootMargin: "-27% 0px -72% 0px",
				threshold: 0,
			});
			this.headings.forEach((heading) => this.observer?.observe(heading));
		}

		private updateActiveScene() {
			if (!this.hasAttribute("data-project-enhanced") || this.headings.length === 0) return;

			const activationLine = window.innerHeight * 0.28;
			let activeId = this.headings[0].id;
			for (const heading of this.headings) {
				if (heading.getBoundingClientRect().top <= activationLine) activeId = heading.id;
				else break;
			}

			let activeParent = activeId;
			this.panels.forEach((panel) => {
				const isActive = panel.dataset.projectRailScene === activeId;
				panel.toggleAttribute("data-active", isActive);
				panel.setAttribute("aria-hidden", String(!isActive));
				panel.toggleAttribute("inert", !isActive);
				if (isActive) activeParent = panel.dataset.projectParent || activeId;
			});

			this.querySelectorAll<HTMLAnchorElement>("[data-project-toc] a[href^='#']").forEach(
				(link) => {
					const isCurrent = link.getAttribute("href") === `#${activeParent}`;
					if (isCurrent) link.setAttribute("aria-current", "location");
					else link.removeAttribute("aria-current");
				},
			);
		}
	}

	if (!customElements.get("project-rail-coordinator")) {
		customElements.define("project-rail-coordinator", ProjectRailCoordinator);
	}
</script>

<style is:global>
	project-rail-coordinator {
		display: block;
	}

	@media (min-width: 1024px) {
		[data-project-rails][data-project-enhanced] [data-project-rail-sticky] {
			position: sticky;
			top: 6rem;
		}

		[data-project-rails][data-project-enhanced] .rail__scenes {
			grid-template-areas: "rail-scene";
			gap: 0;
		}

		[data-project-rails][data-project-enhanced] [data-project-rail-scene] {
			grid-area: rail-scene;
			display: block;
			visibility: hidden;
			pointer-events: none;
		}

		[data-project-rails][data-project-enhanced] [data-project-rail-scene][data-active] {
			z-index: 1;
			visibility: visible;
			pointer-events: auto;
			animation: project-rail-enter 180ms ease-out both;
		}
	}

	[data-project-toc] a[aria-current="location"] {
		color: var(--color-foreground);
	}

	[data-project-toc] a[aria-current="location"]::before {
		color: var(--color-primary);
		content: "→ ";
	}

	@keyframes project-rail-enter {
		from {
			opacity: 0;
			transform: translateY(4px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		[data-project-toc] a {
			transition: none;
		}
		[data-project-rails][data-project-enhanced] [data-project-rail-scene][data-active] {
			animation: none;
		}
	}
</style>
