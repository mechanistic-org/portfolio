---
import clientList from "@/config/clients.json";

interface Props {
	activeClient?: string;
}

const { activeClient = "all" } = Astro.props;

// Process clients exactly like Clients.astro to get logos
const processedClients = clientList.map((client, index) => {
	let image: string | null = null;
	let variant = "text";

	if (client.logo) {
		image = client.logo; // Manual local override
		variant = "logo";
	} else if (client.icon) {
		image = `https://cdn.simpleicons.org/${client.icon}`; // Simple Icons
		variant = "logo";
	} else if (client.domain) {
		image = `https://logo.clearbit.com/${client.domain}`; // Clearbit
		variant = "logo";
	}

	return {
		...client,
		id: `client-${index}`,
		image,
		variant,
	};
});

// Sort: Logos first, then text, roughly alphabetical
processedClients.sort((a, b) => {
	if (a.variant === b.variant) return a.name.localeCompare(b.name);
	return a.variant === "logo" ? -1 : 1;
});
---

<div class="xs:grid-cols-3 grid grid-cols-2 gap-2 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6">
	<!-- "All Clients" Button -->
	<button
		class="filter-btn group hover:border-primary/50 hover:bg-primary/5 data-[active=true]:border-primary data-[active=true]:bg-primary/10 relative flex flex-col items-center justify-center gap-2 rounded-lg border border-white/5 bg-neutral-900/50 p-4 transition-all"
		data-group="client"
		data-filter="all"
		data-active={activeClient === "all" ? "true" : "false"}
	>
		<span
			class="i-tdesign-filter group-hover:text-primary text-2xl text-neutral-500 transition-colors"
		></span>
		<span
			class="group-data-[active=true]:text-primary font-mono text-[10px] tracking-wider text-neutral-400 uppercase"
			>All Clients</span
		>
	</button>

	{
		processedClients.map((client) => (
			<button
				class="filter-btn group hover:border-primary/50 hover:bg-primary/5 data-[active=true]:border-primary data-[active=true]:bg-primary/10 relative flex h-24 flex-col items-center justify-center gap-2 rounded-lg border border-white/5 bg-neutral-900/50 p-2 transition-all"
				data-group="client"
				data-filter={client.name}
				data-active={activeClient === client.name ? "true" : "false"}
				title={client.name}
			>
				{client.image ? (
					<div class="active-client-logo relative flex h-8 w-12 items-center justify-center">
						<img
							src={client.image}
							alt={client.name}
							class="client-logo-img max-h-full max-w-full object-contain opacity-60 grayscale transition-all duration-300 group-hover:opacity-100 group-hover:grayscale-0 group-data-[active=true]:opacity-100 group-data-[active=true]:grayscale-0"
							loading="lazy"
						/>
						<span class="client-logo-fallback group-hover:text-primary/50 hidden text-neutral-600 transition-colors">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="24"
								height="24"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<rect width="16" height="20" x="4" y="2" rx="2" ry="2" />
								<path d="M9 22v-4h6v4" />
								<path d="M8 6h.01" />
								<path d="M16 6h.01" />
								<path d="M12 6h.01" />
								<path d="M12 10h.01" />
								<path d="M12 14h.01" />
								<path d="M16 10h.01" />
								<path d="M16 14h.01" />
								<path d="M8 10h.01" />
								<path d="M8 14h.01" />
							</svg>
						</span>
					</div>
				) : (
					<svg
						class="group-hover:text-primary/50 text-neutral-600 transition-colors"
						xmlns="http://www.w3.org/2000/svg"
						width="24"
						height="24"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<rect width="16" height="20" x="4" y="2" rx="2" ry="2" />
						<path d="M9 22v-4h6v4" />
						<path d="M8 6h.01" />
						<path d="M16 6h.01" />
						<path d="M12 6h.01" />
						<path d="M12 10h.01" />
						<path d="M12 14h.01" />
						<path d="M16 10h.01" />
						<path d="M16 14h.01" />
						<path d="M8 10h.01" />
						<path d="M8 14h.01" />
					</svg>
				)}

				<span class="group-data-[active=true]:text-primary max-w-full truncate font-mono text-[9px] tracking-wider text-neutral-500 uppercase group-hover:text-neutral-300">
					{client.name}
				</span>
			</button>
		))
	}
</div>

<script>
	document.addEventListener("astro:page-load", () => {
		const logos = document.querySelectorAll(".active-client-logo");
		logos.forEach((container) => {
			const img = container.querySelector(".client-logo-img") as HTMLImageElement;
			const fallback = container.querySelector(".client-logo-fallback");

			if (img && fallback) {
				img.onerror = () => {
					console.log("Image load failed:", img.src);
					img.style.display = "none";
					fallback.classList.remove("hidden");
					// Force display flex/block to ensure visibility
					(fallback as HTMLElement).style.display = "inline-block";
				};
			}
		});
	});
</script>
