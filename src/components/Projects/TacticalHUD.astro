---
import { Icon } from "astro-icon/components";
import SonicHeartbeat from "@components/Audio/SonicHeartbeat";
import ForensicTooltip from "@components/DLS/ForensicTooltip.astro";

interface Props {
	data: any;
	metrics?: any;
}

const { data, metrics } = Astro.props;

// Mock Drift Calculations (Real version would use date/budget math)
// Left/Right = Schedule Drift (-100 to 100)
// Up/Down = Budget Drift (-100 to 100)
const scheduleDrift = -20; // Slightly Late (Left)
const budgetDrift = 15; // Under Budget (Up)

// Calculation for FPM Position (Box is 200x200 centered)
const fpmX = scheduleDrift * 2; // Scale factor
const fpmY = -budgetDrift * 2; // Invert Y (Up is positive budget health)
---

<div class="pointer-events-none fixed inset-0 z-50 flex flex-col justify-between">
	<!-- TOP ROW: MISSION HEADER -->
	<div
		class="pointer-events-auto flex w-full items-center justify-between border-b border-white/10 bg-black/95 px-6 py-4"
	>
		<!-- Left: Identity -->
		<div class="flex items-center gap-4">
			<a
				href="/demo-hud"
				class="flex h-8 w-8 items-center justify-center rounded border border-emerald-500 bg-emerald-500/20 text-xs font-bold text-emerald-500"
			>
				FPM
			</a>
			<div>
				<div class="text-[10px] tracking-widest text-neutral-500 uppercase">MISSION ID</div>
				<div class="font-mono text-sm font-bold text-white">{data?.title || "MISSION_ALPHA"}</div>
			</div>
		</div>

		<!-- Center: Mode Annunciator -->
		<div class="flex gap-2">
			<div
				class="animate-pulse rounded border border-red-500/50 bg-red-900/50 px-2 py-0.5 font-mono text-[10px] text-red-400"
			>
				TACTICAL
			</div>
			<div
				class="rounded border border-white/10 bg-black px-2 py-0.5 font-mono text-[10px] text-neutral-500"
			>
				UNCAGED
			</div>
		</div>

		<!-- Right: Sonic Heartbeat -->
		<div class="flex items-center gap-4 border-l border-white/10 pl-6">
			<SonicHeartbeat client:load audioUrl={data?.audio_url} />
		</div>
	</div>

	<!-- CENTER: FLIGHT PATH MARKER (THE RETICLE) -->
	<div class="pointer-events-none absolute inset-0 flex items-center justify-center">
		<!-- The HUD "Glass" -->
		<div class="relative h-[400px] w-[600px] opacity-80">
			<!-- Horizon Line (Artificial Horizon) -->
			<div class="absolute top-1/2 left-0 h-px w-full bg-white/20"></div>
			<!-- Pitch Ladder -->
			<div class="absolute top-1/4 left-1/2 h-px w-48 -translate-x-1/2 bg-white/10"></div>
			<div class="absolute bottom-1/4 left-1/2 h-px w-48 -translate-x-1/2 bg-white/10"></div>

			<!-- THE FPM (Flight Path Marker) - Dynamic Position -->
			<div
				class="absolute transition-all duration-1000 ease-out"
				style={`top: calc(50% + ${fpmY}px); left: calc(50% + ${fpmX}px);`}
			>
				<svg
					width="40"
					height="40"
					viewBox="0 0 40 40"
					class="drop-shadow-[0_0_5px_rgba(46,92,255,0.8)]"
				>
					<!-- Circle -->
					<circle cx="20" cy="20" r="6" fill="none" stroke="#2E5CFF" stroke-width="2"></circle>
					<!-- Wings -->
					<line x1="8" y1="20" x2="0" y2="20" stroke="#2E5CFF" stroke-width="2"></line>
					<line x1="32" y1="20" x2="40" y2="20" stroke="#2E5CFF" stroke-width="2"></line>
					<!-- Vertical Top -->
					<line x1="20" y1="14" x2="20" y2="8" stroke="#2E5CFF" stroke-width="2"></line>
				</svg>
				<!-- Drift Labels -->
				<div class="absolute top-0 -right-24 font-mono text-[9px] text-[#2E5CFF]">
					SCHED: {scheduleDrift > 0 ? "+" : ""}{scheduleDrift}%<br />
					BUDGET: {budgetDrift > 0 ? "+" : ""}{budgetDrift}%
				</div>
			</div>

			<!-- Target Box (The Goal) -->
			<div
				class="absolute top-1/2 left-1/2 h-16 w-16 -translate-x-1/2 -translate-y-1/2 rounded-sm border border-dashed border-white/30"
			>
			</div>
		</div>
	</div>

	<!-- BOTTOM ROW: METRICS REPEATER -->
	<div
		class="pointer-events-auto grid w-full grid-cols-4 gap-4 border-t border-white/10 bg-black/80 p-4 backdrop-blur-md"
	>
		<!-- Metric 1 -->
		<div class="border-r border-white/10 px-4">
			<div class="text-[9px] tracking-widest text-neutral-500 uppercase">Team Size</div>
			<div class="font-mono text-xl font-bold text-white">INT 12 / EXT 4</div>
		</div>
		<!-- Metric 2 -->
		<div class="border-r border-white/10 px-4">
			<div class="text-[9px] tracking-widest text-neutral-500 uppercase">Budget Burn</div>
			<div class="font-mono text-xl font-bold text-emerald-400">
				$1.2M <span class="text-xs text-neutral-500">/ $1.4M</span>
			</div>
		</div>
		<!-- Metric 3 -->
		<div class="border-r border-white/10 px-4">
			<div class="text-[9px] tracking-widest text-neutral-500 uppercase">Governance</div>
			<div class="font-mono text-xl font-bold text-amber-400">
				ECO: 3 <span class="text-xs text-neutral-500">/ CRITAL</span>
			</div>
		</div>
		<!-- Metric 4 -->
		<div class="px-4">
			<div class="text-[9px] tracking-widest text-neutral-500 uppercase">Status</div>
			<div class="font-mono text-xl font-bold text-[#2E5CFF]">PRODUCTION</div>
		</div>
	</div>
</div>
