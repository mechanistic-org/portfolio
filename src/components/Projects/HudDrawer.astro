---
import ClientFilterGrid from "./ClientFilterGrid.astro";

interface Props {
	sectors: string[];
	categories: string[];
	tools: string[];
	clients: string[];
}

const { sectors, categories, tools, clients } = Astro.props;
---

<!-- HUD OVERLAY (Fixed) --><!-- Trigger Button is now in index.astro --><!-- THE DRAWER (Fixed Overlay) -->
<div
	id="hud-drawer-fixed"
	class="fixed inset-x-0 top-0 z-200 hidden h-[85vh] transform border-b border-white/10 shadow-2xl transition-transform duration-500 ease-in-out md:h-[60vh]"
	style="transform: translateY(-100%); background-color: #050505; display: none;"
>
	<!-- Drawer Header -->
	<div class="flex items-center justify-between border-b border-white/10 px-4 py-3 md:px-8">
		<div class="flex items-center gap-4">
			<span class="text-xs font-bold tracking-widest text-neutral-500 uppercase"
				>System Filters</span
			>
			<div class="h-4 w-px bg-white/10"></div>
			<button
				id="hud-reset-btn"
				class="text-[10px] tracking-wider text-neutral-600 uppercase transition-colors hover:text-red-400"
			>
				Reset All
			</button>
		</div>

		<button
			id="hud-close-btn"
			class="text-neutral-500 transition-colors hover:text-white"
			aria-label="Close"
		>
			<span class="i-tdesign-close text-xl"></span>
		</button>
	</div>

	<div class="custom-scrollbar h-[calc(100%-3rem)] overflow-y-auto p-4 md:p-8">
		<div class="grid gap-8 md:grid-cols-12">
			<div class="space-y-6 md:col-span-3">
				<div>
					<h3 class="mb-3 text-[10px] font-bold tracking-widest text-neutral-500 uppercase">
						Sector
					</h3>
					<div class="flex flex-wrap gap-2">
						<button
							class="filter-btn hover:border-primary/50 data-[active=true]:bg-primary rounded border border-white/5 bg-neutral-900 px-3 py-1 text-xs text-neutral-400 transition-colors data-[active=true]:text-black"
							data-group="industry"
							data-filter="all"
							data-active="true">ALL</button
						>
						{
							sectors.map((s) => (
								<button
									class="filter-btn hover:border-primary/50 data-[active=true]:bg-primary rounded border border-white/5 bg-neutral-900 px-3 py-1 text-xs text-neutral-400 transition-colors data-[active=true]:text-black"
									data-group="industry"
									data-filter={s}
								>
									{s}
								</button>
							))
						}
					</div>
				</div>

				<div class="h-px w-full bg-white/5"></div>

				<div>
					<h3 class="mb-3 text-[10px] font-bold tracking-widest text-neutral-500 uppercase">
						Phase
					</h3>
					<div class="flex flex-wrap gap-2">
						<button
							class="filter-btn hover:border-primary/50 data-[active=true]:bg-primary rounded border border-white/5 bg-neutral-900 px-3 py-1 text-xs text-neutral-400 transition-colors data-[active=true]:text-black"
							data-group="status"
							data-filter="all"
							data-active="true">ALL</button
						>
						{
							["Production", "Prototype", "Concept"].map((s) => (
								<button
									class="filter-btn hover:border-primary/50 data-[active=true]:bg-primary rounded border border-white/5 bg-neutral-900 px-3 py-1 text-xs text-neutral-400 transition-colors data-[active=true]:text-black"
									data-group="status"
									data-filter={s}
								>
									{s}
								</button>
							))
						}
					</div>
				</div>

				<div class="h-px w-full bg-white/5"></div>

				<div>
					<h3 class="mb-3 text-[10px] font-bold tracking-widest text-neutral-500 uppercase">
						Category
					</h3>
					<div class="flex flex-wrap gap-2">
						<button
							class="filter-btn hover:border-primary/50 data-[active=true]:bg-primary rounded border border-white/5 bg-neutral-900 px-3 py-1 text-xs text-neutral-400 transition-colors data-[active=true]:text-black"
							data-group="category"
							data-filter="all"
							data-active="true">ALL</button
						>
						{
							categories.map((c) => (
								<button
									class="filter-btn hover:border-primary/50 data-[active=true]:bg-primary rounded border border-white/5 bg-neutral-900 px-3 py-1 text-xs text-neutral-400 transition-colors data-[active=true]:text-black"
									data-group="category"
									data-filter={c}
								>
									{c}
								</button>
							))
						}
					</div>
				</div>
			</div>

			<div class="md:col-span-9">
				<h3 class="mb-3 text-[10px] font-bold tracking-widest text-neutral-500 uppercase">
					Client Matrix
				</h3>
				<ClientFilterGrid activeClient="all" />
			</div>
		</div>
	</div>

	<!-- Drawer Footer (Visual Decor) -->
	<div
		class="from-primary/0 via-primary/50 to-primary/0 absolute bottom-0 left-0 h-1 w-full bg-linear-to-r opacity-20"
	>
	</div>
</div>

<!-- Backdrop -->
<div
	id="hud-backdrop"
	class="pointer-events-none fixed inset-0 z-40 bg-black/50 opacity-0 backdrop-blur-sm transition-opacity duration-500"
>
</div>

<script>
	function initHud() {
		const trigger = document.getElementById("hud-trigger");
		if (!trigger || trigger.hasAttribute("data-hud-init")) return;

		console.log("HUD: Initializing...");
		trigger.setAttribute("data-hud-init", "true");

		const drawer = document.getElementById("hud-drawer-fixed");
		const backdrop = document.getElementById("hud-backdrop");
		const closeBtn = document.getElementById("hud-close-btn");
		const resetBtn = document.getElementById("hud-reset-btn");

		// Portal to body to escape stacking contexts (e.g. transforms in parent)
		// Portal to body to escape stacking contexts (e.g. transforms in parent)
		// if (drawer && document.body) {
		// 	document.body.appendChild(drawer);
		// }
		// if (backdrop && document.body) document.body.appendChild(backdrop);

		let isOpen = false;

		// Logic for Robustness
		function toggleHud(state?: boolean) {
			isOpen = state !== undefined ? state : !isOpen;

			if (isOpen) {
				// Slide Down
				if (drawer) {
					drawer.classList.remove("hidden"); // Show it
					drawer.style.display = ""; // Remove inline display:none
					// Force reflow
					void drawer.offsetHeight;
					drawer.style.transform = "translateY(0%)";
				}

				// Show Backdrop
				if (backdrop) {
					backdrop.classList.remove("pointer-events-none");
					backdrop.style.opacity = "1";
				}

				document.body.style.overflow = "hidden";
			} else {
				// Slide Up
				if (drawer) {
					drawer.style.transform = "translateY(-100%)";
					// Wait for transition to finish then hide?
					// Actually, better to keep it block but translated up to avoid flicker on close?
					// BUT user is experiencing "Ghost Drawer".
					// Let's hide it after transition.
					setTimeout(() => {
						if (!isOpen && drawer) drawer.classList.add("hidden");
					}, 500); // 500ms matches duration-500
				}

				// Hide Backdrop
				if (backdrop) {
					backdrop.classList.add("pointer-events-none");
					backdrop.style.opacity = "0";
				}

				document.body.style.overflow = "";
			}
		}

		if (trigger) {
			trigger.addEventListener("click", () => {
				toggleHud(true);
			});
		}
		if (closeBtn) closeBtn.addEventListener("click", () => toggleHud(false));
		if (backdrop) backdrop.addEventListener("click", () => toggleHud(false));

		const handleKeydown = (e: KeyboardEvent) => {
			if (e.key === "Escape" && isOpen) toggleHud(false);
		};
		document.addEventListener("keydown", handleKeydown);

		// Reset logic
		if (resetBtn) {
			resetBtn.addEventListener("click", () => {
				const event = new CustomEvent("reset-filters");
				window.dispatchEvent(event);
			});
		}
	}

	// Run on initial load
	initHud();

	// Run on View Transitions navigation
	document.addEventListener("astro:page-load", initHud);
</script>

<style>
	.custom-scrollbar::-webkit-scrollbar {
		width: 4px;
	}
	.custom-scrollbar::-webkit-scrollbar-track {
		background: rgba(255, 255, 255, 0.05);
	}
	.custom-scrollbar::-webkit-scrollbar-thumb {
		background: rgba(255, 255, 255, 0.1);
		border-radius: 2px;
	}
	.custom-scrollbar::-webkit-scrollbar-thumb:hover {
		background: rgba(var(--color-primary), 0.5);
	}
</style>
