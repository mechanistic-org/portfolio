---
import { getMultiverseData } from "@/utils/getMultiverseData";
import { Icon } from "astro-icon/components";
import SonicHeartbeat from "@components/Audio/SonicHeartbeat";

const multiverseData = await getMultiverseData();

interface Props {
	data: any;
	nextProject?: any;
	prevProject?: any;
	metrics?: any;
	presentation_mode?: string;
}

const { data, nextProject, prevProject, metrics, presentation_mode = "standard" } = Astro.props;

// Formatting
const dateVal = data.date || new Date();
const isoDate = new Date(dateVal).toISOString().split("T")[0];

const title = data.title || data.id || "Project";
const showMetrics =
	(presentation_mode === "deep_dive" || presentation_mode === "flagship") && metrics;
---

<div class="w-full border-b border-white/10 bg-black/95 transition-all duration-500">
	<!-- EN LOGO (Absolute Top Left) -->
	<a
		href="/"
		class="group absolute top-0 left-0 z-50 flex h-16 w-16 items-center justify-center border-r border-white/10 bg-black transition-colors hover:bg-white/5"
	>
		<img
			src="/assets/branding/EN_logo_white_1200.svg"
			alt="EN Logo"
			class="h-8 w-8 opacity-90 transition-all group-hover:scale-110 group-hover:opacity-100"
		/>
	</a>

	<!-- ROW 1: IDENTITY & NAV (Full Width, padded left for logo) -->
	<div class="flex h-16 w-full items-center justify-between pr-4 pl-16 md:pr-8">
		<!-- LEFT: Title & Context -->
		<div class="flex max-w-[60%] items-center gap-6 overflow-hidden pl-4 md:pl-6">
			<div>
				<span
					class="block truncate text-[10px] tracking-widest text-neutral-500 uppercase md:text-xs"
					>{data.id || data.slug}</span
				>
				<div class="flex items-center gap-2 text-[10px] tracking-wider uppercase md:gap-3">
					<span class="truncate font-bold text-white">{data.employer}</span>
					<span class="hidden text-neutral-500 md:inline">//</span>
					<span class="hidden text-neutral-400 md:inline">{data.category || "Project"}</span>
				</div>
			</div>
		</div>

		<!-- CENTER: Nav Controls (Visible on Mobile via Flex) -->
		<div class="flex shrink-0 items-center gap-1">
			{
				prevProject ? (
					<a
						href={`/projects/${prevProject.id}`}
						class="flex h-8 w-8 items-center justify-center border border-white/10 bg-white/5 text-neutral-400 hover:bg-[#2E5CFF] hover:text-white md:h-6 md:w-8"
					>
						&lt;
					</a>
				) : (
					<span class="flex h-8 w-8 cursor-not-allowed items-center justify-center border border-white/5 bg-black text-neutral-800 md:h-6 md:w-8">
						&lt;
					</span>
				)
			}
			<a
				href="/projects"
				class="flex h-8 w-8 items-center justify-center border border-white/10 bg-white/5 text-neutral-400 hover:bg-emerald-500 hover:text-white md:h-6 md:w-8"
				><Icon name="tabler:grid-dots" class="h-4 w-4" /></a
			>
			{
				nextProject ? (
					<a
						href={`/projects/${nextProject.id}`}
						class="flex h-8 w-8 items-center justify-center border border-white/10 bg-white/5 text-neutral-400 hover:bg-[#2E5CFF] hover:text-white md:h-6 md:w-8"
					>
						&gt;
					</a>
				) : (
					<span class="flex h-8 w-8 cursor-not-allowed items-center justify-center border border-white/5 bg-black text-neutral-800 md:h-6 md:w-8">
						&gt;
					</span>
				)
			}
		</div>

		<!-- RIGHT: Date & Duration (Desktop Only) -->
		<div class="hidden items-center gap-8 md:flex">
			<div class="font-mono text-xs">
				<span class="mr-2 text-neutral-600 uppercase">DATE</span>
				<span class="font-bold text-white">{isoDate}</span>
			</div>
			{
				data.duration && (
					<div class="rounded border border-emerald-500/30 bg-emerald-500/5 px-3 py-1">
						<div class="mb-0.5 text-[8px] leading-none font-bold tracking-wider text-emerald-500 uppercase">
							Duration
						</div>
						<div class="font-mono text-sm leading-none font-bold text-white">{data.duration}</div>
					</div>
				)
			}
			<a
				href={`/raw/${data.id || "v4-test"}`}
				class="flex h-6 items-center justify-center rounded border border-[#2E5CFF]/30 bg-[#2E5CFF]/10 px-2 font-mono text-[10px] font-bold text-[#2E5CFF] transition-colors hover:bg-[#2E5CFF] hover:text-white"
			>
				RAW_SOURCE
			</a>
			{/* SONIC HEARTBEAT (Singularity Audit) */}
			<div class="ml-4 border-l border-white/10 pl-4">
				<SonicHeartbeat client:load audioUrl={data.audio_url} />
			</div>
		</div>
	</div>

	<!-- ROW 2: METRICS (Deep Mode Only) -->
	{
		showMetrics && (
			<div class="hidden w-full grid-cols-6 divide-x divide-white/10 border-t border-white/10 bg-black/50 md:grid">
				{/* 0. TEAM SIZE (New First Column) */}
				<div class="flex flex-col justify-center px-4 py-2">
					<div class="text-[9px] tracking-widest text-neutral-500 uppercase">Team</div>
					<div class="font-mono text-xs font-bold text-white">{data.teamSize || "Core Team"}</div>
				</div>

				{/* 1. COGS */}
				{metrics.cogs ? (
					<div class="flex flex-col justify-center px-4 py-2">
						<div class="text-[9px] tracking-widest text-neutral-500 uppercase">
							{metrics.cogs.label}
						</div>
						<div class="font-mono text-sm font-bold text-white">{metrics.cogs.value}</div>
					</div>
				) : (
					<div class="flex flex-col justify-center px-4 py-2 opacity-30">
						<div class="text-[9px] tracking-widest text-neutral-500 uppercase">COGS</div>
						<div class="font-mono text-sm font-bold text-white">N/A</div>
					</div>
				)}

				{/* 2. PROFITABILITY */}
				{metrics.profitability ? (
					<div class="flex flex-col justify-center px-4 py-2">
						<div class="text-[9px] tracking-widest text-neutral-500 uppercase">
							{metrics.profitability.label}
						</div>
						<div class="font-mono text-sm font-bold text-[#2E5CFF]">
							{metrics.profitability.value}
						</div>
					</div>
				) : (
					<div class="flex flex-col justify-center px-4 py-2 opacity-30">
						<div class="text-[9px] tracking-widest text-neutral-500 uppercase">Margin</div>
						<div class="font-mono text-sm font-bold text-white">N/A</div>
					</div>
				)}

				{/* 3. GOVERNANCE */}
				{metrics.governance ? (
					<div class="flex flex-col justify-center px-4 py-2">
						<div class="text-[9px] tracking-widest text-neutral-500 uppercase">Governance</div>
						<div class="flex items-center gap-2 font-mono text-xs text-neutral-300">
							<span class="text-white">{metrics.governance.dcos} DCOs</span>
							<span class="text-neutral-600">|</span>
							<span class="truncate">{metrics.governance.ecos[0]}</span>
						</div>
					</div>
				) : (
					<div class="flex flex-col justify-center px-4 py-2 opacity-30">
						<div class="text-[9px] tracking-widest text-neutral-500 uppercase">Governance</div>
						<div class="font-mono text-sm font-bold text-white">N/A</div>
					</div>
				)}

				{/* 4. INTERVENTIONS */}
				{metrics.interventions ? (
					<div class="flex flex-col justify-center px-4 py-2">
						<div class="text-[9px] tracking-widest text-neutral-500 uppercase">
							{metrics.interventions.label}
						</div>
						<div class="flex items-center gap-2">
							<div class="font-mono text-sm font-bold text-white">
								{metrics.interventions.count}
							</div>
							<div class="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-500" />
						</div>
					</div>
				) : (
					<div class="flex flex-col justify-center px-4 py-2 opacity-30">
						<div class="text-[9px] tracking-widest text-neutral-500 uppercase">Interventions</div>
						<div class="font-mono text-sm font-bold text-white">N/A</div>
					</div>
				)}

				{/* 5. FINANCIAL */}
				{metrics.financial && metrics.financial.toolingBudget ? (
					<div class="flex flex-col justify-center px-4 py-2">
						<div class="text-[9px] tracking-widest text-neutral-500 uppercase">Tooling Budget</div>
						<div class="font-mono text-sm font-bold text-white">
							${metrics.financial.toolingActual.toLocaleString()}
							<span class="ml-1 text-[10px] text-neutral-500">
								/ ${metrics.financial.toolingBudget.toLocaleString()}
							</span>
						</div>
					</div>
				) : (
					<div class="flex flex-col justify-center px-4 py-2 opacity-30">
						<div class="text-[9px] tracking-widest text-neutral-500 uppercase">Tooling Budget</div>
						<div class="font-mono text-sm font-bold text-white">N/A</div>
					</div>
				)}
			</div>
		)
	}
</div>
