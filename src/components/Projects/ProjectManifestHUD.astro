---
import { getEntry } from "astro:content";

interface Props {
	data: any;
	nextProject?: any;
	prevProject?: any;
	// NEW: Metrics passed from layout
	metrics?: {
		cogs?: { value: string; label: string };
		profitability?: { value: string; label: string };
		governance?: { ecos: string[]; dcos: number };
		interventions?: { count: number; label: string };
		financial?: { toolingBudget?: number; toolingActual?: number };
	};
}

const { data, nextProject, prevProject, metrics } = Astro.props;

// Format dates
const dateVal = data.date || new Date();
const startDate = new Date(dateVal);
// Format: 2006-08-01 (approximate match to screenshot preference)
const isoDate = startDate.toISOString().split("T")[0];

// Parse Team Size string "Core Team of INT 37 / EXT 21" -> int: 37, ext: 21
const teamSizeStr = data.teamSize || "";
let intCount = 0;
let extCount = 0;

// Try regex parse
const intMatch = teamSizeStr.match(/INT\s*(\d+)/i);
const extMatch = teamSizeStr.match(/EXT\s*(\d+)/i);

if (intMatch) intCount = parseInt(intMatch[1], 10);
if (extMatch) extCount = parseInt(extMatch[1], 10);

// Fallback logic if parsing fails but we have hardcoded data for specific known projects
if (data.slug === "c24" && intCount === 0) {
	intCount = 37;
	extCount = 21;
}
if (data.slug === "d-command" && intCount === 0) {
	intCount = 12;
	extCount = 4;
}

// Cap dots for visual sanity (max ~20 dots per row before wrapping or scaling)
const displayInt = Math.min(intCount, 40);
const displayExt = Math.min(extCount, 25);
---

<div
	class="fixed top-0 left-0 z-[9999] w-full border-b border-white/10 bg-black/95 backdrop-blur-md transition-all duration-500"
>
	<!-- EN LOGO (Absolute Top Left) -->
	<a
		href="/"
		class="group absolute top-0 left-0 z-50 flex h-16 w-16 items-center justify-center border-r border-white/10 bg-black transition-colors hover:bg-white/5"
	>
		<img
			src="/assets/branding/EN_logo_white_1200.svg"
			alt="EN Logo"
			class="h-8 w-8 opacity-90 transition-all group-hover:scale-110 group-hover:opacity-100"
		/>
	</a>

	<!-- ROW 1: IDENTITY & NAV (Full Width, padded left for logo) -->
	<div class="flex h-16 w-full items-center justify-between pr-4 pl-16 md:pr-8">
		<!-- LEFT: Title & Context -->
		<div class="flex items-center gap-6 pl-6">
			<div>
				<span class="text-xs tracking-widest text-neutral-500 uppercase">{data.slug}</span>
				<div class="flex items-center gap-3 text-[10px] tracking-wider uppercase">
					<span class="font-bold text-white">{data.employer}</span>
					<span class="text-neutral-500">//</span>
					<span class="text-neutral-400">{data.category || "Project"}</span>
				</div>
			</div>
		</div>

		<!-- CENTER: Nav Controls -->
		<div class="flex items-center gap-1">
			{
				prevProject ? (
					<a
						href={`/projects/${prevProject.id}`}
						class="flex h-6 w-8 items-center justify-center border border-white/10 bg-white/5 text-neutral-400 hover:bg-[#2E5CFF] hover:text-white"
					>
						&lt;
					</a>
				) : (
					<span class="flex h-6 w-8 cursor-not-allowed items-center justify-center border border-white/5 bg-black text-neutral-800">
						&lt;
					</span>
				)
			}
			<a
				href="/projects"
				class="flex h-6 w-8 items-center justify-center border border-white/10 bg-white/5 text-neutral-400 hover:bg-emerald-500 hover:text-white"
				>:::</a
			>
			{
				nextProject ? (
					<a
						href={`/projects/${nextProject.id}`}
						class="flex h-6 w-8 items-center justify-center border border-white/10 bg-white/5 text-neutral-400 hover:bg-[#2E5CFF] hover:text-white"
					>
						&gt;
					</a>
				) : (
					<span class="flex h-6 w-8 cursor-not-allowed items-center justify-center border border-white/5 bg-black text-neutral-800">
						&gt;
					</span>
				)
			}
		</div>

		<!-- RIGHT: Date & Duration -->
		<div class="hidden items-center gap-8 md:flex">
			<div class="font-mono text-xs">
				<span class="mr-2 text-neutral-600 uppercase">DATE</span>
				<span class="font-bold text-white">{isoDate}</span>
			</div>
			<div class="rounded border border-emerald-500/30 bg-emerald-500/5 px-3 py-1">
				<div
					class="mb-0.5 text-[8px] leading-none font-bold tracking-wider text-emerald-500 uppercase"
				>
					Duration
				</div>
				<div class="font-mono text-sm leading-none font-bold text-white">{data.duration}</div>
			</div>
			<a
				href={`/raw/${data.id || "v4-test"}`}
				class="flex h-6 items-center justify-center rounded border border-[#2E5CFF]/30 bg-[#2E5CFF]/10 px-2 font-mono text-[10px] font-bold text-[#2E5CFF] transition-colors hover:bg-[#2E5CFF] hover:text-white"
			>
				RAW_SOURCE
			</a>
		</div>
	</div>

	<!-- ROW 2: DEEP INTELLIGENCE (Condensed 5-Column Grid) -->
	{
		metrics && (
			<div class="grid w-full grid-cols-1 divide-y divide-white/10 border-t border-b border-white/10 bg-neutral-900/50 pl-16 text-white md:grid-cols-5 md:divide-x md:divide-y-0">
				{/* COL 1: ORBIT DATA (Herding Cats Viz) */}
				<div class="group relative bg-black p-3">
					<div class="absolute top-2 right-2 h-1 w-1 rounded-full bg-white/20" />
					<div class="mb-1 text-[9px] font-bold tracking-wider text-neutral-500 uppercase">
						Orbit
					</div>
					<div class="flex items-end justify-between">
						<div class="flex flex-col">
							<div class="font-mono text-[10px] leading-tight text-neutral-400">
								{intCount > 0 ? "Team Composition" : "Orbit"}
							</div>
							{/* Visual "Cat Herding" Dots - Dynamic */}
							<div class="mt-1.5 flex h-2 w-full max-w-[120px] flex-wrap content-start gap-0.5">
								{Array.from({ length: displayInt }).map((_, i) => (
									<div
										class={`h-1.5 w-0.5 rounded-sm ${i < 6 ? "bg-white" : "bg-neutral-700"}`}
										title={i < 6 ? "Core Team" : "Internal Resource"}
									/>
								))}
								{displayExt > 0 && <div class="w-1" />}
								{Array.from({ length: displayExt }).map((_, i) => (
									<div
										class="h-1.5 w-0.5 rounded-sm bg-orange-500"
										title="Vendor / External Partner"
									/>
								))}
							</div>
						</div>
						<div class="flex items-end gap-3 font-mono text-sm font-bold">
							{intCount > 0 && (
								<div class="text-right">
									<span class="mb-0.5 block text-[8px] leading-none text-neutral-600">INT</span>
									<span class="leading-none text-white">{intCount}</span>
								</div>
							)}
							{extCount > 0 && (
								<div class="text-right">
									<span class="mb-0.5 block text-[8px] leading-none text-orange-500/70">EXT</span>
									<span class="leading-none text-orange-500">{extCount}</span>
								</div>
							)}
						</div>
					</div>
				</div>

				{/* COL 3: COGS / PROFITABILITY */}
				<div class="grid grid-cols-2 gap-4 bg-white/5 p-3">
					<div>
						<div class="mb-0.5 text-[9px] font-bold tracking-wider text-neutral-500 uppercase">
							{metrics.cogs?.label || "COGS"}
						</div>
						<div class="font-mono text-sm font-bold text-white">{metrics.cogs?.value}</div>
						{/* Only show Tooling Budget if legit (not D-Command Yield mode) */}
						{metrics.financial?.toolingBudget !== undefined &&
							metrics.financial.toolingBudget > 0 && (
								<div class="mt-1 font-mono text-[9px] text-neutral-500">
									$ {Math.round(metrics.financial.toolingBudget / 1000)} k Tooling
								</div>
							)}
					</div>
					<div class="border-l border-white/10 pl-4">
						<div class="mb-0.5 text-[9px] font-bold tracking-wider text-neutral-500 uppercase">
							{metrics.profitability?.label || "Margin"}
						</div>
						<div class="font-mono text-sm font-bold text-emerald-400">
							{metrics.profitability?.value}
						</div>
						<div class="mt-1 font-mono text-[9px] text-emerald-900">89% IRR</div>
					</div>
				</div>

				{/* COL 4: GOVERNANCE (Merged) */}
				<div class="bg-white/[0.02] p-3">
					<div class="mb-1 text-[9px] font-bold tracking-wider text-neutral-500 uppercase">
						Governance
					</div>
					<div class="mb-2 flex flex-wrap gap-1">
						{metrics.governance?.ecos?.map((eco: any) => (
							<span class="rounded border border-white/10 bg-white/5 px-1 font-mono text-[9px] text-neutral-300">
								{eco}
							</span>
						))}
					</div>
					<div class="flex items-center justify-between">
						<span class="text-[8px] text-neutral-600">{metrics.governance?.ecos?.length} ECOs</span>
						<span class="rounded border border-red-500/30 bg-red-500/5 px-1 font-mono text-[9px] text-red-500">
							{metrics.governance?.dcos} DCOs
						</span>
					</div>
				</div>

				{/* COL 5: INTERVENTIONS (Merged) */}
				<div class="flex flex-col justify-center border-l border-white/10 bg-black/40 p-3">
					<div class="mb-1 flex items-center gap-2">
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="h-4 w-4 text-orange-500"
							viewBox="0 0 24 24"
							fill="currentColor"
						>
							<path d="M13 2L3 14H12L11 22L21 10H12L13 2Z" />
						</svg>
						<span class="text-[9px] font-bold tracking-wider text-orange-500 uppercase">
							Interventions
						</span>
					</div>
					<div class="flex items-baseline gap-2">
						<span class="font-mono text-xl leading-none font-bold text-white">
							{metrics.interventions?.count}
						</span>
						<span class="text-[9px] leading-none text-neutral-400">
							{metrics.interventions?.label || "Confirmed Saves"}
						</span>
					</div>
				</div>

				{/* COL 5: PRIMARY TOOLS (Moved to Far Right) */}
				<div class="border-l-2 border-yellow-500 bg-black/80 p-3">
					<div class="mb-1 text-[9px] font-bold tracking-wider text-yellow-500 uppercase">
						Primary Tools
					</div>
					<div class="flex flex-wrap content-start gap-1">
						{data.tools?.map((tool: string) => (
							<div class="inline-block rounded border border-white/20 bg-white/10 px-1.5 py-0.5 font-mono text-[9px] leading-none whitespace-nowrap text-neutral-300">
								{tool}
							</div>
						))}
					</div>
				</div>
			</div>
		)
	}
</div>
