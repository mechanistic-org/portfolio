---
import { getMultiverseData } from "@/utils/getMultiverseData";

const multiverseData = await getMultiverseData();

interface Props {
	data: any;
	nextProject?: any;
	prevProject?: any;
	metrics?: any;
}

const { data, nextProject, prevProject, metrics } = Astro.props;

// Formatting
const dateVal = data.date || new Date();
const isoDate = new Date(dateVal).toISOString().split("T")[0];

const title = data.title || data.id || "Project";
---

<div class="w-full border-b border-white/10 bg-black/95 transition-all duration-500">
	<!-- EN LOGO (Absolute Top Left) -->
	<a
		href="/"
		class="group absolute top-0 left-0 z-50 flex h-16 w-16 items-center justify-center border-r border-white/10 bg-black transition-colors hover:bg-white/5"
	>
		<img
			src="/assets/branding/EN_logo_white_1200.svg"
			alt="EN Logo"
			class="h-8 w-8 opacity-90 transition-all group-hover:scale-110 group-hover:opacity-100"
		/>
	</a>

	<!-- ROW 1: IDENTITY & NAV (Full Width, padded left for logo) -->
	<div class="flex h-16 w-full items-center justify-between pr-4 pl-16 md:pr-8">
		<!-- LEFT: Title & Context -->
		<div class="flex items-center gap-6 pl-6">
			<div>
				<span class="text-xs tracking-widest text-neutral-500 uppercase"
					>{data.id || data.slug}</span
				>
				<div class="flex items-center gap-3 text-[10px] tracking-wider uppercase">
					<span class="font-bold text-white">{data.employer}</span>
					<span class="text-neutral-500">//</span>
					<span class="text-neutral-400">{data.category || "Project"}</span>
				</div>
			</div>
		</div>

		<!-- CENTER: Nav Controls -->
		<div class="flex items-center gap-1">
			{
				prevProject ? (
					<a
						href={`/projects/${prevProject.id}`}
						class="flex h-6 w-8 items-center justify-center border border-white/10 bg-white/5 text-neutral-400 hover:bg-[#2E5CFF] hover:text-white"
					>
						&lt;
					</a>
				) : (
					<span class="flex h-6 w-8 cursor-not-allowed items-center justify-center border border-white/5 bg-black text-neutral-800">
						&lt;
					</span>
				)
			}
			<a
				href="/projects"
				class="flex h-6 w-8 items-center justify-center border border-white/10 bg-white/5 text-neutral-400 hover:bg-emerald-500 hover:text-white"
				>:::</a
			>
			{
				nextProject ? (
					<a
						href={`/projects/${nextProject.id}`}
						class="flex h-6 w-8 items-center justify-center border border-white/10 bg-white/5 text-neutral-400 hover:bg-[#2E5CFF] hover:text-white"
					>
						&gt;
					</a>
				) : (
					<span class="flex h-6 w-8 cursor-not-allowed items-center justify-center border border-white/5 bg-black text-neutral-800">
						&gt;
					</span>
				)
			}
		</div>

		<!-- RIGHT: Date & Duration -->
		<div class="hidden items-center gap-8 md:flex">
			<div class="font-mono text-xs">
				<span class="mr-2 text-neutral-600 uppercase">DATE</span>
				<span class="font-bold text-white">{isoDate}</span>
			</div>
			{
				data.duration && (
					<div class="rounded border border-emerald-500/30 bg-emerald-500/5 px-3 py-1">
						<div class="mb-0.5 text-[8px] leading-none font-bold tracking-wider text-emerald-500 uppercase">
							Duration
						</div>
						<div class="font-mono text-sm leading-none font-bold text-white">{data.duration}</div>
					</div>
				)
			}
			<a
				href={`/raw/${data.id || "v4-test"}`}
				class="flex h-6 items-center justify-center rounded border border-[#2E5CFF]/30 bg-[#2E5CFF]/10 px-2 font-mono text-[10px] font-bold text-[#2E5CFF] transition-colors hover:bg-[#2E5CFF] hover:text-white"
			>
				RAW_SOURCE
			</a>
		</div>
	</div>

	<!-- ROW 2: DISABLED -->
	<!-- Metrics Grid was causing Astro Compiler Crash. Disabled for stability. -->
</div>
