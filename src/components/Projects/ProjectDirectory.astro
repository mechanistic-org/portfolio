---
import { type CollectionEntry } from "astro:content";

interface Props {
	projects: CollectionEntry<"projects">[];
	sectors: string[];
	categories: string[];
	tools: string[];
	clients: string[];
}

const { projects, sectors, categories, tools, clients } = Astro.props;
---

<div class="relative w-full">
	<!-- Hover Preview Window -->
	<div
		id="project-preview"
		class="pointer-events-none fixed top-0 left-0 z-50 hidden h-64 w-80 overflow-hidden rounded-lg border border-neutral-700 bg-neutral-900 opacity-0 shadow-2xl transition-opacity duration-300 md:block"
	>
		<img
			id="preview-image"
			src=""
			alt="Project Preview"
			class="h-full w-full object-cover opacity-60"
		/>
		<div class="absolute inset-0 flex flex-col justify-between p-4">
			<div class="flex items-start justify-between">
				<span
					id="preview-title"
					class="font-mono text-sm font-bold tracking-widest text-white uppercase drop-shadow-md"
				>
					Preview
				</span>
				<span
					id="preview-team-size"
					class="rounded-full bg-black/50 px-2 py-1 font-mono text-xs text-white backdrop-blur-sm"
				>
				</span>
			</div>

			<!-- Centered Description -->
			<div class="absolute inset-0 flex items-center justify-center px-6 text-center">
				<p id="preview-description" class="font-mono text-sm font-medium text-white drop-shadow-lg">
				</p>
			</div>
		</div>
	</div>

	<div class="scrollbar-hide w-full overflow-x-auto lg:overflow-visible">
		<table class="w-full min-w-[800px] border-collapse text-left font-mono text-sm">
			<thead>
				<tr class="border-b border-neutral-800 text-neutral-500">
					<th class="px-4 py-3 font-medium tracking-wider uppercase"> System </th>
					<th
						class="sort-header cursor-pointer px-4 py-3 font-medium tracking-wider uppercase transition-colors select-none hover:text-white"
						data-col="project"
					>
						<div class="flex items-center gap-2">
							Project <span class="sort-icon text-xs">↕</span>
						</div>
					</th>
					<th
						class="sort-header cursor-pointer px-4 py-3 font-medium tracking-wider uppercase transition-colors select-none hover:text-white"
						data-col="client"
					>
						<div class="flex items-center gap-2">
							Client <span class="sort-icon text-xs">↕</span>
						</div>
					</th>
					<th
						class="sort-header cursor-pointer px-4 py-3 font-medium tracking-wider uppercase transition-colors select-none hover:text-white"
						data-col="sector"
					>
						<div class="flex items-center gap-2">
							Collection <span class="sort-icon text-xs">↕</span>
						</div>
					</th>
					<th
						class="sort-header cursor-pointer px-4 py-3 font-medium tracking-wider uppercase transition-colors select-none hover:text-white"
						data-col="year"
					>
						<div class="flex items-center gap-2">
							Year <span class="sort-icon text-xs">↕</span>
						</div>
					</th>
					<th
						class="sort-header cursor-pointer px-4 py-3 font-medium tracking-wider uppercase transition-colors select-none hover:text-white"
						data-col="status"
					>
						<div class="flex items-center gap-2">
							Status <span class="sort-icon text-xs">↕</span>
						</div>
					</th>
				</tr>
			</thead>
			<tbody id="projects-table-body">
				{
					projects.map((project) => (
						<tr
							class="project-row project-item group hover:bg-primary/5 cursor-pointer border-b border-l-2 border-neutral-800/50 border-transparent transition-colors"
							data-industry={project.data.industry}
							data-tool={JSON.stringify(project.data.tools)}
							data-tool-icons={JSON.stringify((project.data as any).toolIcons || [])}
							data-team-size={(project.data as any).teamSize}
							data-part-graph={project.data.partGraph}
							data-status={project.data.production}
							data-date={new Date(project.data.date as any).getTime()}
							data-client={JSON.stringify([
								...new Set(
									[
										...(project.data.client || []),
										...(project.data.employer ? [project.data.employer] : []),
									].filter(Boolean),
								),
							])}
							data-image={project.data.heroImage}
							data-title={project.data.title}
							data-description={project.data.description}
							onclick={`window.location.href='/projects/${project.id}/'`}
						>
							<td class="px-4 py-3">
								<div class="h-8 w-12 overflow-hidden rounded bg-neutral-800">
									{project.data.heroImage && (
										<img
											src={project.data.heroImage}
											alt={project.data.title}
											class="h-full w-full object-cover opacity-80 transition-opacity group-hover:opacity-100"
											loading="lazy"
										/>
									)}
								</div>
							</td>
							<td class="text-foreground group-hover:text-primary px-4 py-3 font-bold transition-colors">
								{project.data.title}
							</td>
							<td class="px-4 py-3 text-neutral-400">
								{[
									...new Set(
										[
											...(project.data.client || []),
											...(project.data.employer ? [project.data.employer] : []),
										].filter(Boolean),
									),
								].join(", ")}
							</td>
							<td class="px-4 py-3 text-neutral-400">{project.data.industry}</td>
							<td class="px-4 py-3 text-neutral-500">
								{new Date(project.data.date as any).getFullYear()}
							</td>
							<td class="px-4 py-3">
								<span
									class:list={[
										"inline-flex items-center rounded-full border px-2 py-0.5 text-xs font-medium",
										project.data.production === "Mass Production"
											? "border-primary-500/20 bg-primary-500/10 text-primary-500"
											: project.data.production === "Prototyping"
												? "border-amber-500/20 bg-amber-500/10 text-amber-500"
												: "border-neutral-700 bg-neutral-800 text-neutral-400",
									]}
								>
									{project.data.production}
								</span>
							</td>
						</tr>
					))
				}
			</tbody>

			<script>
				const rows = document.querySelectorAll(".project-row");
				const preview = document.getElementById("project-preview");
				const previewImg = document.getElementById("preview-image") as HTMLImageElement;
				const previewTitle = document.getElementById("preview-title");
				const previewDescription = document.getElementById("preview-description");
				const previewTeamSize = document.getElementById("preview-team-size");
				const previewIcons = document.getElementById("preview-icons");
				const previewGraph = document.getElementById("preview-graph") as HTMLImageElement;

				if (preview && previewImg && previewTitle) {
					rows.forEach((row) => {
						row.addEventListener("mouseenter", () => {
							row.classList.add("spotlight-active");
							const img = row.getAttribute("data-image");
							const title = row.getAttribute("data-title");
							const description = row.getAttribute("data-description");
							const teamSize = row.getAttribute("data-team-size");
							const toolIcons = JSON.parse(row.getAttribute("data-tool-icons") || "[]");
							const partGraph = row.getAttribute("data-part-graph");

							if (img) {
								previewImg.src = img;
								if (title) previewTitle.innerText = title;
								// Always reset so a project without a description never
								// shows the previous row's text in the preview window
								if (previewDescription) previewDescription.innerText = description || "";

								// Team Size
								if (previewTeamSize) {
									if (teamSize && teamSize !== "Unknown") {
										previewTeamSize.innerText = `👥 ${teamSize}`;
										previewTeamSize.style.display = "block";
									} else {
										previewTeamSize.style.display = "none";
									}
								}

								// Icons
								if (previewIcons) {
									previewIcons.innerHTML = toolIcons
										.slice(0, 5) // Limit to 5
										.map(
											(icon: string) =>
												`<img src="https://cdn.simpleicons.org/${icon}/white" class="w-5 h-5 opacity-80" onerror="this.style.display='none'" />`,
										)
										.join("");
								}

								// Graph
								if (previewGraph) {
									if (partGraph) {
										previewGraph.src = partGraph;
										previewGraph.style.display = "block";
									} else {
										previewGraph.style.display = "none";
									}
								}

								preview.classList.remove("opacity-0");
								preview.classList.add("opacity-100");
							}
						});

						row.addEventListener("mousemove", (e) => {
							const event = e as MouseEvent;
							const rect = (row as HTMLElement).getBoundingClientRect();
							const x = event.clientX - rect.left;
							const y = event.clientY - rect.top;

							// Update CSS variables for the spotlight
							(row as HTMLElement).style.setProperty("--x", `${x}px`);
							(row as HTMLElement).style.setProperty("--y", `${y}px`);

							// Position preview relative to viewport
							const clientX = event.clientX;
							const clientY = event.clientY;

							// Offset to avoid cursor
							preview.style.left = `${clientX + 20}px`;
							preview.style.top = `${clientY + 20}px`;
						});

						row.addEventListener("mouseleave", () => {
							row.classList.remove("spotlight-active");
							preview.classList.remove("opacity-100");
							preview.classList.add("opacity-0");
							// Reset spotlight
							(row as HTMLElement).style.removeProperty("--x");
							(row as HTMLElement).style.removeProperty("--y");
						});
					});

					// Safety cleanup: Remove spotlight from all rows when mouse leaves the table body
					const tableBody = document.getElementById("projects-table-body");
					if (tableBody) {
						tableBody.addEventListener("mouseleave", () => {
							rows.forEach((row) => {
								row.classList.remove("spotlight-active");
								(row as HTMLElement).style.removeProperty("--x");
								(row as HTMLElement).style.removeProperty("--y");
							});
						});
					}
				}
			</script>

			<style>
				@property --spotlight-opacity {
					syntax: "<number>";
					inherits: false;
					initial-value: 0;
				}

				.project-row {
					position: relative;
					/* Fallback for no JS */
					--x: 50%;
					--y: 50%;
					--spotlight-opacity: 0;

					background-image: radial-gradient(
						600px circle at var(--x) var(--y),
						rgba(46, 92, 255, var(--spotlight-opacity)),
						transparent 40%
					);
					transition: --spotlight-opacity 0.3s;
				}

				/* Restore the green highlight borders and background */
				.project-row.spotlight-active {
					border-left-color: rgb(var(--color-primary));
					border-bottom-color: rgb(var(--color-primary));
					background-color: rgba(var(--color-primary), 0.1);
					--spotlight-opacity: 0.15;
				}

				/* Ensure content stays on top */
				.project-row td {
					position: relative;
					z-index: 1;
				}
			</style>
		</table>
	</div>
</div>
