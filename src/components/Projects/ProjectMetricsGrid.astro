---
import TeamPipChart from "@components/DataViz/TeamPipChart";
import ComplexityViz from "@components/DataViz/ComplexityViz.astro";

interface Props {
	data: any;
	metrics: any;
}

const { data, metrics } = Astro.props;
---

<div class="grid w-full grid-cols-1 gap-4 sm:grid-cols-2">
	{/* 0. TEAM SIZE (Pip Chart or Text) */}
	<div class="col-span-1 flex flex-col justify-center rounded-lg border border-white/10 bg-white/5 p-4">
		{(() => {
			// Parse "INT 37 / EXT 21" logic
			const teamStr = data.teamSize || "";
			const intMatch = teamStr.match(/INT\s*(\d+)/i);
			const extMatch = teamStr.match(/EXT\s*(\d+)/i);
			const coreMatch = teamStr.match(/Core\s*(\d+)/i);

			let intCount = intMatch ? parseInt(intMatch[1]) : 0;
			let extCount = extMatch ? parseInt(extMatch[1]) : 0;
			let coreCount = coreMatch ? parseInt(coreMatch[1]) : 0;

			// Auto-Calculate from Cast if missing specific string format
			if (intCount === 0 && extCount === 0 && data.cast && data.cast.length > 0) {
				intCount = data.cast.length;
			}

			if (intCount > 0 || extCount > 0) {
				return (
					<TeamPipChart client:load internal={intCount} external={extCount} core={coreCount} />
				);
			} else {
				// Fallback
				return (
					<div class="flex h-full flex-col justify-center">
						<div class="text-[9px] tracking-widest text-neutral-500 uppercase">Team</div>
						<div class="font-mono text-xs font-bold text-white">
							{data.teamSize || "Core Team"}
						</div>
					</div>
				);
			}
		})()}
	</div>

	{/* 0.5 COMPLEXITY VECTOR (New V2.1) */}
	{data.complexity_vector && (
		<div class="col-span-1 flex flex-col justify-center rounded-lg border border-white/10 bg-white/5 p-4">
			<ComplexityViz data={data.complexity_vector} />
		</div>
	)}

	{/* 1. BOM / COGS */}
	{metrics.cogs ? (
		<div class="col-span-1 flex flex-col justify-center rounded-lg border border-white/10 bg-white/5 p-4">
			<div class="flex w-full items-center justify-between">
				{/* Left: BOM */}
				<div class="flex flex-col">
					<div class="text-[9px] tracking-widest text-neutral-500 uppercase">BOM</div>
					<div class="font-mono text-sm font-bold text-white">{metrics.cogs.value}</div>
				</div>
				{/* Right: COGS */}
				<div class="flex flex-col items-end opacity-50">
					<div class="text-[9px] tracking-widest text-neutral-600 uppercase">COGS</div>
					<div class="font-mono text-[10px] font-bold text-neutral-400">
						{metrics.financial?.costOfGoodsSold?.length > 0
							? metrics.financial.costOfGoodsSold[0]
							: "--"}
					</div>
				</div>
			</div>
		</div>
	) : (
		<div class="col-span-1 flex flex-col justify-center rounded-lg border border-white/10 bg-white/5 p-4 opacity-30">
			<div class="text-[9px] tracking-widest text-neutral-500 uppercase">BOM</div>
			<div class="font-mono text-sm font-bold text-white">N/A</div>
		</div>
	)}

	{/* 2. MARGIN */}
	{metrics.profitability ? (
		<div class="col-span-1 flex flex-col justify-center rounded-lg border border-white/10 bg-white/5 p-4">
			<div class="text-[9px] tracking-widest text-neutral-500 uppercase">
				{metrics.profitability.label}
			</div>
			<div class="font-mono text-sm font-bold text-[#2E5CFF]">{metrics.profitability.value}</div>
		</div>
	) : (
		<div class="col-span-1 flex flex-col justify-center rounded-lg border border-white/10 bg-white/5 p-4 opacity-30">
			<div class="text-[9px] tracking-widest text-neutral-500 uppercase">Margin</div>
			<div class="font-mono text-sm font-bold text-white">N/A</div>
		</div>
	)}

	{/* 3. GOVERNANCE (ECO / DCD) */}
	{metrics.governance ? (
		<div class="col-span-1 flex flex-col justify-center rounded-lg border border-white/10 bg-white/5 p-4">
			<div class="flex items-center justify-between gap-4">
				{/* Left: ECOs */}
				<div class="flex flex-col">
					<div class="text-[9px] tracking-widest text-neutral-500 uppercase">ECOs</div>
					<div class="font-mono text-xs text-white">
						{metrics.governance.ecos && metrics.governance.ecos.length > 0 ? (
							<span
								class="cursor-help border-b border-dashed border-white/20 hover:border-white/50"
								title={metrics.governance.ecos.join("\n")}
							>
								{metrics.governance.ecos.length}
							</span>
						) : (
							<span class="opacity-50">--</span>
						)}
					</div>
				</div>
				{/* Right: DCDs */}
				<div class="flex flex-col items-end">
					<div class="text-[9px] tracking-widest text-neutral-500 uppercase">DCDs</div>
					<div class="font-mono text-xs font-bold text-white">{metrics.governance.dcos}</div>
				</div>
			</div>
		</div>
	) : (
		<div class="col-span-1 flex flex-col justify-center rounded-lg border border-white/10 bg-white/5 p-4 opacity-30">
			<div class="text-[9px] tracking-widest text-neutral-500 uppercase">Governance</div>
			<div class="font-mono text-sm font-bold text-white">N/A</div>
		</div>
	)}

	{/* 4. INTERVENTIONS */}
	{metrics.interventions ? (
		<div class="col-span-1 flex flex-col justify-center rounded-lg border border-white/10 bg-white/5 p-4">
			<div class="text-[9px] tracking-widest text-neutral-500 uppercase">
				{metrics.interventions.label}
			</div>
			<div class="flex items-center gap-2">
				<div class="font-mono text-sm font-bold text-white">{metrics.interventions.count}</div>
				<div class="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-500" />
			</div>
		</div>
	) : (
		<div class="col-span-1 flex flex-col justify-center rounded-lg border border-white/10 bg-white/5 p-4 opacity-30">
			<div class="text-[9px] tracking-widest text-neutral-500 uppercase">Interventions</div>
			<div class="font-mono text-sm font-bold text-white">N/A</div>
		</div>
	)}

	{/* 5. FINANCIAL */}
	{metrics.financial && metrics.financial.toolingBudget ? (
		<div class="col-span-1 flex flex-col justify-center rounded-lg border border-white/10 bg-white/5 p-4 sm:col-span-2">
			<div class="text-[9px] tracking-widest text-neutral-500 uppercase">Tooling Budget</div>
			<div class="font-mono text-sm font-bold text-white">
				${metrics.financial.toolingActual.toLocaleString()}
				<span class="ml-1 text-[10px] text-neutral-500">
					/ ${metrics.financial.toolingBudget.toLocaleString()}
				</span>
			</div>
		</div>
	) : (
		<div class="col-span-1 flex flex-col justify-center rounded-lg border border-white/10 bg-white/5 p-4 sm:col-span-2 opacity-30">
			<div class="text-[9px] tracking-widest text-neutral-500 uppercase">Tooling Budget</div>
			<div class="font-mono text-sm font-bold text-white">N/A</div>
		</div>
	)}
</div>
