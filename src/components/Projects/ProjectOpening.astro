---
interface Props {
	title: string;
	subtitle?: string;
	meta?: string[];
	withMedia?: boolean;
}
const { title, subtitle, withMedia = false } = Astro.props;
---

<header class:list={["article-masthead", { "project-opening-with-media": withMedia }]}>
	<div class="opening-heading">
		<h1>{title}</h1>
		{subtitle && <p class="masthead-subtitle">{subtitle}</p>}
	</div>
	<slot name="product" />
	<slot name="context" />
	<slot name="media" />
</header>
