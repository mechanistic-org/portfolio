---
interface Props {
	sectors: string[];
	categories: string[];
	tools: string[];
	clients: string[];
}

const { sectors, categories, tools, clients } = Astro.props;
---

<div
	id="filter-toolbar"
	class="sticky top-[72px] z-40 border-b border-neutral-800 bg-neutral-900/80 backdrop-blur-md"
>
	<div class="site-container flex items-center gap-6 py-2">
		<!-- Label -->
		<span class="shrink-0 font-mono text-xs font-bold tracking-widest text-neutral-500 uppercase">
			View:
		</span>

		<!-- Dropdown Group: Sector -->
		<div class="group dropdown-container relative">
			<button
				class="dropdown-trigger flex items-center gap-2 rounded px-3 py-1.5 font-mono text-xs text-neutral-300 transition-colors hover:bg-neutral-800 hover:text-white"
			>
				Collection <span class="text-[10px] opacity-50">▼</span>
			</button>
			<div
				class="dropdown-menu absolute top-full left-0 z-50 mt-1 hidden max-h-[60vh] w-64 overflow-y-auto rounded-lg border border-neutral-800 bg-neutral-900 p-2 shadow-xl"
			>
				<button
					class="filter-btn data-[active=true]:text-primary data-[active=true]:bg-primary/10 w-full rounded px-3 py-2 text-left font-mono text-xs text-neutral-400 transition-colors hover:bg-neutral-800 hover:text-white"
					data-filter="all"
					data-group="industry"
				>
					<button
						class="dropdown-trigger flex items-center gap-2 rounded px-3 py-1.5 font-mono text-xs text-neutral-300 transition-colors hover:bg-neutral-800 hover:text-white"
					>
						Category <span class="text-[10px] opacity-50">▼</span>
					</button>
					<div
						class="dropdown-menu absolute top-full left-0 z-50 mt-1 hidden max-h-[60vh] w-64 overflow-y-auto rounded-lg border border-neutral-800 bg-neutral-900 p-2 shadow-xl"
					>
						<button
							class="filter-btn data-[active=true]:text-primary data-[active=true]:bg-primary/10 w-full rounded px-3 py-2 text-left font-mono text-xs text-neutral-400 transition-colors hover:bg-neutral-800 hover:text-white"
							data-filter="all"
							data-group="category"
						>
							[ All Categories ]
						</button>
						{
							categories.map((cat) => (
								<button
									class="filter-btn data-[active=true]:text-primary data-[active=true]:bg-primary/10 w-full rounded px-3 py-2 text-left font-mono text-xs text-neutral-400 transition-colors hover:bg-neutral-800 hover:text-white"
									data-filter={cat}
									data-group="category"
								>
									{cat}
								</button>
							))
						}
					</div>
				</button>

				<!-- Dropdown Group: Client -->
				<div class="group dropdown-container relative">
					<button
						class="dropdown-trigger flex items-center gap-2 rounded px-3 py-1.5 font-mono text-xs text-neutral-300 transition-colors hover:bg-neutral-800 hover:text-white"
					>
						Client <span class="text-[10px] opacity-50">▼</span>
					</button>
					<div
						class="dropdown-menu absolute top-full left-0 z-50 mt-1 hidden max-h-[60vh] w-64 overflow-y-auto rounded-lg border border-neutral-800 bg-neutral-900 p-2 shadow-xl"
					>
						<button
							class="filter-btn data-[active=true]:text-primary data-[active=true]:bg-primary/10 w-full rounded px-3 py-2 text-left font-mono text-xs text-neutral-400 transition-colors hover:bg-neutral-800 hover:text-white"
							data-filter="all"
							data-group="client"
						>
							[ All Clients ]
						</button>
						{
							clients.map((client) => (
								<button
									class="filter-btn data-[active=true]:text-primary data-[active=true]:bg-primary/10 w-full rounded px-3 py-2 text-left font-mono text-xs text-neutral-400 transition-colors hover:bg-neutral-800 hover:text-white"
									data-filter={client}
									data-group="client"
								>
									{client}
								</button>
							))
						}
					</div>
				</div>

				<!-- Dropdown Group: Toolchain -->
				<div class="group dropdown-container relative">
					<button
						class="dropdown-trigger flex items-center gap-2 rounded px-3 py-1.5 font-mono text-xs text-neutral-300 transition-colors hover:bg-neutral-800 hover:text-white"
					>
						Toolchain <span class="text-[10px] opacity-50">▼</span>
					</button>
					<div
						class="dropdown-menu absolute top-full left-0 z-50 mt-1 hidden max-h-[60vh] w-64 overflow-y-auto rounded-lg border border-neutral-800 bg-neutral-900 p-2 shadow-xl"
					>
						<button
							class="filter-btn data-[active=true]:text-primary data-[active=true]:bg-primary/10 w-full rounded px-3 py-2 text-left font-mono text-xs text-neutral-400 transition-colors hover:bg-neutral-800 hover:text-white"
							data-filter="all"
							data-group="tool"
						>
							[ All Tools ]
						</button>
						{
							tools.map((tool) => (
								<button
									class="filter-btn data-[active=true]:text-primary data-[active=true]:bg-primary/10 w-full rounded px-3 py-2 text-left font-mono text-xs text-neutral-400 transition-colors hover:bg-neutral-800 hover:text-white"
									data-filter={tool}
									data-group="tool"
								>
									{tool}
								</button>
							))
						}
					</div>
				</div>

				<!-- Dropdown Group: Status -->
				<div class="group dropdown-container relative">
					<button
						class="dropdown-trigger flex items-center gap-2 rounded px-3 py-1.5 font-mono text-xs text-neutral-300 transition-colors hover:bg-neutral-800 hover:text-white"
					>
						Status <span class="text-[10px] opacity-50">▼</span>
					</button>
					<div
						class="dropdown-menu absolute top-full left-0 z-50 mt-1 hidden w-48 rounded-lg border border-neutral-800 bg-neutral-900 p-2 shadow-xl"
					>
						<button
							class="filter-btn data-[active=true]:text-primary data-[active=true]:bg-primary/10 w-full rounded px-3 py-2 text-left font-mono text-xs text-neutral-400 transition-colors hover:bg-neutral-800 hover:text-white"
							data-filter="all"
							data-group="status"
						>
							[ All Status ]
						</button>
						{
							["Production", "Prototype", "Concept"].map((status) => (
								<button
									class="filter-btn data-[active=true]:text-primary data-[active=true]:bg-primary/10 w-full rounded px-3 py-2 text-left font-mono text-xs text-neutral-400 transition-colors hover:bg-neutral-800 hover:text-white"
									data-filter={status}
									data-group="status"
								>
									{status}
								</button>
							))
						}
					</div>
				</div>

				<!-- Separator -->
				<div class="mx-2 h-4 w-px bg-neutral-800"></div>

				<!-- Active Filters Display -->
				<div
					id="active-filters-display"
					class="no-scrollbar flex items-center gap-2 overflow-x-auto"
				>
					<span class="font-mono text-xs text-neutral-600">All Projects</span>
				</div>
			</div>
		</div>

		<script>
			// Dropdown Logic
			const triggers = document.querySelectorAll(".dropdown-trigger");

			// Close all menus
			function closeAll() {
				document.querySelectorAll(".dropdown-menu").forEach((menu) => {
					menu.classList.add("hidden");
				});
			}

			triggers.forEach((trigger) => {
				trigger.addEventListener("click", (e) => {
					e.stopPropagation();
					const menu = trigger.nextElementSibling;
					const isOpen = !menu?.classList.contains("hidden");

					closeAll();

					if (!isOpen && menu) {
						menu.classList.remove("hidden");
					}
				});
			});

			// Close on click outside
			document.addEventListener("click", () => {
				closeAll();
			});

			// Prevent closing when clicking inside menu
			document.querySelectorAll(".dropdown-menu").forEach((menu) => {
				menu.addEventListener("click", (e) => {
					e.stopPropagation();
				});
			});
		</script>

		<style>
			.mask-linear-fade {
				mask-image: linear-gradient(to right, black 90%, transparent 100%);
				-webkit-mask-image: linear-gradient(to right, black 90%, transparent 100%);
			}
		</style>
	</div>
</div>
