---
import { type CollectionEntry } from "astro:content";

interface Props {
	projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;
---

<div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
	{
		projects.map((project) => (
			<div
				class="project-item group hover:border-primary/50 relative flex flex-col overflow-hidden rounded-xl border border-neutral-800 bg-neutral-900/50 transition-all hover:bg-neutral-900"
				data-industry={project.data.industry}
				data-tool={JSON.stringify(project.data.tools)}
				data-tool-icons={JSON.stringify((project.data as any).toolIcons || [])}
				data-team-size={(project.data as any).teamSize}
				data-part-graph={project.data.partGraph}
				data-status={project.data.production}
				data-date={new Date(project.data.date as any).getTime()}
				data-client={JSON.stringify([
					...new Set(
						[
							...(project.data.client || []),
							...(project.data.employer ? [project.data.employer] : []),
						].filter(Boolean),
					),
				])}
				data-image={project.data.heroImage}
				data-title={project.data.title}
				data-description={project.data.description}
				data-category={project.data.category}
				onclick={`window.location.href='/projects/${project.id}/'`}
			>
				{/* Image Section */}
				<div class="aspect-video w-full overflow-hidden bg-neutral-950">
					{project.data.heroImage ? (
						<img
							src={project.data.heroImage}
							alt={project.data.title}
							class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
							loading="lazy"
						/>
					) : (
						<div class="flex h-full w-full items-center justify-center px-4 text-center">
							<span class="font-mono text-xs tracking-widest text-neutral-600 uppercase">
								{project.data.title}
							</span>
						</div>
					)}
					{/* Status Chip Overlay */}
					<div class="absolute top-2 right-2">
						<span
							class:list={[
								"inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-medium backdrop-blur-md",
								project.data.production === "Mass Production"
									? "border-primary-500/20 bg-primary-500/10 text-primary-500"
									: project.data.production === "Prototyping"
										? "border-amber-500/20 bg-amber-500/10 text-amber-500"
										: "border-neutral-700 bg-black/50 text-neutral-400",
							]}
						>
							{project.data.production}
						</span>
					</div>
				</div>

				{/* Content Section */}
				<div class="flex flex-1 flex-col justify-between p-4">
					<div>
						<div class="mb-1 flex items-center justify-between">
							<span class="font-mono text-xs text-neutral-500">
								{new Date(project.data.date as any).getFullYear()}
							</span>
							<span class="text-primary/50 group-hover:text-primary font-mono text-xs transition-colors">
								{project.data.industry}
							</span>
						</div>
						<h3 class="group-hover:text-primary text-lg font-bold text-white transition-colors">
							{project.data.title}
						</h3>
						<p class="mt-2 line-clamp-2 text-sm text-neutral-400">{project.data.description}</p>
					</div>

					<div class="mt-4 border-t border-neutral-800 pt-3">
						<div class="flex flex-wrap gap-2 text-xs text-neutral-500">
							{[
								...new Set(
									[
										...(project.data.client || []),
										...(project.data.employer ? [project.data.employer] : []),
									].filter(Boolean),
								),
							]
								.slice(0, 2)
								.map((c) => (
									<span>{c}</span>
								))}
						</div>
					</div>
				</div>
			</div>
		))
	}
</div>

<style>
	/* Spotlight effect can be added here if desired, basically reused from Directory */
	.project-item {
		/* Basic cursor */
		cursor: pointer;
	}
</style>
