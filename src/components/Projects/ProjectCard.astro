---
import { Image } from "astro:assets";

const { project } = Astro.props;
const { data, id } = project;

// Safety checks
const tags = Array.isArray(data.tags) ? data.tags : [];
const href = `/projects/${id}/`;
---

<a
  href={href}
  class="group flex flex-col gap-4 rounded-lg border border-neutral-800 bg-neutral-900 p-4 transition-all hover:bg-neutral-800 hover:border-neutral-700 hover:shadow-xl h-full"
>
  <div class="aspect-video w-full overflow-hidden rounded-md bg-neutral-800 relative">
    {typeof data.heroImage === "string" ? (
      <img
        src={data.heroImage}
        alt={data.title}
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
      />
    ) : (
      <div class="flex h-full w-full items-center justify-center text-neutral-500 bg-neutral-800">
        <span class="text-xs">No Image</span>
      </div>
    )}
  </div>

  <div class="flex flex-col gap-2 justify-between flex-grow">
    <div>
        <h3 class="text-lg font-bold text-white group-hover:text-primary transition-colors">
        {data.title || "Untitled Project"}
        </h3>
        <p class="text-xs text-neutral-500 font-mono mt-1">
            {data.employer} • {new Date(data.date).getFullYear()}
        </p>
    </div>
    
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2 text-xs text-neutral-400 mt-2">
        {tags.slice(0, 3).map(tag => (
            <span class="bg-neutral-800 px-2 py-1 rounded">{tag}</span>
        ))}
        {tags.length > 3 && <span class="px-1 py-1">+{tags.length - 3}</span>}
      </div>
    )}
  </div>
</a>