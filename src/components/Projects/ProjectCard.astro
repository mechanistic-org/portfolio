import { Image } from "astro:assets";
import { getAssetUrl } from "@/utils/assets";

const { project } = Astro.props;
const { data, id } = project;

// Safety checks
const tags = Array.isArray(data.tags) ? data.tags : [];
const href = `/projects/${id}/`;
const heroImage = typeof data.heroImage === "string" ? getAssetUrl(data.heroImage) : null;
---

<a
	href={href}
	class="group border-border bg-card hover:border-primary/50 flex h-full flex-col gap-4 rounded-lg border p-4 transition-all hover:shadow-xl"
>
	<div class="bg-muted relative aspect-video w-full overflow-hidden rounded-md">
		{
			heroImage ? (
				<img
					src={heroImage}
					alt={data.title}
					class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
					loading="lazy"
				/>
			) : (
				<div class="text-muted-foreground bg-muted flex h-full w-full items-center justify-center">
					<span class="text-xs">No Image</span>
				</div>
			)
		}
	</div>

	<div class="flex flex-grow flex-col justify-between gap-2">
		<div>
			<h3 class="text-foreground group-hover:text-primary text-lg font-bold transition-colors">
				{data.title || "Untitled Project"}
			</h3>
			<p class="text-muted-foreground mt-1 font-mono text-xs">
				{data.employer} • {new Date(data.date).getFullYear()}
			</p>
		</div>

		{
			tags.length > 0 && (
				<div class="text-muted-foreground mt-2 flex flex-wrap gap-2 text-xs">
					{tags.slice(0, 3).map((tag) => (
						<span class="bg-muted rounded px-2 py-1">{tag}</span>
					))}
					{tags.length > 3 && <span class="px-1 py-1">+{tags.length - 3}</span>}
				</div>
			)
		}
	</div>
</a>
