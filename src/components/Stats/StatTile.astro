---
interface Props {
	label: string;
	value: string;
	unit?: string;
	sub?: string;
}

const { label, value, unit, sub } = Astro.props;
---

<div
	class="group hover:border-primary/50 flex flex-col justify-between rounded-sm border border-neutral-800 bg-neutral-950/50 p-4 transition-colors"
>
	<div class="mb-2 font-mono text-[10px] tracking-widest text-neutral-500 uppercase">
		{label}
	</div>
	<div class="flex items-baseline gap-2">
		<span class="group-hover:text-primary font-mono text-2xl font-bold text-white transition-colors"
			>{value}</span
		>
		{unit && <span class="font-mono text-[10px] text-neutral-600 uppercase">{unit}</span>}
	</div>
	{sub && <div class="mt-1 font-mono text-[10px] leading-relaxed text-neutral-600">{sub}</div>}
</div>
