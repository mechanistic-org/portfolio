---
interface Row {
	label: string;
	value: number;
	display?: string;
	color?: string;
}

interface Props {
	title?: string;
	rows: Row[];
	unit?: string;
}

const { title, rows, unit } = Astro.props;
const max = Math.max(...rows.map((r) => r.value), 1);
const fmt = (n: number) => n.toLocaleString("en-US");
---

<figure class="not-content my-8 rounded-sm border border-neutral-800 bg-neutral-950/50 p-5">
	{
		title && (
			<figcaption class="mb-4 border-b border-neutral-800 pb-2 font-mono text-xs font-bold tracking-widest text-neutral-500 uppercase">
				<span class="text-primary mr-2">///</span>
				{title}
			</figcaption>
		)
	}
	<div class="space-y-3">
		{
			rows.map((r) => (
				<div title={`${r.label}: ${r.display ?? fmt(r.value)}${unit ? ` ${unit}` : ""}`}>
					<div class="mb-1 flex justify-between gap-4 font-mono text-[11px] text-neutral-400">
						<span class="truncate uppercase">{r.label}</span>
						<span class="shrink-0 text-neutral-300">{r.display ?? fmt(r.value)}</span>
					</div>
					<div class="h-2 w-full bg-neutral-900">
						<div
							class="h-full rounded-r-[4px]"
							style={`width: ${(r.value / max) * 100}%; background-color: ${r.color ?? "var(--primary)"};`}
						/>
					</div>
				</div>
			))
		}
	</div>
	{unit && <div class="mt-3 text-right font-mono text-[10px] text-neutral-600 uppercase">{unit}</div>}
</figure>
