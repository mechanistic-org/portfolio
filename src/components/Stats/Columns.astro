---
interface Point {
	label: string;
	values: number[];
}

interface Props {
	title?: string;
	series: string[];
	colors?: string[];
	points: Point[];
	unit?: string;
	compact?: boolean;
}

const {
	title,
	series,
	colors = ["var(--primary)", "#0d9488"],
	points,
	unit,
	compact = false,
} = Astro.props;

const H = 140;
const max = Math.max(...points.flatMap((p) => p.values), 1);
const fmt = (n: number) =>
	compact && n >= 1_000_000
		? `${(n / 1_000_000).toFixed(1)}M`
		: compact && n >= 1_000
			? `${Math.round(n / 1_000)}k`
			: n.toLocaleString("en-US");

// Selective direct label: only the peak column carries its value.
const peakIndex = points.reduce(
	(best, p, i) => (Math.max(...p.values) > Math.max(...points[best].values) ? i : best),
	0
);
---

<figure class="not-content my-8 rounded-sm border border-neutral-800 bg-neutral-950/50 p-5">
	<figcaption
		class="mb-4 flex items-center justify-between gap-4 border-b border-neutral-800 pb-2 font-mono text-xs font-bold tracking-widest text-neutral-500 uppercase"
	>
		<span>
			{title && <span class="text-primary mr-2">///</span>}
			{title}
		</span>
		{
			series.length > 1 && (
				<span class="flex shrink-0 gap-3 font-normal normal-case">
					{series.map((s, i) => (
						<span class="flex items-center gap-1.5 text-[10px] text-neutral-400">
							<span class="h-2 w-2 rounded-full" style={`background-color: ${colors[i]};`} />
							{s}
						</span>
					))}
				</span>
			)
		}
	</figcaption>
	<div class="flex items-end gap-1.5 md:gap-2" style={`height: ${H + 18}px;`}>
		{
			points.map((p, i) => (
				<div
					class="flex h-full flex-1 flex-col justify-end"
					title={`${p.label}: ${series.map((s, si) => `${s} ${fmt(p.values[si] ?? 0)}`).join(" / ")}${unit ? ` ${unit}` : ""}`}
				>
					{i === peakIndex && (
						<div class="mb-1 text-center font-mono text-[10px] text-neutral-300">
							{fmt(Math.max(...p.values))}
						</div>
					)}
					<div class="flex items-end justify-center gap-[2px]">
						{p.values.map((v, si) => (
							<div
								class="w-full max-w-[26px] rounded-t-[4px]"
								style={`height: ${v > 0 ? Math.max((v / max) * H, 2) : 0}px; background-color: ${colors[si]};`}
							/>
						))}
					</div>
				</div>
			))
		}
	</div>
	<div class="mt-2 flex gap-1.5 border-t border-neutral-800 pt-2 md:gap-2">
		{
			points.map((p) => (
				<div class="flex-1 text-center font-mono text-[10px] tracking-wider text-neutral-500 uppercase">
					{p.label}
				</div>
			))
		}
	</div>
	{unit && <div class="mt-2 text-right font-mono text-[10px] text-neutral-600 uppercase">{unit}</div>}
</figure>
