---
interface Metric {
	label: string;
	v3: string | number;
	v4: string | number;
	unit?: string;
	trend?: "down" | "up" | "neutral";
}

const metrics: Metric[] = [
	{
		label: "Total Switches",
		v3: 466,
		v4: 436,
		unit: "PCS",
		trend: "down",
	},
	{
		label: "Total LEDs",
		v3: 1720,
		v4: 1692,
		unit: "PCS",
		trend: "down",
	},
	{
		label: "Chassis Width",
		v3: 43.375,
		v4: 43.0,
		unit: "IN",
		trend: "down",
	},
	{
		label: "LCD Display",
		v3: "4x1",
		v4: "6x2",
		unit: "LINE",
		trend: "up",
	},
];
---

<div class="my-12 w-full max-w-4xl space-y-6">
	<div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
		{
			metrics.map((m) => (
				<div class="group relative overflow-hidden rounded-xl border border-white/5 bg-neutral-900/40 p-5 transition-all hover:border-blue-500/30 hover:bg-neutral-900/60">
					{/* Header */}
					<div class="mb-4 flex items-center justify-between border-b border-white/5 pb-2">
						<span class="font-mono text-[10px] tracking-widest text-neutral-500 uppercase">
							{m.label}
						</span>
						<span class="font-mono text-[10px] tracking-tighter text-neutral-600">
							METRIC_TRANSITION
						</span>
					</div>

					{/* Comparison */}
					<div class="flex items-end gap-3">
						<div class="flex flex-col">
							<span class="font-mono text-[10px] text-neutral-500">CONTROL|24</span>
							<span class="text-lg font-light text-neutral-400">
								{m.v3}
								{m.unit && <span class="ml-1 text-[10px] opacity-40">{m.unit}</span>}
							</span>
						</div>

						<div class="mb-1 flex h-6 w-6 items-center justify-center text-neutral-700">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="16"
								height="16"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="rotate-[-135deg]"
							>
								<path d="M7 7h10v10" />
								<path d="M7 17 17 7" />
							</svg>
						</div>

						<div class="flex flex-col">
							<span class="font-mono text-[10px] text-blue-400/80 italic">CURTIS (C|24)</span>
							<span class="text-2xl font-semibold tracking-tight text-white">
								{m.v4}
								{m.unit && <span class="ml-1 text-[10px] opacity-40">{m.unit}</span>}
							</span>
						</div>
					</div>

					{/* Glow Effect */}
					<div class="absolute -right-4 -bottom-4 h-12 w-12 rounded-full bg-blue-500/5 blur-2xl transition-all group-hover:bg-blue-500/10" />
				</div>
			))
		}
	</div>

	<p class="font-mono text-[10px] leading-relaxed text-neutral-500 italic">
		> INTEGRATION DENSITY: The Curtis (C|24) represents a ~6% reduction in component footprint while
		increasing functional display surface area by 300%. This was achieved through "The 7mm
		Mandate"—a design law enforced to preserve parity with legacy D-Sub routing while compressing
		the chassis.
	</p>
</div>
