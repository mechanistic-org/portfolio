---
import ModelViewer from "./ModelViewer.astro";
---

<div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
	<!-- The Vector Truth (Logic) -->
	<div class="flex flex-col gap-4">
		<div class="flex items-center justify-between border-b border-neutral-800 pb-2">
			<h3 class="font-mono text-xs text-neutral-500 uppercase">Logic layer (SVG)</h3>
			<span class="font-mono text-[10px] text-neutral-600">G2 CONTINUITY</span>
		</div>
		<div
			class="relative flex aspect-square items-center justify-center rounded-lg border border-neutral-800 bg-neutral-950 p-8"
		>
			<img
				src="/assets/vectors/EN_logic_map.svg"
				alt="EN Logic Map"
				class="h-full w-full opacity-80"
			/>
			<!-- Overlay Guidelines -->
			<div
				class="pointer-events-none absolute inset-0 bg-[url('/assets/ui/grid-pattern.svg')] opacity-10"
			>
			</div>
		</div>
		<p class="font-mono text-xs text-neutral-400">
			> The "Wire" variant defines the tangency constraints. It is not a sketch; it is a resolved
			equation.
		</p>
	</div>

	<!-- The Material Truth (Carbon) -->
	<div class="flex flex-col gap-4">
		<div class="flex items-center justify-between border-b border-neutral-800 pb-2">
			<h3 class="font-mono text-xs text-neutral-500 uppercase">Physical Layer (GLB)</h3>
			<span class="text-primary animate-pulse font-mono text-[10px]">ANISOTROPY: ACTIVE</span>
		</div>
		<div
			class="relative aspect-square overflow-hidden rounded-lg border border-neutral-800 bg-neutral-900"
		>
			<ModelViewer
				src="/assets/models/EN_Logo_ForgedCarbon.glb"
				alt="Forged Carbon"
				poster="/assets/history/EN_15_3.png"
				autoRotate={true}
				cameraOrbit="45deg 55deg 105%"
			/>
			<div class="absolute top-4 right-4 z-10">
				<span class="bg-primary flex h-2 w-2 rounded-full shadow-[0_0_8px_rgba(46,92,255,0.8)]"
				></span>
			</div>
		</div>
		<p class="font-mono text-xs text-neutral-400">
			> Forged Carbon flake map responds to light angle. Interaction required to verify surface
			integrity.
		</p>
	</div>
</div>
