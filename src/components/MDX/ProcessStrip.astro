---
interface Step {
	image: string;
	label: string;
	description?: string;
}

interface Props {
	steps: Step[];
}

const { steps } = Astro.props;
---

<div class="my-16">
	<div class="mb-6 flex items-center gap-4">
		<h3 class="font-header text-xl font-bold tracking-tight text-white uppercase">
			Process Sequence
		</h3>
		<div class="h-px flex-1 bg-neutral-800"></div>
		<span class="font-mono text-xs text-neutral-500">SCROLL &rarr;</span>
	</div>

	<div
		class="scrollbar-hide -mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-8 md:mx-0 md:px-0"
	>
		{
			steps.map((step, index) => (
				<div class="group w-64 flex-none snap-center overflow-hidden rounded-lg border border-neutral-800 bg-neutral-900 md:w-72">
					<div class="relative aspect-video overflow-hidden">
						<img
							src={step.image}
							alt={step.label}
							class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
						/>
						<div class="absolute top-2 left-2 rounded-full border border-neutral-800 bg-black/80 px-2 py-0.5 font-mono text-[10px] text-white backdrop-blur-sm">
							{String(index + 1).padStart(2, "0")}
						</div>
					</div>
					<div class="p-4">
						<h4 class="mb-1 text-sm font-bold text-white">{step.label}</h4>
						{step.description && (
							<p class="line-clamp-2 text-xs text-neutral-500">{step.description}</p>
						)}
					</div>
				</div>
			))
		}
	</div>
</div>

<style>
	/* Hide scrollbar for Chrome, Safari and Opera */
	.scrollbar-hide::-webkit-scrollbar {
		display: none;
	}
	/* Hide scrollbar for IE, Edge and Firefox */
	.scrollbar-hide {
		-ms-overflow-style: none; /* IE and Edge */
		scrollbar-width: none; /* Firefox */
	}
</style>
