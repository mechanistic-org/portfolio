---
interface Item {
	image: string;
	title: string;
	text: string;
}

interface Props {
	items: Item[];
}

const { items } = Astro.props;
---

<div class="my-16 space-y-24">
	{
		items.map((item, index) => (
			<div class="grid grid-cols-1 items-center gap-8 md:grid-cols-2 md:gap-16">
				{/* Image Column */}
				<div
					class={` ${index % 2 === 1 ? "md:order-2" : "md:order-1"} group relative overflow-hidden rounded-xl border border-neutral-800 bg-neutral-900`}
				>
					<img
						src={item.image}
						alt={item.title}
						class="h-64 w-full object-cover transition-transform duration-700 group-hover:scale-105 md:h-80"
					/>
					<div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100" />
				</div>

				{/* Text Column */}
				<div class={` ${index % 2 === 1 ? "md:order-1" : "md:order-2"} space-y-4`}>
					<div class="flex items-center gap-3">
						<span class="text-primary font-mono text-xs tracking-widest uppercase">
							Step {String(index + 1).padStart(2, "0")}
						</span>
						<div class="h-px flex-1 bg-neutral-800" />
					</div>
					<h3 class="font-header text-2xl font-bold text-white">{item.title}</h3>
					<p class="max-w-md leading-relaxed text-neutral-400">{item.text}</p>
				</div>
			</div>
		))
	}
</div>
