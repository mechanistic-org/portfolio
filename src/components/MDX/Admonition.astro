---
interface Props {
	variant?: "info" | "tip" | "caution" | "danger";
}

const { variant = "info" } = Astro.props;

const variants = {
	info: {
		borderColor: "border-blue-500",
		bgColor: "bg-blue-500/5",
		icon: "ℹ️",
		title: "INFO",
		textColor: "text-blue-400",
	},
	tip: {
		borderColor: "border-green-500",
		bgColor: "bg-green-500/5",
		icon: "💡",
		title: "TIP",
		textColor: "text-green-400",
	},
	caution: {
		borderColor: "border-amber-500",
		bgColor: "bg-amber-500/5",
		icon: "⚠️",
		title: "CAUTION",
		textColor: "text-amber-400",
	},
	danger: {
		borderColor: "border-red-500",
		bgColor: "bg-red-500/5",
		icon: "🛑",
		title: "DANGER",
		textColor: "text-red-400",
	},
};

const style = variants[variant];
---

<div class={`my-6 border-l-2 ${style.borderColor} ${style.bgColor} p-4 not-prose`}>
	<div class={`font-mono text-xs font-bold mb-1 ${style.textColor} flex items-center gap-2`}>
		<span>{style.icon}</span>
		<span>{style.title}</span>
	</div>
	<div class="font-mono text-sm text-neutral-300">
		<slot />
	</div>
</div>
