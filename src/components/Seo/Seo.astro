---
import metadata from "../../data/biography-metadata.json";
import { getImage } from "astro:assets";

import { SEO } from "astro-seo";

// component import
import siteData from "@config/siteData.json";
import jsonLDGenerator from "@js/jsonLD";
import { currentSite, SITE_CONFIG } from "@config/site_config";
import { publishedProjectHome } from "@utils/projectDestination";

interface BaseProps {
	title: string;
	description: string;
	noindex?: boolean;
	socialImage?: { src?: string; type: string; alt: string; width?: number; height?: number };
}

interface GeneralProps extends BaseProps {
	type: "general";
	image?: ImageMetadata | string;
}

interface ProjectProps extends BaseProps {
	type: "project";
	image?: ImageMetadata | string;
	projectFrontmatter: any; // specific or any
}

const {
	type,
	title: suppliedTitle,
	description: suppliedDescription,
	image,
	socialImage,
	noindex = false,
} = Astro.props as GeneralProps | ProjectProps;

const pageMetadata = (metadata.pages as Record<string, any>)[Astro.url.pathname] || {};
const title = pageMetadata.title || suppliedTitle;
const description = pageMetadata.description || suppliedDescription;
let optimizedImage;
let jsonLD;

// CANONICAL LOGIC (The Link Triangle)
let canonicalBase = SITE_CONFIG[currentSite].domain;

if (type === "project") {
	const { projectFrontmatter } = Astro.props as ProjectProps;
	const slug = projectFrontmatter?.slug || Astro.url.pathname.split("/").filter(Boolean).at(-1) || "";
	const home = publishedProjectHome(slug, projectFrontmatter?.primary_home ?? currentSite);
	canonicalBase = SITE_CONFIG[home].domain;
}
// Ensure protocol
if (!canonicalBase.startsWith("http")) {
	canonicalBase = `https://${canonicalBase}`;
}

const canonicalUrl = new URL(Astro.url.pathname, canonicalBase);

// if this is a blog page we do things differently
if (type === "project") {
	const { projectFrontmatter } = Astro.props as ProjectProps;

	if (image && typeof image !== "string") {
		optimizedImage = await getImage({
			src: image,
			format: "webp",
			quality: "high",
			width: 1200,
		});
	}

	jsonLD = jsonLDGenerator({
		type: "project",
		projectFrontmatter: projectFrontmatter,
		image:
			optimizedImage ||
			(typeof image === "string" && image ? { src: image } : siteData.defaultImage),
		canonicalUrl: canonicalUrl,
	});
}
// for general pages
else {
	jsonLD = jsonLDGenerator({
		type: "general",
		url: canonicalUrl,
	});
}

const selectedImage = socialImage || pageMetadata.image || (!image ? metadata.defaultImage : undefined);
// Explicit public URLs stay absolute; local and optimized paths use the site origin.
const imageSource =
	selectedImage?.src ||
	optimizedImage?.src ||
	(typeof image === "string" ? image : image?.src) ||
	siteData.defaultImage.src;
const imageUrl = new URL(imageSource, Astro.site || canonicalBase).toString();
---

<SEO
	title={title}
	description={description}
	canonical={canonicalUrl.toString()}
	openGraph={{
		basic: {
			title: title,
			type: type === "project" ? "article" : "website",
			image: imageUrl,
			url: canonicalUrl.toString(),
		},
		optional: {
			description: description,
			siteName: siteData.name,
		},
		// Explicit metadata is opt-in; other pages retain their existing output.
		image: selectedImage
			? {
					type: selectedImage.type,
					alt: selectedImage.alt,
					width: selectedImage.width,
					height: selectedImage.height,
				}
			: {
					type: "image/webp",
					width: optimizedImage?.attributes.width || "1200",
					height: optimizedImage?.attributes.height || "800",
					alt: title,
				},
	}}
	twitter={{
		site: siteData.author.twitter ? "@" + siteData.author.twitter : "",
		creator: siteData.author.twitter ? "@" + siteData.author.twitter : "",
		card: selectedImage?.card === "summary" ? "summary" : "summary_large_image",
		title: title,
		description: description,
		image: imageUrl,
	}}
	noindex={noindex}
	nofollow={noindex}
/>

<!-- JSON LD -->
<Fragment set:html={jsonLD} />
