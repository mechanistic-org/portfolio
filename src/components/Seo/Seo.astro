---
import { getImage } from "astro:assets";

import { SEO } from "astro-seo";

// component import
import siteData from "@config/siteData.json";
import jsonLDGenerator from "@js/jsonLD";
import { currentSite, SITE_CONFIG } from "@config/site_config";

interface BaseProps {
	title: string;
	description: string;
	noindex?: boolean;
}

interface GeneralProps extends BaseProps {
	type: "general";
	image?: ImageMetadata | string;
}

interface ProjectProps extends BaseProps {
	type: "project";
	image?: ImageMetadata | string;
	projectFrontmatter: any; // specific or any
}

const {
	type,
	title,
	description,
	image,
	noindex = false,
} = Astro.props as GeneralProps | ProjectProps;

let optimizedImage;
let jsonLD;

// CANONICAL LOGIC (The Link Triangle)
let canonicalBase = SITE_CONFIG[currentSite].domain;

if (type === "project") {
	const { projectFrontmatter } = Astro.props as ProjectProps;
	// If the project specifies a primary_home, points canonical to that domain ("The Owner")
	if (projectFrontmatter?.primary_home && SITE_CONFIG[projectFrontmatter.primary_home]) {
		canonicalBase = SITE_CONFIG[projectFrontmatter.primary_home].domain;
	}
}
// Ensure protocol
if (!canonicalBase.startsWith("http")) {
	canonicalBase = `https://${canonicalBase}`;
}

const canonicalUrl = new URL(Astro.url.pathname, canonicalBase);

// if this is a blog page we do things differently
if (type === "project") {
	const { projectFrontmatter } = Astro.props as ProjectProps;

	if (image && typeof image !== "string") {
		optimizedImage = await getImage({
			src: image,
			format: "webp",
			quality: "high",
			width: 1200,
		});
	}

	jsonLD = jsonLDGenerator({
		type: "project",
		projectFrontmatter: projectFrontmatter,
		image:
			optimizedImage ||
			(typeof image === "string" && image ? { src: image } : siteData.defaultImage),
		canonicalUrl: canonicalUrl,
	});
}
// for general pages
else {
	jsonLD = jsonLDGenerator({
		type: "general",
		url: canonicalUrl,
	});
}

// Explicit public URLs stay absolute; local and optimized paths use the site origin.
const imageSource =
	optimizedImage?.src ||
	(typeof image === "string" ? image : image?.src) ||
	siteData.defaultImage.src;
const imageUrl = new URL(imageSource, Astro.site || canonicalBase).toString();
---

<SEO
	title={title}
	description={description}
	canonical={canonicalUrl.toString()}
	openGraph={{
		basic: {
			title: title,
			type: type === "project" ? "article" : "website",
			image: imageUrl,
			url: canonicalUrl.toString(),
		},
		optional: {
			description: description,
			siteName: siteData.title,
		},
		image: {
			type: "image/webp",
			width: optimizedImage?.attributes.width || "1200",
			height: optimizedImage?.attributes.height || "800",
			alt: title,
		},
	}}
	twitter={{
		site: siteData.author.twitter ? "@" + siteData.author.twitter : "",
		creator: siteData.author.twitter ? "@" + siteData.author.twitter : "",
		card: "summary_large_image",
		title: title,
		description: description,
		image: imageUrl,
	}}
	noindex={noindex}
	nofollow={noindex}
/>

<!-- JSON LD -->
<Fragment set:html={jsonLD} />
