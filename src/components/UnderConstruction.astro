---
import Layout from "../layouts/BaseLayout.astro";
import { site } from "@config/site_config";
---

<Layout title={site.title} description="Site Under Construction" noindex={true}>
	<div
		class="flex min-h-screen items-center justify-center bg-zinc-950 p-4 font-mono text-zinc-300 selection:bg-lime-900 selection:text-white"
	>
		<div
			class="w-full max-w-md space-y-8 rounded-lg border border-zinc-800 bg-zinc-900/50 p-8 backdrop-blur-sm"
		>
			<div class="space-y-2 text-center">
				<h1 class="text-3xl font-bold tracking-tighter text-white">{site.title.split("|")[0]}</h1>
				<p class="text-sm font-medium tracking-widest text-zinc-500 uppercase">
					System Status: Offline
				</p>
			</div>

			<div class="space-y-4">
				<div class="group relative overflow-hidden rounded bg-zinc-900 p-4">
					<div
						class="absolute inset-0 bg-gradient-to-r from-transparent via-zinc-800/10 to-transparent opacity-0 transition-opacity group-hover:opacity-100"
					>
					</div>
					<div class="flex items-center justify-between text-xs">
						<span class="text-zinc-500">PROTOCOL</span>
						<span class="font-bold text-lime-500">INITIATED</span>
					</div>
					<div class="mt-2 text-sm text-zinc-400">Deploying architecture v2.0 from source.</div>
				</div>

				<div class="h-1 w-full overflow-hidden rounded-full bg-zinc-800">
					<div class="h-full w-2/3 animate-pulse bg-lime-700/50"></div>
				</div>

				<p class="text-center text-xs text-zinc-600">
					Forensic Engineering in Progress.<br />
					Expected Resolution: Soon™
				</p>
			</div>

			<div class="flex justify-center pt-4">
				<a
					href="https://eriknorris.com"
					class="text-xs font-bold text-zinc-500 transition-colors hover:text-white"
				>
					&larr; Return to Central Command
				</a>
			</div>
		</div>
	</div>
</Layout>
