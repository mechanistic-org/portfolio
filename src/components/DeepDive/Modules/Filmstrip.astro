---
interface Props {
	data: any;
	startIndex: number;
}
const { data, startIndex } = Astro.props;
---

<div
	class="flex h-screen w-full items-center justify-center border-y border-yellow-500/50 bg-neutral-900"
>
	<div class="text-center">
		<h2 class="mb-4 text-4xl font-bold text-yellow-500">FILMSTRIP MODULE</h2>
		<p class="font-mono text-neutral-400">ID: {data.id} // INDEX: {startIndex}</p>
		<p class="mt-2 font-mono text-xs text-neutral-600">Coming Soon</p>
	</div>
</div>
