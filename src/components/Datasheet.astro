---
// src/components/Datasheet.astro
interface Props {
  specs: {
    category: string;
    parameter: string;
    typical: string | number;
    unit: string;
    notes: string;
  }[];
}

const { specs } = Astro.props;

// Group data by Category
const categories = [...new Set(specs.map(s => s.category))];
---

<div class="border-2 border-black font-mono text-sm max-w-4xl mx-auto bg-white text-black p-8 shadow-2xl">
  {/* Datasheet Header */}
  <div class="flex justify-between items-end border-b-4 border-black pb-4 mb-8">
    <div>
      <h1 class="text-4xl font-bold tracking-tighter uppercase">Erik Norris</h1>
      <p class="text-gray-600 mt-1">High-Performance Mechanical Engineer</p>
    </div>
    <div class="text-right">
      <div class="text-xs text-gray-500">DOC ID:</div>
      <div class="font-bold text-xl">EN-SPEC-2025</div>
    </div>
  </div>

  {/* The Spec Tables */}
  {categories.map((cat) => (
    <div class="mb-8">
      <h3 class="font-bold uppercase border-b border-black mb-2">{cat}</h3>
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="text-xs text-gray-500 border-b border-gray-300">
            <th class="py-1 w-1/3">Parameter</th>
            <th class="py-1 w-1/6">Typical</th>
            <th class="py-1 w-1/6">Unit</th>
            <th class="py-1 w-1/3">Conditions / Notes</th>
          </tr>
        </thead>
        <tbody>
          {specs.filter(s => s.category === cat).map((row) => (
            <tr class="border-b border-gray-100 hover:bg-gray-50">
              <td class="py-2 font-semibold">{row.parameter}</td>
              <td class="py-2 font-mono">{row.typical}</td>
              <td class="py-2 text-xs text-gray-600">{row.unit}</td>
              <td class="py-2 italic text-gray-700">{row.notes}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ))}

  {/* Footer Disclaimer */}
  <div class="text-[10px] text-gray-400 mt-12 border-t pt-2">
    * SPECIFICATIONS SUBJECT TO CHANGE WITHOUT NOTICE. PROTOTYPE UNIT BEHAVIOR MAY VARY BEFORE 9:00 AM.
    <br/>
    * ARIES/TAURUS CUSP INDICATES HIGH TORQUE OUTPUT AT LOW SPEEDS.
  </div>
</div>
