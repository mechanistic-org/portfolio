---
// components
import siteData from "@config/siteData.json";

const today = new Date();
---

<footer
	class="bg-background/80 border-border fixed bottom-0 left-0 z-50 w-full border-t backdrop-blur-md"
>
	<div
		class="site-container flex h-8 items-center justify-between text-[10px] font-bold tracking-wider text-neutral-500 uppercase md:text-xs"
	>
		<!-- Left: System Status -->
		<div class="flex items-center gap-2">
			<span class="relative flex h-2 w-2">
				<span
					class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-75"
				></span>
				<span class="relative inline-flex h-2 w-2 rounded-full bg-green-500"></span>
			</span>
			<span>SYSTEM: OPERATIONAL</span>
		</div>

		<!-- Center: Location (Hidden on mobile to save space) -->
		<div class="hidden md:block">
			<span>LOC: 37.7749° N, 122.4194° W</span>
		</div>

		<!-- Right: Version & Copyright -->
		<div class="flex items-center gap-4">
			<button
				id="debug-toggle"
				class="hover:text-primary cursor-pointer transition-colors"
				aria-label="Toggle Debug Mode"
			>
				DEBUG [ OFF ]
			</button>
			<span class="hidden md:inline">VER: 5.0.0</span>
			<span>&copy; {today.getFullYear()} {siteData.name.toUpperCase()}</span>
		</div>
	</div>
</footer>

<script>
	const toggle = document.getElementById("debug-toggle");
	const html = document.documentElement;

	// Init
	const isDebug = localStorage.getItem("debug-mode") === "true";
	if (isDebug) {
		html.classList.add("debug-mode");
		if (toggle) toggle.innerText = "DEBUG [ ON ]";
	}

	// Toggle
	toggle?.addEventListener("click", () => {
		const isActive = html.classList.toggle("debug-mode");
		if (toggle) toggle.innerText = isActive ? "DEBUG [ ON ]" : "DEBUG [ OFF ]";
		localStorage.setItem("debug-mode", isActive.toString());
	});
</script>
