---
interface Props {
  src: string;
  alt?: string;
}
const { src, alt } = Astro.props;
---
<div class="model-viewer-wrapper w-full h-96 bg-gray-100 rounded-lg overflow-hidden">
  <script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.4.0/model-viewer.min.js"></script>
  <model-viewer 
    src={src} 
    alt={alt || "3D Model"}
    auto-rotate 
    camera-controls 
    ar
    shadow-intensity="1"
    class="w-full h-full"
  ></model-viewer>
</div>