---
import BaseLayout from "@layouts/BaseLayout.astro";
import MediaGroup from "./MediaGroup.astro";
import MediaExperience from "./MediaExperience.astro";
import ProjectOpening from "../Projects/ProjectOpening.astro";
import projectOpenings from "../../config/project-openings.json";
import { selectProjectOpening } from "../../utils/projectOpening.mjs";
import { synopsisOpening } from "../../lib/project-synopsis.mjs";
import { selectAuthoredTimeline } from "../../utils/projectTimeline.mjs";
import ProjectTimeline from "../Projects/ProjectTimeline.astro";
import ProjectModelEvidence from "../Projects/ProjectModelEvidence.astro";
import "@/styles/authoring-page.css";
import "@/styles/project-reading.css";
import ProjectRecords from "../Projects/ProjectRecords.astro";
import ProjectCareerContext from "../Projects/ProjectCareerContext.astro";
import ProjectRecord from "../Projects/ProjectRecord.astro";
import Cast from "../primitives/Cast.astro";
import { normalizeCast } from "../../utils/cast.mjs";
const {
	page,
	chronology = null,
	revisions = null,
	entropy = [],
	contextNodes = [],
	projectNavigation,
	hasRecords = false,
} = Astro.props;
const cast = normalizeCast(page.frontmatter?.cast);
const narrativeTimeline = page.headings.find((h: any) =>
	["development-timeline", "proposed-development-timeline"].includes(h.slug),
);
const isPublic = page.public === true;
const isGlyph = page.project === "avegant-glyph";
const presentation = projectOpenings[page.project as keyof typeof projectOpenings];
const canonicalOpening = synopsisOpening(page);
const legacy = canonicalOpening ? null : selectProjectOpening(page.pieces, presentation?.selection);
const opening = canonicalOpening ?? legacy?.opening;
const pieces = canonicalOpening ? page.pieces : legacy!.pieces;
const openingImage =
	canonicalOpening?.image ??
	legacy?.opening?.group.items[0].displaySrc ??
	legacy?.opening?.group.items[0].src;
const timeline = selectAuthoredTimeline(pieces, chronology);
const chapters = page.headings.filter(
	(h: any) => h.depth === 2 && !(timeline.referenceHtml && h.slug === timeline.referenceId),
);
const projectLabel = isGlyph ? "Avegant Glyph" : page.title;
const firstImageGroup = pieces.find((piece: any) => piece.group?.items[0]?.kind === "image")?.group;
const browseImageCount = page.imageCount - (legacy?.opening?.group.items.length ?? 0);
const hasArticle = pieces.some((piece: any) => piece.group || piece.model || piece.html?.trim());
const hasRail = chapters.length > 0 || browseImageCount > 0 || cast.length > 0 || hasRecords;
---

<BaseLayout
	type="project"
	title={page.title}
	description={page.description}
	image={page.image}
	projectFrontmatter={page.frontmatter}
	noindex={!isPublic}
	projectNavigation={projectNavigation}
>
	{
		!isPublic && (
			<div class="working-strip">
				<>
					<span>
						<i /> Working page
					</span>
					<span>{projectLabel}</span>
					<a href="#source-notes">Source notes</a>
				</>
			</div>
		)
	}
	<article
		class:list={["authoring-page", { "public-authored-page": isPublic }]}
		data-authoring-project={page.project}
		data-project-reader="shared"
		data-revision={page.revision}
		data-project-title={projectLabel}
		data-project-intro={page.description}
		data-pagefind-meta="title[data-project-title], project[data-authoring-project], intro[data-project-intro]"
	>
		<ProjectOpening
			title={canonicalOpening?.title ?? presentation?.title ?? page.title}
			subtitle={canonicalOpening?.subtitle ?? presentation?.subtitle}
			meta={presentation?.meta}
			withMedia={Boolean(openingImage)}
		>
			<Fragment slot="product">
				{opening && <p class="opening-product" set:html={opening.blocks[0]} />}
			</Fragment>
			<Fragment slot="context">
				{
					opening && (
						<div class="opening-context">
							{opening.blocks.slice(1).map((block, index) => (
								<p set:html={block} />
							))}
						</div>
					)
				}
			</Fragment>
			<Fragment slot="media">
				{
					openingImage && (
						<div class="opening-visual">
							<img
								src={openingImage}
								alt=""
								aria-hidden="true"
								fetchpriority="high"
								decoding="async"
							/>
						</div>
					)
				}
			</Fragment>
		</ProjectOpening>
		<ProjectCareerContext nodes={contextNodes} currentId={page.project} />
		<div class:list={["authoring-layout", { "synopsis-only": !hasRail && !hasArticle }]}>
			{
				hasRail && (
					<aside class="article-contents">
						{isGlyph && <a class="article-all-work" href="/projects/">← All work</a>}
						{chapters.length > 0 && (
							<nav aria-label="On this page">
								{chapters.map((h: any, i: number) => (
									<a href={`#${h.slug}`}>
										<span>{String(i + 1).padStart(2, "0")}</span>
										{h.text}
									</a>
								))}
							</nav>
						)}
						{page.imageCount > 0 && firstImageGroup && (
							<a
								class="browse-project-media"
								href={`#media-${firstImageGroup.id}`}
								data-browse-media
							>
								Browse {browseImageCount} images
							</a>
						)}
						<ProjectRecords
							chronology={chronology}
							timelineHref={
								timeline.referenceId
									? `#${timeline.referenceId}`
									: narrativeTimeline
										? `#${narrativeTimeline.slug}`
										: null
							}
							revisions={revisions}
							entropy={entropy}
						/>
						{cast.length > 0 && (
							<ProjectRecord title="Cast & crew">
								<div id="cast-credits">
									<Cast cast={cast} />
								</div>
							</ProjectRecord>
						)}
						<slot name="records" />
					</aside>
				)
			}
			<div class="article-composition">
				<slot name="lead" />
				{
					timeline.pieces.map((piece: any) =>
						piece.timeline ? null : piece.group ? (
							<MediaGroup group={piece.group} />
						) : piece.model ? (
							<ProjectModelEvidence models={[piece.model]} />
						) : (
							<div class="article-prose" set:html={piece.html} />
						),
					)
				}
				{
					chronology?.events?.length > 0 && (
						<ProjectTimeline chronology={chronology} referenceHtml={timeline.referenceHtml} />
					)
				}

				{
					!isPublic && (
						<details class="source-notes" id="source-notes">
							<>
								<summary>
									Sources and authoring notes <span>{page.footnotes.length} notes</span>
								</summary>
								<ol>
									{page.footnotes.map((note: any) => (
										<li id={`note-${note.id}`}>
											<>
												<strong>{note.id.replaceAll("-", " ")}</strong>
												<div set:html={note.html} />
											</>
										</li>
									))}
								</ol>
							</>
						</details>
					)
				}
			</div>
		</div>
	</article>
	{page.groups?.length > 0 && <MediaExperience projectLabel={projectLabel} isPublic={isPublic} />}
</BaseLayout>
