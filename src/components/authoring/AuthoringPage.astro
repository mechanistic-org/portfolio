---
import BaseLayout from "@layouts/BaseLayout.astro";
import MediaGroup from "./MediaGroup.astro";
import MediaExperience from "./MediaExperience.astro";
import "@/styles/authoring-page.css";
import "@/styles/project-reading.css";
import DevelopmentTimeline from "../Projects/DevelopmentTimeline.astro";
import ProjectRecords from "../Projects/ProjectRecords.astro";
import ProjectRecord from "../Projects/ProjectRecord.astro";
import ContextRibbon from "../primitives/ContextRibbon.astro";
const {
	page,
	chronology = null,
	revisions = null,
	contextNodes = [],
	projectNavigation,
} = Astro.props;
const hasNarrativeTimeline = page.headings.some((h: any) => h.slug === "development-timeline");
const hasAuthoredOverview = page.headings.some((h: any) => h.slug === "development-at-a-glance");
const chapters = page.headings.filter((h: any) => h.depth === 2);
const isPublic = page.public === true;
const isGlyph = page.project === "avegant-glyph";
const title = isGlyph ? "Glyph" : page.title;
const subtitle = isGlyph ? "Getting it into production" : undefined;
const projectLabel = isGlyph ? "Avegant Glyph" : page.title;
const firstImageGroup = page.pieces.find(
	(piece: any) => piece.group?.items[0]?.kind === "image",
)?.group;
---

<BaseLayout
	type="project"
	title={isPublic ? page.title : "Avegant Glyph: getting it into production"}
	description={page.description ||
		"Erik Norris on the mechanical development, tooling, validation and production ramp of Avegant Glyph."}
	image={page.image}
	projectFrontmatter={page.frontmatter}
	noindex={!isPublic}
	projectNavigation={projectNavigation}
>
	{
		!isPublic && (
			<div class="working-strip">
				<>
					<span>
						<i /> Working page
					</span>
					<span>{projectLabel}</span>
					<a href="#source-notes">Source notes</a>
				</>
			</div>
		)
	}
	<article
		class:list={["authoring-page", { "public-authored-page": isPublic }]}
		data-authoring-project={page.project}
		data-revision={page.revision}
		data-project-title={projectLabel}
		data-project-intro={page.description}
		data-pagefind-meta="title[data-project-title], project[data-authoring-project], intro[data-project-intro]"
	>
		<header class="article-masthead">
			{
				isGlyph && (
					<div class="masthead-meta">
						<>
							<span>Avegant</span>
							<span>2015–2016</span>
							<span>Mechanical engineering</span>
						</>
					</div>
				)
			}
			<h1>{title}</h1>
			{subtitle && <p class="masthead-subtitle">{subtitle}</p>}
		</header>
		{
			!hasAuthoredOverview && (
				<DevelopmentTimeline
					chronology={chronology}
					detailHref={hasNarrativeTimeline ? "#development-timeline" : "#chronology-heading"}
				/>
			)
		}
		<div class="authoring-layout">
			<aside class="article-contents">
				<nav aria-label="On this page">
					<span class="contents-label">In this account</span>{
						chapters.map((h: any, i: number) => (
							<a href={`#${h.slug}`}>
								<span>{String(i + 1).padStart(2, "0")}</span>
								{h.text}
							</a>
						))
					}
				</nav>
				{
					page.imageCount > 0 && firstImageGroup && (
						<a class="browse-project-media" href={`#media-${firstImageGroup.id}`} data-browse-media>
							Browse {page.imageCount} images ↗
						</a>
					)
				}
				<ProjectRecords
					chronology={hasNarrativeTimeline ? null : chronology}
					revisions={revisions}
				/>
				{
					contextNodes.length > 0 && (
						<ProjectRecord title="Career context">
							<ContextRibbon nodes={contextNodes} currentId={page.project} />
						</ProjectRecord>
					)
				}
			</aside>
			<div class="article-composition">
				{
					page.pieces.map((piece: any) =>
						piece.group ? (
							<MediaGroup group={piece.group} />
						) : (
							<div class="article-prose" set:html={piece.html} />
						),
					)
				}
				{
					!isPublic && (
						<details class="source-notes" id="source-notes">
							<>
								<summary>
									Sources and authoring notes <span>{page.footnotes.length} notes</span>
								</summary>
								<ol>
									{page.footnotes.map((note: any) => (
										<li id={`note-${note.id}`}>
											<>
												<strong>{note.id.replaceAll("-", " ")}</strong>
												<div set:html={note.html} />
											</>
										</li>
									))}
								</ol>
							</>
						</details>
					)
				}
			</div>
		</div>
	</article>
	<MediaExperience projectLabel={projectLabel} isPublic={isPublic} />
</BaseLayout>
