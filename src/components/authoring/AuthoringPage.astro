---
import BaseLayout from "@layouts/BaseLayout.astro";
import MediaGroup from "./MediaGroup.astro";
import "@/styles/authoring-page.css";
const { page } = Astro.props;
const chapters = page.headings.filter((h: any) => h.depth === 2);
const isPublic = page.public === true;
const isGlyph = page.project === "avegant-glyph";
const title = isGlyph ? "Glyph" : page.title;
const subtitle = isGlyph ? "Getting it into production" : undefined;
const projectLabel = isGlyph ? "Avegant Glyph" : page.title;
---

<BaseLayout
	type="project"
	title={isPublic ? page.title : "Avegant Glyph: getting it into production"}
	description={page.description ||
		"Erik Norris on the mechanical development, tooling, validation and production ramp of Avegant Glyph."}
	image={page.image}
	projectFrontmatter={page.frontmatter}
	noindex={!isPublic}
>
	{
		!isPublic && (
			<div class="working-strip">
				<>
					<span>
						<i /> Working page
					</span>
					<span>{projectLabel}</span>
					<a href="#source-notes">Source notes</a>
				</>
			</div>
		)
	}
	<article
		class:list={["authoring-page", { "public-authored-page": isPublic }]}
		data-authoring-project={page.project}
		data-revision={page.revision}
	>
		<header class="article-masthead">
			<div class="masthead-meta">
				{
					isGlyph ? (
						<>
							<>
								<span>Avegant</span>
								<span>2015–2016</span>
								<span>Mechanical engineering</span>
							</>
						</>
					) : (
						<span>{projectLabel}</span>
					)
				}
			</div>
			<h1>{title}{subtitle && <span>{subtitle}</span>}</h1>
			<div class="masthead-bottom">
				<span>By Erik Norris</span><button type="button" data-browse-media
					>Explore the photographs <span>↗</span></button
				><span>{page.imageCount} images · {page.videoCount} videos</span>
			</div>
		</header>
		<div class="authoring-layout">
			<aside class="article-contents">
				<nav aria-label="On this page">
					<span class="contents-label">In this account</span>{
						chapters.map((h: any, i: number) => (
							<a href={`#${h.slug}`}>
								<span>{String(i + 1).padStart(2, "0")}</span>
								{h.text}
							</a>
						))
					}
				</nav><button type="button" data-browse-media>Browse the images ↗</button>
			</aside>
			<div class="article-composition">
				{
					page.pieces.map((piece: any) =>
						piece.group ? (
							<MediaGroup group={piece.group} />
						) : (
							<div class="article-prose" set:html={piece.html} />
						),
					)
				}
				{
					!isPublic && (
						<details class="source-notes" id="source-notes">
							<>
								<summary>
									Sources and authoring notes <span>{page.footnotes.length} notes</span>
								</summary>
								<ol>
									{page.footnotes.map((note: any) => (
										<li id={`note-${note.id}`}>
											<>
												<strong>{note.id.replaceAll("-", " ")}</strong>
												<div set:html={note.html} />
											</>
										</li>
									))}
								</ol>
							</>
						</details>
					)
				}
			</div>
		</div>
	</article>
	<dialog class="media-browser" aria-labelledby="media-browser-title">
		<header>
			<div>
				<span class="group-kicker">{projectLabel}</span><h2 id="media-browser-title">
					Photographs from the work
				</h2>
			</div><button type="button" data-close-browser aria-label="Close image browser"
				>Close ×</button
			>
		</header><div class="media-browser-groups"></div>
	</dialog>
	<dialog class="image-viewer" aria-labelledby="image-viewer-title">
		<header>
			<h2 id="image-viewer-title"></h2><div>
				<button type="button" data-zoom aria-pressed="false">Zoom in</button><button
					type="button"
					data-close-viewer
					aria-label="Close enlarged image">Close ×</button
				>
			</div>
		</header><div class="viewer-image"><img alt="" /></div><footer>
			<div class="viewer-paging">
				<button type="button" data-viewer-step="-1" aria-label="Previous enlarged image">←</button
				><span class="viewer-count" aria-live="polite"></span><button
					type="button"
					data-viewer-step="1"
					aria-label="Next enlarged image">→</button
				>
			</div><div class="viewer-caption"></div><a
				class="viewer-original"
				href="#"
				target="_blank"
				rel="noopener">{isPublic ? "Full-size ↗" : "Original ↗"}</a
			>
		</footer>
	</dialog>
	<script>
		import { initializeAuthoringPage } from "./page-client";
		initializeAuthoringPage();
		document.addEventListener("astro:page-load", initializeAuthoringPage);
	</script>
</BaseLayout>
