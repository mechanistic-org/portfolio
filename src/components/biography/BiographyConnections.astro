---
import bio from "../../data/biography-intros.json";
import "../../styles/biography-intros.css";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<section class:list={["bio-connections", className]} aria-label="The connected account">
	<p class="bio-kicker">Follow a connection</p>
	<p data-bio-id="erik-reading-intro">{bio["erik-reading-intro"]}</p>
	<div class="bio-link-grid">
		<a href="/about/"
			><span>eriknorris.com</span><strong>About Erik Norris</strong><small
				>The work and the longer account</small
			></a
		>
		<a href="https://moreplay.com/"
			><span>Moreplay</span><strong>Family, photographs and the longer story</strong><small
				>Family and coast · The repair shop</small
			></a
		>
		<a href="https://mechanistic.com/"
			><span>Mechanistic</span><strong>Development methods and tools</strong><small
				>The practice and its working records</small
			></a
		>
	</div>
</section>
