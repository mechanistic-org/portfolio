---
interface Props {
	title: string;
}

const { title } = Astro.props;
import noise from "@assets/noise.png";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Quantum Pitch Deck" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;900&family=JetBrains+Mono:wght@400;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body
		class="overflow-x-hidden bg-black text-white antialiased selection:bg-[#2E5CFF] selection:text-white"
	>
		<main class="relative w-full">
			<slot />
		</main>

		{/* Cinematic Grain Overlay */}
		<div
			class="pointer-events-none fixed inset-0 z-50 opacity-[0.03] mix-blend-overlay"
			style={`background-image: url('${noise.src}');`}
		>
		</div>
	</body>
</html>

<style is:global>
	/* Cinematic Typography */
	h1,
	h2,
	h3,
	h4,
	h5,
	h6 {
		font-family: "Inter", sans-serif;
		letter-spacing: -0.05em;
	}
	.font-mono {
		font-family: "JetBrains Mono", monospace;
	}

	/* Hide Scrollbar but keep functionality */
	body::-webkit-scrollbar {
		width: 0px;
		background: transparent;
	}
</style>
