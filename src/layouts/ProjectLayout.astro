---
import { Image } from "astro:assets";
import { type CollectionEntry } from "astro:content";

import Button from "@/components/Button/Button.astro";

import ProjectSpecCard from "@/components/Projects/ProjectSpecCard.astro";
import TechStack from "@/components/Projects/TechStack.astro";
import ForensicHUD from "@/components/Projects/ForensicHUD.astro";
import { getLocaleFromUrl } from "@/js/localeUtils";
import { formatDate } from "@/js/textUtils";
import { useTranslations } from "@/js/translationUtils";

import BaseLayout from "./BaseLayout.astro";

interface Props {
	project: CollectionEntry<"projects">;
}

const { project } = Astro.props as Props;
const {
	title,
	description = "",
	heroImage: image,
	tools: technologies,
	date: completionDate,
	links = [],
} = project.data;

const demoUrl = links.find((l) => l.name === "Demo" || l.name === "Live")?.url;
const githubUrl = links.find((l) => l.name === "GitHub" || l.name === "Repo")?.url;

const currLocale = getLocaleFromUrl(Astro.url);
const t = useTranslations(currLocale);
---

<BaseLayout type="general" title={title} description={description} image={image}>
	<article class="site-container mt-24">
		<!-- Project Header -->
		<div class="mx-auto max-w-3xl pt-8 pb-8 text-center md:pb-12">
			<h1 class="h1 mb-4">{title}</h1>
			<p class="text-muted-foreground text-lg md:text-xl">{description}</p>
		</div>

		<!-- Technical Spec Card -->
		<div class="mx-auto mb-12 max-w-3xl">
			<ProjectSpecCard entry={project} />
		</div>

		<!-- Project Featured Image -->
		{
			image ? (
				<div class="mx-auto flex w-full max-w-[1000px] justify-center pb-12">
					<div class="w-full overflow-hidden rounded-xl border md:rounded-2xl">
						<Image
							src={image}
							alt={title}
							width={1000}
							height={600}
							densities={[1.5, 2]}
							quality="high"
							format="webp"
							loading="eager"
							class="max-h-[70vh] w-full rounded-xl object-cover md:rounded-2xl"
						/>
					</div>
				</div>
			) : (
				<div class="mx-auto mb-12 flex w-full max-w-[1000px] justify-center pb-12">
					<div class="flex aspect-video w-full items-center justify-center overflow-hidden rounded-xl border border-neutral-800 bg-neutral-900/50 md:rounded-2xl">
						<div class="flex flex-col items-center gap-2 text-neutral-700">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="48"
								height="48"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="opacity-50"
							>
								<path d="M21 12a9 9 0 1 1-6.219-8.56" />
							</svg>
							<span class="font-mono text-xs tracking-widest">NO VISUAL DATA</span>
						</div>
					</div>
				</div>
			)
		}

		<!-- Content Section -->
		<div class="py-12">
			<div class="mx-auto max-w-3xl">
				<div class="mb-12">
					<h2 class="h2 mb-4">Technologies Used</h2>
					<TechStack tools={technologies} />
				</div>

				{
					/* <div class="mb-12">
					<h2 class="h2 mb-4">Key Features</h2>
					<KeyFeatures {keyFeatures} />
				</div> */
				}

				<div class="markdown-content">
					<slot />
				</div>

				<div class="mt-10 flex flex-col gap-6">
					<div class="opacity-70">
						Completed on: {formatDate(completionDate || new Date())}
					</div>

					<div class="flex flex-wrap gap-4">
						{
							demoUrl && (
								<Button
									href={demoUrl}
									target="_blank"
									variant="primary"
									arrow="right"
									class="px-6 py-3"
								>
									Live Demo
								</Button>
							)
						}
						{
							githubUrl && (
								<Button
									href={githubUrl}
									target="_blank"
									variant="outline"
									arrow="right"
									class="px-6 py-3"
								>
									View Source
								</Button>
							)
						}
					</div>
				</div>

				<ForensicHUD
					metrics={project.data.forensic_metrics}
					transcript={project.data.transcript ?? undefined}
					audioUrl={project.data.audio_url ?? undefined}
					events={project.data.events ?? undefined}
				/>
			</div>
		</div>
	</article>
</BaseLayout>
