---
import BaseLayout from "@layouts/BaseLayout.astro";
import StickyStage from "@components/Scrolly/StickyStage.astro";
import ScrollTrigger from "@components/Scrolly/ScrollTrigger.astro";
import NarrativeItem from "@components/Scrolly/NarrativeItem.astro";
import ScrollyHud from "@components/Scrolly/ScrollyHud.astro";
import TextDeck from "@components/Scrolly/TextDeck.astro";
import TacticalHUD from "@components/Projects/TacticalHUD.astro";
import { getAssetUrl } from "@/utils/assets";
import GlobalHomeButton from "@components/Nav/GlobalHomeButton.astro";
import ForensicDossier from "@components/Scrolly/ForensicDossier.astro";
import ForensicMarker from "@components/Scrolly/ForensicMarker.tsx";
import C24TitleAnimator from "@components/Projects/C24TitleAnimator";
import SCThermalMatrix from "@components/Visualizations/SCThermalMatrix";
import SharedLayoutGallery from "@components/Projects/SharedLayoutGallery";

const { entry, nextProject, prevProject, Content, metrics, entropy } = Astro.props;
const { cyberspace, title, description, presentation_mode } = entry.data;

const stickies = cyberspace?.stickies || [];
const narratives = cyberspace?.narrative || [];
---

<BaseLayout
	title={title}
	description={description}
	hideNav={true}
	type="project"
	projectFrontmatter={entry.data}
	entropy={entropy}
	starfield={true}
>
	<GlobalHomeButton />

	<!-- FIXED INTRO -->
	<div
		id="intro-layer"
		class="pointer-events-none fixed inset-0 z-50 flex flex-col items-center justify-center bg-black transition-opacity duration-300"
	>
		{
			entry.data.heroImage && (
				<div id="hero-parallax" class="absolute inset-0 h-full w-full">
					<img
						src={entry.data.heroImage}
						alt=""
						class="animate-breathe h-full w-full object-cover opacity-50"
					/>
				</div>
			)
		}
		<div class="absolute inset-0 bg-linear-to-t from-black via-transparent to-black/50"></div>

		<C24TitleAnimator client:load />
	</div>

	<!-- LATERAL NAV (Keeping ScrollyHud for side navigation) -->
	<ScrollyHud steps={stickies.map((s: any) => ({ id: s.id, label: s.label }))} />

	<!-- TACTICAL HUD (The FPV Layer) -->
	<div
		id="top-hud"
		class="fixed top-0 left-0 z-9999 w-full transition-transform duration-500 ease-out"
		style="transform: translateY(-100%);"
	>
		<TacticalHUD data={{ ...entry.data, id: entry.id }} metrics={metrics} />
	</div>

	<!-- MAIN ENGINE -->
	<main
		class="relative z-10 snap-y snap-proximity bg-transparent"
		style={`height: ${stickies.length * 100 + 100}vh;`}
	>
		<!-- STICKY DECK -->
		<div class="sticky top-0 h-screen w-full overflow-hidden">
			{
				stickies.map((stage: any, index: number) => (
					<StickyStage
						id={`stage-${stage.id}`}
						active={index === 0}
						data-interactive={stage.type === "gallery" || stage.type === "model"}
					>
						{stage.type === "media" && (
							<div class="relative h-full w-full">
								{stage.data?.src && (
									<img
										src={getAssetUrl(stage.data.src)}
										class="h-full w-full object-cover opacity-80"
									/>
								)}
								<div class="absolute inset-0 bg-linear-to-t from-neutral-900 via-transparent to-transparent" />
							</div>
						)}
						{stage.type === "gallery" && (
							<SharedLayoutGallery
								client:load
								id={`gallery-${stage.id}`}
								images={stage.data?.images || []}
								columns={3}
							/>
						)}
						{stage.type === "thermal" && <SCThermalMatrix client:load />}
					</StickyStage>
				))
			}
		</div>

		<!-- TRIGGERS -->
		<div class="pointer-events-none absolute inset-0 flex flex-col">
			{
				stickies.map((stage: any, index: number) => {
					const hasDeck = stage.deck && stage.deck.length > 0;
					const isInvisible = !stage.title && !stage.text && !hasDeck;
					const isWide = hasDeck;

					return (
						<ScrollTrigger
							step={stage.id}
							align={stage.align}
							invisible={isInvisible}
							wide={isWide}
						>
							{stage.title && <h2 class="mb-4 text-3xl font-bold text-white">{stage.title}</h2>}
							{stage.text && <p class="text-neutral-400" set:html={stage.text} />}
							{hasDeck && <TextDeck id={`deck-${stage.id}`} slides={stage.deck} />}
						</ScrollTrigger>
					);
				})
			}
		</div>
	</main>

	<div class="h-[25vh] w-full snap-end bg-transparent"></div>
</BaseLayout>

<script>
	// COPIED ENGINE SCRIPT (Simplified for Demo)
	const intro = document.getElementById("intro-layer");
	const heroParallax = document.getElementById("hero-parallax");
	const topHud = document.getElementById("top-hud");

	if (topHud) {
		topHud.style.transform = "translateY(-100%)";
	}

	window.addEventListener("scroll", () => {
		const scrollY = window.scrollY;
		if (heroParallax) heroParallax.style.transform = `translateY(${scrollY * 0.5}px)`;
		if (intro) {
			const opacity = Math.max(0, 1 - scrollY / 200);
			intro.style.opacity = opacity.toString();
			intro.style.visibility = opacity === 0 ? "hidden" : "visible";
		}
		// HUD Reveal
		if (topHud) {
			topHud.style.transform = scrollY > 100 ? "translateY(0%)" : "translateY(-100%)";
		}
	});

	// Stage Switcher
	const observer = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					const targetId = entry.target.getAttribute("data-step");
					const targetStage = document.getElementById(`stage-${targetId}`);
					if (targetStage) {
						document.querySelectorAll("[data-scrolly-layer]").forEach((el: any) => {
							el.style.opacity = "0";
							el.style.pointerEvents = "none";
						});
						targetStage.style.opacity = "1";
						targetStage.style.visibility = "visible";
					}
				}
			});
		},
		{ threshold: 0.5 },
	);

	document.querySelectorAll("[data-step]").forEach((el) => observer.observe(el));
</script>
