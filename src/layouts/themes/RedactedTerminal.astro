---
import Layout from "@layouts/BaseLayout.astro";
import { YouTube } from "@astro-community/astro-embed-youtube";

const { entry, Content } = Astro.props;
const data = entry.data;
---

<Layout
	title={`TERMINAL: ${data.title}`}
	description="NORAD MAINFRAME CONNECTION"
	image={data.heroImage ?? ""}
	type="project"
>
	<!-- CRT EFFECT OVERLAY -->
	<div
		class="pointer-events-none fixed inset-0 z-[100] h-full w-full bg-[url('/assets/scanline.png')] opacity-10 mix-blend-overlay"
	>
	</div>
	<div
		class="pointer-events-none fixed inset-0 z-[100] h-full w-full rounded-[50px] shadow-[inset_0_0_100px_rgba(0,0,0,0.9)]"
	>
	</div>

	<!-- GREEN PHOSPHOR GLOW -->
	<style>
		.phosphor-text {
			color: #33ff00;
			text-shadow:
				0 0 5px #33ff00,
				0 0 10px #33ff00;
		}
		.crt-flicker {
			animation: flicker 0.15s infinite;
		}
		@keyframes flicker {
			0% {
				opacity: 0.97;
			}
			50% {
				opacity: 1;
			}
			100% {
				opacity: 0.98;
			}
		}
	</style>

	<div
		class="crt-flicker font-vt323 min-h-screen overflow-hidden bg-[#0a110a] p-8 font-mono text-[#33ff00] selection:bg-[#33ff00] selection:text-black md:p-16"
	>
		<!-- HEADER -->
		<header class="mb-12 border-b-2 border-dashed border-[#33ff00] pb-4">
			<div class="flex items-end justify-between">
				<div>
					<div class="text-xs opacity-70">W.O.P.R. SYSTEM V1.0</div>
					<h1 class="phosphor-text mt-2 text-4xl font-bold uppercase md:text-6xl">{data.title}</h1>
				</div>
				<div class="text-right text-[10px] md:text-sm">
					<div>DEFCON: <span class="animate-pulse font-bold text-red-500">1</span></div>
					<div>SIMULATION: ACTIVE</div>
				</div>
			</div>
		</header>

		<main class="mx-auto max-w-4xl">
			<!-- ASCII ART BOX -->
			<div class="relative mb-12 border border-[#33ff00] p-4">
				<div class="absolute -top-3 left-4 bg-[#0a110a] px-2 text-xs">TACTICAL MAP</div>
				<pre
					class="text-[10px] leading-none opacity-80 select-none md:text-xs">
+--------------------------------------------------+
|      .         _  .          .          .    .   |
|   .      .    ( \   .    .      .     .       .  |
|      .       /   \     .    _ .     .    .       |
|  .      .   |     | .      ( \   .       .    .  |
|     .        \___/    .   /   \     .       .    |
|  .      .    .    .      |     | .      .        |
|     .           TARGET    \___/         .    .   |
+--------------------------------------------------+
                </pre>
			</div>

			<!-- METADATA GRID -->
			<div class="mb-12 grid grid-cols-2 gap-8 border-l border-[#33ff00] pl-6">
				<div>
					<div class="text-xs uppercase opacity-50">Code Name</div>
					<div class="text-xl">{data.slug}</div>
				</div>
				<div>
					<div class="text-xs uppercase opacity-50">Date</div>
					<div class="text-xl">{data.date}</div>
				</div>
				<div>
					<div class="text-xs uppercase opacity-50">Agency</div>
					<div class="text-xl">{data.employer}</div>
				</div>
				<div>
					<div class="text-xs uppercase opacity-50">Status</div>
					<div class="text-xl">{data.statusLabel}</div>
				</div>
			</div>

			<!-- CONTENT STREAM -->
			<article
				class="prose prose-invert prose-lg prose-headings:text-[#33ff00] prose-strong:text-[#33ff00] prose-code:text-[#33ff00] prose-code:bg-[#33ff00]/10 max-w-none font-mono text-[#33ff00]"
			>
				<div class="mb-8 border border-dashed border-[#33ff00]/50 bg-[#33ff00]/5 p-4 text-sm">
					> DECRYPTING DATA STREAM...<br />
					> ACCESS CODE ACCEPTED.<br />
					> DISPLAYING FILE CONTENTS:
				</div>
				<Content components={{ YouTube }} />
			</article>

			<!-- CURSOR -->
			<div class="mt-12 animate-pulse text-2xl">_</div>
		</main>

		<footer
			class="fixed bottom-0 left-0 w-full border-t border-[#33ff00] bg-[#0a110a] p-2 text-center text-xs opacity-60"
		>
			CONNECTION SECURE // NO CARRIER
		</footer>
	</div>
</Layout>
