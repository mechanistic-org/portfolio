---
import BaseLayout from "@layouts/BaseLayout.astro";
import StickyStage from "@components/Scrolly/StickyStage.astro";
import ScrollTrigger from "@components/Scrolly/ScrollTrigger.astro";
import NarrativeItem from "@components/Scrolly/NarrativeItem.astro";
import ScrollyHud from "@components/Scrolly/ScrollyHud.astro";
import TextDeck from "@components/Scrolly/TextDeck.astro";
import ProjectManifestHUD from "@components/Projects/ProjectManifestHUD.astro";
import SharedLayoutGallery from "@components/Projects/SharedLayoutGallery";

const { entry, nextProject, prevProject, Content, metrics } = Astro.props;
const { cyberspace, title, description } = entry.data;
// Backwards compatibility/Renaming
const scrolly = cyberspace;

import GlobalHomeButton from "@components/Nav/GlobalHomeButton.astro";
// NEW COMPONENT IMPORTS
// import ConspiracyBoard from "@components/Projects/ConspiracyBoard";
// import Comparator from "@components/Projects/Comparator";
import C24TitleAnimator from "@components/Projects/C24TitleAnimator";
import SCThermalMatrix from "@components/Visualizations/SCThermalMatrix";

const stickies = scrolly?.stickies || [];
const narratives = scrolly?.narrative || [];

// GENERATED CONTENT FOR SWARM (Should also be data driven eventually, but hardcoded for V4.2 proof)
const swarmlings = Array.from({ length: 50 }).map((_, i) => ({
	id: i,
	color: ["#FF0000", "#00FF00", "#0000FF", "#FFFF00", "#00FFFF", "#FF00FF"][
		Math.floor(Math.random() * 6)
	],
	scale: 0.5 + Math.random(),
}));
---

<BaseLayout
	title={title}
	description={description}
	hideNav={true}
	type="project"
	projectFrontmatter={entry.data}
>
	<GlobalHomeButton />
	<!-- FIXED INTRO -->
	<div
		id="intro-layer"
		class="pointer-events-none fixed inset-0 z-50 flex flex-col items-center justify-center bg-black transition-opacity duration-300"
	>
		{
			entry.data.heroImage && (
				<div id="hero-parallax" class="absolute inset-0 h-full w-full">
					<img
						src={entry.data.heroImage}
						alt=""
						class="animate-breathe h-full w-full object-cover opacity-50"
					/>
				</div>
			)
		}
		<div class="absolute inset-0 bg-linear-to-t from-black via-transparent to-black/50"></div>

		{/* C24 ORIGIN STORY ANIMATION */}
		{
			// ROBUST CHECK: specific slug check was failing (undefined), falling back to URL path
			Astro.url.pathname.includes("c24") ? (
				<C24TitleAnimator client:load />
			) : (
				<h1
					class="font-heading relative z-10 text-9xl font-bold tracking-tighter text-white mix-blend-difference"
					set:html={(title && typeof title === "string" ? title : String(title || "UNKNOWN"))
						.toUpperCase()
						.replace(
							"|",
							'<span class=\"text-white opacity-60 mx-3\" style=\"font-family: Arial, sans-serif;\">|</span>',
						)}
				/>
			)
		}
	</div>

	<!-- HUD -->
	<ScrollyHud steps={stickies.map((s: any) => ({ id: s.id, label: s.label }))} />

	<!-- TOP HUD (Project Info) - Initially Hidden/Offscreen -->
	<div
		id="top-hud"
		class="fixed top-0 left-0 z-9999 w-full transition-transform duration-500 ease-out"
		style="transform: translateY(-100%);"
	>
		<ProjectManifestHUD
			data={entry.data}
			nextProject={nextProject}
			prevProject={prevProject}
			metrics={metrics}
		/>
	</div>

	<!-- MAIN ENGINE -->
	<main
		class="relative z-10 snap-y snap-proximity bg-neutral-900"
		style={`height: ${stickies.length * 100 + 100}vh;`}
	>
		<!-- STICKY DECK -->
		<div class="sticky top-0 h-screen w-full overflow-hidden">
			{
				stickies.map((stage: any, index: number) => (
					<StickyStage
						id={`stage-${stage.id}`}
						active={index === 0}
						data-interactive={
							stage.type === "gallery" ||
							stage.type === "model" ||
							stage.type === "conspiracy" ||
							stage.type === "comparator"
						}
					>
						{/* TYPE: SWARM */}
						{stage.type === "swarm" && (
							<div
								id="swarm-grid"
								class="perspective-1000 grid w-full max-w-4xl grid-cols-10 gap-2 p-8"
							>
								{swarmlings.map((s) => (
									<div
										class="swarmling glass-panel aspect-square rounded-full transition-transform duration-75 ease-out"
										data-scale={s.scale}
										style={`background-color: ${s.color}; opacity: 0.5; transform: scale(${s.scale}); box-shadow: 0 0 10px ${s.color}40;`}
									/>
								))}
							</div>
						)}

						{/* TYPE: MODEL */}
						{stage.type === "model" && (
							<model-viewer
								src={stage.data?.src}
								poster={stage.data?.poster}
								loading="eager"
								camera-controls
								disable-zoom
								shadow-intensity="1"
								exposure="0.3"
								interaction-prompt="none"
								interaction-prompt-style="wiggle"
								camera-orbit={stage.data?.cameraOrbit || "-30deg 75deg 110%"}
								field-of-view="30deg"
								class="h-full w-full"
								style="background: radial-gradient(circle at center, #111 0%, #000 100%);"
							>
								<div
									slot="progress-bar"
									class="pointer-events-none absolute top-0 left-0 h-1 w-full bg-neutral-800/80"
									id={`loader-${stage.id}`}
								>
									<div
										class="h-full bg-[#2E5CFF] transition-all duration-100 ease-out"
										style="width: 0%"
										data-progress-bar
									/>
								</div>
							</model-viewer>
						)}

						{/* TYPE: MEDIA */}
						{stage.type === "media" && (
							<div class="relative h-full w-full">
								{stage.data?.src && (
									<img
										src={stage.data.src}
										alt={stage.title}
										class="h-full w-full object-cover opacity-80"
									/>
								)}
								<div class="absolute inset-0 bg-linear-to-t from-neutral-900 via-transparent to-transparent" />
							</div>
						)}

						{/* TYPE: GALLERY */}
						{stage.type === "gallery" && (
							<SharedLayoutGallery
								client:load
								id={`gallery-${stage.id}`}
								images={stage.data?.images || []}
								columns={stage.data?.columns || 3}
								layout={stage.data?.layout || "grid"}
								scattered={stage.data?.scattered || false}
								featuredIndices={stage.data?.featuredIndices || []}
								showLabels={false}
							/>
						)}

						{/* TYPE: CONSPIRACY BOARD - DISABLED FOR MANIFESTO V4.2 BUILD
						{stage.type === "conspiracy" && (
							<ConspiracyBoard client:load images={stage.data?.images || []} />
						)}
						*/}

						{/* TYPE: COMPARATOR - DISABLED FOR MANIFESTO V4.2 BUILD
						{stage.type === "comparator" && (
							<Comparator
								client:load
								beforeSrc={stage.data?.beforeSrc}
								afterSrc={stage.data?.afterSrc}
								beforeLabel={stage.data?.beforeLabel}
								afterLabel={stage.data?.afterLabel}
							/>
						)}
						*/}

						{/* TYPE: THERMAL VIZ */}
						{stage.type === "thermal" && <SCThermalMatrix client:load />}
					</StickyStage>
				))
			}
		</div>

		<!-- TRIGGERS -->
		<div class="pointer-events-none absolute inset-0 flex flex-col">
			<!-- Intro Spacer -->
			<div class="flex h-[20vh] items-center justify-center">
				<div
					id="start-engine-btn"
					class="border border-white/10 bg-black/50 p-4 font-mono text-sm text-white transition-all duration-300"
				>
					START_ENGINE
				</div>
			</div>

			{
				stickies.map((stage: any) => (
					<ScrollTrigger
						step={stage.id}
						align={stage.align}
						invisible={!stage.title && !stage.text && !stage.deck}
						wide={!!stage.deck}
					>
						{stage.title && <h2 class="mb-4 text-3xl font-bold text-white">{stage.title}</h2>}
						{stage.text && <p class="text-neutral-400" set:html={stage.text} />}

						{/* DECK SUPPORT - Explicitly excluded for Resources and Artifact stages */}
						{stage.deck &&
							stage.deck.length > 0 &&
							stage.id !== "06_press_resources" &&
							stage.id !== "07_the_artifact" && (
								<TextDeck id={`deck-${stage.id}`} slides={stage.deck} />
							)}
					</ScrollTrigger>
				))
			}
		</div>
	</main>

	<!-- NARRATIVE SECTION -->
	{
		narratives.length > 0 && (
			<section class="relative z-10 bg-neutral-900 pt-12 pb-32">
				<div class="site-container max-w-4xl space-y-24">
					{narratives.map((n: any) => {
						// Find the matching visual from the sticky stages
						const relatedStage = stickies.find((s: any) => s.id === n.step);
						const imgSrc = relatedStage?.data?.src;
						const posterSrc = relatedStage?.data?.poster; // NEW: Support poster
						const isModel = relatedStage?.type === "model";

						return (
							<NarrativeItem
								step={n.step}
								title={n.title}
								subtitle={n.subtitle}
								reverse={n.reverse}
							>
								<div
									slot="visual"
									class="group relative h-full w-full overflow-hidden rounded-xl bg-neutral-800"
								>
									{/* CASE 1: Standard Image */}
									{imgSrc && !isModel && (
										<img
											src={imgSrc}
											alt={n.title}
											class="h-full w-full object-cover opacity-80 transition-opacity duration-500 hover:opacity-100"
										/>
									)}

									{/* CASE 2: Model (Use Poster or Icon) */}
									{isModel && (
										<div class="flex h-full w-full items-center justify-center bg-black">
											{posterSrc ? (
												<img src={posterSrc} class="h-full w-full object-cover opacity-80" />
											) : (
												<div class="text-center">
													<div class="mb-4 text-6xl">🧊</div>
													<div class="font-mono text-xs text-neutral-500">[INTERACTIVE_MODEL]</div>
												</div>
											)}
										</div>
									)}

									{/* CASE 3: Fallback */}
									{!imgSrc && !isModel && !posterSrc && (
										<div class="p-8 font-mono text-4xl font-bold text-neutral-700">{n.step}</div>
									)}
								</div>
								<div
									class="prose prose-invert max-w-none text-lg leading-relaxed text-neutral-400"
									set:html={n.body}
								/>
							</NarrativeItem>
						);
					})}
				</div>
			</section>
		)
	}

	<!-- MDX CONTENT SLOT -->
	<section class="relative z-10 bg-neutral-900 pb-32">
		<div class="site-container max-w-4xl">
			<Content />
		</div>
	</section>

	<!-- Scroll Cushion -->
	<div class="h-[25vh] w-full snap-end bg-neutral-900"></div>
</BaseLayout>

<script>
	// LOADER LOGIC
	// improved to handle multiple viewers potentially
	customElements.whenDefined("model-viewer").then(() => {
		const viewers = document.querySelectorAll("model-viewer");
		viewers.forEach((viewer) => {
			viewer.addEventListener("progress", (e) => {
				const p = (e as any).detail.totalProgress;
				const bar = viewer.querySelector("[data-progress-bar]");
				const loader = viewer.querySelector('[slot="progress-bar"]');

				if (bar) {
					(bar as HTMLElement).style.width = `${p * 100}%`;
				}

				if (p === 1) {
					if (loader)
						setTimeout(() => {
							(loader as HTMLElement).style.opacity = "0";
						}, 300);
				}
			});
		});
	});

	// ENGINE SCRIPT (Physics & Logic)

	// 1. Intro Fade & HUD REVEAL
	const intro = document.getElementById("intro-layer");
	const heroParallax = document.getElementById("hero-parallax");
	const topHud = document.getElementById("top-hud");
	const startBtn = document.getElementById("start-engine-btn");

	// FORCE INITIAL STATE - Fixes "Stuck Down" on reload/restoration edge cases
	// Wrapped in listener to ensure reliable execution after layout
	document.addEventListener("DOMContentLoaded", () => {
		if (topHud && startBtn) {
			// STRICT RESET: Always hide first
			topHud.style.transform = "translateY(-100%)";
			startBtn.style.opacity = "1";

			// Double-check scroll position after layout
			if (window.scrollY > 100) {
				// If we restored to a scrolled position, show HUD
				topHud.style.transform = "translateY(0%)";
				startBtn.style.opacity = "0";
			}
		}
	});

	window.addEventListener("scroll", () => {
		const scrollY = window.scrollY;

		// PARALLAX HERO
		if (heroParallax) {
			heroParallax.style.transform = `translateY(${scrollY * 0.5}px)`;
		}

		if (intro) {
			const opacity = Math.max(0, 1 - scrollY / 200);
			intro.style.opacity = opacity.toString();
			// Hide completely when invisible to prevent blocking clicks
			if (opacity === 0) {
				intro.style.visibility = "hidden";
			} else {
				intro.style.visibility = "visible";
			}
		}

		// HUD REVEAL LOGIC
		// Button moves up and fades out
		// HUD moves down and fades in
		if (startBtn && topHud) {
			if (scrollY > 100) {
				// Expanded State
				topHud.style.transform = "translateY(0%)";
				startBtn.style.opacity = "0";
				startBtn.style.transform = "translateY(-50px) scale(0.9)";
				console.log("HUD: Showing");
			} else {
				// Default State
				topHud.style.transform = "translateY(-100%)";
				startBtn.style.opacity = "1";
				startBtn.style.transform = "translateY(0) scale(1)";
				console.log("HUD: Hiding");
			}
		}
	});

	// 2. Stage Switcher
	const observer = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					const targetId = entry.target.getAttribute("data-step");
					const targetStage = document.getElementById(`stage-${targetId}` || "");

					if (targetId && targetStage) {
						// Hide all stages
						document.querySelectorAll("[data-scrolly-layer]").forEach((el) => {
							const elem = el as HTMLElement;
							elem.style.opacity = "0";
							elem.style.pointerEvents = "none";
							// Fix ghosting: Ensure deep cleanup after transition
							// We wait 700ms (matching CSS duration) then force visibility: hidden
							setTimeout(() => {
								if (elem.style.opacity === "0") {
									elem.style.visibility = "hidden";
								}
							}, 700);
						});

						// Show target
						targetStage.style.visibility = "visible"; // Ensure visible before fade
						targetStage.style.opacity = "1";

						if (
							targetStage.dataset.interactive !== undefined ||
							targetStage.querySelector("model-viewer") ||
							targetStage.querySelector(".pointer-events-auto")
						) {
							targetStage.style.pointerEvents = "auto";
						}
					}
				}
			});
		},
		{ threshold: 0.5 },
	);

	document.querySelectorAll("[data-step]").forEach((el) => observer.observe(el));

	// 3. SWARM PHYSICS (Kept Generic)
	const swarmGrid = document.getElementById("swarm-grid");
	const swarmlings = document.querySelectorAll(".swarmling");

	if (swarmGrid && swarmlings.length > 0) {
		window.addEventListener("mousemove", (e) => {
			// Optimization: Only run if any swarm stage is active?
			// For V4 we just check if the element exists in DOM

			const mx = e.clientX;
			const my = e.clientY;
			const cx = window.innerWidth / 2;
			const cy = window.innerHeight / 2;

			const dx = (mx - cx) * 0.05;
			const dy = (my - cy) * 0.05;
			swarmGrid.style.transform = `translate(${dx}px, ${dy}px) rotateY(${dx * 0.1}deg) rotateX(${-dy * 0.1}deg)`;

			swarmlings.forEach((s) => {
				const box = s.getBoundingClientRect();
				const sx = box.left + box.width / 2;
				const sy = box.top + box.height / 2;
				const dist = Math.hypot(mx - sx, my - sy);
				const limit = 200;

				if (dist < limit) {
					const force = (limit - dist) / limit;
					const ang = Math.atan2(my - sy, mx - sx);
					const moveX = Math.cos(ang) * -30 * force;
					const moveY = Math.sin(ang) * -30 * force;
					const scale = (s as HTMLElement).dataset.scale || "1";
					(s as HTMLElement).style.transform =
						`translate(${moveX}px, ${moveY}px) scale(${parseFloat(scale) * 1.5})`;
				} else {
					const scale = (s as HTMLElement).dataset.scale || "1";
					(s as HTMLElement).style.transform = `translate(0, 0) scale(${scale})`;
				}
			});
		});
	}

	// 4. MODEL VIEWER REFINEMENTS (Wiggle & Elastic)
	const modelViewers = document.querySelectorAll("model-viewer");
	let mouseX = 0;
	let mouseY = 0;

	window.addEventListener("mousemove", (e) => {
		mouseX = (e.clientX / window.innerWidth - 0.5) * 2;
		mouseY = (e.clientY / window.innerHeight - 0.5) * 2;
	});

	modelViewers.forEach((viewer: any) => {
		const baseOrbit = viewer.getAttribute("camera-orbit") || "-30deg 75deg 110%";
		let isInteracting = false;
		let interactionTimer: any;
		let time = Math.random() * 100;

		function animateWiggle() {
			if (!isInteracting && (viewer as any).model) {
				time += 0.01;
				const orbitParts = baseOrbit.split(" ");
				const baseAzimuth = parseFloat(orbitParts[0]);
				const basePolar = parseFloat(orbitParts[1]);

				// 1. Idle Wiggle (Increased Amplitude to match Homepage)
				const wiggleAzimuth = Math.sin(time * 0.5) * 20;
				const wigglePolar = Math.cos(time * 0.3) * 10;

				viewer.cameraOrbit = `${baseAzimuth + wiggleAzimuth}deg ${basePolar + wigglePolar}deg ${orbitParts[2]}`;

				// 2. RAINBOW CYCLE (Restoring user-requested animation)
				try {
					const material = (viewer as any).model.materials[0];
					if (material) {
						const hue = (time * 20) % 360;
						const saturation = 100;
						const lightness = 50;

						// Simple HSL to RGB conversion for baseColorFactor
						const c = ((1 - Math.abs((2 * lightness) / 100 - 1)) * saturation) / 100;
						const x = c * (1 - Math.abs(((hue / 60) % 2) - 1));
						const m = lightness / 100 - c / 2;
						let r = 0,
							g = 0,
							b = 0;

						if (0 <= hue && hue < 60) {
							r = c;
							g = x;
							b = 0;
						} else if (60 <= hue && hue < 120) {
							r = x;
							g = c;
							b = 0;
						} else if (120 <= hue && hue < 180) {
							r = 0;
							g = c;
							b = x;
						} else if (180 <= hue && hue < 240) {
							r = 0;
							g = x;
							b = c;
						} else if (240 <= hue && hue < 300) {
							r = x;
							g = 0;
							b = c;
						} else if (300 <= hue && hue < 360) {
							r = c;
							g = 0;
							b = x;
						}

						material.pbrMetallicRoughness.setBaseColorFactor([r + m, g + m, b + m, 1.0]);
					}
				} catch (e) {
					// Fail silently if material struct differs
				}
			}
			requestAnimationFrame(animateWiggle);
		}

		animateWiggle();

		viewer.addEventListener("camera-change", (e: any) => {
			if (e.detail.source === "user-interaction") {
				isInteracting = true;
				clearTimeout(interactionTimer);
				interactionTimer = setTimeout(() => {
					isInteracting = false;
					viewer.setAttribute("camera-orbit", baseOrbit);
				}, 2000);
			}
		});
	});
</script>
