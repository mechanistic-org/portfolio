---
import Layout from "@layouts/BaseLayout.astro";
import { YouTube } from "@astro-community/astro-embed-youtube";

const { entry, Content } = Astro.props;
const data = entry.data;

const paperColor = "#f3f0e6"; // Manila / Old Paper
const inkColor = "#2a2a2a"; // Typewriter ribbon
---

<Layout
	title={`CASE FILE: ${data.title}`}
	description="CONFIDENTIAL DOSSIER"
	image={data.heroImage ?? ""}
	type="project"
>
	<!-- BACKGROUND TEXTURE (Paper) -->
	<div class="fixed inset-0 z-[-1] bg-[#f3f0e6] bg-[url('/assets/paper-texture.png')]"></div>

	<div class="min-h-screen p-4 font-serif text-[#2a2a2a] md:p-12">
		<!-- FOLDER CONTAINER -->
		<main
			class="relative mx-auto max-w-4xl rotate-1 transform-gpu bg-white p-8 shadow-2xl transition-transform duration-500 hover:rotate-0 md:p-16"
		>
			<!-- PAPERCLIP -->
			<div
				class="absolute -top-4 left-12 z-50 h-24 w-8 rounded-full border-4 border-zinc-400 bg-transparent"
			>
			</div>

			<!-- STAMPS -->
			<div
				class="mask-stamp absolute top-12 right-12 rotate-12 border-4 border-red-700 px-4 py-2 text-2xl font-bold tracking-widest text-red-700 uppercase opacity-80"
			>
				CONFIDENTIAL
			</div>

			<!-- HEADER -->
			<header class="mb-12 border-b-2 border-black pb-4 font-mono">
				<div class="mb-4 flex justify-between text-xs tracking-widest uppercase opacity-60">
					<span>Form 524-B</span>
					<span>Bureau of Intelligence</span>
				</div>
				<h1
					class="font-typewriter text-4xl font-bold tracking-tighter uppercase underline decoration-red-700 decoration-double md:text-5xl"
				>
					Subject: {data.title}
				</h1>
			</header>

			<!-- PHOTO & METADATA -->
			<div class="mb-12 flex flex-col gap-8 md:flex-row">
				<!-- PHOTO: Paperclipped -->
				<div class="relative h-48 w-48 rotate-[-3deg] border-4 border-white bg-gray-200 shadow-md">
					<div
						class="absolute -top-4 right-1/2 z-20 h-12 w-4 -translate-x-1/2 transform rounded bg-zinc-300"
					>
					</div>
					{/* Tape? */}
					{
						data.heroImage ? (
							<img
								src={data.heroImage}
								class="h-full w-full object-cover contrast-125 grayscale sepia-[.3]"
							/>
						) : (
							<div class="flex h-full w-full items-center justify-center bg-zinc-800 font-mono text-xs text-white">
								NO PHOTO
							</div>
						)
					}
				</div>

				<!-- TYPED DATA -->
				<div class="flex-1 space-y-4 pt-4 font-mono text-sm">
					<div class="grid grid-cols-[120px_1fr] border-b border-dotted border-gray-400 pb-1">
						<span class="opacity-50">CODENAME:</span>
						<span class="font-bold">{data.slug.toUpperCase()}</span>
					</div>
					<div class="grid grid-cols-[120px_1fr] border-b border-dotted border-gray-400 pb-1">
						<span class="opacity-50">DATE:</span>
						<span>{data.date}</span>
					</div>
					<div class="grid grid-cols-[120px_1fr] border-b border-dotted border-gray-400 pb-1">
						<span class="opacity-50">ASSIGNMENT:</span>
						<span>{data.employer}</span>
					</div>
					<div class="grid grid-cols-[120px_1fr] border-b border-dotted border-gray-400 pb-1">
						<span class="opacity-50">CLEARANCE:</span>
						<span class="font-bold text-red-700">{data.statusLabel}</span>
					</div>
				</div>
			</div>

			<!-- BODY CONTENT -->
			<article
				class="prose prose-zinc prose-lg prose-headings:font-bold prose-headings:uppercase prose-headings:font-sans max-w-none font-mono text-[#2a2a2a]"
			>
				<!-- Redaction Style Injection -->
				<style>
					.prose strong {
						background-color: black;
						color: black;
						padding: 0 4px;
					}
					.prose strong:hover {
						color: white !important; /* Peek */
					}
					/* Typewriter effect for paragraphs */
					.prose p {
						font-family: "Courier New", Courier, monospace;
						font-weight: 500;
					}
				</style>

				<Content components={{ YouTube }} />
			</article>

			<!-- FOOTER STAMP -->
			<div
				class="mt-16 flex items-center justify-between border-t-2 border-black pt-8 font-mono text-xs opacity-60"
			>
				<div>
					ARCHIVED BY: AGENT NORRIS<br />
					DATE: {new Date().toLocaleDateString()}
				</div>
				<div
					class="flex h-16 w-16 rotate-[-15deg] items-center justify-center rounded-full border-4 border-black font-bold"
				>
					FILE
				</div>
			</div>
		</main>
	</div>
</Layout>
