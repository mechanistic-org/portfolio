---
/**
 * ProjectArticle v2 — the IMDb-title-page + Wikipedia-MoS flagship reader.
 *
 *   MediaHeader (poster · title · meta · chips · media strip)
 *   ── 3-column body ──────────────────────────────────────────
 *   LEFT  = forensic HUD (key facts · metrics · scars · BOM)   [hybrid: collapsible
 *           widget cards, tabs inside the large ones; scars live here]
 *   CENTER= the article (lead + sections) + cast
 *   RIGHT = contents · media · references
 *
 * Assembled entirely from the primitive library so 100+ pages share one taxonomy.
 * Fed by entry.data (today hand-authored mdx; tomorrow the canon generator).
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import MediaHeader from "@components/primitives/MediaHeader.astro";
import HudRail from "@components/primitives/HudRail.astro";
import Collapse from "@components/primitives/Collapse.astro";
import Infobox from "@components/primitives/Infobox.astro";
import HudMetrics from "@components/primitives/HudMetrics.astro";
import ScarTimeline from "@components/primitives/ScarTimeline.astro";
import ForensicSummary from "@components/primitives/ForensicSummary.astro";
import References from "@components/primitives/References.astro";
import ThemeControl from "@components/primitives/ThemeControl.astro";
import Cast from "@components/primitives/Cast.astro";
import Gallery from "@components/primitives/Gallery.astro";
import Toc from "@components/primitives/Toc.astro";
import Navbox from "@components/primitives/Navbox.astro";
import Hatnote from "@components/primitives/Hatnote.astro";
import ProjectContinuityRail from "@components/Projects/ProjectContinuityRail.astro";
import ProjectEvidenceBreakout from "@components/Projects/ProjectEvidenceBreakout.astro";
import ProjectModelEvidence from "@components/Projects/ProjectModelEvidence.astro";
import ProjectRailCoordinator from "@components/Projects/ProjectRailCoordinator.astro";
import ContextRibbon from "@components/primitives/ContextRibbon.astro";
import ChronoStrip from "@components/primitives/ChronoStrip.astro";
import EntropySeismograph from "@components/primitives/EntropySeismograph.astro";
import RevMatrix from "@components/primitives/RevMatrix.astro";
import type { RibbonModel } from "@utils/contextRibbon";
import { resolveProjectPresentation, type ProjectPresentation } from "@utils/projectPresentation";

interface Props {
	entry: { id: string; data: Record<string, any> };
	Content: any;
	headings?: { depth: number; slug: string; text: string }[];
	nextProject?: any;
	prevProject?: any;
	contextRibbon?: RibbonModel | null;
	presentation?: ProjectPresentation;
	chronology?: any;
	entropy?: any[];
	revisions?: any;
}
const {
	entry,
	Content,
	headings = [],
	nextProject,
	prevProject,
	contextRibbon = null,
	presentation,
	chronology = null,
	entropy = [],
	revisions = null,
} = Astro.props;
const d = entry.data;

const pretty = (s?: string) =>
	s
		? String(s)
				.replace(/_/g, " ")
				.replace(/\b\w/g, (c) => c.toUpperCase())
		: undefined;
const yr = (x: any) => {
	if (!x) return null;
	const date = new Date(x);
	// Normalize the trial's recorded years without changing non-trial presentations.
	return presentation ? date.getUTCFullYear() : date.getFullYear();
};
const period = ["room-director", "wall-plates", "webtv-galaxy", "webtv-cortez", "webtv-elmer", "320-slot-optical-carousel", "kplayer-6000", "kserver-1500", "kserver-5000", "m700", "dv700", "morpheus", "extension-switches"].includes(d.slug) && d.duration
	? d.duration
	: [yr(d.date), yr(d.endDate)].filter(Boolean).join("–") || d.duration;

// Recursively collect any { src, alt } images stashed in the legacy cyberspace data.
function collectImages(node: any, out: { src: string; alt?: string }[] = []) {
	if (!node) return out;
	if (Array.isArray(node)) {
		node.forEach((n) => collectImages(n, out));
		return out;
	}
	if (typeof node === "object") {
		if (Array.isArray(node.images)) {
			node.images.forEach((im: any) => im?.src && out.push({ src: im.src, alt: im.alt }));
		}
		Object.values(node).forEach((v) => collectImages(v, out));
	}
	return out;
}
const images = collectImages(d.cyberspace);
// KPLAYER-300's reviewed selection must be fully visible in its media rail.
const railImages = d.slug === "kplayer-300" ? images : images.slice(0, 6);

// Sectioned galleries (the forensic evidence) live under cyberspace.stickies.
const galleries = (d.cyberspace?.stickies || []).filter(
	(s: any) => s?.type === "gallery" && s?.data?.images?.length,
);

// Two-tier rendering — `tier` is the sole classification field.
// deep_dive = everything expanded + full galleries; lite = collapsed HUD, no gallery wall.
const isDeepDive = d.tier === "deep_dive";
const lite = !isDeepDive;
const resolved =
	presentation && !lite
		? resolveProjectPresentation(presentation, { ...d, title: d.title }, headings, galleries)
		: undefined;
const activeRailScenes = resolved?.scenes ?? [];
const useContinuityRails = !!resolved;

const meta = [
	pretty(d.employer),
	period,
	pretty(d.industry),
	d.teamSize ? `${d.teamSize} stakeholders` : undefined,
];

const facts: [string, unknown][] = (
	[
		["Role", pretty(d.job_title) || (d.slug === "portion-cup" ? undefined : "Mechanical / ID Lead")],
		["Employer", pretty(d.employer)],
		["Client", (d.client || []).map(pretty).join(", ")],
		["Period", period],
		["Team", d.teamSize],
		["Industry", pretty(d.industry)],
		["Production", [pretty(d.production), pretty(d.productionScale)].filter(Boolean).join(" · ")],
		["Tools", (d.tools || []).map(pretty).join(", ")],
	] as [string, unknown][]
).filter(([, v]) => v);

const scars = d.scars?.filter((s: any) => s && typeof s === "object") ?? [];
const bom = d.bom ?? [];

const references = [
	d.audio_url && { text: "Audio briefing (NotebookLM overview)", href: d.audio_url },
	d.nlm_url && { text: "NotebookLM source notebook", href: d.nlm_url },
	d.notebook_url && { text: "Project notebook", href: d.notebook_url },
].filter(Boolean) as { text: string; href?: string }[];

const navPrev = prevProject
	? { href: `/projects/${prevProject.id}`, title: prevProject.data?.title }
	: null;
const navNext = nextProject && !(d.slug === "extension-switches" && nextProject.id === "switches")
	? { href: `/projects/${nextProject.id}`, title: nextProject.data?.title }
	: null;
---

<BaseLayout type="project" title={d.title} description={d.description} image={d.heroImage}>
	<article
		data-project-article={entry.id}
		data-trial={resolved ? "" : undefined}
		class="mx-auto mt-24 mb-24 w-full max-w-[1680px] px-4 sm:px-6 lg:px-8"
	>
		<div class="mb-4 flex items-center justify-end">
			<ThemeControl />
		</div>

		<MediaHeader
			title={d.title}
			meta={meta}
			tags={d.tags || []}
			heroImage={d.heroImage}
			description={d.description}
			audioUrl={d.audio_url}
			photoCount={images.length || undefined}
			mediaCountLabel={["sundance", "sc48", "d-control", "d-command", "room-director", "wall-plates", "webtv-galaxy", "webtv-cortez", "webtv-elmer", "backsplash", "320-slot-optical-carousel", "kplayer-6000", "kserver-1500", "kserver-5000", "m700", "dv700", "morpheus", "extension-switches", "dispensers", "makeline", "portion-cup", "xbox", "fissler-bbq", "kplayer-300", "motorola-mp3", "avegant-glyph", "cinema-one"].includes(d.slug) ? "images" : undefined}
		/>

		{contextRibbon && <ContextRibbon model={contextRibbon} />}
		{chronology && <ChronoStrip chronology={chronology} />}
		{entropy.length > 0 && <EntropySeismograph events={entropy} />}
		{revisions && <RevMatrix revisions={revisions} />}

		<ProjectRailCoordinator enabled={useContinuityRails} anchors={resolved?.anchors}>
			<div class="lg:grid lg:grid-cols-[260px_minmax(0,1fr)_300px] lg:gap-8 xl:gap-12">
				{/* LEFT — forensic HUD */}
				{
					useContinuityRails ? (
						<ProjectContinuityRail
							side="left"
							mediaCountLabel={["sundance", "sc48", "d-control", "d-command", "room-director", "wall-plates", "webtv-galaxy", "webtv-cortez", "webtv-elmer", "backsplash", "320-slot-optical-carousel", "kplayer-6000", "kserver-1500", "kserver-5000", "m700", "dv700", "morpheus", "extension-switches", "dispensers", "makeline", "portion-cup", "xbox", "fissler-bbq", "kplayer-300", "motorola-mp3", "avegant-glyph", "cinema-one"].includes(d.slug) ? "images" : undefined}
							projectTitle={d.title}
							scenes={activeRailScenes}
							headings={headings}
							scars={scars}
							metrics={d.forensic_metrics || {}}
							bom={bom}
							facts={facts}
							galleries={galleries}
							references={references}
							audioUrl={d.audio_url}
						/>
					) : (
						<HudRail>
							<Collapse title="Key Facts" open={true}>
								<Infobox facts={facts} />
							</Collapse>
							<HudMetrics metrics={d.forensic_metrics || {}} open={!lite} />
							<ScarTimeline scars={scars} open={!lite} />
							{bom.length > 0 && (
								<Collapse title="Bill of Materials" count={bom.length} open={false}>
									<ul class="space-y-1.5">
										{bom.map((b: any) => (
											<li class="flex items-baseline justify-between gap-3 text-sm">
												<span class="text-muted-foreground">{b.label}</span>
												{b.value && (
													<span class="text-foreground font-mono text-xs">{b.value}</span>
												)}
											</li>
										))}
									</ul>
								</Collapse>
							)}
						</HudRail>
					)
				}

				{/* CENTER — the article */}
				<main class="min-w-0">
					{d.hatnote && <Hatnote>{d.hatnote}</Hatnote>}
					{d.forensic_summary && <ForensicSummary summary={d.forensic_summary} />}
					<div class="markdown-content max-w-3xl">
						<Content />
					</div>

					{
						/* LITE RECORD NOTE — rendered by the template, not typed into 53 files.
				    A lite page is a complete small thing, not a truncated large one, and
				    saying so converts thinness from "unfinished" into stated editorial
				    policy. It is also true: the archive holds far more than the page. */
					}
					{
						lite && (
							<p class="text-muted-foreground mt-12 max-w-3xl border-t border-white/10 pt-5 font-mono text-xs leading-relaxed">
								<span class="text-primary">Lite record.</span> This page carries what can be stated
								and sourced briefly. The program archive holds more — drawings, test data, and the
								decisions behind them — and is available on request.
							</p>
						)
					}
					{
						!lite && !useContinuityRails && galleries.length > 0 && (
							<section class="mt-16">
								<h2 class="h2 mb-6">Visual Evidence</h2>
								<div class="space-y-10">
									{galleries.map((g: any) => (
										<Gallery
											title={g.title}
											images={g.data.images}
											columns={g.data.columns}
											caption={g.caption}
										/>
									))}
								</div>
							</section>
						)
					}
					{
						d.cast && d.cast.length > 0 && (
							<section class="mt-16">
								<h2 class="h2 mb-6">Cast &amp; Credits</h2>
								<Cast cast={d.cast} />
							</section>
						)
					}
				</main>

				{/* RIGHT — contents · media · references */}
				{
					useContinuityRails && !["kplayer-300", "motorola-mp3", "avegant-glyph", "cinema-one"].includes(d.slug) ? (
						<ProjectContinuityRail
							side="right"
							projectTitle={d.title}
							scenes={activeRailScenes}
							headings={headings}
							scars={scars}
							metrics={d.forensic_metrics || {}}
							bom={bom}
							facts={facts}
							galleries={galleries}
							references={references}
							audioUrl={d.audio_url}
						/>
					) : (
						<aside class="mt-12 space-y-10 lg:mt-0">
							<div class="lg:sticky lg:top-24 lg:max-h-[calc(100vh-7rem)] lg:space-y-10 lg:overflow-y-auto">
								<Toc headings={headings} />

								{images.length > 0 && (
									<div>
										<div class="text-muted-foreground mb-3 font-mono text-[10px] font-bold tracking-widest uppercase">
											Media · {images.length}
										</div>
										<div class="grid grid-cols-2 gap-2">
											{railImages.map((im) => (
												<img
													src={im.src}
													alt={im.alt || ""}
													loading="lazy"
													class="border-border aspect-square w-full rounded border object-cover"
												/>
											))}
										</div>
									</div>
								)}

								{d.audio_url && (
									<div>
										<div class="text-muted-foreground mb-3 font-mono text-[10px] font-bold tracking-widest uppercase">
											Briefing
										</div>
										<audio controls preload="none" src={d.audio_url} class="w-full" />
									</div>
								)}

								<References references={references} />
							</div>
						</aside>
					)
				}
			</div>
		</ProjectRailCoordinator>
		{
			useContinuityRails && galleries.length > 0 && (
				<ProjectEvidenceBreakout
			fullSizeLinks={["backsplash", "320-slot-optical-carousel", "kplayer-6000", "kserver-1500", "kserver-5000", "m700", "dv700", "morpheus", "extension-switches", "dispensers", "makeline", "portion-cup", "xbox", "fissler-bbq", "kplayer-300", "motorola-mp3", "avegant-glyph", "cinema-one"].includes(d.slug)}
					galleries={resolved?.galleries ?? galleries}
					featured={resolved?.featured}
					breakout={resolved?.breakout}
				/>
			)
		}
		{resolved && resolved.models.length > 0 && <ProjectModelEvidence models={resolved.models} />}
		<p
			class="border-border text-muted-foreground mt-12 border-t pt-6 font-mono text-xs leading-relaxed"
		>
			This page is rendered from the canonical record for this project. The source and build system
			are documented in <a class="text-primary hover:underline" href="/colophon/en-os/"
				>the EN-OS colophon</a
			>.
		</p>
		<Navbox prev={navPrev} next={navNext} />
	</article>
</BaseLayout>

