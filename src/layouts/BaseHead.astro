---
import { ClientRouter } from "astro:transitions";

// component imports
import Seo from "@components/Seo/Seo.astro";

// data
import siteData from "@config/siteData.json";

export interface Props {
	type?: "general" | "project" | undefined;
	title: string;
	description: string;
	image?: ImageMetadata | string;
	projectFrontmatter?: any; // For projects
	noindex?: boolean;
}

const {
	type = "general",
	title,
	description,
	image,
	projectFrontmatter,
	noindex = false,
} = Astro.props as Props;

import JetBrainsMono from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2";
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" initial-scale="1.0" />

<script is:inline>
	// This code is inlined in the head to make it instant & blocking.
	const getThemePreference = () => {
		// FORCE DARK MODE (User Request 2026-01-16)
		// We ignore localStorage because we want to enforce the new "Forever Dark" policy.
		return "dark";
	};
	const isDark = getThemePreference() === "dark";
	document.documentElement.classList[isDark ? "add" : "remove"]("dark");

	if (typeof localStorage !== "undefined") {
		// Watch the document element and persist user preference when it changes.
		const observer = new MutationObserver(() => {
			const isDark = document.documentElement.classList.contains("dark");
			localStorage.setItem("theme", isDark ? "dark" : "light");
		});
		observer.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
	}
</script>

<!-- local font preload for better performance -->
<link rel="preload" href={JetBrainsMono} as="font" type="font/woff2" crossorigin="anonymous" />

<!-- Favicons (RealFaviconGenerator Standard) -->
<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta name="apple-mobile-web-app-title" content="Erik Norris" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="msapplication-TileColor" content="#2E5CFF" />
<meta name="theme-color" content="#2E5CFF" />

<!-- other -->
<meta name="generator" content={Astro.generator} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="text/plain" href="/llms.txt" title="Agentic Identity Matrix" />
<link
	rel="alternate"
	type="application/json"
	href="/api/projects.json"
	title="Machine-Readable Project Index"
/>

<Seo
	type={type}
	title={title}
	description={description}
	image={image}
	projectFrontmatter={projectFrontmatter}
	noindex={noindex}
/>

<!-- Google Fonts (canonical families loaded via src/styles/fonts.css @import) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

<!-- no fallback as I saw issues with firefox fallback -->
{siteData.useViewTransitions && <ClientRouter fallback="none" />}
