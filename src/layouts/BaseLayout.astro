---
// style import
import "@/styles/global.css";

import { type CollectionEntry } from "astro:content";
import { ClientRouter } from "astro:transitions";

// component imports
import BaseHead from "@layouts/BaseHead.astro";
import Nav from "@components/Nav/Nav.astro";
import Footer from "@components/Footer/Footer.astro";
import CommandMenu from "@components/Search/CommandMenu";

// import CookieConsent from "@components/CookieConsent/CookieConsent.astro";
// import CookieConsent from "@components/CookieConsent/CookieConsent.astro";
import CollimatedBackground from "@components/Effects/CollimatedBackground"; // NEW: Audit Rec #1

// data
import siteData from "@config/siteData.json";

interface Props {
	type?: "blog" | "general" | "project";
	title: string;
	description: string;
	image?: ImageMetadata | string;
	authorsData?: CollectionEntry<"authors">[];
	postFrontmatter?: CollectionEntry<"blog">["data"];
	projectFrontmatter?: any;
	entropy?: any;
	noindex?: boolean;
	hideNav?: boolean;
	overflowHidden?: boolean;
	starfield?: boolean; // NEW: Audit Rec #1
}

const {
	type = "general",
	title,
	description,
	image,
	authorsData,
	postFrontmatter,
	projectFrontmatter,
	entropy,
	noindex = false,
	hideNav = false,
	overflowHidden = false,
	starfield = false,
} = Astro.props as Props;
---

<!doctype html>
<html
	lang="en"
	class="dark"
	class:list={[
		{
			"overflow-hidden": overflowHidden,
		},
	]}
	transition:animate="fade"
>
	<BaseHead
		type={type}
		title={title}
		description={description}
		image={image}
		authors={authorsData}
		postFrontmatter={postFrontmatter}
		projectFrontmatter={projectFrontmatter}
		noindex={noindex}
	/>
	<body
		class:list={[
			"text-neutral-900 dark:text-neutral-200",
			{
				"use-animations": siteData.useAnimations === true ? true : false,
				"overflow-hidden": overflowHidden,
			},
		]}
	>
		{starfield && <CollimatedBackground client:load />}
		<div class="noise-overlay"></div>
		<div class="relative z-10 flex min-h-lvh flex-col justify-between">
			<div>
				{!hideNav && <Nav />}
				<main>
					<slot />
				</main>
			</div>
			{!overflowHidden && <Footer entropy={entropy} />}
		</div>
		<CommandMenu client:only="react" />

		<script>
			import siteData from "@config/siteData.json";
			import MOS from "motion-on-scroll";

			if (siteData.useAnimations === true) {
				MOS.init({
					once: true,
					duration: 0.75,
					distance: 15,
					timeUnits: "s",
					easing: "ease-out-cubic",
				});
				document.addEventListener("astro:after-swap", MOS.refreshHard);
			}
		</script>
	</body>
</html>
