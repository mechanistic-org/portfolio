---
// style import
import "@/styles/global.css";
import "@/styles/themes.css"; // The Trimain Theme Engine
// Trigger HMR Rebuild

// component imports
import BaseHead from "@layouts/BaseHead.astro";
import Nav from "@components/Nav/Nav.astro";
import Footer from "@components/Footer/Footer.astro";
import PagefindSearch from "@components/Search/PagefindSearch.astro";

// import CookieConsent from "@components/CookieConsent/CookieConsent.astro";
// import CookieConsent from "@components/CookieConsent/CookieConsent.astro";
// import CookieConsent from "@components/CookieConsent/CookieConsent.astro";
// import CollimatedBackground from "@components/Effects/CollimatedBackground"; // NEW: Audit Rec #1

// data
import siteData from "@config/siteData.json";
import { site } from "@config/site_config";

interface Props {
	type?: "general" | "project";
	title: string;
	description: string;
	image?: ImageMetadata | string;
	projectFrontmatter?: any;
	entropy?: any;
	noindex?: boolean;
	hideNav?: boolean;
	overflowHidden?: boolean;
	starfield?: boolean; // NEW: Audit Rec #1
	hideNavLogo?: boolean;
}

const {
	type = "general",
	title,
	description,
	image,
	projectFrontmatter,
	entropy,
	noindex = false,
	hideNav = false,
	overflowHidden = false,
	starfield = false,
	hideNavLogo = false,
} = Astro.props as Props;
---

<!doctype html>
<html
	lang="en"
	class="dark"
	class:list={[
		site.theme, // Inject The Suit / Lab / Garage Theme
		{
			"overflow-hidden": overflowHidden,
		},
	]}
	transition:animate="fade"
>
	<BaseHead
		type={type}
		title={title}
		description={description}
		image={image}
		projectFrontmatter={projectFrontmatter}
		noindex={noindex}
	/>
	<body
		class:list={[
			"text-neutral-900 dark:text-neutral-200",
			{
				"use-animations": siteData.useAnimations === true ? true : false,
				"overflow-hidden": overflowHidden,
			},
		]}
	>
		{/* {starfield && <CollimatedBackground client:only="react" />} */}
		<div class="noise-overlay"></div>
		<div class="relative z-10 flex min-h-lvh flex-col justify-between">
			<div>
				{!hideNav && <Nav hideLogo={hideNavLogo} />}
				<main data-pagefind-body>
					<slot />
				</main>
			</div>
			{!overflowHidden && <Footer entropy={entropy} />}
		</div>
		<PagefindSearch />

		<script>
			import siteData from "@config/siteData.json";
			import MOS from "motion-on-scroll";

			if (
				siteData.useAnimations === true &&
				!window.matchMedia("(prefers-reduced-motion: reduce)").matches
			) {
				MOS.init({
					once: true,
					duration: 0.75,
					distance: 15,
					timeUnits: "s",
					easing: "ease-out-cubic",
				});
				document.addEventListener("astro:after-swap", MOS.refreshHard);
			}
		</script>
	</body>
</html>
