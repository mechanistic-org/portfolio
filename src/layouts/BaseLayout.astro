---
// style import
import "@/styles/global.css";

import { type CollectionEntry } from "astro:content";
import { ClientRouter } from "astro:transitions";

// component imports
import BaseHead from "@layouts/BaseHead.astro";
import Nav from "@components/Nav/Nav.astro";
import Footer from "@components/Footer/Footer.astro";
import CommandMenu from "@components/Search/CommandMenu";
// import CookieConsent from "@components/CookieConsent/CookieConsent.astro";

// data
import siteData from "@config/siteData.json";

interface Props {
	type?: "blog" | "general";
	title: string;
	description: string;
	image?: ImageMetadata;
	authorsData?: CollectionEntry<"authors">[];
	postFrontmatter?: CollectionEntry<"blog">["data"];
	noindex?: boolean;
}

const {
	type = "general",
	title,
	description,
	image,
	authorsData,
	postFrontmatter,
	noindex = false,
} = Astro.props as Props;
---

<!doctype html>
<html lang="en" class="dark" transition:animate="fade">
	<head>
		<BaseHead
			type={type}
			title={title}
			description={description}
			image={image ? image : undefined}
			authors={authorsData ? authorsData : undefined}
			postFrontmatter={postFrontmatter ? postFrontmatter : undefined}
			noindex={noindex}
		/>
		<ClientRouter />
		<style>
			/* Matrix Curtain - Hidden by default */
			#matrix-curtain {
				display: none;
			}
			/* Shown only when the booting class is present */
			html.booting #matrix-curtain {
				display: block;
			}
		</style>
		<script is:inline>
			// Check session immediately to prevent FOUC
			if (!sessionStorage.getItem("quantum_booted")) {
				document.documentElement.classList.add("booting");
				// Safety valve: Remove curtain after 4s if React fails to load
				setTimeout(() => {
					document.documentElement.classList.remove("booting");
				}, 4000);
			}
		</script>
	</head>
	<body
		class:list={[
			"overflow-y-scroll bg-white text-neutral-900 dark:bg-neutral-950 dark:text-neutral-200",
			{
				"use-animations": siteData.useAnimations === true ? true : false,
			},
		]}
	>
		<!-- The Curtain -->
		<div id="matrix-curtain" class="fixed inset-0 z-[9999] bg-black"></div>

		<div class="flex min-h-lvh flex-col justify-between">
			<div>
				<Nav />
				<main>
					<slot />
				</main>
			</div>
			<Footer />
		</div>
		<CommandMenu client:only="react" />

		<script>
			import siteData from "@config/siteData.json";
			import MOS from "motion-on-scroll";

			if (siteData.useAnimations === true) {
				MOS.init({
					once: true,
					duration: 0.75,
					distance: 15,
					timeUnits: "s",
					easing: "ease-out-cubic",
				});
				document.addEventListener("astro:after-swap", MOS.refreshHard);
			}
		</script>
	</body>
</html>
