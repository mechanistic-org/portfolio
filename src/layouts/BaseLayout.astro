---
// style import
import "@/styles/global.css";

import { type CollectionEntry } from "astro:content";

// component imports
import BaseHead from "@layouts/BaseHead.astro";
import Nav from "@components/Nav/Nav.astro";
import Footer from "@components/Footer/Footer.astro";
// import CookieConsent from "@components/CookieConsent/CookieConsent.astro"; // Keeping commented as per your source

// data
import siteData from "@config/siteData.json";

interface Props {
	type?: "blog" | "general";
	title: string;
	description: string;
	image?: ImageMetadata;
	authorsData?: CollectionEntry<"authors">[];
	postFrontmatter?: CollectionEntry<"blog">["data"];
	noindex?: boolean;
}

const {
	type = "general",
	title,
	description,
	image,
	authorsData,
	postFrontmatter,
	noindex = false,
} = Astro.props as Props;
---

<!doctype html>
<html lang="en" transition:animate="fade" class="dark">
	<head>
		<BaseHead
			type={type}
			title={title}
			description={description}
			image={image ? image : undefined}
			authors={authorsData ? authorsData : undefined}
			postFrontmatter={postFrontmatter ? postFrontmatter : undefined}
			noindex={noindex}
		/>
	</head>
	<body
		class:list={[
			"dark overflow-y-scroll",
			{
				"use-animations": siteData.useAnimations === true ? true : false,
			},
		]}
	>


        <div class="w-full bg-yellow-500/10 border-b border-yellow-500/20 text-yellow-500 text-[10px] uppercase tracking-widest font-mono py-1 px-4 flex justify-center md:justify-between items-center z-50 relative">
            <span>⚠  System Status: V1.0 Beta / Ingestion Active</span>
            <span class="hidden md:inline opacity-75">Reference Design Only</span>
        </div>

		<div class="flex min-h-lvh flex-col justify-between">
			<div>
				<Nav />
				<main>
					<slot />
				</main>
			</div>
			<Footer />
		</div>

		<script>
			import siteData from "@config/siteData.json";
            import MOS from "motion-on-scroll";

			if (siteData.useAnimations === true) {
				// runs on initial page load
				MOS.init({
					once: true,
					duration: 0.75,
					distance: 15,
					timeUnits: "s",
					easing: "ease-out-cubic",
				});
                // runs on view transitions navigation
				document.addEventListener("astro:after-swap", MOS.refreshHard);
			}
		</script>
	</body>
</html>