  "timeline": [
    {
      "date": "2012-02-01",
      "description": "Design firms (Astro Studios, NewDealDesign, Smart Design, etc.) submit proposals for 'MacDuff' (Cinema One) with a target price of $1500-$2500 and 20k annual volume.",
      "title": "MacDuff Program Kickoff Proposals"
    },
    {
      "date": "2012-09-13",
      "description": "Whipsaw presents Phase 2 Industrial Design updates for Kaleidescape Macduff, refining concepts like 'Grid', 'Rake', 'Fractal', 'Bow', 'Arch', 'Slice', 'Tile', and 'Crease'.",
      "title": "Phase 2 ID Updates"
    },
    {
      "date": "2012-12-18",
      "description": "Erik Norris coordinates with Vowin Prototype regarding the status of parts for the upcoming CES show, expressing concern about timing.",
      "title": "CES Prototype Coordination"
    },
    {
      "date": "2013-07-23",
      "description": "Cinema One (Model K0503-0100), codenamed Macduff, is officially launched.",
      "title": "Product Launch"
    },
    {
      "date": "2014-03-27",
      "description": "Erik Norris is notified that Cinema One won a Red Dot Award; plans for a press release and blog post by Mark Henninger (AVS Forum) are discussed.",
      "title": "Red Dot Award Notification"
    },
    {
      "date": "2014-04-01",
      "description": "Erik Norris coordinates the release of 'beefed-up' HDD bracket (REV 6) and new cover prototypes to resolve hard drive screw interference issues.",
      "title": "Sheetmetal Revision (HDD Bracket)"
    },
    {
      "date": "2014-04-29",
      "description": "Erik Norris requests a purchase order for quick-turn prototype springs (330-1050-03) from Scandic to support ongoing development.",
      "title": "Spring Prototype Procurement"
    },
    {
      "date": "2014-05-02",
      "description": "Erik Norris presents preliminary concepts for a '1U Macduff' variant, discussing slot placement and dimensions with the hardware team.",
      "title": "1U Macduff Concept Review"
    },
    {
      "date": "2014-05-20",
      "description": "Erik Norris loads Macduff files into Arena for production release, confirming they are ready for the MacDuff BOM update.",
      "title": "Production File Release"
    },
    {
      "date": "2014-05-27",
      "description": "Erik Norris works with vendors (Roger Lee, Grat Wu) to obtain cover assembly quotes for the Macduff chassis.",
      "title": "Cover Assembly Quote"
    },
    {
      "date": "2014-06-17",
      "description": "Erik Norris releases updated mechanical assembly instructions and modifies the disc slot design to prevent 'edge-catch' issues.",
      "title": "Disc Slot Modification"
    },
    {
      "date": "2014-07-10",
      "description": "Erik Norris releases the 'Cosmetic and Graphic Spec Rev 3' (CMF) document for Macduff.",
      "title": "CMF Document Release"
    },
    {
      "date": "2014-10-09",
      "description": "Erik Norris defines and agrees upon a detailed inspection plan for Top Covers (502-1192-00) to address cosmetic yield issues causing a production line-down.",
      "title": "Top Cover Inspection Protocol"
    },
    {
      "date": "2014-10-13",
      "description": "Erik Norris circulates specific visual inspection criteria to Supply Chain and Manufacturing teams to manage the top cover quality crisis.",
      "title": "Detailed Inspection Criteria Release"
    },
    {
      "date": "2014-10-16",
      "description": "Erik Norris investigates 'ESCALATION-705' regarding recurring disc ejection problems, analyzing photos and samples to determine root cause.",
      "title": "Disc Ejection Escalation"
    },
    {
      "date": "2014-11-05",
      "description": "Erik Norris prepares the 'Macduff plastic RFQ' for release.",
      "title": "Plastic RFQ Preparation"
    },
    {
      "date": "2014-12-16",
      "description": "Erik Norris is cc'd on critical stock status updates from Yomura regarding cosmetic concessions for Macduff top covers to solve the line-down problem.",
      "title": "Vendor Concession Management"
    },
    {
      "date": "2015-02-20",
      "description": "Erik Norris circulates a modified version of the chassis (520-1213-00) and requests a meeting to discuss changes.",
      "title": "Chassis Modification Proposal"
    }
  ],
  "scars": [
    {
      "description": "Issued pragmatic deviation allowing cosmetic flow marks &lt;25mm to unblock shipping while protecting the 100% failure lots.",
      "label": "The 'Tactical' Deviation",
      "value": "25x20mm Limit"
    },
    {
      "description": "Diagnosed a 'Software Fatal Error' on the Gennum VXP chip as physical interference: the drive cage was shearing off Resistor R332.",
      "label": "The Gennum Crash Loop",
      "value": "R332 Resistor"
    }
  ],
