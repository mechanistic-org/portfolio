  "isomorphics": [
    {
      "hardware_point": "A 'Line Down' crisis was triggered when production halted because top covers were rejected for cosmetic flow marks on the underside of the chassis. Implemented the 'Ugly Bottom' strategy, forensically reclassifying the non-visible bottom surfaces from Class A to Class C to immediately recover 60-70% of the inventory and save the production run.",
      "label": "Yield Rate",
      "principle": "Never halt a functional core engine for a non-visible cosmetic defect.",
      "software_point": "Build Success Rate / Uptime — In software CI/CD pipelines, do not let non-critical warnings (Class C aesthetic bugs) block deployment of a functionally sound backend (Class A). Implement graceful degradation to maintain uptime."
    }
  ],
