---
import Layout from "@layouts/OuroborosLayout.astro";
import ConstellationEngine from "@components/Constellation/ConstellationEngine";
import sitemapData from "../data/sitemap.json";

// Filter for WORK nodes and the central anchor
const workNodes = sitemapData.nodes.filter((n) => n.category === "WORK" || n.id === "realm-work");

// Re-map realm-work to be the ROOT for this specific view
const filteredData = {
	nodes: workNodes.map((n) => {
		if (n.id === "realm-work") {
			return { ...n, category: "CORE", name: "WORK SECTOR" };
		}
		return n;
	}),
};
---

<Layout title="Work Constellation | Ouroboros">
	<main class="relative h-screen w-full overflow-hidden bg-black">
		<ConstellationEngine client:only="react" data={filteredData} />

		<div class="pointer-events-none absolute top-8 left-8 z-10">
			<h1 class="font-mono text-2xl tracking-widest text-white opacity-50">SECTOR_VIEW // WORK</h1>
			<p class="mt-2 font-mono text-xs text-[#00C2FF] uppercase">
				Deep field exploration of project outputs
			</p>
		</div>

		<nav class="absolute right-8 bottom-8 z-10">
			<a
				href="/"
				class="border border-white/10 bg-black/40 px-4 py-2 font-mono text-xs text-white/30 backdrop-blur-md transition-colors hover:text-white"
			>
				RETURN TO HUB
			</a>
		</nav>
	</main>
</Layout>
