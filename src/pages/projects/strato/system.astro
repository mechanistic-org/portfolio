---
import Layout from "@layouts/OuroborosLayout.astro";
import ConstellationEngine from "@components/Constellation/ConstellationEngine";
import stratoData from "../../../data/strato-system.json";
---

<Layout title="Strato System | Ouroboros">
	<main class="relative h-screen w-full overflow-hidden bg-black">
		<ConstellationEngine client:only="react" data={stratoData} />

		<div class="pointer-events-none absolute top-8 left-8 z-10">
			<h1 class="font-mono text-2xl tracking-widest text-[#04e32f] opacity-80">
				PROJECT_SYSTEM // STRATO
			</h1>
			<p class="mt-2 font-mono text-xs text-white/40 uppercase">
				Hierarchical Case Study Constellation
			</p>
		</div>

		<nav class="absolute right-8 bottom-8 z-10 flex gap-4">
			<a
				href="/work-constellation"
				class="border border-white/10 bg-black/40 px-4 py-2 font-mono text-xs text-white/30 backdrop-blur-md transition-colors hover:text-white"
			>
				BACK TO WORK SECTOR
			</a>
			<a
				href="/"
				class="border border-white/10 bg-black/40 px-4 py-2 font-mono text-xs text-white/30 backdrop-blur-md transition-colors hover:text-white"
			>
				SITE HUB
			</a>
		</nav>

		<div class="absolute bottom-8 left-8 z-10 max-w-sm">
			<div class="border-l-2 border-[#04e32f] pl-4">
				<p class="font-mono text-xs leading-relaxed text-white/60">
					Strato is not just a project; it's a modular ecosystem. Explore the sub-modules to
					understand the technical synergy.
				</p>
			</div>
		</div>
	</main>
</Layout>
