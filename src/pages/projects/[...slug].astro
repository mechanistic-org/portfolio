---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { getMultiverseData } from "@/utils/getMultiverseData";
import fs from "node:fs";
import path from "node:path";
import { currentSite } from "@config/site_config";

export const prerender = true;

// THEME REGISTRY
// import DataSheet from "@layouts/themes/DataSheet.astro"; // DELETED
import Hyperspace from "@layouts/themes/Hyperspace.astro";
// 1. Generate a new path for every collection entry
// import RetroConsole from "@layouts/themes/RetroConsole.astro";

// 1. Generate a new path for every collection entry
export async function getStaticPaths() {
	const allProjects = await getCollection("projects");
	const projects = allProjects.filter((p) => {
		const targets = p.data.targets || ["main"];
		return targets.includes(currentSite);
	});

	const multiverseData = await getMultiverseData();

	const paths: any[] = projects.map((entry) => ({
		params: { slug: entry.id },
		props: { entry, placeholderData: null },
	}));

	// Auto-generate placeholders for missing Graph Nodes
	// Fuel Filter: Only generate placeholders for "The Suit" (main)
	if (currentSite === "main") {
		const existingIds = new Set(projects.map((p) => p.id));
		multiverseData.nodes.forEach((node: any) => {
			if (
				node.id &&
				!existingIds.has(node.id) &&
				node.category !== "CORE" &&
				node.category !== "REALM"
			) {
				paths.push({
					params: { slug: node.id },
					props: { entry: null, placeholderData: node },
				});
			}
		});
	}

	return paths;
}

// 2. For your template, you can get the entry directly from the prop
interface Props {
	entry: CollectionEntry<"projects"> | null;
	placeholderData: any;
}

const { entry, placeholderData } = Astro.props;
let Content: any = () => null;
let headings: any[] = [];
let data: any;

if (entry) {
	const rendered = await render(entry);
	Content = rendered.Content;
	headings = rendered.headings;
	data = entry.data;
} else if (placeholderData) {
	// Construct simulated entry data from JSON
	// Ensure we have a valid date object
	const year = placeholderData.year || new Date().getFullYear();
	data = {
		title: placeholderData.name,
		description: "Archived Record // Pending Digitization",
		date: new Date(year, 0, 1),
		heroImage: placeholderData.img,
		theme: "hyperspace", // UPGRADED TO SCROLLY
		slug: placeholderData.id.toLowerCase().replace(/ /g, "-"),
		tags: [placeholderData.group || "Archive", placeholderData.category || "Project"],
		draft: false,
		listed: true,
		// Generic Scrolly Structure
		cyberspace: {
			enable: true,
			stickies: [
				{
					id: "intro",
					title: placeholderData.name,
					text: `<strong>YEAR:</strong> ${year}<br/><strong>ROLE:</strong> ${placeholderData.category || "Contributor"}`,
					align: "center",
					type: "media",
					data: {
						src: placeholderData.img,
					},
				},
				{
					id: "details",
					title: "PROJECT DATA",
					text: `This project is currently archived. Full restoration pending.<br/><br/><strong>Group:</strong> ${placeholderData.group || "N/A"}`,
					align: "center",
					type: "void", // Just text
				},
			],
		},
	};
}

// Get all projects for navigation
const allProjects = await getCollection("projects");

// Sort by date descending (newest first)
const sortedProjects = allProjects.sort(
	(a, b) =>
		new Date(b.data.date || new Date()).getTime() - new Date(a.data.date || new Date()).getTime(),
);

// Navigation (Only works for real projects, placeholders get no nav for now)
const currentIndex = sortedProjects.findIndex((p) => p.id === entry?.id);
const nextProject = currentIndex > 0 ? sortedProjects[currentIndex - 1] : null;
const prevProject =
	currentIndex > -1 && currentIndex < sortedProjects.length - 1
		? sortedProjects[currentIndex + 1]
		: null;

// === ROUTER LOGIC ===
let theme = "hyperspace"; // Default fallback (Was DataSheet)

// Check for explicit theme override
if (data.theme) {
	theme = data.theme.toLowerCase();
}
// Check for legacy "cyberspace" flag
else if (data.cyberspace?.enable) {
	theme = "hyperspace";
}
// GLOBAL OVERRIDE: If no theme is set, upgrade to Hyperspace (Generic)
else {
	theme = "hyperspace";
}

// Map string to Component
const ThemeComponents: Record<string, any> = {
	datasheet: Hyperspace, // Re-route legacy datasheet to Hyperspace
	hyperspace: Hyperspace,
	command: Hyperspace, // Archived -> Hyperspace
	redacted: Hyperspace, // Archived -> Hyperspace
	"redacted-terminal": Hyperspace, // Archived -> Hyperspace
	"redacted-dossier": Hyperspace, // Archived -> Hyperspace
	redacteddossier: Hyperspace, // Archived -> Hyperspace
};

// Select Component (with fallback)
const SelectedTheme = ThemeComponents[theme] || Hyperspace;

// Construct valid entry for both real and placeholder
// We clone data to avoid mutating the readonly content collection object if needed
const finalEntry = entry
	? { ...entry, data: data }
	: {
			id: placeholderData.id,
			collection: "projects",
			data: data,
		};

// === INTELLIGENCE INJECTION (Entropy) ===
let entropyData = [];
// Only check for entropy on real projects (not placeholders)
if (entry) {
	try {
		// Construct path relative to project root
		// Assuming structure: src/content/projects/[id]/_entropy.json
		const entropyPath = path.join(
			process.cwd(),
			"src",
			"content",
			"projects",
			entry.id,
			"_entropy.json",
		);
		if (fs.existsSync(entropyPath)) {
			const fileContent = fs.readFileSync(entropyPath, "utf-8");
			entropyData = JSON.parse(fileContent);
			console.log(
				`[INTELLIGENCE] Loaded entropy data for ${entry.id}: ${entropyData.length} events`,
			);
		}
	} catch (e) {
		console.warn(`[INTELLIGENCE] Failed to load entropy for ${entry.id}`, e);
	}
}

// INJECT GENERIC SCROLLY STRUCTURE IF MISSING (For Legacy MDX upgrades)
if (
	theme === "hyperspace" &&
	(!finalEntry.data.cyberspace || !finalEntry.data.cyberspace.stickies)
) {
	const year = finalEntry.data.date ? new Date(finalEntry.data.date).getFullYear() : "N/A";
	finalEntry.data.cyberspace = {
		enable: true,
		stickies: [
			{
				id: "intro",
				title: finalEntry.data.title,
				text: `<strong>YEAR:</strong> ${year}<br/><strong>ROLE:</strong> ${finalEntry.data.employer || "Contributor"}`,
				align: "center",
				type: "media",
				data: {
					src: finalEntry.data.heroImage,
				},
			},
			{
				id: "details",
				title: "PROJECT DATA",
				text: `This record has been upgraded to the Hyperspace Protocol.<br/><br/><strong>Group:</strong> ${finalEntry.data.industry || "N/A"}`,
				align: "center",
				type: "void",
			},
		],
	};
}

console.log(`[ROUTER] Project: ${finalEntry.id} -> Theme: ${theme}`);
---

<SelectedTheme
	entry={finalEntry}
	nextProject={nextProject}
	prevProject={prevProject}
	Content={Content}
	headings={headings}
	metrics={finalEntry.data.metrics}
	entropy={entropyData}
/>
