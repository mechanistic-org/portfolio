---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Layout from "@layouts/BaseLayout.astro";
import Button from "@components/Button/Button.astro";
import ProjectGallery from "@components/Projects/ProjectGallery";
import UnifiedDashboard from "@components/Dashboard/UnifiedDashboard";
import { YouTube } from "@astro-community/astro-embed-youtube";
import ModelViewer from "@components/MDX/ModelViewer.astro";
import ProjectTOC from "@components/Projects/ProjectTOC.astro";
import ScrambleText from "@components/Effects/ScrambleText";
import Chip from "@components/DLS/Chip.astro";
import Wire from "@components/DLS/Wire.astro";
import ProjectHeader from "@components/Projects/ProjectHeader.astro";

// 1. Generate a new path for every collection entry
export async function getStaticPaths() {
	const projects = await getCollection("projects");
	return projects.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

// 2. For your template, you can get the entry directly from the prop
interface Props {
	entry: CollectionEntry<"projects">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const data = entry.data as any;

// Format dates
const dateVal = data.date || new Date();
const startDate = new Date(dateVal);
const dateDisplay = startDate.toLocaleDateString("en-US", { month: "short", year: "numeric" });

// Get all projects for navigation
const allProjects = await getCollection("projects");
// Sort by date descending (newest first)
const sortedProjects = allProjects.sort(
	(a, b) =>
		new Date(b.data.date || new Date()).getTime() - new Date(a.data.date || new Date()).getTime(),
);

const currentIndex = sortedProjects.findIndex((p) => p.id === entry.id);
const nextProject = currentIndex > 0 ? sortedProjects[currentIndex - 1] : null; // Newer project
const prevProject =
	currentIndex < sortedProjects.length - 1 ? sortedProjects[currentIndex + 1] : null; // Older project

// Parse lists
const clients = data.client || [];
const tools = data.tools || [];
const documents = data.documents || [];
const links = data.links || [];
const gallery = data.gallery || [];
---

<Layout
	title={data.title}
	description={data.description ?? ""}
	image={data.heroImage ?? ""}
	type="project"
>
	<ProjectHeader entry={entry} nextProject={nextProject} prevProject={prevProject} />

	<div class="site-container grid gap-8 py-8 md:grid-cols-12 md:py-12">
		<aside
			class="order-2 space-y-8 md:sticky md:top-24 md:order-1 md:col-span-4 md:h-fit lg:col-span-3"
		>
			<div
				class="rounded-xl border border-neutral-200 bg-white/50 p-6 dark:border-neutral-800 dark:bg-neutral-900/50"
			>
				<h3
					class="mb-4 border-b border-neutral-200 pb-2 text-sm font-bold tracking-wider text-neutral-900 uppercase dark:border-neutral-800 dark:text-white"
				>
					Project Data
				</h3>
				<dl class="space-y-4 text-sm">
					<div>
						<dt class="mb-1 text-neutral-500">Role</dt><dd
							class="font-medium text-neutral-900 dark:text-white"
						>
							{data.employer}
						</dd>
					</div>
					<div>
						<dt class="mb-1 text-neutral-500">Started</dt><dd class="font-medium text-white">
							{dateDisplay}
						</dd>
					</div>
					<div>
						<dt class="mb-1 text-neutral-500">Duration</dt><dd class="font-medium text-white">
							{data.duration}
						</dd>
					</div>
					{
						clients.length > 0 && (
							<div>
								<>
									<dt class="mb-1 text-neutral-500">Client / Partner</dt>
									<dd class="font-medium text-neutral-900 dark:text-white">{clients.join(", ")}</dd>
								</>
							</div>
						)
					}
					<div>
						<dt class="mb-1 text-neutral-500">Status</dt>
						<dd
							class="bg-primary/10 text-primary border-primary/20 inline-flex items-center gap-2 rounded border px-2 py-1 text-xs font-bold"
						>
							{data.statusLabel}
						</dd>
					</div>
				</dl>
			</div>

			{
				data.additionalSkills && data.additionalSkills.length > 0 && (
					<div class="border-t border-neutral-200 pt-4 dark:border-neutral-800">
						<h3 class="mb-3 text-xs font-bold tracking-wider text-neutral-500 uppercase">
							Core Competencies
						</h3>
						<div class="flex flex-wrap gap-2">
							{data.additionalSkills.map((s) => (
								<span class="border-primary/20 bg-primary/5 text-primary-400 hover:bg-primary/10 hover:text-primary-300 cursor-default rounded border px-2 py-1 text-xs transition-colors">
									{s}
								</span>
							))}
						</div>
					</div>
				)
			}

			{/* DOWNLOADS & LINKS */}
			{
				(documents.length > 0 || links.length > 0) && (
					<div class="border-t border-neutral-800 pt-4">
						<h3 class="mb-3 text-xs font-bold tracking-wider text-neutral-500 uppercase">
							Resources
						</h3>
						<ul class="space-y-2 text-sm">
							{documents.map((doc) => (
								<li>
									<a
										href={doc.url}
										target="_blank"
										class="group flex items-center gap-2 text-neutral-400 transition-colors hover:text-white"
									>
										<span class="group-hover:bg-primary/20 rounded bg-neutral-800 p-1 text-neutral-500 transition-colors group-hover:text-white">
											<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
												<path
													stroke-linecap="round"
													stroke-linejoin="round"
													stroke-width="2"
													d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
												/>
											</svg>
										</span>
										<span class="group-hover:decoration-primary/50 underline decoration-neutral-700 underline-offset-4">
											{doc.name}
										</span>
									</a>
								</li>
							))}
							{links.map((link) => (
								<li>
									<a
										href={link.url}
										target="_blank"
										class="group flex items-center gap-2 text-neutral-400 transition-colors hover:text-white"
									>
										<span class="group-hover:bg-primary/20 rounded bg-neutral-800 p-1 text-neutral-500 transition-colors group-hover:text-white">
											<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
												<path
													stroke-linecap="round"
													stroke-linejoin="round"
													stroke-width="2"
													d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
												/>
											</svg>
										</span>
										<span class="group-hover:decoration-primary/50 underline decoration-neutral-700 underline-offset-4">
											{link.name}
										</span>
									</a>
								</li>
							))}
						</ul>
					</div>
				)
			}

			<ProjectTOC headings={headings} />
		</aside>

		<article class="order-1 space-y-12 md:order-2 md:col-span-8 lg:col-span-9">
			<div
				class="overflow-hidden rounded-xl border border-neutral-200 bg-white shadow-2xl dark:border-neutral-800 dark:bg-neutral-900"
			>
				<img
					src={data.heroImage}
					alt={data.title}
					class="h-auto max-h-[600px] w-full object-cover"
				/>
			</div>

			{/* Unified Dashboard (Mini View) */}
			{
				(data.skillData || data.phase_stats) && (
					<div class="mb-12">
						<UnifiedDashboard
							client:visible
							variant="mini"
							data={data as any}
							projectId={entry.id}
						/>
					</div>
				)
			}
			<div
				class="prose prose-neutral dark:prose-invert prose-lg prose-headings:font-sans prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-neutral-900 dark:prose-headings:text-white prose-p:text-neutral-700 dark:prose-p:text-neutral-300 prose-a:text-primary prose-img:rounded-xl custom-prose max-w-none font-mono"
			>
				<Content components={{ YouTube, ModelViewer }} />
			</div>

			{
				gallery.length > 0 && (
					<div class="mt-16 border-t border-neutral-200 pt-12 dark:border-neutral-800">
						<h3 class="mb-8 text-2xl font-bold text-neutral-900 dark:text-white">
							Project Gallery
						</h3>
						<ProjectGallery client:visible images={gallery} />
					</div>
				)
			}
		</article>
	</div>
</Layout>

<style is:global>
	@reference "../../styles/global.css";

	/* Custom Prose Overrides */
	.custom-prose blockquote {
		font-style: normal;
		font-weight: 400;
		color: var(--color-neutral-300);
		border-left-width: 2px;
		border-left-color: var(--color-primary-500);
		background-color: color-mix(in srgb, var(--primary) 5%, transparent);
		padding: 1rem 1.5rem;
		border-radius: 0; /* Brutalist: No rounded corners */
		quotes: none;
		margin-top: 2rem;
		margin-bottom: 2rem;
	}

	.custom-prose blockquote p:first-of-type::before {
		content: none;
	}

	.custom-prose blockquote p:last-of-type::after {
		content: none;
	}

	.custom-prose h2 {
		@apply text-2xl;
		color: var(--primary);
		border-bottom: 1px solid var(--border);
		padding-bottom: 0.5rem;
		margin-top: 4rem; /* More breathing room */
		margin-bottom: 1.5rem;
		position: relative;
		padding-left: 1.5rem;
	}

	@media (min-width: 768px) {
		.custom-prose h2 {
			@apply text-3xl;
		}
	}

	.custom-prose h2::before {
		content: "";
		position: absolute;
		left: 0;
		top: 50%;
		transform: translateY(-50%);
		width: 0.5rem;
		height: 0.5rem;
		background-color: var(--primary);
		border-radius: 9999px;
		z-index: 10;
	}

	.custom-prose h2::after {
		content: "";
		position: absolute;
		left: 0;
		top: 50%;
		transform: translateY(-50%);
		width: 0.5rem;
		height: 0.5rem;
		background-color: var(--primary);
		border-radius: 9999px;
		animation: ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;
		z-index: 1;
	}

	@keyframes ping {
		75%,
		100% {
			transform: translateY(-50%) scale(2.5);
			opacity: 0;
		}
	}

	.custom-prose h3 {
		@apply text-2xl;
		color: var(--primary);
		margin-top: 2.5rem;
		margin-bottom: 1rem;
		border-bottom: 1px solid var(--border);
		padding-bottom: 0.5rem;
	}

	@media (min-width: 768px) {
		.custom-prose h3 {
			@apply text-3xl;
		}
	}

	.custom-prose strong {
		color: white;
		font-weight: 700;
	}

	.custom-prose a {
		color: var(--primary);
		text-decoration: none;
		border-bottom: 1px solid transparent;
		transition: border-color 0.2s;
	}

	.custom-prose a:hover {
		border-bottom-color: var(--primary);
	}

	/* Brutalist List Styling */
	.custom-prose ul {
		list-style-type: disc;
		padding-left: 1.5rem;
		margin-top: 1rem;
		margin-bottom: 1rem;
	}

	.custom-prose ul > li {
		margin-bottom: 0.5rem;
		padding-left: 0.25rem;
	}

	.custom-prose ul > li::marker {
		color: var(--color-neutral-600);
	}

	.custom-prose ol {
		list-style-type: decimal;
		padding-left: 1.5rem;
		margin-top: 1rem;
		margin-bottom: 1rem;
	}

	.custom-prose ol > li {
		margin-bottom: 0.5rem;
		padding-left: 0.25rem;
	}

	.custom-prose ol > li::marker {
		color: var(--color-neutral-600);
	}
</style>
