---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Layout from "@layouts/BaseLayout.astro";
import Button from "@components/Button/Button.astro";
import ProjectGallery from "@components/Projects/ProjectGallery";
import { YouTube } from "@astro-community/astro-embed-youtube";
import ModelViewer from "@components/mdx/ModelViewer.astro";

// 1. Generate a new path for every collection entry
export async function getStaticPaths() {
	const projects = await getCollection("projects");
	// console.log("Generated paths:", projects.map(p => p.id));
	return projects.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

// 2. For your template, you can get the entry directly from the prop
interface Props {
	entry: CollectionEntry<"projects">;
}

const { entry } = Astro.props;
// console.log("Entry keys:", Object.keys(entry));
const { Content } = await render(entry);
const data = entry.data;

// Format dates
const dateVal = data.date || new Date();
const startDate = new Date(dateVal);
const dateDisplay = startDate.toLocaleDateString("en-US", { month: "short", year: "numeric" });

// Get all projects for navigation
const allProjects = await getCollection("projects");
// Sort by date descending (newest first)
const sortedProjects = allProjects.sort(
	(a, b) =>
		new Date(b.data.date || new Date()).getTime() - new Date(a.data.date || new Date()).getTime(),
);

const currentIndex = sortedProjects.findIndex((p) => p.id === entry.id);
const nextProject = currentIndex > 0 ? sortedProjects[currentIndex - 1] : null; // Newer project
const prevProject =
	currentIndex < sortedProjects.length - 1 ? sortedProjects[currentIndex + 1] : null; // Older project

// Parse lists
const clients = data.client || [];
const tools = data.tools || [];
const documents = data.documents || [];
const links = data.links || [];
const gallery = data.gallery || [];
---

<Layout title={data.title} description={data.description ?? ""} image={data.heroImage ?? ""}>
	<section class="relative bg-transparent py-12 md:py-24">
		<div class="site-container">
			<div class="mb-6 flex items-center justify-between">
				<a
					href="/projects"
					class="group flex items-center gap-2 text-sm font-medium text-neutral-500 transition-colors hover:text-white"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="h-4 w-4 transition-transform group-hover:-translate-x-1"
					>
						<path d="m15 18-6-6 6-6"></path>
					</svg>
					Back to Projects
				</a>
				<div
					class="text-primary flex items-center gap-3 font-mono text-sm tracking-widest uppercase"
				>
					<span>{data.industry || "Engineering"}</span>
					<span>/</span>
					<span>{data.category || "Project"}</span>
				</div>
			</div>
			<div class="max-w-4xl">
				<h1 class="mb-6 text-4xl font-bold text-white md:text-6xl">{data.title}</h1>
			</div>
		</div>
	</section>

	<div class="site-container grid gap-12 py-12 md:grid-cols-12 md:py-24">
		<aside class="order-2 space-y-8 md:order-1 md:col-span-4 lg:col-span-3">
			<div class="mb-6 flex items-center justify-between pb-4">
				<div class="flex items-center gap-1">
					{
						prevProject ? (
							<a
								href={`/projects/${prevProject.id}`}
								class="group flex h-8 w-8 items-center justify-center rounded-md text-neutral-500 transition-colors hover:bg-neutral-900 hover:text-white"
								title={`Previous: ${prevProject.data.title}`}
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="h-4 w-4"
								>
									<path d="m15 18-6-6 6-6" />
								</svg>
							</a>
						) : (
							<div class="flex h-8 w-8 items-center justify-center text-neutral-800">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="h-4 w-4"
								>
									<path d="m15 18-6-6 6-6" />
								</svg>
							</div>
						)
					}

					<span class="font-mono text-xs text-neutral-600">NAVIGATE</span>

					{
						nextProject ? (
							<a
								href={`/projects/${nextProject.id}`}
								class="group flex h-8 w-8 items-center justify-center rounded-md text-neutral-500 transition-colors hover:bg-neutral-900 hover:text-white"
								title={`Next: ${nextProject.data.title}`}
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="h-4 w-4"
								>
									<path d="m9 18 6-6-6-6" />
								</svg>
							</a>
						) : (
							<div class="flex h-8 w-8 items-center justify-center text-neutral-800">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="h-4 w-4"
								>
									<path d="m9 18 6-6-6-6" />
								</svg>
							</div>
						)
					}
				</div>
			</div>

			<div class="rounded-xl border border-neutral-800 bg-neutral-900/50 p-6">
				<h3
					class="mb-4 border-b border-neutral-800 pb-2 text-sm font-bold tracking-wider text-white uppercase"
				>
					Project Data
				</h3>
				<dl class="space-y-4 text-sm">
					<div>
						<dt class="mb-1 text-neutral-500">Role</dt><dd class="font-medium text-white">
							{data.employer}
						</dd>
					</div>
					<div>
						<dt class="mb-1 text-neutral-500">Started</dt><dd class="font-medium text-white">
							{dateDisplay}
						</dd>
					</div>
					<div>
						<dt class="mb-1 text-neutral-500">Duration</dt><dd class="font-medium text-white">
							{data.duration}
						</dd>
					</div>
					{
						clients.length > 0 && (
							<div>
								<>
									<dt class="mb-1 text-neutral-500">Client / Partner</dt>
									<dd class="font-medium text-white">{clients.join(", ")}</dd>
								</>
							</div>
						)
					}
					<div>
						<dt class="mb-1 text-neutral-500">Status</dt>
						<dd
							class="bg-primary/10 text-primary border-primary/20 inline-flex items-center gap-2 rounded border px-2 py-1 text-xs font-bold"
						>
							{data.statusLabel}
						</dd>
					</div>
				</dl>
			</div>

			{
				data.additionalSkills && data.additionalSkills.length > 0 && (
					<div class="border-t border-neutral-800 pt-4">
						<h3 class="mb-3 text-xs font-bold tracking-wider text-neutral-500 uppercase">
							Core Competencies
						</h3>
						<div class="flex flex-wrap gap-2">
							{data.additionalSkills.map((s) => (
								<span class="border-primary/20 bg-primary/5 text-primary-400 hover:bg-primary/10 hover:text-primary-300 cursor-default rounded border px-2 py-1 text-xs transition-colors">
									{s}
								</span>
							))}
						</div>
					</div>
				)
			}

			{/* DOWNLOADS & LINKS */}
			{
				(documents.length > 0 || links.length > 0) && (
					<div class="border-t border-neutral-800 pt-4">
						<h3 class="mb-3 text-xs font-bold tracking-wider text-neutral-500 uppercase">
							Resources
						</h3>
						<ul class="space-y-2 text-sm">
							{documents.map((doc) => (
								<li>
									<a
										href={doc.url}
										target="_blank"
										class="group flex items-center gap-2 text-neutral-400 transition-colors hover:text-white"
									>
										<span class="group-hover:bg-primary/20 rounded bg-neutral-800 p-1 text-neutral-500 transition-colors group-hover:text-white">
											<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
												<path
													stroke-linecap="round"
													stroke-linejoin="round"
													stroke-width="2"
													d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
												/>
											</svg>
										</span>
										<span class="group-hover:decoration-primary/50 underline decoration-neutral-700 underline-offset-4">
											{doc.name}
										</span>
									</a>
								</li>
							))}
							{links.map((link) => (
								<li>
									<a
										href={link.url}
										target="_blank"
										class="group flex items-center gap-2 text-neutral-400 transition-colors hover:text-white"
									>
										<span class="group-hover:bg-primary/20 rounded bg-neutral-800 p-1 text-neutral-500 transition-colors group-hover:text-white">
											<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
												<path
													stroke-linecap="round"
													stroke-linejoin="round"
													stroke-width="2"
													d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
												/>
											</svg>
										</span>
										<span class="group-hover:decoration-primary/50 underline decoration-neutral-700 underline-offset-4">
											{link.name}
										</span>
									</a>
								</li>
							))}
						</ul>
					</div>
				)
			}
		</aside>

		<article class="order-1 space-y-12 md:order-2 md:col-span-8 lg:col-span-9">
			<div class="overflow-hidden rounded-xl border border-neutral-800 bg-neutral-900 shadow-2xl">
				<img
					src={data.heroImage}
					alt={data.title}
					class="h-auto max-h-[600px] w-full object-cover"
				/>
			</div>

			<div class="my-12 grid gap-8 md:grid-cols-2">
				{
					data.skillGraph && (
						<div class="flex flex-col items-center justify-center rounded-xl border border-neutral-800 bg-neutral-900/30 p-6">
							<div class="text-primary mb-4 font-mono text-xs tracking-widest uppercase">
								Skill Fingerprint
							</div>
							<img
								src={data.skillGraph}
								alt="Skill Radar Chart"
								class="h-64 w-64 opacity-90 invert dark:invert-0"
							/>
						</div>
					)
				}
				{
					data.partGraph && (
						<div class="flex flex-col items-center justify-center rounded-xl border border-neutral-800 bg-neutral-900/30 p-6">
							<div class="text-primary mb-4 font-mono text-xs tracking-widest uppercase">
								Part Breakdown
							</div>
							<img
								src={data.partGraph}
								alt="Part Breakdown Chart"
								class="h-64 w-64 opacity-90 invert dark:invert-0"
							/>
						</div>
					)
				}
			</div>

			<div
				class="prose prose-invert prose-lg prose-headings:font-bold prose-headings:text-white prose-p:text-neutral-300 prose-img:rounded-xl custom-prose max-w-none"
			>
				<Content components={{ YouTube, ModelViewer }} />
			</div>

			{
				gallery.length > 0 && (
					<div class="mt-16 border-t border-neutral-800 pt-12">
						<h3 class="mb-8 text-2xl font-bold text-white">Project Gallery</h3>
						<ProjectGallery client:visible images={gallery} />
					</div>
				)
			}
		</article>
	</div>
</Layout>

<style is:global>
	/* Custom Prose Overrides */
	.custom-prose blockquote {
		font-style: normal;
		font-weight: 500;
		color: var(--color-neutral-200);
		border-left-width: 4px;
		border-left-color: var(--color-primary-500);
		background-color: color-mix(in srgb, var(--primary) 10%, transparent);
		padding: 1.5rem;
		border-radius: 0.5rem;
		quotes: none;
		margin-top: 2rem;
		margin-bottom: 2rem;
	}

	.custom-prose blockquote p:first-of-type::before {
		content: none;
	}

	.custom-prose blockquote p:last-of-type::after {
		content: none;
	}

	.custom-prose h2 {
		color: white;
		border-bottom: 1px solid var(--border);
		padding-bottom: 0.5rem;
		margin-top: 3rem;
	}

	.custom-prose strong {
		color: white;
		font-weight: 700;
	}

	.custom-prose a {
		color: var(--primary);
		text-decoration: none;
		border-bottom: 1px solid transparent;
		transition: border-color 0.2s;
	}

	.custom-prose a:hover {
		border-bottom-color: var(--primary);
	}
</style>
