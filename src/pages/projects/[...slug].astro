---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/BaseLayout.astro";
import { YouTube } from "@astro-community/astro-embed-youtube";
import ModelViewer from "../../components/mdx/ModelViewer.astro";
import Button from "../../components/Button/Button.astro";

export async function getStaticPaths() {
	const projects = await getCollection("projects");
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
const data = project.data;

// --- DATE LOGIC ---
const startDate = data.date;
const dateDisplay = startDate
	? startDate.toLocaleDateString("en-US", { year: "numeric", month: "short" })
	: "Unknown";

// --- HELPERS (SIMPLIFIED) ---
const tools = data.tools || [];
const tags = data.tags || [];
const clients = data.client || [];
const gallery = data.gallery || [];
const documents = data.documents || [];
const links = data.links || [];

const metaDesc = data.description || `Engineering case study: ${data.title}`;
---

<Layout title={data.title} description={metaDesc}>
	<section class="relative border-b border-neutral-800 bg-neutral-900/30 pt-32 pb-12">
		<div class="site-container">
			<div class="max-w-4xl">
				<div
					class="text-primary mb-4 flex items-center gap-3 font-mono text-xs tracking-widest uppercase"
				>
					<span>{data.industry || "Engineering"}</span>
					<span>/</span>
					<span>{data.category || "Project"}</span>
				</div>
				<h1 class="mb-6 text-4xl font-bold text-white md:text-6xl">{data.title}</h1>
				<p class="max-w-2xl text-xl text-neutral-400">{data.description}</p>
			</div>
		</div>
	</section>

	<div class="site-container grid gap-12 py-12 md:grid-cols-12 md:py-24">
		<aside class="order-2 space-y-8 md:order-1 md:col-span-4 lg:col-span-3">
			<div class="rounded-xl border border-neutral-800 bg-neutral-900/50 p-6">
				<h3
					class="mb-4 border-b border-neutral-800 pb-2 text-sm font-bold tracking-wider text-white uppercase"
				>
					Project Data
				</h3>
				<dl class="space-y-4 text-sm">
					<div>
						<dt class="mb-1 text-neutral-500">Role</dt><dd class="font-medium text-white">
							{data.employer}
						</dd>
					</div>
					<div>
						<dt class="mb-1 text-neutral-500">Started</dt><dd class="font-medium text-white">
							{dateDisplay}
						</dd>
					</div>
					<div>
						<dt class="mb-1 text-neutral-500">Duration</dt><dd class="font-medium text-white">
							{data.duration}
						</dd>
					</div>
					{
						clients.length > 0 && (
							<div>
								<>
									<dt class="mb-1 text-neutral-500">Client / Partner</dt>
									<dd class="font-medium text-white">{clients.join(", ")}</dd>
								</>
							</div>
						)
					}
					<div>
						<dt class="mb-1 text-neutral-500">Status</dt>
						<dd
							class="bg-primary/10 text-primary border-primary/20 inline-flex items-center gap-2 rounded border px-2 py-1 text-xs font-bold"
						>
							{data.statusLabel}
						</dd>
					</div>
				</dl>
			</div>

			{
				tools.length > 0 && (
					<div>
						<h3 class="mb-3 text-xs font-bold tracking-wider text-neutral-500 uppercase">
							Toolchain
						</h3>
						<div class="flex flex-wrap gap-2">
							{tools.map((t) => (
								<span class="rounded border border-neutral-700 bg-neutral-800 px-2 py-1 text-xs text-neutral-300">
									{t}
								</span>
							))}
						</div>
					</div>
				)
			}

			{
				data.additionalSkills && data.additionalSkills.length > 0 && (
					<div class="border-t border-neutral-800 pt-4">
						<h3 class="mb-3 text-xs font-bold tracking-wider text-neutral-500 uppercase">
							Core Competencies
						</h3>
						<div class="flex flex-wrap gap-2">
							{data.additionalSkills.map((s) => (
								<span class="border-primary/20 bg-primary/5 text-primary-400 rounded border px-2 py-1 text-xs">
									{s}
								</span>
							))}
						</div>
					</div>
				)
			}

			{/* DOWNLOADS & LINKS */}
			{
				(documents.length > 0 || links.length > 0) && (
					<div class="border-t border-neutral-800 pt-4">
						<h3 class="mb-3 text-xs font-bold tracking-wider text-neutral-500 uppercase">
							Resources
						</h3>
						<ul class="space-y-2 text-sm">
							{documents.map((doc) => (
								<li>
									<a
										href={doc.url}
										target="_blank"
										class="text-primary flex items-center gap-2 hover:underline"
									>
										<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
											<path
												stroke-linecap="round"
												stroke-linejoin="round"
												stroke-width="2"
												d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
											/>
										</svg>
										{doc.name}
									</a>
								</li>
							))}
							{links.map((link) => (
								<li>
									<a
										href={link.url}
										target="_blank"
										class="text-primary flex items-center gap-2 hover:underline"
									>
										<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
											<path
												stroke-linecap="round"
												stroke-linejoin="round"
												stroke-width="2"
												d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
											/>
										</svg>
										{link.name}
									</a>
								</li>
							))}
						</ul>
					</div>
				)
			}

			<Button variant="outline" href="/projects/" arrow="left" class="w-full justify-center"
				>Back to Archive</Button
			>
		</aside>

		<article class="order-1 space-y-12 md:order-2 md:col-span-8 lg:col-span-9">
			<div class="overflow-hidden rounded-xl border border-neutral-800 bg-neutral-900 shadow-2xl">
				<img
					src={data.heroImage}
					alt={data.title}
					class="h-auto max-h-[600px] w-full object-cover"
				/>
			</div>

			{
				data.stats && (data.stats.plastic > 0 || data.stats.metal > 0 || data.stats.pcb > 0) && (
					<div class="grid grid-cols-3 gap-4 rounded-xl border border-neutral-800 bg-neutral-900/30 p-6">
						<div class="text-center">
							<>
								<div class="text-2xl font-bold text-white">{data.stats.plastic}</div>
								<div class="text-xs text-neutral-500 uppercase">Plastic</div>
							</>
						</div>
						<div class="border-l border-neutral-800 text-center">
							<>
								<div class="text-2xl font-bold text-white">{data.stats.metal}</div>
								<div class="text-xs text-neutral-500 uppercase">Metal</div>
							</>
						</div>
						<div class="border-l border-neutral-800 text-center">
							<>
								<div class="text-2xl font-bold text-white">{data.stats.pcb}</div>
								<div class="text-xs text-neutral-500 uppercase">PCBs</div>
							</>
						</div>
					</div>
				)
			}

			{
				data.skillGraph && (
					<div class="my-12">
						<h3 class="mb-6 flex items-center gap-3 text-2xl font-bold text-white">
							<span class="text-primary">///</span> Skill Fingerprint
						</h3>
						<div class="flex h-[400px] w-full items-center justify-center rounded-xl border border-neutral-800 bg-neutral-900/30 p-6">
							<img src={data.skillGraph} alt="Skill Radar Chart" class="h-full w-auto" />
						</div>
					</div>
				)
			}

			<div
				class="prose prose-invert prose-lg prose-headings:font-bold prose-headings:text-white prose-p:text-neutral-300 prose-img:rounded-xl max-w-none"
			>
				<Content components={{ YouTube, ModelViewer }} />
			</div>

			{
				gallery.length > 0 && (
					<div class="mt-16 border-t border-neutral-800 pt-12">
						<h3 class="mb-8 text-2xl font-bold text-white">Project Gallery</h3>
						<div class="columns-1 gap-8 space-y-8 md:columns-2">
							{gallery.map((img, i) => (
								<div class="break-inside-avoid overflow-hidden rounded-xl border border-neutral-800 bg-neutral-900 transition-colors hover:border-neutral-600">
									<img
										src={img}
										alt={`Detail view ${i + 1}`}
										class="h-auto w-full"
										loading="lazy"
									/>
								</div>
							))}
						</div>
					</div>
				)
			}
		</article>
	</div>
</Layout>
