---
import { type CollectionEntry, getCollection, render } from "astro:content";

export const prerender = true;

// THEME REGISTRY
import DataSheet from "@layouts/themes/DataSheet.astro";
import Hyperspace from "@layouts/themes/Hyperspace.astro";
import Command from "@layouts/themes/Command.astro";
import Redacted from "@layouts/themes/Redacted.astro";
import RedactedTerminal from "@layouts/themes/RedactedTerminal.astro";
import RedactedDossier from "@layouts/themes/RedactedDossier.astro";
// Future themes:
// import RetroConsole from "@layouts/themes/RetroConsole.astro";

// 1. Generate a new path for every collection entry
export async function getStaticPaths() {
	const projects = await getCollection("projects");
	return projects.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

// 2. For your template, you can get the entry directly from the prop
interface Props {
	entry: CollectionEntry<"projects">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const data = entry.data as any;

// Get all projects for navigation
const allProjects = await getCollection("projects");
// Sort by date descending (newest first)
const sortedProjects = allProjects.sort(
	(a, b) =>
		new Date(b.data.date || new Date()).getTime() - new Date(a.data.date || new Date()).getTime(),
);

const currentIndex = sortedProjects.findIndex((p) => p.id === entry.id);
const nextProject = currentIndex > 0 ? sortedProjects[currentIndex - 1] : null; // Newer project
const prevProject =
	currentIndex < sortedProjects.length - 1 ? sortedProjects[currentIndex + 1] : null; // Older project

// === ROUTER LOGIC ===
// Determine which theme to use

let theme = "datasheet"; // Default Safe Mode

// Check for explicit theme override
if (data.theme) {
	theme = data.theme.toLowerCase();
}
// Fallback: Check for legacy "cyberspace" flag
else if (data.cyberspace?.enable) {
	theme = "hyperspace";
}

// Map string to Component
const ThemeComponents: Record<string, any> = {
	datasheet: DataSheet,
	hyperspace: Hyperspace,
	command: Command,
	redacted: Redacted, // Concept C (Default)
	"redacted-terminal": RedactedTerminal, // Concept A (Alpha)
	"redacted-dossier": RedactedDossier, // Concept B (Bravo)
};

// Select Component (with fallback)
const SelectedTheme = ThemeComponents[theme] || DataSheet;

console.log(`[ROUTER] Project: ${entry.id} -> Theme: ${theme}`);
---

<SelectedTheme
	entry={entry}
	nextProject={nextProject}
	prevProject={prevProject}
	Content={Content}
	headings={headings}
/>
