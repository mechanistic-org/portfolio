---
import BaseLayout from "@layouts/BaseLayout.astro";
import ProjectSpecCard from "@components/Projects/ProjectSpecCard.astro";
import ExplodedView from "@components/CaseStudy/ExplodedView";
import KinematicsDemo from "@components/CaseStudy/KinematicsDemo";
import SolarMetrics from "@components/CaseStudy/SolarMetrics";

const projectMetadata = {
	title: "Erik Norris Prototypes",
	description: "A convergence of Industrial Design, Mechanical Engineering, and Software Systems.",
	role: "Lead Engineer / Designer",
	client: "Various",
	year: "2010-2025",
	tech: ["SolidWorks", "React", "Python", "IoT", "FEA"],
};
---

<BaseLayout
	title="Kitchen Sink"
	description="A showcase of technical capabilities across multiple domains."
>
	{/* 1. Deals Memo / Header */}
	<div class="site-container pt-20 pb-12">
		<div
			class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1"
		>
			<span class="h-2 w-2 animate-pulse rounded-full bg-indigo-500"></span>
			<span class="font-mono text-xs tracking-widest text-indigo-300 uppercase"
				>Layout Prototype V1</span
			>
		</div>
		<h1 class="font-heading mb-6 text-5xl font-bold text-white md:text-7xl">
			The <span class="text-indigo-500">Erik Norris</span> Portfolio
		</h1>
		<p class="mb-12 max-w-3xl text-xl text-neutral-400">
			A unified demonstration of rigorous hardware engineering, interactive software, and strategic
			design. This page aggregates key interaction models from 5 distinct case studies.
		</p>

		<ProjectSpecCard
			title={projectMetadata.title}
			description={projectMetadata.description}
			role={projectMetadata.role}
			client={projectMetadata.client}
			year={projectMetadata.year}
			tech={projectMetadata.tech}
		/>
	</div>

	{/* 2. Kinematics (Marin / BigToys) */}
	<section class="border-y border-white/5 bg-neutral-900/50 py-24">
		<div class="site-container grid items-center gap-12 md:grid-cols-2">
			<div>
				<div
					class="mb-4 inline-block rounded-full bg-red-500/20 px-3 py-1 text-xs font-bold text-red-500"
				>
					MECHANICAL DYNAMICS
				</div>
				<h2 class="mb-4 text-3xl font-bold text-white">Kinematic Optimization</h2>
				<p class="mb-6 text-neutral-400">
					Suspension linkage design requires balancing pedal efficiency (anti-squat) with impact
					absorption. Simulating 4-bar linkages ensures optimal axle path and leverage ratios.
				</p>
				<div class="grid grid-cols-2 gap-4">
					<div class="rounded-lg border border-white/10 bg-neutral-950 p-4">
						<div class="text-2xl font-bold text-white">
							140<span class="text-sm text-neutral-500">mm</span>
						</div>
						<div class="text-xs text-neutral-500">Travel</div>
					</div>
					<div class="rounded-lg border border-white/10 bg-neutral-950 p-4">
						<div class="text-2xl font-bold text-white">2.8:1</div>
						<div class="text-xs text-neutral-500">Leverage Ratio</div>
					</div>
				</div>
			</div>
			<div>
				<KinematicsDemo client:visible />
			</div>
		</div>
	</section>

	{/* 3. High Density Packaging (Sound Devices) - Exploded View SCROLL */}
	<section class="py-24">
		<div class="site-container mb-8">
			<div
				class="mb-4 inline-block rounded-full bg-blue-500/20 px-3 py-1 text-xs font-bold text-blue-500"
			>
				ELECTRONIC PACKAGING
			</div>
			<h2 class="text-3xl font-bold text-white">Vertical Integration</h2>
			<p class="max-w-2xl text-neutral-400">
				Achieving cinema-grade reliability in a handheld form factor requires stacking high-speed
				digital boards with sensitive analog preamps.
			</p>
		</div>
		{/* Full width scroller */}
		<ExplodedView client:visible />
	</section>

	{/* 4. IoT & Systems (Syncromatics) */}
	<section class="border-t border-white/5 bg-neutral-950 py-24">
		<div class="site-container grid gap-16 md:grid-cols-2">
			<div class="order-2 md:order-1">
				<SolarMetrics client:visible />
			</div>
			<div class="order-1 md:order-2">
				<div
					class="mb-4 inline-block rounded-full bg-green-500/20 px-3 py-1 text-xs font-bold text-green-500"
				>
					IOT INFRASTRUCTURE
				</div>
				<h2 class="mb-4 text-3xl font-bold text-white">Autonomous Power Systems</h2>
				<p class="mb-6 text-neutral-400">
					Deploying real-time transit signage in off-grid locations necessitates aggressive power
					management. The firmware dynamically throttles cellular polling based on solar yield and
					battery health.
				</p>
				<ul class="space-y-2 text-neutral-400">
					<li class="flex items-center gap-2">
						<span class="h-2 w-2 rounded-full bg-green-500"></span>
						<span>MPPT Solar Charging</span>
					</li>
					<li class="flex items-center gap-2">
						<span class="h-2 w-2 rounded-full bg-green-500"></span>
						<span>LTE-M Telemetry</span>
					</li>
					<li class="flex items-center gap-2">
						<span class="h-2 w-2 rounded-full bg-green-500"></span>
						<span>99.9% Uptime SLA</span>
					</li>
				</ul>
			</div>
		</div>
	</section>

	{/* 5. Strategy / Data (Eclipse) */}
	<section class="bg-gradient-to-b from-neutral-900 to-black py-24">
		<div class="site-container text-center">
			<div
				class="mb-4 inline-block rounded-full bg-purple-500/20 px-3 py-1 text-xs font-bold text-purple-500"
			>
				ENTERPRISE STRATEGY
			</div>
			<h2 class="mb-8 text-3xl font-bold text-white">Single Source of Truth</h2>
			<p class="mx-auto mb-12 max-w-2xl text-neutral-400">
				Migrating 3 distinct manufacturing silos into a unified global PLM system. Visualizing the
				flow of CAD data across 3 continents.
			</p>

			{/* Simple SVG Map Placeholder */}
			<div
				class="mx-auto w-full max-w-4xl opacity-50 transition-opacity duration-1000 hover:opacity-100"
			>
				<svg viewBox="0 0 800 400" class="h-auto w-full">
					<!-- World Map Outline (Simplified) -->
					<path
						d="M 100,100 Q 200,50 300,100 T 500,100 T 700,200"
						fill="none"
						stroke="#333"
						stroke-width="2"></path>

					<!-- Connection Arcs -->
					<path
						d="M 150,150 Q 400,0 650,150"
						fill="none"
						stroke="#8B5CF6"
						stroke-width="2"
						stroke-dasharray="5,5"
					>
						<animate
							attributeName="stroke-dashoffset"
							from="100"
							to="0"
							dur="2s"
							repeatCount="indefinite"></animate>
					</path>
					<circle cx="150" cy="150" r="5" fill="#8B5CF6"></circle>
					<text x="150" y="180" fill="#fff" font-size="10" text-anchor="middle">USA</text>

					<circle cx="650" cy="150" r="5" fill="#8B5CF6"></circle>
					<text x="650" y="180" fill="#fff" font-size="10" text-anchor="middle">China</text>

					<circle cx="400" cy="120" r="5" fill="#8B5CF6"></circle>
					<text x="400" y="150" fill="#fff" font-size="10" text-anchor="middle">Europe</text>
				</svg>
			</div>
		</div>
	</section>
</BaseLayout>
