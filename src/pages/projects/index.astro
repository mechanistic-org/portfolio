---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/Projects/ProjectCard.astro";
import FilterButton from "../../components/Button/FilterButton.astro"; // Capitalized path

// 1. Get all projects
const allProjects = await getCollection("projects", ({ data }) => {
  return data.draft !== true;
});

// 2. Sort by Date
const projects = allProjects.sort((a, b) => {
  const dateA = new Date(a.data.date || 0);
  const dateB = new Date(b.data.date || 0);
  return dateB.getTime() - dateA.getTime();
});

// 3. Extract Technologies
const allTechnologies = [
  ...new Set(projects.flatMap((project) => {
    return Array.isArray(project.data.tags) ? project.data.tags : [];
  }))
].sort();
---

<BaseLayout
  title="Projects"
  description="Explore my projects and learn about my development journey."
>
  <div class="site-container py-24 md:pb-36">
    <div class="mx-auto max-w-4xl text-center">
      <h1 class="h1 mb-4">Projects</h1>
      <p class="text-muted-foreground text-lg md:text-xl">
        Archive of {projects.length} Engineering Projects
      </p>
    </div>

   <div class="mt-12 flex flex-wrap justify-center gap-2">
      {/* 1. Fixed "All" Button: Self-closing tag with 'text' prop */}
      <FilterButton 
        class="filter-btn active" 
        data-filter="all" 
        aria-pressed="true"
        text="All"
      />
      
      {/* 2. Fixed Map Loop: Passing 'tech' into 'text' prop */}
      {allTechnologies.map((tech) => (
        <FilterButton 
          class="filter-btn" 
          data-filter={tech} 
          aria-pressed="false"
          text={tech}
        />
      ))}
    </div>

    {/* CHANGE 1: Removed 'hidden' class from the HTML. Cards are visible by default. */}
    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3" id="projects-grid">
      {projects.map((project) => {
        const tags = Array.isArray(project.data.tags) ? JSON.stringify(project.data.tags) : "[]";
        return (
          <div class="project-card" data-tags={tags}>
            <ProjectCard project={project} />
          </div>
        );
      })}
    </div>

    <div class="mt-12 text-center hidden" id="pagination-controls">
        <button id="load-more-btn" class="px-6 py-3 bg-neutral-800 hover:bg-neutral-700 text-white rounded-lg font-medium transition-colors">
            Load More Projects
        </button>
        <p id="showing-count" class="mt-4 text-sm text-neutral-500"></p>
    </div>
  </div>

  <script>
    // CHANGE 2: Use 'astro:page-load' instead of 'DOMContentLoaded' to support View Transitions
    document.addEventListener('astro:page-load', () => {
        const cards = Array.from(document.querySelectorAll('.project-card')) as HTMLElement[];
        const buttons = document.querySelectorAll('.filter-btn');
        const controls = document.getElementById('pagination-controls');
        const loadMoreBtn = document.getElementById('load-more-btn');
        const countLabel = document.getElementById('showing-count');
        
        // Only run if we actually have projects
        if (cards.length === 0) return;

        // Show the controls now that JS is running
        if (controls) controls.classList.remove('hidden');
        
        let visibleCount = 12; 
        let currentFilter = 'all';
        let activeCards: HTMLElement[] = [];

        function updateDisplay() {
            // Identify which cards match the filter
            activeCards = cards.filter(card => {
                try {
                    const tags = JSON.parse(card.getAttribute('data-tags') || '[]');
                    return currentFilter === 'all' || tags.includes(currentFilter);
                } catch (e) {
                    return true; // Fallback: show if data is weird
                }
            });

            // Manage Visibility
            cards.forEach(card => {
                // First, hide everything that doesn't match the filter
                if (!activeCards.includes(card)) {
                    card.style.display = 'none';
                    return;
                }
                
                // For matching cards, check pagination index
                const index = activeCards.indexOf(card);
                if (index < visibleCount) {
                    card.style.display = 'block';
                    // Optional fade in
                    card.animate([
                        { opacity: 0, transform: 'translateY(10px)' },
                        { opacity: 1, transform: 'translateY(0)' }
                    ], { duration: 300, fill: 'forwards' });
                } else {
                    card.style.display = 'none';
                }
            });

            // Update Controls
            if (countLabel) {
                countLabel.textContent = `Showing ${Math.min(visibleCount, activeCards.length)} of ${activeCards.length} projects`;
            }

            if (loadMoreBtn) {
                loadMoreBtn.style.display = visibleCount >= activeCards.length ? 'none' : 'inline-block';
            }
        }

        // Initial Run
        updateDisplay();

        // Event Listeners
        loadMoreBtn?.addEventListener('click', () => {
            visibleCount += 12;
            updateDisplay();
        });

        buttons.forEach(btn => {
            btn.addEventListener('click', () => {
                // Toggle UI
                buttons.forEach(b => {
                    b.classList.remove('active');
                    b.setAttribute('aria-pressed', 'false');
                });
                btn.classList.add('active');
                btn.setAttribute('aria-pressed', 'true');

                // Update Logic
                currentFilter = btn.getAttribute('data-filter') || 'all';
                visibleCount = 12; // Reset pagination
                updateDisplay();
            });
        });
    });
  </script>

  <style>
    @reference "../../styles/global.css";
    
    .filter-btn.active {
      @apply bg-primary text-black ring-2 ring-primary;
    }
  </style>
</BaseLayout>