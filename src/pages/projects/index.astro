---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/projects/ProjectCard.astro";
import FilterButton from "../../components/Button/FilterButton.astro";

const allProjects = await getCollection("projects", ({ data }) => !data.draft);
const projects = allProjects.sort((a, b) => new Date(b.data.date || 0).getTime() - new Date(a.data.date || 0).getTime());

// Extract Facets for the UI
const industries = [...new Set(projects.map(p => p.data.industry).filter(Boolean))].sort();
const tools = [...new Set(projects.flatMap(p => p.data.tools).filter(Boolean))].sort();
const statuses = ["Mass Production", "Manufacturing Prep", "Prototyping", "Concept"]; // Ordered logic
---

<BaseLayout title="Projects" description="Engineering Archive">
  <div class="site-container py-24 md:pb-36">
    
    <div class="mx-auto max-w-4xl text-center mb-12">
      <h1 class="h1 mb-4">Projects</h1>
      <p class="text-muted-foreground text-lg">
        Archive of {projects.length} Engineering Projects
      </p>
    </div>

    <div class="sticky top-4 z-40 bg-neutral-950/90 backdrop-blur-md border border-neutral-800 rounded-xl p-4 mb-12 shadow-2xl">
        
        <div class="flex flex-col gap-2 mb-4">
            <span class="text-xs font-mono text-neutral-500 uppercase tracking-widest">Sector</span>
            <div class="flex flex-wrap gap-2">
                <FilterButton class="filter-btn active" data-group="industry" data-filter="all" text="All" />
                {industries.map(i => <FilterButton class="filter-btn" data-group="industry" data-filter={i} text={i} />)}
            </div>
        </div>

        <div class="grid md:grid-cols-2 gap-4 pt-4 border-t border-neutral-800">
            
            <div class="flex flex-col gap-2">
                <span class="text-xs font-mono text-neutral-500 uppercase tracking-widest">Toolchain</span>
                <div class="flex flex-wrap gap-2">
                    <FilterButton class="filter-btn active" data-group="tool" data-filter="all" text="Any" />
                    {tools.map(t => <FilterButton class="filter-btn" data-group="tool" data-filter={t} text={t} />)}
                </div>
            </div>

            <div class="flex flex-col gap-2">
                <span class="text-xs font-mono text-neutral-500 uppercase tracking-widest">Production Status</span>
                <div class="flex flex-wrap gap-2">
                    <FilterButton class="filter-btn active" data-group="status" data-filter="all" text="Any Stage" />
                    {statuses.map(s => <FilterButton class="filter-btn" data-group="status" data-filter={s} text={s} />)}
                </div>
            </div>
        </div>
    </div>

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3" id="projects-grid">
      {projects.map((project) => (
        <div 
            class="project-card" 
            data-industry={project.data.industry}
            data-tool={JSON.stringify(project.data.tools)}
            data-status={project.data.production}
        >
            <ProjectCard project={project} />
        </div>
      ))}
    </div>
    
    <div class="mt-12 text-center hidden" id="pagination-controls">
        <button id="load-more-btn" class="px-6 py-3 bg-neutral-800 hover:bg-neutral-700 text-white rounded-lg font-medium transition-colors">Load More</button>
        <p id="showing-count" class="mt-4 text-sm text-neutral-500"></p>
    </div>
  </div>

  <script>
    document.addEventListener('astro:page-load', () => {
        const cards = Array.from(document.querySelectorAll('.project-card')) as HTMLElement[];
        const buttons = document.querySelectorAll('.filter-btn');
        const loadMoreBtn = document.getElementById('load-more-btn');
        const countLabel = document.getElementById('showing-count');
        const controls = document.getElementById('pagination-controls');
        
        if (cards.length === 0) return;
        if (controls) controls.classList.remove('hidden');

        // State
        let filters = { industry: 'all', tool: 'all', status: 'all' };
        let visibleCount = 12;

        function update() {
            // Filter
            const active = cards.filter(card => {
                const d = card.dataset;
                const cardTools = JSON.parse(d.tool || '[]');
                
                const matchInd = filters.industry === 'all' || d.industry === filters.industry;
                const matchStatus = filters.status === 'all' || d.status === filters.status;
                const matchTool = filters.tool === 'all' || cardTools.includes(filters.tool);
                
                return matchInd && matchStatus && matchTool;
            });

            // Render
            cards.forEach(c => c.style.display = 'none');
            active.slice(0, visibleCount).forEach(c => {
                c.style.display = 'block';
                c.animate([{ opacity: 0, transform: 'translateY(10px)' }, { opacity: 1, transform: 'translateY(0)' }], { duration: 300 });
            });

            // UI Updates
            if (countLabel) countLabel.innerText = `Showing ${Math.min(visibleCount, active.length)} of ${active.length}`;
            if (loadMoreBtn) loadMoreBtn.style.display = visibleCount >= active.length ? 'none' : 'inline-block';
        }

        // Init
        update();

        // Events
        loadMoreBtn?.addEventListener('click', () => { visibleCount += 12; update(); });

        buttons.forEach(btn => {
            btn.addEventListener('click', () => {
                const group = btn.getAttribute('data-group');
                const val = btn.getAttribute('data-filter');
                if (!group || !val) return;

                // UI Toggle
                document.querySelectorAll(`.filter-btn[data-group="${group}"]`).forEach(b => {
                    b.classList.remove('active');
                    b.setAttribute('aria-pressed', 'false');
                });
                btn.classList.add('active');
                btn.setAttribute('aria-pressed', 'true');

                // Logic Update
                filters[group] = val;
                visibleCount = 12;
                update();
            });
        });
    });
  </script>

  <style>
    @reference "../../styles/global.css";
    .filter-btn.active {
      @apply bg-primary text-black ring-2 ring-primary;
    }
  </style>
</BaseLayout>