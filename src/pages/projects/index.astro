---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectDirectory from "../../components/Projects/ProjectDirectory.astro";
import FilterPanel from "../../components/Projects/FilterPanel.astro";

const allProjects = await getCollection("projects", ({ data }) => !data.draft);
const projects = allProjects.sort(
	(a, b) => new Date(b.data.date || 0).getTime() - new Date(a.data.date || 0).getTime(),
);

// Extract Facets for the UI
const industries = [...new Set(projects.map((p) => p.data.industry).filter(Boolean))].sort();
const tools = [...new Set(projects.flatMap((p) => p.data.tools).filter(Boolean))].sort();
// Merge Employer and Client into one list
const allClients = projects.flatMap((p) => {
	const c = p.data.client || [];
	const e = p.data.employer ? [p.data.employer] : [];
	return [...c, ...e];
});
const clients = [...new Set(allClients.filter(Boolean))].sort();
---

<BaseLayout title="Projects" description="Engineering Archive">
	<div class="site-container pt-32 pb-24 md:pb-36">
		<div class="mb-8 flex flex-col gap-6">
			<FilterPanel sectors={industries} tools={tools} clients={clients} />
		</div>

		<!-- Project Directory Table -->
		<div id="projects-container">
			<ProjectDirectory projects={projects} />
		</div>
	</div>
</BaseLayout>

<script>
	document.addEventListener("astro:page-load", () => {
		// Target rows instead of cards
		const rows = Array.from(document.querySelectorAll(".project-row")) as HTMLElement[];
		const buttons = document.querySelectorAll(".filter-btn");
		const sortHeaders = document.querySelectorAll(".sort-header");

		if (rows.length === 0) return;

		// State
		let filters = { industry: "all", tool: "all", status: "all", client: "all" };
		let sortState = { column: "date", direction: "desc" }; // default sort

		// URL Params Logic - Run BEFORE initial update
		const urlParams = new URLSearchParams(window.location.search);
		const clientParam = urlParams.get("client");
		if (clientParam) {
			// Decode URI component to handle spaces (e.g. "Consumer Appliances")
			const decodedClient = decodeURIComponent(clientParam);
			filters.client = decodedClient;

			// Set active state on the button immediately
			const btn = document.querySelector(
				`.filter-btn[data-group="client"][data-filter="${decodedClient}"]`,
			);
			if (btn) {
				btn.setAttribute("data-active", "true");
				// Deactivate "All"
				document
					.querySelector(`.filter-btn[data-group="client"][data-filter="all"]`)
					?.setAttribute("data-active", "false");
			}
		}

		function renderActiveFilters() {
			const display = document.getElementById("active-filters-display");
			if (!display) return;

			const activeKeys = Object.entries(filters).filter(([key, val]) => val !== "all");

			if (activeKeys.length === 0) {
				display.innerHTML = '<span class="font-mono text-xs text-neutral-600">All Projects</span>';
				return;
			}

			display.innerHTML = "";
			activeKeys.forEach(([key, val]) => {
				const span = document.createElement("span");
				span.className = "font-mono text-xs text-primary";
				span.innerText = `[ ${val} ]`;

				// Add clear button for this filter
				const clear = document.createElement("button");
				clear.className = "ml-1 hover:text-white";
				clear.innerHTML = "&times;";
				clear.onclick = (e) => {
					e.stopPropagation();
					const btn = document.querySelector(
						`.filter-btn[data-group="${key}"][data-filter="all"]`,
					) as HTMLElement;
					if (btn) btn.click();
				};
				span.appendChild(clear);

				display.appendChild(span);
			});

			// Add "View All" / Reset button
			const resetBtn = document.createElement("button");
			resetBtn.className =
				"ml-4 font-mono text-xs text-neutral-500 hover:text-white underline decoration-dotted underline-offset-4";
			resetBtn.innerText = "RESET VIEW";
			resetBtn.onclick = () => {
				document.querySelectorAll('.filter-btn[data-filter="all"]').forEach((b: any) => b.click());
				// Clear URL params
				window.history.replaceState({}, "", window.location.pathname);
				// Reset Sort
				sortState = { column: "date", direction: "desc" };
				update();
			};
			display.appendChild(resetBtn);
		}

		function getCellValue(row: HTMLElement, column: string): string | number {
			const d = row.dataset;
			switch (column) {
				case "project":
					return d.title?.toLowerCase() || "";
				case "client":
					// Client is an array string, just take the first one for sorting or join them
					return (JSON.parse(d.client || "[]")[0] || "").toLowerCase();
				case "sector":
					return d.industry?.toLowerCase() || "";
				case "year":
					return parseInt(d.date || "0");
				case "status":
					return d.status?.toLowerCase() || "";
				default:
					return "";
			}
		}

		// Keyboard Nav State
		let selectedIndex = -1;

		function updateActiveRow() {
			// Remove active class from all
			rows.forEach((r) => {
				r.classList.remove("bg-primary/10", "border-l-2", "border-primary", "animate-pulse-slow");
				r.classList.add("border-transparent"); // Reset border
			});

			if (selectedIndex >= 0 && selectedIndex < rows.length) {
				const row = rows[selectedIndex];
				// Only apply if row is visible
				if (row.style.display !== "none") {
					row.classList.add("bg-primary/10", "border-l-2", "border-primary", "animate-pulse-slow");
					row.classList.remove("border-transparent");

					// Scroll into view if needed (smooth)
					row.scrollIntoView({ behavior: "smooth", block: "nearest" });
				}
			}
		}

		// Keyboard Listeners
		document.addEventListener("keydown", (e) => {
			// Only if not focused on an input
			if (document.activeElement?.tagName === "INPUT") return;

			const visibleRows = rows.filter((r) => r.style.display !== "none");
			if (visibleRows.length === 0) return;

			// Find current index in visible rows
			let currentVisibleIndex = visibleRows.findIndex((r) => r === rows[selectedIndex]);

			if (e.key === "j" || e.key === "ArrowDown") {
				e.preventDefault();
				if (currentVisibleIndex < visibleRows.length - 1) {
					currentVisibleIndex++;
				} else {
					currentVisibleIndex = 0; // Loop to top
				}
				// Find the global index of the new visible row
				selectedIndex = rows.indexOf(visibleRows[currentVisibleIndex]);
				updateActiveRow();
			} else if (e.key === "k" || e.key === "ArrowUp") {
				e.preventDefault();
				if (currentVisibleIndex > 0) {
					currentVisibleIndex--;
				} else {
					currentVisibleIndex = visibleRows.length - 1; // Loop to bottom
				}
				selectedIndex = rows.indexOf(visibleRows[currentVisibleIndex]);
				updateActiveRow();
			} else if (e.key === "Enter") {
				if (selectedIndex >= 0) {
					const row = rows[selectedIndex];
					const link = row.getAttribute("onclick");
					// Extract URL from "window.location.href='/projects/slug/'"
					const match = link?.match(/'([^']+)'/);
					if (match) {
						window.location.href = match[1];
					}
				}
			}
		});

		// Sync Hover with Selection - REMOVED to prevent sticky highlight
		// rows.forEach((row, index) => {
		// 	row.addEventListener("mouseenter", () => {
		// 		selectedIndex = index;
		// 		updateActiveRow();
		// 	});
		// });

		function update() {
			// Filter
			let active = rows.filter((row) => {
				const d = row.dataset;
				const rowTools = JSON.parse(d.tool || "[]");
				const rowClients = JSON.parse(d.client || "[]"); // Assuming client is array

				// Find title in the second cell (index 1)
				const titleCell = row.children[1] as HTMLElement;
				const rowTitle = titleCell?.innerText.toLowerCase() || "";

				const matchInd = filters.industry === "all" || d.industry === filters.industry;
				const matchStatus = filters.status === "all" || d.status === filters.status;
				const matchTool = filters.tool === "all" || rowTools.includes(filters.tool);
				const matchClient = filters.client === "all" || rowClients.includes(filters.client);

				return matchInd && matchStatus && matchTool && matchClient;
			});

			// Sort
			active.sort((a, b) => {
				const valA = getCellValue(a, sortState.column);
				const valB = getCellValue(b, sortState.column);

				if (valA < valB) return sortState.direction === "asc" ? -1 : 1;
				if (valA > valB) return sortState.direction === "asc" ? 1 : -1;
				return 0;
			});

			// Render
			// First hide all rows
			rows.forEach((r) => (r.style.display = "none"));

			// Then append active rows in order to the tbody to ensure visual order matches sort order
			const tbody = document.getElementById("projects-table-body");
			if (tbody) {
				active.forEach((r) => {
					r.style.display = "table-row";
					tbody.appendChild(r); // Re-appending moves it to the end, effectively reordering
				});
			}

			// Reset selection on filter change
			selectedIndex = -1;
			updateActiveRow();

			renderActiveFilters();
			updateSortIcons();
		}

		function updateSortIcons() {
			sortHeaders.forEach((header) => {
				const col = header.getAttribute("data-col");
				const icon = header.querySelector(".sort-icon");
				if (!icon) return;

				if (col === sortState.column) {
					icon.innerHTML = sortState.direction === "asc" ? "▲" : "▼";
					header.classList.add("text-primary");
					header.classList.remove("text-neutral-500");
				} else {
					icon.innerHTML = "↕"; // or some neutral icon
					header.classList.remove("text-primary");
					header.classList.add("text-neutral-500");
				}
			});
		}

		// Init
		update();

		// Events

		buttons.forEach((btn) => {
			const applyFilter = () => {
				const group = btn.getAttribute("data-group");
				const val = btn.getAttribute("data-filter");
				if (!group || !val) return;

				// UI Toggle
				document.querySelectorAll(`.filter-btn[data-group="${group}"]`).forEach((b) => {
					b.setAttribute("data-active", "false");
				});
				btn.setAttribute("data-active", "true");

				// Logic Update
				filters[group as keyof typeof filters] = val;
				update();
			};

			btn.addEventListener("click", applyFilter);
			btn.addEventListener("mouseenter", applyFilter);
		});

		sortHeaders.forEach((header) => {
			header.addEventListener("click", () => {
				const col = header.getAttribute("data-col");
				if (!col) return;

				if (sortState.column === col) {
					// Toggle direction
					sortState.direction = sortState.direction === "asc" ? "desc" : "asc";
				} else {
					// New column, default to asc (or desc for year?)
					sortState.column = col;
					sortState.direction = col === "year" ? "desc" : "asc";
				}
				update();
			});
		});
	});
</script>

<style>
	@reference "../../styles/global.css";
	.filter-btn.active {
		@apply bg-primary ring-primary text-black ring-2;
	}
	@keyframes pulse-slow {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0.8;
			background-color: rgba(var(--color-primary), 0.15);
		}
	}
	.animate-pulse-slow {
		animation: pulse-slow 3s cubic-bezier(0.4, 0, 0.6, 1) infinite;
	}
</style>
