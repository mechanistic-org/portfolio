---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { archivePresentation, compareArchive } from "../../utils/archivePresentation.ts";
import ProjectDirectory from "../../components/Projects/ProjectDirectory.astro";
import ProjectGrid from "../../components/Projects/ProjectGrid.astro";
import Assembly from "../../components/DataViz/Assembly";
import TimelineStream from "../../components/DataViz/TimelineStream";
import RadialTaxonomy from "../../components/DataViz/RadialTaxonomy";
import ScrollCoordinator from "@components/Effects/ScrollCoordinator.astro";
import { getMultiverseData } from "@/utils/getMultiverseData";
import { Icon } from "astro-icon/components";
import ThemeToggle from "@components/ThemeToggle/ThemeToggle.astro";
import { currentSite } from "@config/site_config";

export const prerender = true;

const multiverseData = await getMultiverseData();
const multiverseMap = new Map(multiverseData.nodes.map((n) => [n.id.toLowerCase(), n]));

const rawProjects = await getCollection("projects");
const projects = rawProjects
	.filter(({ data }) => {
		const targets = data.targets || ["main"];
		return targets.includes(currentSite);
	})
	.filter(({ data, id }) => {
		const hiddenIds = [
			"classified",
			"classified-alpha",
			"classified-bravo",
			"electronic-battery-lock",
		];
		return (
			!data.draft &&
			(data as any).impact !== "NO_DATA" &&
			!hiddenIds.includes(data.slug || (data as any).id || id)
		);
	})
	.map((p) => {
		const node = multiverseMap.get((p.data.slug || p.id).toLowerCase());
		if (node) {
			// if (node.client) p.data.client = node.client; // Not in MultiverseNode
			if (node.group) p.data.employer = node.group;
			if (node.industry) p.data.industry = node.industry;
			if (node.category) p.data.category = node.category;
			if (node.skills) p.data.tools = node.skills;
		}
		return p;
	})
	.sort((a, b) => compareArchive(archivePresentation(a).sort, archivePresentation(b).sort));

const industries = [...new Set(projects.map((p) => p.data.industry).filter(Boolean))].sort();
const categories = [
	...new Set(projects.map((p) => p.data.category).filter(Boolean)),
].sort() as string[];
const tools = [...new Set(projects.flatMap((p) => p.data.tools || []).filter(Boolean))].sort();
const allClients = projects.flatMap((p) => {
	const c = p.data.client || [];
	const e = p.data.employer ? [p.data.employer] : [];
	return [...c, ...e];
});
const clients = [...new Set(allClients.filter(Boolean))].sort();
---

<BaseLayout title="Work" description="Engineering Archive" starfield={true}>
	<div class="site-container-full min-h-screen px-4 pt-24 pb-24 md:px-8 md:pb-36">
		<header class="mb-6 flex flex-wrap items-center justify-between gap-3">
			<h1 class="font-mono text-lg font-bold tracking-widest uppercase">Projects</h1>
			<ThemeToggle />
			<div role="group" aria-label="Archive view" class="flex w-full flex-wrap items-center gap-1">
				<!-- View Toggles -->
				<button
					class="view-toggle flex items-center gap-2 rounded-full bg-white/10 px-3 py-2 font-mono text-xs tracking-wider text-white uppercase transition-all duration-300"
					data-view="list"
					aria-pressed="true"
				>
					<Icon name="tabler:list" class="h-3.5 w-3.5" />
					<span>Ref</span>
				</button>
				<button
					class="view-toggle flex items-center gap-2 rounded-full px-3 py-2 font-mono text-xs tracking-wider text-neutral-400 uppercase transition-all duration-300 hover:bg-white/5 hover:text-white"
					data-view="grid"
					aria-pressed="false"
				>
					<Icon name="tabler:layout-grid" class="h-3.5 w-3.5" />
					<span>Grid</span>
				</button>
				<button
					class="view-toggle flex items-center gap-2 rounded-full px-3 py-2 font-mono text-xs tracking-wider text-neutral-400 uppercase transition-all duration-300 hover:bg-white/5 hover:text-white"
					data-view="multiverse"
					aria-pressed="false"
				>
					<Icon name="tabler:circles-relation" class="h-3.5 w-3.5" />
					<span>Assembly</span>
				</button>
				<button
					class="view-toggle flex items-center gap-2 rounded-full px-3 py-2 font-mono text-xs tracking-wider text-neutral-400 uppercase transition-all duration-300 hover:bg-white/5 hover:text-white"
					data-view="timeline"
					aria-pressed="false"
				>
					<Icon name="tabler:timeline" class="h-3.5 w-3.5" />
					<span>Time</span>
				</button>
				<button
					class="view-toggle flex items-center gap-2 rounded-full px-3 py-2 font-mono text-xs tracking-wider text-neutral-400 uppercase transition-all duration-300 hover:bg-white/5 hover:text-white"
					data-view="radial"
					aria-pressed="false"
				>
					<Icon name="tabler:chart-radar" class="h-3.5 w-3.5" />
					<span>Radial</span>
				</button>
			</div>
		</header>
		<!-- VIEW: LIST (Default) -->
		<div id="view-list" class="view-container animate-in fade-in w-full duration-500">
			<ProjectDirectory
				projects={projects}
				sectors={industries}
				categories={categories}
				tools={tools}
				clients={clients}
			/>
		</div>

		<!-- VIEW: GRID -->
		<div
			id="view-grid"
			class="view-container animate-in fade-in zoom-in-95 hidden w-full duration-500"
		>
			<ProjectGrid projects={projects} />
		</div>

		<!-- VIEW: ASSEMBLY -->
		<div
			id="view-multiverse"
			class="view-container animate-in fade-in zoom-in-95 hidden w-full duration-500"
		>
			<div
				class="relative overflow-hidden rounded-xl border border-white/5 bg-neutral-900/10"
				style="height: calc(100vh - 150px)"
			>
				<Assembly client:only="react" data={multiverseData} />
				<div
					class="pointer-events-none absolute bottom-4 left-4 font-mono text-[10px] text-green-500/50"
				>
					MODE: ASSEMBLY::GRAVITY_WELL<br />
					NODES: {multiverseData.nodes.length}
				</div>
			</div>
		</div>

		<!-- VIEW: TIMELINE -->
		<div
			id="view-timeline"
			class="view-container animate-in fade-in zoom-in-95 hidden w-full duration-500"
		>
			<div
				class="relative overflow-hidden rounded-xl border border-white/5 bg-neutral-900/10"
				style="height: calc(100vh - 150px)"
			>
				<TimelineStream client:only="react" data={multiverseData} />
			</div>
		</div>

		<!-- VIEW: RADIAL -->
		<div
			id="view-radial"
			class="view-container animate-in fade-in zoom-in-95 hidden w-full duration-500"
		>
			<div
				class="relative overflow-hidden rounded-xl border border-white/5 bg-neutral-900/10"
				style="height: calc(100vh - 150px)"
			>
				<RadialTaxonomy client:only="react" data={multiverseData} />
			</div>
		</div>

		<script>
			// VIEW SWITCHER LOGIC
			// Controls remain available beside the archive at every viewport.
			document.addEventListener("astro:page-load", () => {
				const toggles = document.querySelectorAll(".view-toggle");
				const containers = document.querySelectorAll(".view-container");

				toggles.forEach((btn) => {
					btn.addEventListener("click", () => {
						const view = btn.getAttribute("data-view");
						switchView(view);
					});
				});

				function switchView(mode: string | null) {
					// 1. Update Buttons
					toggles.forEach((btn) => {
						const isMatch = btn.getAttribute("data-view") === mode;
						btn.setAttribute("aria-pressed", String(isMatch));
						if (isMatch) {
							// Active State
							btn.classList.add("bg-white/10", "text-white");
							btn.classList.remove("text-neutral-400", "hover:text-white", "hover:bg-white/5");
						} else {
							// Inactive State
							btn.classList.remove("bg-white/10", "text-white");
							btn.classList.add("text-neutral-400", "hover:text-white", "hover:bg-white/5");
						}
					});

					// 2. Update Containers
					containers.forEach((element) => {
						const c = element;
						if (c.id === `view-${mode}`) {
							c.classList.remove("hidden");
						} else {
							c.classList.add("hidden");
						}
					});
				}
			});
		</script>

		<ScrollCoordinator />
	</div>
</BaseLayout>
