---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectDirectory from "../../components/Projects/ProjectDirectory.astro";
import FilterPanel from "../../components/Projects/FilterPanel.astro";

const allProjects = await getCollection("projects", ({ data }) => !data.draft);
const projects = allProjects.sort(
	(a, b) => new Date(b.data.date || 0).getTime() - new Date(a.data.date || 0).getTime(),
);

// Extract Facets for the UI
const industries = [...new Set(projects.map((p) => p.data.industry).filter(Boolean))].sort();
const tools = [...new Set(projects.flatMap((p) => p.data.tools).filter(Boolean))].sort();
// Merge Employer and Client into one list
const allClients = projects.flatMap((p) => {
	const c = p.data.client || [];
	const e = p.data.employer ? [p.data.employer] : [];
	return [...c, ...e];
});
const clients = [...new Set(allClients.filter(Boolean))].sort();
const statuses = ["Mass Production", "Manufacturing Prep", "Prototyping", "Concept"]; // Ordered logic
---

<BaseLayout title="Projects" description="Engineering Archive">
	<div class="site-container pt-32 pb-24 md:pb-36">
		<div class="mx-auto mb-12 max-w-4xl text-center">
			<h1 class="h1 mb-4">Projects</h1>
			<p class="text-muted-foreground text-lg">
				Archive of {projects.length} Engineering Projects
			</p>
		</div>

		<div class="mb-8 flex flex-col gap-6">
			<div class="relative w-full">
				<svg
					xmlns="http://www.w3.org/2000/svg"
					class="absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-neutral-500"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg
				>
				<input
					type="text"
					id="project-search"
					placeholder="Search projects..."
					class="focus:border-primary focus:ring-primary h-10 w-full rounded-lg border border-neutral-800 bg-neutral-900 py-2 pr-4 pl-10 text-sm text-white placeholder-neutral-500 transition-colors focus:ring-1 focus:outline-none"
				/>
			</div>

			<FilterPanel sectors={industries} tools={tools} clients={clients} />
		</div>

		<!-- Project Directory Table -->
		<div id="projects-container">
			<ProjectDirectory projects={projects} />
		</div>
	</div>

	<div
		class="mt-12 flex hidden items-center justify-center gap-4 text-center"
		id="pagination-controls"
	>
		<button
			id="prev-btn"
			class="flex items-center gap-2 rounded-lg border border-neutral-800 bg-neutral-900 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-neutral-800 disabled:cursor-not-allowed disabled:opacity-50"
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				width="16"
				height="16"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg
			>
			Prev
		</button>

		<span id="page-indicator" class="font-mono text-sm text-neutral-500">Page 1</span>

		<button
			id="next-btn"
			class="flex items-center gap-2 rounded-lg border border-neutral-800 bg-neutral-900 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-neutral-800 disabled:cursor-not-allowed disabled:opacity-50"
		>
			Next
			<svg
				xmlns="http://www.w3.org/2000/svg"
				width="16"
				height="16"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg
			>
		</button>
	</div>
</BaseLayout>

<script>
	document.addEventListener("astro:page-load", () => {
		// Target rows instead of cards
		const rows = Array.from(document.querySelectorAll(".project-row")) as HTMLElement[];
		const buttons = document.querySelectorAll(".filter-btn");
		const searchInput = document.getElementById("project-search") as HTMLInputElement;

		const prevBtn = document.getElementById("prev-btn") as HTMLButtonElement;
		const nextBtn = document.getElementById("next-btn") as HTMLButtonElement;
		const pageIndicator = document.getElementById("page-indicator");
		const controls = document.getElementById("pagination-controls");

		if (rows.length === 0) return;
		if (controls) controls.classList.remove("hidden");

		// State
		let filters = { industry: "all", tool: "all", status: "all", client: "all", search: "" };
		let currentPage = 1;
		const itemsPerPage = 15; // Increased for list view

		// URL Params Logic - Run BEFORE initial update
		const urlParams = new URLSearchParams(window.location.search);
		const clientParam = urlParams.get("client");
		if (clientParam) {
			// Decode URI component to handle spaces (e.g. "Consumer Appliances")
			const decodedClient = decodeURIComponent(clientParam);
			filters.client = decodedClient;

			// Set active state on the button immediately
			const btn = document.querySelector(
				`.filter-btn[data-group="client"][data-filter="${decodedClient}"]`,
			);
			if (btn) {
				btn.setAttribute("data-active", "true");
				// Deactivate "All"
				document
					.querySelector(`.filter-btn[data-group="client"][data-filter="all"]`)
					?.setAttribute("data-active", "false");
			}
		}

		function renderActiveFilters() {
			const display = document.getElementById("active-filters-display");
			if (!display) return;

			const activeKeys = Object.entries(filters).filter(
				([key, val]) => key !== "search" && val !== "all",
			);

			if (activeKeys.length === 0) {
				display.innerHTML = '<span class="font-mono text-xs text-neutral-400">NONE</span>';
				return;
			}

			display.innerHTML = "";
			activeKeys.forEach(([key, val]) => {
				const span = document.createElement("span");
				span.className = "font-mono text-xs text-primary";
				span.innerText = `[ ${val} ]`;

				// Add clear button for this filter
				const clear = document.createElement("button");
				clear.className = "ml-1 hover:text-white";
				clear.innerHTML = "&times;";
				clear.onclick = (e) => {
					e.stopPropagation();
					const btn = document.querySelector(
						`.filter-btn[data-group="${key}"][data-filter="all"]`,
					) as HTMLElement;
					if (btn) btn.click();
				};
				span.appendChild(clear);

				display.appendChild(span);
			});

			// Add "View All" / Reset button
			const resetBtn = document.createElement("button");
			resetBtn.className =
				"ml-4 font-mono text-xs text-neutral-500 hover:text-white underline decoration-dotted underline-offset-4";
			resetBtn.innerText = "RESET VIEW";
			resetBtn.onclick = () => {
				document.querySelectorAll('.filter-btn[data-filter="all"]').forEach((b: any) => b.click());
				// Clear URL params
				window.history.replaceState({}, "", window.location.pathname);
			};
			display.appendChild(resetBtn);
		}

		function update() {
			// Filter
			const active = rows.filter((row) => {
				const d = row.dataset;
				const rowTools = JSON.parse(d.tool || "[]");
				const rowClients = JSON.parse(d.client || "[]"); // Assuming client is array

				// Find title in the second cell (index 1)
				const titleCell = row.children[1] as HTMLElement;
				const rowTitle = titleCell?.innerText.toLowerCase() || "";

				const matchInd = filters.industry === "all" || d.industry === filters.industry;
				const matchStatus = filters.status === "all" || d.status === filters.status;
				const matchTool = filters.tool === "all" || rowTools.includes(filters.tool);
				const matchClient = filters.client === "all" || rowClients.includes(filters.client);

				const searchLower = filters.search.toLowerCase();
				const matchSearch =
					!searchLower ||
					rowTitle.includes(searchLower) ||
					rowTools.some((t: string) => t.toLowerCase().includes(searchLower));

				return matchInd && matchStatus && matchTool && matchClient && matchSearch;
			});

			// Pagination Logic
			const totalPages = Math.ceil(active.length / itemsPerPage);
			if (currentPage > totalPages) currentPage = 1;
			if (currentPage < 1) currentPage = 1;

			const start = (currentPage - 1) * itemsPerPage;
			const end = start + itemsPerPage;
			const visibleItems = active.slice(start, end);

			// Render
			rows.forEach((r) => (r.style.display = "none"));
			visibleItems.forEach((r) => {
				r.style.display = "table-row"; // Must be table-row for tables
				r.animate(
					[
						{ opacity: 0, transform: "translateX(-10px)" },
						{ opacity: 1, transform: "translateX(0)" },
					],
					{ duration: 200 },
				);
			});

			// UI Updates
			if (pageIndicator) pageIndicator.innerText = `Page ${currentPage} of ${totalPages || 1}`;

			if (prevBtn) {
				prevBtn.disabled = currentPage <= 1;
				prevBtn.style.display = totalPages > 1 ? "flex" : "none";
			}
			if (nextBtn) {
				nextBtn.disabled = currentPage >= totalPages;
				nextBtn.style.display = totalPages > 1 ? "flex" : "none";
			}
			if (pageIndicator) {
				pageIndicator.style.display = totalPages > 1 ? "inline" : "none";
			}

			renderActiveFilters();
		}

		// Init
		update();

		// Events
		prevBtn?.addEventListener("click", () => {
			if (currentPage > 1) {
				currentPage--;
				update();
				window.scrollTo({ top: 0, behavior: "smooth" });
			}
		});

		nextBtn?.addEventListener("click", () => {
			currentPage++;
			update();
			window.scrollTo({ top: 0, behavior: "smooth" });
		});

		searchInput?.addEventListener("input", (e) => {
			filters.search = (e.target as HTMLInputElement).value;
			currentPage = 1;
			update();
		});

		buttons.forEach((btn) => {
			btn.addEventListener("click", () => {
				const group = btn.getAttribute("data-group");
				const val = btn.getAttribute("data-filter");
				if (!group || !val) return;

				// UI Toggle
				document.querySelectorAll(`.filter-btn[data-group="${group}"]`).forEach((b) => {
					b.setAttribute("data-active", "false");
				});
				btn.setAttribute("data-active", "true");

				// Logic Update
				filters[group as keyof typeof filters] = val;
				currentPage = 1;
				update();
			});
		});
	});
</script>

<style>
	@reference "../../styles/global.css";
	.filter-btn.active {
		@apply bg-primary ring-primary text-black ring-2;
	}
</style>
