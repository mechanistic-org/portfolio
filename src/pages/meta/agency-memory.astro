---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { marked } from "marked";

// Use Vite's import.meta.glob instead of node:fs to be Edge compatible
// We grab all metadata.json and nested .md files inside the symlinked target
const metadataFiles = import.meta.glob("../../content/_agency_memory/**/metadata.json", {
  eager: true,
  query: "?raw",
  import: "default",
});

const artifactFiles = import.meta.glob("../../content/_agency_memory/**/artifacts/**/*.md", {
  eager: true,
  query: "?raw",
  import: "default",
});

type KI = {
  slug: string;
  title: string;
  summary: string;
  files: { name: string; content: string }[];
};

const processedKIs: Record<string, KI> = {};

// Parse Metadata
for (const [filePath, rawContent] of Object.entries(metadataFiles)) {
  const parts = filePath.split("/");
  // e.g. ../../content/_agency_memory/en_os_technical_ecosystem/metadata.json
  const slug = parts[parts.length - 2];
  
  const parsed = JSON.parse(rawContent as string);
  processedKIs[slug] = {
    slug,
    title: parsed.title || "UNKNOWN CLUSTER",
    summary: parsed.summary || "Data Missing",
    files: [],
  };
}

// Parse Markdown Rules
for (const [filePath, rawContent] of Object.entries(artifactFiles)) {
  const parts = filePath.split("/");
  // Find which slug this artifact belongs to (the folder under _agency_memory)
  const memoryIndex = parts.indexOf("_agency_memory");
  if (memoryIndex === -1) continue;
  
  const slug = parts[memoryIndex + 1];
  const fileName = parts[parts.length - 1];
  
  if (processedKIs[slug]) {
    processedKIs[slug].files.push({
      name: fileName,
      content: marked.parse(rawContent as string) as string,
    });
  }
}

const knowledgeItems = Object.values(processedKIs);

// Universal Taxonomy Filter (Issue #5)
// We stratify the AI's God-Brain into 3 Sovereign Filters
const taxonomy = {
  ERIKNORRIS: [] as KI[],
  MECHANISTIC: [] as KI[],
  MOOTMOAT: [] as KI[],
  MOREPLAY: [] as KI[], // The Playground
  UNASSIGNED: [] as KI[], // The Catch-all
};

knowledgeItems.forEach((ki) => {
  const searchableText = `${ki.slug} ${ki.title} ${ki.summary}`.toLowerCase();
  
  if (searchableText.includes("mechanistic") || searchableText.includes("c-suite") || searchableText.includes("round table")) {
    taxonomy.MECHANISTIC.push(ki);
  } else if (searchableText.includes("mootmoat")) {
    taxonomy.MOOTMOAT.push(ki);
  } else if (searchableText.includes("moreplay")) {
    taxonomy.MOREPLAY.push(ki);
  } else if (searchableText.includes("eriknorris") || searchableText.includes("en-os") || searchableText.includes("sovereign asset") || searchableText.includes("r2")) {
    // Note: User explicitly defined R2 / Sovereign Asset constraints as derived from ERIKNORRIS
    taxonomy.ERIKNORRIS.push(ki);
  } else {
    // If it doesn't clearly match, default it to the Core System
    taxonomy.ERIKNORRIS.push(ki);
  }
});
---

<BaseLayout title="Agency Memory (Raw)" description="A raw read of the AI SWARM Knowledge Items.">
  <section class="max-w-4xl mx-auto px-4 py-8">
    <div class="mb-12 border-b border-[#333] pb-8">
      <h1 class="font-mono text-[11px] text-[#A0A0A0] tracking-widest uppercase mb-4">
        Zero Trust Cluster // Agency Memory
      </h1>
      <h2 class="font-sans text-3xl font-bold tracking-tight text-white m-0">
        The Constitution ("The Gold")
      </h2>
      <p class="font-sans text-[15px] font-normal text-[#B0B0B0] mt-4 leading-relaxed max-w-2xl">
        This is a brutalist, zero-abstraction read of the IDE's true physical subsystem (`.gemini/knowledge`). 
        No UI components. No CMS databases. Just raw parsed Markdown rules auto-generated by the Forensic Miner.
        <br/><br/>
        <strong class="text-[#F3B04A]">[ISSUE #5: THE GREAT RENAMING]</strong> The AI God-Brain is unified, but Contextual Sovereignty is strictly enforced via Semantic Filtering below. EN-OS is deprecated. Welcome to the Universe.
      </p>
    </div>

    <!-- The Feed (Taxonomy Pillars) -->
    <div class="space-y-24">
      {
        knowledgeItems.length === 0 ? (
          <div class="border border-[#333] p-8 text-center">
            <p class="font-mono text-xs text-[#FF3E3E] uppercase">
              ERR_EMPTY_CLUSTER: Run <code class="bg-[#111] px-1">python scripts/sync_agency_memory.py</code> to hydrate the node.
            </p>
          </div>
        ) : (
          Object.entries(taxonomy).map(([domain, kis]) => {
            if (kis.length === 0) return null;
            
            return (
              <div class="domain-silo border border-[#222] bg-[#050505]">
                <div class="bg-[#111] border-b border-[#222] p-4 flex items-center justify-between sticky top-0 z-20">
                  <h3 class="font-mono text-sm tracking-widest text-[#EAEAEA]">[{domain}]</h3>
                  <span class="font-mono text-xs text-[#666]">{kis.length} Core Directives</span>
                </div>
                
                <div class="p-8 space-y-16">
                  {kis.map((ki: any) => (
                    <article class="relative">
                      {/* Timeline Stem */}
                      <div class="absolute left-0 top-0 bottom-0 w-px bg-[#333]" />

                      <div class="pl-8">
                        {/* Header Node */}
                        <div class="mb-6">
                          <div class="absolute w-2 h-2 bg-[#F3B04A] left-[-3px] top-[14px]" />
                          <h4 class="font-sans text-xl font-bold text-[#EAEAEA] mb-2">{ki.title}</h4>
                          <p class="font-mono text-xs text-[#808080] bg-[#111] p-3 border border-[#222] italic">
                            {ki.summary}
                          </p>
                        </div>

                        {/* The Rules (The Markdown) */}
                        <div class="space-y-4">
                          {ki.files.map((file: any) => (
                            <details class="group bg-[#0A0A0A] border border-[#222] open:border-[#444] transition-colors relative z-10">
                              <summary class="cursor-pointer font-mono text-xs text-[#A0A0A0] p-4 flex items-center justify-between hover:bg-[#111]">
                                <span>[FILE] {file.name}</span>
                                <span class="text-[#444] group-open:text-[#A0A0A0]">┼</span>
                              </summary>
                              <div class="p-6 border-t border-[#222] prose prose-invert prose-sm max-w-none prose-p:text-[#B0B0B0] prose-li:text-[#B0B0B0] prose-headings:text-[#DDDDDD] prose-a:text-[#F3B04A]">
                                <div set:html={file.content} />
                              </div>
                            </details>
                          ))}
                        </div>
                      </div>
                    </article>
                  ))}
                </div>
              </div>
            );
          })
        )
      }
    </div>
  </section>
</BaseLayout>
