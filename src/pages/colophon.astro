---
import Layout from "@layouts/BaseLayout.astro";
import Button from "@components/Button/Button.astro";

const tools = [
  "VS Code", "GitHub", "Cloudflare Pages", "Cloudflare R2", "Python", 
  "Astro v5", "React", "Tailwind CSS v4", "Recharts", "Google Gemini", 
  "Google Antigravity", "Namecheap", "NPM", "Node.js", "TypeScript"
];

// Duplicate for marquee loop
const marqueeTools = [...tools, ...tools, ...tools];
---

<Layout title="Colophon" description="How this site was built: Architecture and Stack.">
  
  <section class="relative pt-32 pb-24 border-b border-neutral-800 bg-neutral-900/30">
    <div class="site-container text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-primary/30 bg-primary/10 text-primary text-xs font-mono uppercase tracking-widest mb-6">
            System Architecture
        </div>
        <h1 class="text-5xl md:text-7xl font-bold text-white mb-8 tracking-tight">
            The Machine <br/><span class="text-neutral-500">Behind the Curtain</span>
        </h1>
        <p class="text-xl text-neutral-400 max-w-2xl mx-auto">
            This isn't just a portfolio template. It's a custom-engineered, data-driven static site generator powered by a relational CSV database and automated Python pipelines.
        </p>
    </div>
  </section>

  <div class="w-full py-8 border-y border-neutral-800 bg-neutral-950 overflow-hidden">
      <div class="flex gap-12 w-max animate-marquee items-center">
          {marqueeTools.map((tool) => (
              <div class="text-lg font-mono font-bold text-neutral-600 uppercase tracking-wider whitespace-nowrap">
                  {tool}
              </div>
          ))}
      </div>
  </div>

  <section class="site-container py-24">
      <div class="grid md:grid-cols-2 gap-16 items-center">
          <div>
              <h2 class="h2 mb-6">The Data Pipeline</h2>
              <p class="text-neutral-400 mb-6 text-lg">
                  Most portfolios are hard-coded HTML or locked in a CMS database. This site treats <strong>Google Sheets</strong> as a headless CMS.
              </p>
              <ul class="space-y-4 text-neutral-300">
                  <li class="flex gap-3">
                      <span class="text-primary">01.</span>
                      <span><strong>Input:</strong> Raw project data, skills, and history are managed in a multi-tab Google Sheet.</span>
                  </li>
                  <li class="flex gap-3">
                      <span class="text-primary">02.</span>
                      <span><strong>Ingest:</strong> A custom Python script (<code>ingest_data.py</code>) parses 8 relational CSVs, normalizing headers and mapping relationships.</span>
                  </li>
                  <li class="flex gap-3">
                      <span class="text-primary">03.</span>
                      <span><strong>Build:</strong> Astro v5 generates 89+ static pages, injecting Recharts visualizations and 3D models at build time.</span>
                  </li>
                  <li class="flex gap-3">
                      <span class="text-primary">04.</span>
                      <span><strong>Deploy:</strong> The final artifact is pushed to Cloudflare Pages for global edge delivery.</span>
                  </li>
              </ul>
          </div>
          
          <div class="bg-neutral-900/50 border border-neutral-800 rounded-xl p-8 relative">
              <div class="absolute top-0 left-0 w-full h-full bg-[url('/assets/grid.svg')] opacity-10"></div>
              
              <div class="flex flex-col gap-4 relative z-10">
                  <div class="p-4 bg-green-900/20 border border-green-500/30 rounded text-green-400 font-mono text-center">
                      Google Sheets (Source)
                  </div>
                  <div class="h-8 w-px bg-neutral-700 mx-auto"></div>
                  <div class="p-4 bg-blue-900/20 border border-blue-500/30 rounded text-blue-400 font-mono text-center">
                      Python Ingestion Engine
                  </div>
                  <div class="h-8 w-px bg-neutral-700 mx-auto"></div>
                  <div class="grid grid-cols-2 gap-4">
                      <div class="p-4 bg-neutral-800 border border-neutral-700 rounded text-neutral-300 font-mono text-center text-sm">
                          JSON Data
                      </div>
                      <div class="p-4 bg-neutral-800 border border-neutral-700 rounded text-neutral-300 font-mono text-center text-sm">
                          MDX Content
                      </div>
                  </div>
                  <div class="h-8 w-px bg-neutral-700 mx-auto"></div>
                  <div class="p-4 bg-purple-900/20 border border-purple-500/30 rounded text-purple-400 font-mono text-center">
                      Astro v5 Build
                  </div>
              </div>
          </div>
      </div>
  </section>

  <section class="py-24 border-t border-neutral-800 bg-neutral-900/20">
      <div class="site-container">
          <h2 class="h2 text-center mb-16">The Stack</h2>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
              <div class="p-6 bg-neutral-950 border border-neutral-800 rounded-lg">
                  <div class="text-primary font-mono text-xs mb-2">Core Framework</div>
                  <div class="text-xl font-bold text-white">Astro v5</div>
              </div>
              <div class="p-6 bg-neutral-950 border border-neutral-800 rounded-lg">
                  <div class="text-primary font-mono text-xs mb-2">Styling</div>
                  <div class="text-xl font-bold text-white">Tailwind v4</div>
              </div>
              <div class="p-6 bg-neutral-950 border border-neutral-800 rounded-lg">
                  <div class="text-primary font-mono text-xs mb-2">Visualization</div>
                  <div class="text-xl font-bold text-white">React + Recharts</div>
              </div>
              <div class="p-6 bg-neutral-950 border border-neutral-800 rounded-lg">
                  <div class="text-primary font-mono text-xs mb-2">3D Engine</div>
                  <div class="text-xl font-bold text-white">Google Model-Viewer</div>
              </div>
              <div class="p-6 bg-neutral-950 border border-neutral-800 rounded-lg">
                  <div class="text-primary font-mono text-xs mb-2">Automation</div>
                  <div class="text-xl font-bold text-white">Python</div>
              </div>
              <div class="p-6 bg-neutral-950 border border-neutral-800 rounded-lg">
                  <div class="text-primary font-mono text-xs mb-2">Hosting</div>
                  <div class="text-xl font-bold text-white">Cloudflare Pages</div>
              </div>
              <div class="p-6 bg-neutral-950 border border-neutral-800 rounded-lg">
                  <div class="text-primary font-mono text-xs mb-2">Storage</div>
                  <div class="text-xl font-bold text-white">Cloudflare R2</div>
              </div>
              <div class="p-6 bg-neutral-950 border border-neutral-800 rounded-lg">
                  <div class="text-primary font-mono text-xs mb-2">AI Partner</div>
                  <div class="text-xl font-bold text-white">Gemini 1.5 Pro</div>
              </div>
          </div>
      </div>
  </section>

  <section class="site-container py-24 text-center">
      <h2 class="h2 mb-6">See the Source</h2>
      <p class="text-neutral-400 mb-8">
        While this is a private portfolio, the architecture is designed to be open.
      </p>
      <div class="flex justify-center gap-4">
          <Button href="/" variant="primary">Return Home</Button>
          <Button href="https://github.com/eriknorris" variant="outline" target="_blank">View GitHub</Button>
      </div>
  </section>

</Layout>

<style>
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .animate-marquee {
    animation: marquee 40s linear infinite;
  }
</style>