---
import Layout from "@layouts/BaseLayout.astro";
import Button from "@components/Button/Button.astro";
import Marquee from "@components/Marquee/Marquee";
import { getCollection } from "astro:content";

const features = (await getCollection("colophon")).sort((a, b) => a.data.order - b.data.order);

const renderedFeatures = await Promise.all(
	features.map(async (feature) => {
		const { Content } = await feature.render();
		return {
			...feature.data,
			Content,
		};
	}),
);

const tools = [
	"VS Code",
	"GitHub",
	"Cloudflare Pages",
	"Cloudflare R2",
	"Python",
	"Astro v5",
	"React",
	"Tailwind CSS v4",
	"Recharts",
	"Google Gemini",
	"Google Antigravity",
	"Namecheap",
	"NPM",
	"Node.js",
	"TypeScript",
];

// Duplicate for marquee loop
const marqueeTools = [...tools, ...tools, ...tools, ...tools, ...tools, ...tools]; // Infinite loop (6x)
---

<Layout title="Colophon" description="How this site was built: Architecture and Stack.">
	<section class="border-border bg-muted/30 relative border-b pt-32 pb-24">
		<div class="site-container text-center">
			<div
				class="border-primary/30 bg-primary/10 text-primary mb-6 inline-flex items-center gap-2 rounded-full border px-3 py-1 font-mono text-xs tracking-widest uppercase"
			>
				System Architecture
			</div>
			<h1 class="mb-8 text-5xl font-bold tracking-tight text-white md:text-7xl">
				The Machine <br /><span class="text-neutral-500">Behind the Curtain</span>
			</h1>
			<p class="mb-6 text-lg text-neutral-400">
				Most portfolios are hard-coded HTML or locked in a CMS database. This site treats <strong
					>Google Sheets</strong
				> as a headless CMS.
			</p>
			<ul class="space-y-4 text-neutral-300">
				<li class="flex gap-3">
					<span class="text-primary">01.</span>
					<span
						><strong>Input:</strong> Raw project data, skills, and history are managed in a multi-tab
						Google Sheet.</span
					>
				</li>
				<li class="flex gap-3">
					<span class="text-primary">02.</span>
					<span
						><strong>Ingest:</strong> A custom Python script (<code>ingest_data.py</code>) parses 8
						relational CSVs, normalizing headers and mapping relationships.</span
					>
				</li>
				<li class="flex gap-3">
					<span class="text-primary">03.</span>
					<span
						><strong>Build:</strong> Astro v5 generates 89+ static pages, injecting Recharts visualizations
						and 3D models at build time.</span
					>
				</li>
				<li class="flex gap-3">
					<span class="text-primary">04.</span>
					<span
						><strong>Deploy:</strong> The final artifact is pushed to Cloudflare Pages for global edge
						delivery.</span
					>
				</li>
			</ul>
		</div>

		<div class="border-border bg-muted/50 mt-16 border-y py-6">
			<Marquee
				client:load
				speed={1}
				grayscale={true}
				items={marqueeTools.map((tool) => {
					const slugMap: Record<string, string> = {
						"Google Gemini": "googlegemini",
						"Google Antigravity": "google",
						"Astro v5": "astro",
						"Tailwind CSS v4": "tailwindcss",
						"Cloudflare Pages": "cloudflare",
						"Cloudflare R2": "cloudflare",
						"VS Code": "visualstudiocode",
						React: "react",
						Recharts: "react",
						Namecheap: "namecheap",
						NPM: "npm",
						"Node.js": "nodedotjs",
						TypeScript: "typescript",
						GitHub: "github",
						Python: "python",
					};

					const linkMap: Record<string, string> = {
						"VS Code": "https://code.visualstudio.com/",
						GitHub: "https://github.com/",
						"Cloudflare Pages": "https://pages.cloudflare.com/",
						"Cloudflare R2": "https://www.cloudflare.com/developer-platform/r2/",
						Python: "https://www.python.org/",
						"Astro v5": "https://astro.build/",
						React: "https://react.dev/",
						"Tailwind CSS v4": "https://tailwindcss.com/",
						Recharts: "https://recharts.org/",
						"Google Gemini": "https://deepmind.google/technologies/gemini/",
						"Google Antigravity": "https://antigravity.google/",
						Namecheap: "https://www.namecheap.com/",
						NPM: "https://www.npmjs.com/",
						"Node.js": "https://nodejs.org/",
						TypeScript: "https://www.typescriptlang.org/",
					};

					const slug =
						slugMap[tool] ||
						tool.toLowerCase().replace(/ /g, "").replace(/\./g, "").replace(/\+/g, "plus");

					return {
						id: tool,
						text: tool,
						image: `https://cdn.simpleicons.org/${slug}`,
						link: linkMap[tool],
						variant: "logo-only",
					};
				})}
			/>
		</div>

		<div class="site-container text-center">
			<div class="border-border bg-muted/50 relative mt-24 rounded-xl border p-8">
				<div class="absolute top-0 left-0 h-full w-full bg-[url('/assets/grid.svg')] opacity-10">
				</div>

				<div class="relative z-10 flex flex-col gap-4">
					<div
						class="rounded border border-green-500/30 bg-green-900/20 p-4 text-center font-mono text-green-400"
					>
						Google Sheets (Source)
					</div>
					<div class="mx-auto h-8 w-px bg-neutral-700"></div>
					<div
						class="rounded border border-blue-500/30 bg-blue-900/20 p-4 text-center font-mono text-blue-400"
					>
						Python Ingestion Engine
					</div>
					<div class="mx-auto h-8 w-px bg-neutral-700"></div>
					<div class="grid grid-cols-2 gap-4">
						<div
							class="rounded border border-neutral-700 bg-neutral-800 p-4 text-center font-mono text-sm text-neutral-300"
						>
							JSON Data
						</div>
						<div
							class="rounded border border-neutral-700 bg-neutral-800 p-4 text-center font-mono text-sm text-neutral-300"
						>
							MDX Content
						</div>
					</div>
					<div class="mx-auto h-8 w-px bg-neutral-700"></div>
					<div
						class="rounded border border-purple-500/30 bg-purple-900/20 p-4 text-center font-mono text-purple-400"
					>
						Astro v5 Build
					</div>
				</div>
			</div>
		</div>

		<section class="border-border bg-muted/20 border-t py-24">
			<div class="site-container">
				<h2 class="h2 mb-16 text-center">The Stack</h2>
				<div class="grid grid-cols-2 gap-4 md:grid-cols-4">
					<div class="border-border bg-card rounded-lg border p-6">
						<div class="text-primary mb-2 font-mono text-xs">Core Framework</div>
						<div class="text-xl font-bold text-white">Astro v5</div>
					</div>
					<div class="border-border bg-card rounded-lg border p-6">
						<div class="text-primary mb-2 font-mono text-xs">Styling</div>
						<div class="text-xl font-bold text-white">Tailwind v4</div>
					</div>
					<div class="border-border bg-card rounded-lg border p-6">
						<div class="text-primary mb-2 font-mono text-xs">Visualization</div>
						<div class="text-xl font-bold text-white">React + Recharts</div>
					</div>
					<div class="border-border bg-card rounded-lg border p-6">
						<div class="text-primary mb-2 font-mono text-xs">3D Engine</div>
						<div class="text-xl font-bold text-white">Google Model-Viewer</div>
					</div>
					<div class="border-border bg-card rounded-lg border p-6">
						<div class="text-primary mb-2 font-mono text-xs">Automation</div>
						<div class="text-xl font-bold text-white">Python</div>
					</div>
					<div class="border-border bg-card rounded-lg border p-6">
						<div class="text-primary mb-2 font-mono text-xs">Hosting</div>
						<div class="text-xl font-bold text-white">Cloudflare Pages</div>
					</div>
					<div class="border-border bg-card rounded-lg border p-6">
						<div class="text-primary mb-2 font-mono text-xs">Storage</div>
						<div class="text-xl font-bold text-white">Cloudflare R2</div>
					</div>
					<div class="border-border bg-card rounded-lg border p-6">
						<div class="text-primary mb-2 font-mono text-xs">AI Partner</div>
						<div class="text-xl font-bold text-white">Gemini 1.5 Pro</div>
					</div>
				</div>
			</div>
		</section>

		<section class="border-border bg-muted/30 border-t py-24">
			<div class="site-container">
				<h2 class="h2 mb-16 text-center">Meta-Features</h2>
				<div class="grid gap-8 md:grid-cols-3">
					<!-- Feature 1: The Pulse -->
					<div class="border-border bg-card relative overflow-hidden rounded-xl border p-8">
						<div
							class="mb-6 flex h-12 w-12 items-center justify-center rounded-full bg-green-500/10 text-green-500"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="24"
								height="24"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="lucide lucide-activity"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg
							>
						</div>
						<h3 class="text-xl font-bold text-white">The Pulse</h3>
						<p class="mt-2 font-mono text-sm text-green-400">Self-Aware Build Stats</p>
						<p class="mt-4 text-neutral-400">
							The site knows how fast it was built. The ingestion pipeline tracks its own runtime
							performance and stamps the footer with the exact build duration (e.g., "Built in
							0.42s").
						</p>
					</div>

					<!-- Feature 2: AR-Ready 3D -->
					<div class="border-border bg-card relative overflow-hidden rounded-xl border p-8">
						<div
							class="mb-6 flex h-12 w-12 items-center justify-center rounded-full bg-blue-500/10 text-blue-500"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="24"
								height="24"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="lucide lucide-box"
								><path
									d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"
								></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line
									x1="12"
									y1="22.08"
									x2="12"
									y2="12"></line></svg
							>
						</div>
						<h3 class="text-xl font-bold text-white">AR-Ready Viewer</h3>
						<p class="mt-2 font-mono text-sm text-blue-400">&lt;model-viewer&gt; Integration</p>
						<p class="mt-4 text-neutral-400">
							Zero-runtime 3D visualization. Assets are optimized for web delivery and support "View
							in Room" Augmented Reality on mobile devices, adapting lighting to the environment.
						</p>
					</div>

					<!-- Feature 3: The Physical Spec -->
					<div class="border-border bg-card relative overflow-hidden rounded-xl border p-8">
						<div
							class="mb-6 flex h-12 w-12 items-center justify-center rounded-full bg-purple-500/10 text-purple-500"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="24"
								height="24"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="lucide lucide-printer"
								><polyline points="6 9 6 2 18 2 18 9"></polyline><path
									d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"
								></path><rect width="12" height="8" x="6" y="14"></rect></svg
							>
						</div>
						<h3 class="text-xl font-bold text-white">The Physical Spec</h3>
						<p class="mt-2 font-mono text-sm text-purple-400">Print Mode Optimization</p>
						<p class="mt-4 text-neutral-400">
							The Datasheet is physical. Custom <code>@media print</code> styles strip the UI navigation
							and footer, reformatting the Project Detail page into a high-contrast, PDF-ready specification
							document.
						</p>
					</div>
				</div>
			</div>
		</section>

		<section class="site-container py-24 text-center">
			<h2 class="h2 mb-6">See the Source</h2>
			<p class="mb-8 text-neutral-400">
				While this is a private portfolio, the architecture is designed to be open.
			</p>
			<div class="flex justify-center gap-4">
				<Button href="/" variant="primary">Return Home</Button>
				<Button href="https://github.com/eriknorris" variant="outline" target="_blank"
					>View GitHub</Button
				>
			</div>
		</section>
	</section>
</Layout>
