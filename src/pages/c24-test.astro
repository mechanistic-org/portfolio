---
import { getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BananaDefect from '@/components/c24/BananaDefect.astro';

// Fetch the C24 project data
const project = await getEntry('projects', 'c24');

if (!project) {
  throw new Error("C24 project not found in content collection.");
}
---

<BaseLayout title="C|24 Banana Defect Test" description="Testing the new scrollytelling component">
  <div class="pt-24 pb-12">
    <div class="container mx-auto px-4 mb-8">
      <h1 class="text-3xl font-bold font-mono text-slate-200">Test Page: BananaDefect.astro</h1>
      <p class="text-slate-400 font-mono mt-2">Checking brutalist styling and dynamic data injection.</p>
    </div>
    
    {/* Mount the component and pass the project data */}
    <BananaDefect project={project} />
    
  </div>
</BaseLayout>
