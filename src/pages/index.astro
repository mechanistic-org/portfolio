---
/**
 * * Homepage
 * Engineering Portfolio: 3D Hero + Featured Projects + Datasheet Access
 */

import { getCollection } from "astro:content";
import Layout from "@layouts/BaseLayout.astro";
// 👇 FIXED: Capitalized 'Hero' to match your folder structure
import Hero from "@components/Hero/HeroSideImage.astro";
import ProjectCard from "@components/projects/ProjectCard.astro";
// 👇 FIXED: Capitalized 'Button' to match your folder structure
import Button from "@components/Button/Button.astro";

// 1. Get Projects instead of Blog Posts
const allProjects = await getCollection("projects", ({ data }) => {
  return data.draft !== true;
});

// Sort by Date and take top 3 recent projects
const recentProjects = allProjects
  .sort((a, b) => new Date(b.data.date || 0).getTime() - new Date(a.data.date || 0).getTime())
  .slice(0, 3);
---

<Layout title="Home" description="Mechanical Design Engineer Portfolio">
  
  <Hero />

  <section class="site-container py-12 md:py-24">
    <div class="flex items-center justify-between mb-8">
      <h2 class="h2">Recent Field Notes</h2>
      <Button href="/projects/" variant="outline" arrow="right">
        View Archive
      </Button>
    </div>
    
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {recentProjects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>

  <section class="site-container py-12 md:py-24 border-t border-neutral-800">
    <div class="grid md:grid-cols-2 gap-8">
      
      <div class="bg-neutral-900/50 border border-neutral-800 rounded-xl p-8 flex flex-col justify-between">
        <div>
          <h3 class="text-xl font-bold text-white mb-2">Technical Specifications</h3>
          <p class="text-neutral-400 mb-6">
            Download the complete Interface Control Document (ICD) for Erik Norris. 
            Includes full work history, patent list, and skill matrix.
          </p>
        </div>
        <div>
          <Button href="https://assets.eriknorris.com/resume/Erik_Norris_CV.pdf" target="_blank" variant="primary">
            Download Datasheet (PDF)
          </Button>
          <p class="text-xs text-neutral-600 mt-3 font-mono">DOC ID: EN-SPEC-V1.0</p>
        </div>
      </div>

      <div class="bg-blue-900/20 border border-blue-500/30 rounded-xl p-8 flex flex-col justify-between relative overflow-hidden group">
        <div class="absolute top-0 right-0 -mt-4 -mr-4 w-24 h-24 bg-blue-500/20 blur-3xl rounded-full group-hover:bg-blue-500/30 transition-all"></div>
        
        <div>
          <h3 class="text-xl font-bold text-white mb-2">Secure Uplink</h3>
          <p class="text-neutral-300 mb-6">
            Connect via encrypted channel (LinkedIn) for consulting inquiries, 
            collaboration opportunities, or schematic reviews.
          </p>
        </div>
        
        <div class="flex items-center gap-4">
          <a 
            href="https://www.linkedin.com/in/eriknorris/" 
            target="_blank"
            class="flex items-center gap-2 bg-[#0077b5] hover:bg-[#006396] text-white px-5 py-2.5 rounded-lg font-medium transition-all hover:scale-105"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            Connect on LinkedIn
          </a>
        </div>
      </div>

    </div>
  </section>
</Layout>