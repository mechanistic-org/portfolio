---
import { getCollection } from "astro:content";
import Layout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero/HeroSideImage.astro";
import ProjectCard from "@components/Projects/ProjectCard.astro";
import ProjectStrip from "@components/Projects/ProjectStrip.tsx";
import Button from "@components/Button/Button.astro";
import ClientGrid from "../components/About/Clients.astro";

const allProjects = await getCollection("projects", ({ data }) => !data.draft);
const recentProjects = allProjects.sort(
	(a, b) => new Date(b.data.date || 0).getTime() - new Date(a.data.date || 0).getTime(),
);
---

<Layout title="Home" description="Mechanical Design Engineer Portfolio">
	<Hero />

	<ClientGrid />

	<section class="w-full py-8 md:py-16">
		<ProjectStrip client:load projects={recentProjects} />
	</section>
</Layout>
