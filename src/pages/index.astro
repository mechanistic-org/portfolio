---
export const prerender = true;
import Layout from "../layouts/BaseLayout.astro";
import { getCareerAssembly } from "../utils/mapCareerAssembly";
import HXOSwarmContainer from "../components/HXO/HXOSwarmContainer";
import HXOConsole from "../components/HXO/HXOConsole";
import { projectPeriod } from "../utils/projectDates";
import { getCollection } from "astro:content";
import { routeEligibleProjects, careerRecords } from "../utils/projectRoster";
import { careerIdentityAliases } from "../config/projectArticleTrial";
import { currentSite } from "@config/site_config";
import siteData from "@config/siteData.json";
import UnderConstruction from "../components/UnderConstruction.astro";

const isUnderConstruction = currentSite !== "main";

// Initialize empty
let swarmNodes: any[] = [];
let consoleProjects: any[] = [];

const careerNodes = careerRecords(
	routeEligibleProjects(await getCollection("projects"), currentSite),
	careerIdentityAliases,
);
const careerIds = new Set(careerNodes.map((node) => node.id));

if (!isUnderConstruction) {
	// 1. FETCH SOURCE OF TRUTH (The Assembly)
	const assembly = await getCareerAssembly();
	const visibleProjectNodes = assembly.nodes
		.filter((n) => n.type === "project")
		.filter((n) => careerIds.has(n.id))
		.filter((n) => {
			const targets = n.data.targets || ["main"];
			return targets.includes(currentSite);
		})
		.filter((n) => n.data.employer !== "erik_norris" && n.id !== "meta/philosophy");

	// 2. ADAPTER: Transform for Swarm (MultiverseNode)
	swarmNodes = visibleProjectNodes.map((n) => {
		const period = projectPeriod(n.id, n.data);
		return {
			id: n.id,
			name: n.data.title,
			group: n.data.employer === "erik_norris" ? "meta" : n.data.employer || "Private", // Custom Group for Color
			start_date: period.start ?? "",
			end_date: period.end ?? "",
			period_basis: period.basis,
			value: n.data.employer === "erik_norris" ? 60 : 20, // Bigger Mass for Bio
			tier: n.data.tier,
			// Pass-throughs
			category: n.data.category,
			type: "project", // Explicit Type
			// NEW: Pass explicit skills for Ghost Connections
			skills: [...(n.data.tags || [])],
		};
	});

	// 3. ADAPTER: Transform for Console (ConsoleProject)
	consoleProjects = visibleProjectNodes.map((n) => ({
		id: n.id,
		data: n.data,
	}));
}
---

{
	isUnderConstruction ? (
		<UnderConstruction />
	) : (
		<Layout
			title={siteData.title}
			description={siteData.description}
			hideNavLogo={false}
			starfield={true}
		>
			<div class="hxo-homepage min-h-screen max-w-[100vw] overflow-x-clip bg-transparent font-sans text-zinc-300 selection:bg-lime-900 selection:text-white">
				<h1 class="sr-only">Erik Norris · Work</h1>
				<main class="grid grid-cols-1 lg:h-screen lg:grid-cols-12 lg:overflow-hidden">
					{/* LEFT: THE SWARM (Navigation / Map) */}
					{/* The hydrated swarm may grow below lg; without JavaScript this remains one hero stage. */}
					<div
						id="career-map"
						class="hxo-swarm-stage custom-scrollbar relative min-h-svh border-r border-zinc-900 bg-transparent lg:col-span-7 lg:h-screen lg:overflow-x-hidden lg:overflow-y-auto"
					>
						<HXOSwarmContainer client:only="react" nodes={swarmNodes}>
							<div
								slot="fallback"
								class="swarm-fallback flex min-h-svh flex-col justify-center gap-6 p-8"
							>
								<h2 class="font-display text-2xl text-white">Explore the engineering work</h2>
								<p class="max-w-sm text-sm text-zinc-400">
									Browse the complete project archive, or follow a project in the career timeline.
								</p>
								<a href="/projects/" class="text-lime-400 underline underline-offset-4">
									Browse all projects →
								</a>
							</div>
						</HXOSwarmContainer>
					</div>

					{/* RIGHT: THE CONSOLE (Details / Index) */}
					{/* Must start below the 5rem Nav and fill the rest without overflow */}
					<div class="hxo-console-stage relative z-30 flex flex-col bg-transparent lg:col-span-5 lg:mt-16 lg:h-[calc(100vh-4rem)]">
						<HXOConsole
							client:load
							projects={consoleProjects}
							careerNodes={careerNodes}
							projectAliases={careerIdentityAliases}
						/>
					</div>
				</main>
			</div>
		</Layout>
	)
}

<style>
	/* Quick helper for scrollbar */
	.custom-scrollbar::-webkit-scrollbar {
		width: 6px;
	}
	.custom-scrollbar::-webkit-scrollbar-track {
		background: #111;
	}
	.custom-scrollbar::-webkit-scrollbar-thumb {
		background: #333;
		border-radius: 3px;
	}
	.custom-scrollbar::-webkit-scrollbar-thumb:hover {
		background: #444;
	}
</style>

<style is:global>
	.hxo-homepage {
		overflow-anchor: none;
	}
	.hxo-console-stage {
		scroll-margin-top: 4rem;
	}
	.node-group:focus {
		outline: none;
	}
	.node-group:focus-visible .focus-ring {
		opacity: 1;
		stroke: #e1e8f2;
		stroke-width: 1.5px;
	}
	.hxo-console-stage > astro-island {
		display: block;
		height: 100%;
		width: 100%;
	}

	/* The swarm remains client-only. The console is prerendered so its native
	   project anchors remain available without JavaScript. */
	@media (max-width: 1023px) {
		.hxo-swarm-stage > astro-island:has(> div) {
			display: block;
			width: 100%;
		}

		.hxo-console-stage > astro-island {
			height: max(48rem, calc(100svh - 4rem));
		}
	}
</style>
