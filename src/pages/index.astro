---
/**
 * THEME ENGINE ROUTER
 *
 * This file acts as the "Dispatcher" for the homepage.
 * It does not render content directly but decides WHICH theme to render based on:
 * 1. Query Parameter (?theme=classic or ?theme=hyperspace)
 * 2. Default Preference (Currently: Hyperspace)
 *
 * This architecture allows for multiple "front doors" to the same content.
 */

import StandardHome from "@components/Themes/StandardHome.astro";
import HyperspaceHome from "@components/Themes/HyperspaceHome.astro";

// Default Theme Strategy
// Change this string to 'classic' to default to the old site.
const DEFAULT_THEME = "hyperspace";

let activeTheme = DEFAULT_THEME;

// 1. Check Query Param (Highest Priority)
// usage: /?theme=classic
if (Astro.url.searchParams.has("theme")) {
	const requestedTheme = Astro.url.searchParams.get("theme");
	if (requestedTheme === "classic" || requestedTheme === "hyperspace") {
		activeTheme = requestedTheme;
	}
}

// Future: Check Cookie Logic here
---

{activeTheme === "classic" ? <StandardHome /> : <HyperspaceHome />}
