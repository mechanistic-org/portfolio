---
import BaseLayout from "@layouts/BaseLayout.astro";
import CustomTimeline from "@components/Resume/CustomTimeline.astro";
import workHistory from "../data/work_history.json";
import type { TimelineItem } from "../utils/timelineParser";

// Map JSON data to TimelineItem interface
const timelineItems: TimelineItem[] = workHistory.map((job) => {
	// Extract year for grouping (Assumes "M/D/YYYY" or similar format)
	const startYear = job.start.includes("/") ? job.start.split("/").pop() : job.start;
	const endYear =
		job.end === "Present" ? "Present" : job.end.includes("/") ? job.end.split("/").pop() : job.end;

	return {
		title: `${startYear} - ${endYear}`, // Format: "2022 - Present" to ensure grouping by Year
		cardTitle: `${job.title} @ ${job.company}`,
		cardSubtitle: job.description,
		cardDetailedText: job.description,
		responsibilities: [],
		keyProjects: [],
		techStack: [],
	};
});

const pageTitle = "Universal History";
const pageDescription =
	"A complete, interactive timeline of professional history generated from the 20-year Resume Corpus.";

export const prerender = true;
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<div class="site-container py-12">
		<div class="mb-12 text-center">
			<h1 class="font-heading mb-4 text-4xl font-bold text-white">Universal History</h1>
			<p class="mx-auto max-w-2xl text-neutral-400">
				An exhaustive, interactive chronology of every project, role, and shipment. Synthesized from
				over 200 archived documents (2002-2025).
			</p>
		</div>

		<div class="w-full">
			<CustomTimeline items={timelineItems} />
		</div>
	</div>
</BaseLayout>
