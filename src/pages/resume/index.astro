---
import { resumeMaster } from "../../config/resume_master";
import BaseLayout from "../../layouts/BaseLayout.astro";

const { header, summary, competencies, experience, education, patents } = resumeMaster;

// Helper to process markdown-style bolding in bullets
function processMarkdown(text: string) {
	// Simple replace for **bold**
	return text.replace(/\*\*(.*?)\*\*/g, '<strong class="font-bold text-black">$1</strong>');
}
---

<BaseLayout title="Resume | Erik Norris" description="Master Resume">
	<!-- 
    PRINT LAYOUT CONTAINER 
    - Forced white background
    - Standard letter size width approximation on screen
    - Print-specific overrides
  -->
	<div
		class="min-h-screen w-full bg-[#f2f2f2] p-12 pt-48 md:p-24 md:pt-48 print:bg-white print:p-0"
	>
		<!-- Top Centered Print Button -->
		<div class="mb-12 flex w-full justify-center print:hidden">
			<button
				onclick="window.print()"
				class="flex cursor-pointer items-center gap-2 rounded-full bg-black px-6 py-3 font-mono text-xs font-bold tracking-wider text-white uppercase shadow-xl transition-all hover:scale-105 hover:bg-neutral-800"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="16"
					height="16"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<path d="M6 9V2h12v7"></path>
					<path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"
					></path>
					<path d="M6 14h12v8H6z"></path>
				</svg>
				Save as PDF
			</button>
		</div>

		<div
			class="mx-auto max-w-[216mm] bg-white p-[12mm] shadow-2xl print:max-w-none print:shadow-none"
		>
			<!-- HEADER -->
			<header class="mb-6 flex items-start justify-between border-b-2 border-black pb-4">
				<div>
					<h1 class="font-sans text-4xl font-extrabold tracking-tight text-black uppercase">
						{header.name}
					</h1>
					<h2 class="mt-1 font-mono text-lg font-bold tracking-tighter text-neutral-800">
						{header.title}
					</h2>
					<p
						class="mt-4 hidden font-mono text-xs tracking-widest text-neutral-500 uppercase print:block"
					>
						// {header.tagline}
					</p>
				</div>

				<!-- Web-Only Controls -->
				<div class="flex flex-col items-end gap-2 print:hidden">
					<div class="text-right text-xs text-neutral-900">
						<div class="font-bold">{header.contact.phone}</div>
						<div>{header.contact.email}</div>
						<div>{header.contact.location}</div>
						<div class="text-primary-700 font-bold">{header.contact.portfolio}</div>
					</div>
				</div>

				<!-- Print-Only Contact Info -->
				<div class="hidden text-right text-xs text-neutral-900 print:block">
					<div class="font-bold">{header.contact.phone}</div>
					<div>{header.contact.email}</div>
					<div>{header.contact.location}</div>
					<div class="text-primary-700 font-bold">{header.contact.portfolio}</div>
				</div>
			</header>

			<!-- SUMMARY -->
			<section class="mb-6">
				<h3
					class="mb-2 border-b border-black/20 pb-1 font-sans text-sm font-bold tracking-wider text-black uppercase"
				>
					Professional Summary
				</h3>
				<p class="text-justify text-sm leading-relaxed text-neutral-900">
					{summary.executive}
				</p>
			</section>

			<!-- COMPETENCIES GRID -->
			<section class="mb-6">
				<h3
					class="mb-2 border-b border-black/20 pb-1 font-sans text-sm font-bold tracking-wider text-black uppercase"
				>
					Core Competencies
				</h3>
				<div class="grid grid-cols-3 gap-4 text-xs">
					<div>
						<div class="mb-1 font-bold text-black">ENGINEERING</div>
						<ul class="list-disc space-y-0.5 pl-3 text-black">
							{competencies.engineering.map((item) => <li>{item}</li>)}
						</ul>
					</div>
					<div>
						<div class="mb-1 font-bold text-black">MANUFACTURING</div>
						<ul class="list-disc space-y-0.5 pl-3 text-black">
							{competencies.manufacturing.map((item) => <li>{item}</li>)}
						</ul>
					</div>
					<div>
						<div class="mb-1 font-bold text-black">TOOLS & REGULATORY</div>
						<ul class="list-disc space-y-0.5 pl-3 text-black">
							{competencies.tools.map((item) => <li>{item}</li>)}
							<li class="h-1 list-none"></li>
							{competencies.regulatory.map((item) => <li>{item}</li>)}
						</ul>
					</div>
				</div>
			</section>

			<!-- EXPERIENCE -->
			<section class="mb-6">
				<h3
					class="mb-4 border-b border-black/20 pb-1 font-sans text-sm font-bold tracking-wider text-black uppercase"
				>
					Professional Experience
				</h3>

				<div class="space-y-5">
					{
						experience.map((role) => (
							<div class="break-inside-avoid">
								<div class="mb-1 flex items-baseline justify-between">
									<div class="text-base font-bold text-black">
										{role.company}
										<span class="mx-2 font-normal text-neutral-500">|</span>
										<span class="text-sm font-medium text-neutral-700">{role.title}</span>
									</div>
									<div class="font-mono text-xs text-neutral-700">{role.dates}</div>
								</div>

								{/* Context Blurb */}
								<div class="mb-2 border-l-2 border-neutral-300 pl-2 text-xs font-medium text-neutral-700 italic">
									{role.blurb}
								</div>

								{/* Bullets */}
								<ul class="list-disc space-y-1 pl-4 text-sm leading-snug text-neutral-900">
									{role.bullets.map((bullet) => (
										<li set:html={processMarkdown(bullet)} />
									))}
								</ul>
							</div>
						))
					}
				</div>
			</section>

			<!-- FOOTER / EDUCATION -->
			<section class="grid grid-cols-2 gap-8 border-t-2 border-black pt-4">
				<div>
					<h3 class="mb-2 font-sans text-xs font-bold tracking-wider text-black uppercase">
						Education
					</h3>
					{
						education.map((edu) => (
							<div class="text-xs text-black">
								<div class="font-bold">{edu.school}</div>
								<div>{edu.degree}</div>
							</div>
						))
					}
				</div>
				<div>
					<h3 class="mb-2 font-sans text-xs font-bold tracking-wider text-black uppercase">
						Awards & Patents
					</h3>
					<ul class="list-disc pl-3 text-xs text-black">
						{patents.map((pat) => <li>{pat}</li>)}
					</ul>
				</div>
			</section>
		</div>
	</div>
</BaseLayout>

<style>
	/* PRINT OVERRIDES */
	@media print {
		@page {
			margin: 0.5in;
			size: letter;
		}
		body {
			background: white;
		}
		/* Hide standard site nav/footer if they exist in BaseLayout */
		:global(nav),
		:global(footer:not(.resume-footer)) {
			display: none !important;
		}
	}
</style>
