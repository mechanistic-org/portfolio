---
import { resumeMaster } from "../../config/resume_master";

export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";

const { header, summary, competencies, experience, education, recognition } = resumeMaster;

// Helper to process markdown-style bolding in bullets
function processMarkdown(text: string) {
	// Simple replace for **bold**
	return text.replace(
		/\*\*(.*?)\*\*/g,
		'<strong class="font-bold text-black dark:text-white">$1</strong>',
	);
}
---

<BaseLayout title="Resume | Erik Norris" description="Master Resume" starfield={true}>
	<!-- 
    PRINT LAYOUT CONTAINER 
    - Forced white background
    - Standard letter size width approximation on screen
    - Print-specific overrides
  -->
	<div
		class="min-h-screen w-full bg-[#f2f2f2] p-12 pt-24 md:p-24 md:pt-24 dark:bg-transparent print:bg-white print:p-0"
	>
		<!-- Print Button Moved to Nav -->

		<div
			class="mx-auto max-w-[216mm] bg-white p-[12mm] shadow-2xl dark:bg-neutral-900 print:max-w-none print:shadow-none"
		>
			<!-- HEADER -->
			<header
				class="mb-6 flex items-start justify-between border-b-2 border-black pb-4 dark:border-neutral-700"
			>
				<div>
					<h1
						class="font-sans text-4xl font-extrabold tracking-tight text-black uppercase dark:text-white"
					>
						{header.name}
					</h1>
					<h2
						class="mt-1 font-mono text-base font-bold tracking-tighter whitespace-nowrap text-neutral-800 dark:text-neutral-300"
					>
						{header.title}
					</h2>
					<p
						class="mt-4 font-mono text-[10px] tracking-wider whitespace-nowrap text-neutral-500 uppercase md:block dark:text-neutral-400 print:block"
					>
						// {header.tagline}
					</p>
				</div>

				<!-- Web-Only Controls -->
				<div class="flex flex-col items-end gap-2 print:hidden">
					<div class="text-right text-xs text-neutral-900 dark:text-neutral-300">
						<div class="text-primary-700 dark:text-primary-400 font-bold">
							{header.contact.portfolio}
						</div>
						<div>{header.contact.email}</div>
						<div class="font-bold text-neutral-900 dark:text-white">{header.contact.resume}</div>
						<div>{header.contact.linkedin}</div>
						<div>{header.contact.github}</div>
						<div>{header.contact.location}</div>
					</div>
				</div>

				<!-- Print-Only Contact Info -->
				<div class="hidden text-right text-xs text-neutral-900 print:block">
					<div class="text-primary-700 font-bold">{header.contact.portfolio}</div>
					<div>{header.contact.email}</div>
					<div class="font-bold text-neutral-900">{header.contact.resume}</div>
					<div>{header.contact.linkedin}</div>
					<div>{header.contact.github}</div>
					<div>{header.contact.location}</div>
				</div>
			</header>

			<!-- SUMMARY -->
			<section class="mb-6">
				<h3
					class="mb-2 border-b border-black/20 pb-1 font-sans text-sm font-bold tracking-wider text-black uppercase dark:border-white/20 dark:text-white"
				>
					Professional Summary
				</h3>
				<div
					class="space-y-4 text-justify text-sm leading-relaxed text-neutral-900 dark:text-neutral-300"
				>
					{summary.executive.split("\n\n").map((paragraph) => <p>{paragraph}</p>)}
				</div>
			</section>

			<!-- COMPETENCIES GRID -->
			<section class="mb-6">
				<h3
					class="mb-2 border-b border-black/20 pb-1 font-sans text-sm font-bold tracking-wider text-black uppercase dark:border-white/20 dark:text-white"
				>
					Core Competencies
				</h3>
				<div class="grid grid-cols-3 gap-4 text-xs">
					<div>
						<div class="mb-1 font-bold text-black dark:text-white">ENGINEERING</div>
						<ul class="list-disc space-y-0.5 pl-3 text-black dark:text-neutral-300">
							{competencies.engineering.map((item) => <li>{item}</li>)}
						</ul>
					</div>
					<div>
						<div class="mb-1 font-bold text-black dark:text-white">MANUFACTURING</div>
						<ul class="list-disc space-y-0.5 pl-3 text-black dark:text-neutral-300">
							{competencies.manufacturing.map((item) => <li>{item}</li>)}
						</ul>
					</div>
					<div>
						<div class="mb-1 font-bold text-black dark:text-white">TOOLS & REGULATORY</div>
						<ul class="list-disc space-y-0.5 pl-3 text-black dark:text-neutral-300">
							{competencies.tools.map((item) => <li>{item}</li>)}
						</ul>
					</div>
				</div>
			</section>

			<!-- EXPERIENCE -->
			<section class="mb-6 print:break-before-page">
				<h3
					class="mb-4 border-b border-black/20 pb-1 font-sans text-sm font-bold tracking-wider text-black uppercase dark:border-white/20 dark:text-white"
				>
					Professional Experience
				</h3>

				<div class="space-y-5">
					{
						experience.map((role) => (
							<div class="break-inside-avoid">
								<div class="mb-1 flex items-baseline justify-between">
									<div class="text-base font-bold text-black dark:text-white">
										{role.company}
										<span class="mx-2 font-normal text-neutral-500">|</span>
										<span class="text-sm font-medium text-neutral-700 dark:text-neutral-400">
											{role.title}
										</span>
									</div>
									<div class="font-mono text-xs text-neutral-700 dark:text-neutral-400">
										{role.dates}
									</div>
								</div>

								{/* Context Blurb */}
								<div class="mb-2 border-l-2 border-neutral-300 pl-2 text-xs font-medium text-neutral-700 italic dark:border-neutral-700 dark:text-neutral-400">
									{role.blurb}
								</div>

								{/* Bullets */}
								<ul class="list-disc space-y-1 pl-4 text-sm leading-snug text-neutral-900 dark:text-neutral-300">
									{role.bullets.map((bullet) => (
										<li set:html={processMarkdown(bullet)} />
									))}
								</ul>
							</div>
						))
					}
				</div>
			</section>

			<!-- FOOTER / EDUCATION -->
			<section class="grid grid-cols-2 gap-8 border-t-2 border-black pt-4 dark:border-neutral-700">
				<div>
					<h3
						class="mb-2 font-sans text-xs font-bold tracking-wider text-black uppercase dark:text-white"
					>
						Education
					</h3>
					{
						education.map((edu) => (
							<div class="text-xs text-black dark:text-neutral-300">
								<div class="font-bold">{edu.school}</div>
								<div>{edu.degree}</div>
							</div>
						))
					}
				</div>
				<div>
					<h3
						class="mb-2 font-sans text-xs font-bold tracking-wider text-black uppercase dark:text-white"
					>
						Recognition
					</h3>
					<ul class="list-disc pl-3 text-xs text-black dark:text-neutral-300">
						{recognition.map((item) => <li>{item}</li>)}
					</ul>
				</div>
			</section>
		</div>
	</div>
</BaseLayout>

<style>
	/* PRINT OVERRIDES */
	@media print {
		@page {
			margin: 0.5in;
			size: letter;
		}
		body {
			background: white;
		}
		/* Hide standard site nav/footer if they exist in BaseLayout */
		:global(nav),
		:global(footer:not(.resume-footer)) {
			display: none !important;
		}
	}
</style>
