---
import { resumeMaster } from "../../config/resume_master";
import { resumeExperience, resumeSummary, httpsUrl } from "../../config/resume_projection.ts";
import BaseLayout from "../../layouts/BaseLayout.astro";
export const prerender = true;
const { header, competencies, education } = resumeMaster;
const experience = resumeExperience();
---

<BaseLayout title={`Resume | ${header.name}`} description={header.title} starfield={false}>
	<main class="resume-wrap">
		<div class="resume-actions">
			<a href={resumeMaster.pdf.url} download={resumeMaster.pdf.filename}>Download PDF</a>
		</div>
		<article class="resume-document" data-resume-document>
			<h1>{header.name}</h1>
			<p>{header.title}</p>
			<p>
				{header.contact.location} | <a href={`mailto:${header.contact.email}`}
					>{header.contact.email}</a
				> | {header.contact.phone}
			</p>
			<p>
				<a href={httpsUrl(header.contact.portfolio)}>{header.contact.portfolio}</a> | <a
					href={httpsUrl(header.contact.linkedin)}>{header.contact.linkedin}</a
				> | <a href={httpsUrl(header.contact.github)}>{header.contact.github}</a>
			</p>
			<h2>Profile</h2><p>{resumeSummary().executive}</p>
			<h2>Experience</h2>
			{
				experience.map((entry, index) => (
					<>
						{index === 4 && <div class="page-break" />}
						<section aria-labelledby={`resume-${entry.id}`}>
							<h3 id={`resume-${entry.id}`}>{entry.company}</h3>
							<p class="rolemeta">
								{entry.title && `${entry.title} | `}
								{entry.dates}
							</p>
							{entry.blurb
								.split("\n\n")
								.filter(Boolean)
								.map((text) => (
									<p>{text}</p>
								))}
							{entry.bullets.length > 0 && (
								<ul>
									{entry.bullets.map((text) => (
										<li>{text}</li>
									))}
								</ul>
							)}
						</section>
					</>
				))
			}
			<h2>Technical capabilities</h2>
			{
				Object.values(competencies)
					.flat()
					.map((text) => <p>{text}</p>)
			}
			<h2>Education</h2>
			{
				education.map((edu) => (
					<p>
						{edu.school} | {edu.degree}
					</p>
				))
			}
		</article>
	</main>
</BaseLayout>
<style>
	.resume-wrap {
		padding: 90px 20px 40px;
	}
	.resume-document {
		background: #fff;
		color: #141c24;
		max-width: 860px;
		padding: 50px 56px;
		margin: 30px auto;
		box-shadow: 0 15px 60px #0005;
		font:
			16px/1.42 Barlow,
			Arial,
			sans-serif;
	}
	.resume-document h1 {
		font-family: "Barlow Condensed", Arial, sans-serif;
		font-size: 46px;
		line-height: 1.1;
		margin: 0 0 6px;
	}
	.resume-document h1 + p {
		font-size: 18px;
		font-weight: 600;
		margin: 0 0 14px;
		color: #284764;
	}
	.resume-document h2 {
		font-family: Barlow, Arial, sans-serif;
		font-size: 13px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		border-bottom: 1px solid #b5bec7;
		padding-bottom: 6px;
		margin: 26px 0 12px;
		color: #344d65;
	}
	.resume-document h3 {
		font-family: "Barlow Condensed", Arial, sans-serif;
		font-size: 25px;
		text-transform: none;
		letter-spacing: 0;
		margin: 24px 0 3px;
		color: #172c3e;
	}
	.resume-document p {
		margin: 7px 0 10px;
	}
	.resume-document .rolemeta {
		font-size: 14px;
		color: #4b5f70;
		margin: 0 0 11px;
	}
	.resume-document ul {
		list-style: disc;
		padding-left: 16px;
		margin: 0;
	}
	.resume-document li {
		padding-left: 0;
		margin: 7px 0 10px;
	}
	.resume-document .page-break {
		border-top: 1px dashed #bfc8d1;
		margin: 32px 0;
		padding-top: 8px;
	}
	.resume-document a {
		color: inherit;
		text-decoration: underline;
		text-decoration-color: #9aaabd;
	}
	.resume-actions {
		max-width: 860px;
		margin: 20px auto;
		display: flex;
		gap: 20px;
		flex-wrap: wrap;
	}
	@media (max-width: 760px) {
		.resume-wrap {
			padding: 80px 8px 20px;
		}
		.resume-document {
			padding: 27px 22px;
			font-size: 15px;
		}
		.resume-document h1 {
			font-size: 38px;
		}
		.resume-document h1 + p {
			font-size: 17px;
		}
	}
	@media print {
		.resume-wrap {
			margin: 0;
			padding: 0;
		}
		.resume-actions {
			display: none;
		}
		.resume-document {
			box-shadow: none;
			padding: 0;
			margin: 0;
			max-width: none;
			font-size: 10.8pt;
			line-height: 1.3;
		}
		.resume-document h1 {
			font-size: 28pt;
		}
		.resume-document h2 {
			font-size: 10pt;
			margin: 15pt 0 6pt;
		}
		.resume-document h3 {
			font-size: 14pt;
			margin-top: 12pt;
		}
		.resume-document h1 + p {
			font-size: 11.5pt;
		}
		.resume-document .rolemeta {
			font-size: 9.5pt;
		}
		.resume-document .page-break {
			break-before: page;
			border: 0;
			margin: 0;
			padding: 0;
		}
		.resume-document p,
		.resume-document li {
			margin: 4pt 0 6pt;
		}
		h2,
		h3 {
			break-after: avoid;
		}
		:global(header),
		:global(nav),
		:global(footer),
		:global(.site-footer) {
			display: none !important;
		}
		@page {
			size: letter;
			margin: 0.5in;
		}
	}
</style>
