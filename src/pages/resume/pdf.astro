---
import { pdfConfiguration } from "../../config/resume_projection.ts";
const { url } = pdfConfiguration();
export const prerender = true;
---

<!doctype html>
<html lang="en">
	<head
		><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta
			http-equiv="refresh"
			content={`0;url=${url}`}
		/><link rel="canonical" href={url} /><title>Download PDF</title></head
	>
	<body
		><main>
			<h1>Resume PDF</h1><p><a href={url}>Download PDF</a></p><p>
				<a href="/resume/">Read the resume online</a>
			</p>
		</main></body>
</html>
<style>
	body {
		background: #000;
		color: #e0e0e0;
		font-family: "JetBrains Mono", monospace;
		padding: 2rem;
	}
	a {
		color: #ff6600;
	}
	a:focus-visible {
		outline: 2px solid #00ffff;
		outline-offset: 4px;
	}
</style>
