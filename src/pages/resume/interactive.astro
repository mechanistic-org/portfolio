---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TerminalGame from "../../components/Resume/TerminalGame";
import workHistory from "../../config/work_history.json";
---

<BaseLayout title="Interactive Resume" description="Gamified career exploration.">
	<div
		class="container mx-auto flex h-screen flex-col items-center justify-center px-4 pt-32 pb-8 text-center"
	>
		<h1 class="text-accent-500 pixel-font mb-6 text-5xl font-bold">TERMINAL ACCESS</h1>
		<p class="text-surface-300 mb-12 max-w-2xl text-xl">
			Initialize connection to view classified career data.
		</p>

		<TerminalGame client:only="react" workHistory={workHistory} />

		<div class="text-surface-500 mt-8 font-mono text-xs">
			TIP: Try 'ls' to list jobs, then 'cat [job_name]' to read details.
		</div>
	</div>
</BaseLayout>

<style>
	.pixel-font {
		font-family: "Courier New", Courier, monospace;
	}
</style>
