---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CareerCircuit from "../../components/Resume/CareerCircuit";
import workHistory from "../../config/work_history.json";
---

<BaseLayout title="Infographic Resume" description="Visualizing my career path and skills.">
	<div class="container mx-auto px-4 pt-32 pb-8">
		<h1 class="text-accent-500 mb-8 text-4xl font-bold">Career Circuit</h1>
		<p class="text-surface-300 mb-8 text-lg">Tracing the signal path of professional experience.</p>

		<CareerCircuit client:only="react" workHistory={workHistory} />
	</div>
</BaseLayout>
