---
import BaseLayout from "@layouts/BaseLayout.astro";
import UnifiedDashboard from "@components/Dashboard/UnifiedDashboard";
import { getCareerTimeline } from "@/utils/getCareerTimeline";
import { getMultiverseData } from "@/utils/getMultiverseData";
import { getCollection } from "astro:content";
import specs from "../../data/specs.json";

export const prerender = true;

// Fetch Global Data
const timelineItems = await getCareerTimeline();
const multiverseData = await getMultiverseData();
const projects = await getCollection("projects");

const totalProjects = projects.length;
const activeProjects = projects.filter(
	// @ts-ignore
	(p) => p.data.status === "in-progress" || p.data.status === "prototype",
).length;

// Aggregate Total Parts
let totalParts = 0;
projects.forEach((p) => {
	// @ts-ignore
	if (p.data.phase_stats) {
		// @ts-ignore
		const stats = p.data.phase_stats as Record<string, number>;
		totalParts += Object.values(stats).reduce((a, b) => a + b, 0);
	}
});

const startYear = 1985;
const currentYear = new Date().getFullYear();
const totalYears = currentYear - startYear;

// Map timelineItems to Work History format for Dashboard
const workHistory = timelineItems.map((item) => ({
	company: item.cardTitle.split("@")[1]?.trim() || "Independent",
	title: item.cardTitle.split("@")[0]?.trim() || "Engineer",
	start: item.title.split("-")[0]?.trim() || "2000",
	end: item.title.split("-")[1]?.trim() || "Present",
	description: item.cardSubtitle,
}));

const dashboardData = {
	// Mock Dreamjob for now (Can be hydrated from a specific 'manifesto' project later)
	skillData: [],
	phase_stats: {
		Strategy: 25,
		Design: 35,
		Engineering: 30,
		Production: 10,
	},
	history: workHistory,
	specs: specs,
	multiverseData: multiverseData,
	globalStats: {
		totalParts: Math.round(totalParts),
		totalProjects,
		activeProjects,
		totalYears,
	},
};

const title = "Command Center";
const description = "Global System Metrics and Career Velocity.";
---

<BaseLayout title={title} description={description}>
	<div class="site-container pt-32 pb-24">
		<UnifiedDashboard client:load variant="mega" data={dashboardData} />
	</div>
</BaseLayout>
