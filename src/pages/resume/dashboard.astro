---
import BaseLayout from "@layouts/BaseLayout.astro";
import UnifiedDashboard from "@components/Dashboard/UnifiedDashboard";
import skillsData from "../../data/skills.json";
import { getCollection } from "astro:content";

import workHistory from "../../data/work_history.json";
import specs from "../../data/specs.json";
import multiverseData from "../../data/timeline/multiverse.json";

// Fetch Global Data
// For the "Mega" view, we want to show the "Ideal" (Dreamjob) vs the "Reality" (Projects)
// We'll pass the "Dreamjob" skill set as the primary data visualization source
const dreamJob = skillsData.find((s) => s.name === "dreamjob")?.skills || {};

// We can also aggregate project stats here if needed
const projects = await getCollection("projects");
const totalProjects = projects.length;
const activeProjects = projects.filter(
	// @ts-ignore
	(p) => p.data.status === "in-progress" || p.data.status === "prototype",
).length;

// Aggregate Total Parts
let totalParts = 0;
projects.forEach((p) => {
	// @ts-ignore
	if (p.data.phase_stats) {
		// @ts-ignore
		const stats = p.data.phase_stats as Record<string, number>;
		totalParts += Object.values(stats).reduce((a, b) => a + b, 0);
	}
});
// Start: 1985 (from first entry in json)
// End: Now
const startYear = 1985; // Hardcoded from data/work_history.json
const currentYear = new Date().getFullYear();
const totalYears = currentYear - startYear;

const dashboardData = {
	skillData: Object.entries(dreamJob).map(([name, value]) => ({ name, value, fullMark: 100 })),
	// Mocking phase stats for the Mega View (Global Average) or Real Aggregation
	phase_stats: {
		Strategy: 25,
		Design: 35,
		Engineering: 30,
		Production: 10,
	},
	// Data God Extensions
	history: workHistory,
	specs: specs,
	multiverseData: multiverseData,
	globalStats: {
		totalParts: Math.round(totalParts),
		totalProjects,
		activeProjects,
		totalYears,
	},
};

const title = "Command Center";
const description = "Global System Metrics and Career Velocity.";
---

<BaseLayout title={title} description={description}>
	<div class="site-container pt-32 pb-24">
		<UnifiedDashboard client:load variant="mega" data={dashboardData} />
	</div>
</BaseLayout>
