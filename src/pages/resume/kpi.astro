---
import BaseLayout from "../../layouts/BaseLayout.astro";
import KPIDashboard from "../../components/Resume/KPIDashboard";
import workHistory from "../../config/work_history.json";
import specs from "../../config/specs.json";
---

<BaseLayout title="KPI Resume" description="Data-driven view of professional performance.">
	<div class="container mx-auto px-4 pt-32 pb-8">
		<header class="border-surface-700 mb-8 flex items-center justify-between border-b pb-4">
			<h1 class="text-3xl font-bold text-white">Career Dashboard</h1>
			<div class="flex gap-2">
				<span
					class="rounded border border-green-800 bg-green-900/30 px-3 py-1 text-xs text-green-400"
					>STATUS: ACTIVE</span
				>
				<span
					class="bg-surface-800 text-surface-400 border-surface-700 rounded border px-3 py-1 text-xs"
					>LAST UPDATED: TODAY</span
				>
			</div>
		</header>

		<div class="mb-8 grid grid-cols-1 gap-6 md:grid-cols-3">
			<!-- KPI Cards -->
			<div class="bg-surface-800 border-accent-500 rounded border-l-4 p-6 shadow-lg">
				<h3 class="text-surface-400 mb-2 text-sm font-bold uppercase">Total Experience</h3>
				<p class="font-mono text-4xl text-white">
					15.2 <span class="text-surface-500 text-lg">Yrs</span>
				</p>
				<p class="mt-2 text-xs text-green-400">↑ 1.0 Yrs vs Last Year</p>
			</div>

			<div class="bg-surface-800 rounded border-l-4 border-blue-500 p-6 shadow-lg">
				<h3 class="text-surface-400 mb-2 text-sm font-bold uppercase">Projects Delivered</h3>
				<p class="font-mono text-4xl text-white">42</p>
				<p class="text-surface-500 mt-2 text-xs">Across 8 Industries</p>
			</div>

			<div class="bg-surface-800 rounded border-l-4 border-purple-500 p-6 shadow-lg">
				<h3 class="text-surface-400 mb-2 text-sm font-bold uppercase">Code Commits</h3>
				<p class="font-mono text-4xl text-white">8,432</p>
				<p class="mt-2 text-xs text-purple-400">High Velocity</p>
			</div>
		</div>

		<!-- React Dashboard Component -->
		<KPIDashboard client:only="react" workHistory={workHistory} specs={specs} />
	</div>
</BaseLayout>
