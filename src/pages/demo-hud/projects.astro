---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TelemetryHUD from "@components/Nav/TelemetryHUD.astro";
import ProjectDirectory from "../../components/Projects/ProjectDirectory.astro";
import ProjectGrid from "../../components/Projects/ProjectGrid.astro";
import Assembly from "../../components/DataViz/Assembly";
import TimelineStream from "../../components/DataViz/TimelineStream";
import RadialTaxonomy from "../../components/DataViz/RadialTaxonomy";
import ScrollCoordinator from "@components/Effects/ScrollCoordinator.astro";
import { getMultiverseData } from "@/utils/getMultiverseData";

const multiverseData = await getMultiverseData();
const multiverseMap = new Map(multiverseData.nodes.map((n) => [n.id.toLowerCase(), n]));

const rawProjects = await getCollection("projects");
const projects = rawProjects
	.filter(({ data, id }) => {
		const hiddenIds = [
			"classified",
			"classified-alpha",
			"classified-bravo",
			"electronic-battery-lock",
		];
		return (
			!data.draft &&
			data.statusLabel !== "NO_DATA" &&
			(data as any).impact !== "NO_DATA" &&
			!hiddenIds.includes(data.slug || (data as any).id || id)
		);
	})
	.map((p) => {
		const node = multiverseMap.get((p.data.slug || p.id).toLowerCase());
		if (node) {
			if (node.client) p.data.client = node.client;
			if (node.employer) p.data.employer = node.employer;
			if (node.industry) p.data.industry = node.industry;
			if (node.category) p.data.category = node.category;
			if (node.tools) p.data.tools = node.tools;
		}
		return p;
	})
	.sort((a, b) => new Date(b.data.date || 0).getTime() - new Date(a.data.date || 0).getTime());

const industries = [...new Set(projects.map((p) => p.data.industry).filter(Boolean))].sort();
const categories = [
	...new Set(projects.map((p) => p.data.category).filter(Boolean)),
].sort() as string[];
const tools = [...new Set(projects.flatMap((p) => p.data.tools || []).filter(Boolean))].sort();
const allClients = projects.flatMap((p) => {
	const c = p.data.client || [];
	const e = p.data.employer ? [p.data.employer] : [];
	return [...c, ...e];
});
const clients = [...new Set(allClients.filter(Boolean))].sort();
---

<BaseLayout
	title="Projects [DEMO]"
	description="Engineering Archive"
	starfield={true}
	hideNav={true}
>
	<!-- TELEMETRY HUD -->
	<div class="fixed top-0 left-0 z-50 w-full bg-transparent">
		<TelemetryHUD />
	</div>

	<!-- FULL VIEWPORT DATA CONTAINER -->
	<div class="site-container-full min-h-screen px-4 pt-32 pb-24 md:px-8 md:pb-36">
		<!-- VIEW SWITCHER (The Control Console) -->
		<div
			class="mb-8 flex flex-col items-center justify-center gap-4 pb-4 md:flex-row"
			data-scroll-effect="flee"
		>
			<div class="flex items-center gap-1 rounded-lg border border-white/10 bg-neutral-900 p-1">
				<button
					class="view-toggle text-primary bg-primary/10 px-3 py-1 font-mono text-xs tracking-wider uppercase transition-colors"
					data-view="multiverse"
				>
					<span class="i-tdesign-lightbulb-circle text-sm"></span> Assembly
				</button>
				<button
					class="view-toggle px-3 py-1 font-mono text-xs tracking-wider text-neutral-500 uppercase transition-colors hover:bg-white/5 hover:text-white"
					data-view="list"
				>
					<span class="i-tdesign-menu-2 text-sm"></span> List
				</button>
			</div>
		</div>

		<!-- VIEW: LIST -->
		<div id="view-list" class="view-container hidden w-full">
			<ProjectDirectory
				projects={projects}
				sectors={industries}
				categories={categories}
				tools={tools}
				clients={clients}
			/>
		</div>

		<!-- VIEW: ASSEMBLY -->
		<div
			id="view-multiverse"
			class="view-container animate-in fade-in zoom-in-95 w-full duration-500"
		>
			<div
				class="relative overflow-hidden rounded-xl bg-transparent"
				style="height: calc(100vh - 250px)"
			>
				<Assembly client:only="react" data={multiverseData} />
				<div
					class="pointer-events-none absolute bottom-4 left-4 font-mono text-[10px] text-green-500/50"
				>
					MODE: ASSEMBLY::GRAVITY_WELL<br />
					NODES: {multiverseData.nodes.length}
				</div>
			</div>
		</div>

		<script>
			// VIEW SWITCHER LOGIC (Simplified)
			document.addEventListener("astro:page-load", () => {
				const toggles = document.querySelectorAll(".view-toggle");
				const containers = document.querySelectorAll(".view-container");

				toggles.forEach((btn) => {
					btn.addEventListener("click", () => {
						const view = btn.getAttribute("data-view");
						switchView(view);
					});
				});

				function switchView(mode) {
					toggles.forEach((btn) => {
						const isMatch = btn.getAttribute("data-view") === mode;
						if (isMatch) {
							btn.classList.add("text-primary", "bg-primary/10");
							btn.classList.remove("text-neutral-500", "hover:bg-white/5");
						} else {
							btn.classList.remove("text-primary", "bg-primary/10");
							btn.classList.add("text-neutral-500", "hover:bg-white/5");
						}
					});

					containers.forEach((element) => {
						const c = element;
						if (c.id === `view-${mode}`) {
							c.classList.remove("hidden");
						} else {
							c.classList.add("hidden");
						}
					});
				}
			});
		</script>

		<ScrollCoordinator />
	</div>
</BaseLayout>
