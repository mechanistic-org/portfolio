---
import { getCollection, render } from "astro:content";
import DocsLayout from "@/components/Docs/DocsLayout.astro";

export const prerender = true;

export async function getStaticPaths() {
	const docsCollection = await getCollection("docs");

	const docs = docsCollection.map((entry: any) => {
		const slug = entry.id.replace(/\.(mdx|md)$/i, "").toLowerCase();
		return {
			params: { slug },
			props: { entry, slug },
		};
	});

	// Sort docs to determine order for prev/next
	// Reuse sort logic from index/sidebar
	const validDocs = docs.filter(
		(d: any) => d && d.params && d.params.slug && d.props.entry.data.title,
	);
	const sortedDocs = validDocs.sort((a: any, b: any) => {
		const orderA = a.props.entry.data.sidebar?.order ?? 999;
		const orderB = b.props.entry.data.sidebar?.order ?? 999;
		if (orderA !== orderB) return orderA - orderB;
		return String(a.params.slug).localeCompare(String(b.params.slug));
	});

	return sortedDocs.map((doc, index) => {
		const prevDoc = sortedDocs[index - 1];
		const nextDoc = sortedDocs[index + 1];

		return {
			...doc,
			props: {
				...doc.props,
				prev: prevDoc
					? {
							slug: prevDoc.params.slug,
							title: prevDoc.props.entry.data.title || prevDoc.params.slug,
						}
					: null,
				next: nextDoc
					? {
							slug: nextDoc.params.slug,
							title: nextDoc.props.entry.data.title || nextDoc.params.slug,
						}
					: null,
			},
		};
	});
}

const { entry, slug, prev, next } = Astro.props;
let Content;
import type { MarkdownHeading } from "astro";
let headings: MarkdownHeading[] = [];

if (entry) {
	const rendered = await render(entry);
	Content = rendered.Content;
	headings = rendered.headings;
}

// Mock collection entry for the layout
// DocsLayout expects a doc object with slug and data
const docFn = {
	slug: slug,
	data: entry?.data || {},
	collection: "docs",
};
---

<DocsLayout doc={docFn as any} headings={headings} prev={prev} next={next}>
	{Content ? <Content /> : <p>Loading...</p>}
</DocsLayout>
