---
// Workaround for empty collection issue: manually load files via glob
const globDocs = import.meta.glob("../../content/docs/**/*.{md,mdx}", { eager: true });
const docs = Object.values(globDocs)
	.map((file: any) => {
		const data = file.frontmatter || {};

		// Fix: Derive slug from full path relative to docs root
		// file.file is absolute or relative from root. split on 'content/docs/'
		const pathParts = file.file.split("/content/docs/");
		const relativePath = pathParts[1] || file.file;
		// Remove extension
		const derivedSlug = relativePath.replace(/\.(mdx|md)$/, "");

		return {
			// Prefer explicit slug, fallback to derived path-based slug (handling subfolders)
			slug: data.slug || derivedSlug,
			data: data,
		};
	})
	.sort((a, b) => {
		// Priority sort for specific slugs
		const priority = ["forensic_registry", "gem_creation_guide", "architecture", "introduction"];
		const slugA = a.slug.toLowerCase();
		const slugB = b.slug.toLowerCase();

		const idxA = priority.indexOf(slugA);
		const idxB = priority.indexOf(slugB);

		if (idxA !== -1 && idxB !== -1) return idxA - idxB;
		if (idxA !== -1) return -1;
		if (idxB !== -1) return 1;

		// Then by order
		const orderA = a.data.sidebar?.order ?? 999;
		const orderB = b.data.sidebar?.order ?? 999;

		if (orderA !== orderB) return orderA - orderB;

		return slugA.localeCompare(slugB);
	});

// Debug log
console.log("Glob Docs found:", docs.length);

const firstDoc = docs[0];

if (!firstDoc) {
	return new Response("Docs collection is empty (glob failed). Check server logs.", {
		status: 404,
	});
}

const destination = `/docs/${firstDoc.slug}`;
return Astro.redirect(destination);
---
