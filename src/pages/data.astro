---
import BaseLayout from "../layouts/BaseLayout.astro";
import MultiverseGraph from "../components/DataViz/MultiverseGraph";
import multiverseData from "../data/timeline/multiverse.json";

const title = "The Timeline Authority";
const description = "Visualizing the Quantum Project Multiverse.";
---

<BaseLayout title={title} description={description} current="data">
	<div class="site-container pt-32 pb-24">
		<div class="prose mb-12 max-w-none">
			<h1 class="font-header mb-4 text-5xl font-black">THE MULTIVERSE</h1>
			<p class="max-w-2xl font-mono text-lg text-gray-400">
				// ACCESS LEVEL: DATA GOD<br />
				// PROTOCOL: VISUALIZATION D3-FORCE<br />
				// STATUS: STABLE
			</p>
		</div>

		<div
			class="relative w-full overflow-hidden rounded-xl border border-white/10 bg-black/20 backdrop-blur-sm"
			style="height: 80vh;"
		>
			<MultiverseGraph client:only="react" data={multiverseData} />

			<div class="pointer-events-none absolute bottom-4 left-4 font-mono text-xs text-green-500/50">
				SYSTEM.GRAVITY = -20<br />
				SYSTEM.COLLISION = TRUE<br />
				NODES: {multiverseData.nodes.length}
			</div>
		</div>

		<div class="mt-12 grid grid-cols-1 gap-8 font-mono text-sm text-gray-400 md:grid-cols-3">
			<div class="rounded-lg border border-white/5 p-4">
				<h3 class="mb-2 font-bold text-white">[01] The Gravity Well</h3>
				<p>
					Larger projects exert greater gravitational pull on the timeline. Mass is calculated by <span
						class="text-green-400">Duration * Skill Density</span
					>.
				</p>
			</div>
			<div class="rounded-lg border border-white/5 p-4">
				<h3 class="mb-2 font-bold text-white">[02] Clustering</h3>
				<p>
					Nodes naturally cluster by <span class="text-green-400">Employer</span> and <span
						class="text-green-400">Category</span
					>, revealing the hidden structure of the career path.
				</p>
			</div>
			<div class="rounded-lg border border-white/5 p-4">
				<h3 class="mb-2 font-bold text-white">[03] The Pruning Stick</h3>
				<p>
					Data integrity is enforced by the TVA protocol. Variance is pruned before visualization.
				</p>
			</div>
		</div>
	</div>
</BaseLayout>
