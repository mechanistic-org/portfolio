---
import Layout from "@layouts/OuroborosLayout.astro";
import ConstellationEngine from "@components/Constellation/ConstellationEngine";
import sitemapData from "../data/sitemap.json";
import HyperspaceHUD from "@components/Nav/HyperspaceHUD.astro";

/**
 * THE CONSTELLATION MAP (V6 Sitemap)
 *
 * An organic, high-altitude view of the global site structure.
 * Provides broad orientation across all site realms and pages.
 */

const pageTitle = "Site Constellation | Ouroboros";
---

<Layout
	title={pageTitle}
	description="Global organic projection of the Erik Norris site hierarchy."
>
	<!-- Persistent HUD -->
	<HyperspaceHUD />

	<!-- THE ENGINE (Organic Tectonic Mode) -->
	<main class="relative h-screen w-full overflow-hidden bg-black">
		<ConstellationEngine client:only="react" data={sitemapData} layout="tectonic" />

		<!-- Global Orientation Overlay -->
		<div class="pointer-events-none absolute bottom-24 left-1/2 z-10 -translate-x-1/2 text-center">
			<h2 class="text-primary-500 mb-2 font-mono text-[12px] tracking-[0.5em] uppercase">
				GLOBAL_SECTOR_VIEW
			</h2>
			<p class="font-mono text-[9px] tracking-[0.3em] text-white/20 uppercase">
				Click Clusters to Zoom // Drag to Navigate // Scroll to Traverse Depth
			</p>
		</div>
	</main>
</Layout>

<style>
	/* Immersive full-screen constraints */
	:global(body) {
		overflow: hidden;
	}
</style>
