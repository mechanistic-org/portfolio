---
import BaseLayout from "@layouts/BaseLayout.astro";
import navData from "@config/navData.json";
import { getCollection } from "astro:content";

// Fetch all Key Projects
const projects = await getCollection("projects", ({ data }) => !data.draft);
const sortedProjects = projects.sort(
	(a, b) => new Date(b.data.date || 0).getTime() - new Date(a.data.date || 0).getTime(),
);

const pageTitle = "System Topology | Site Map";
---

<BaseLayout title={pageTitle} description="Visual structure of the Erik Norris Platform.">
	<div class="site-container min-h-screen pt-32 pb-20">
		<header class="mb-12 border-b border-neutral-800 pb-8">
			<h1 class="font-mono text-4xl font-bold tracking-tighter text-white uppercase">
				<span class="text-primary-500 mr-4">///</span>System Topology
			</h1>
			<p class="mt-4 max-w-2xl text-lg text-neutral-400">
				Visualizing the current routing architecture and signal hierarchy.
			</p>
		</header>

		<div class="relative">
			<!-- Central "Bus" Line -->
			<div class="absolute top-0 bottom-0 left-8 w-px bg-neutral-800 lg:left-1/2"></div>

			<div class="flex flex-col gap-16">
				{
					navData.map((item, index) => (
						<div class="relative grid grid-cols-1 gap-8 lg:grid-cols-2">
							{/* Connection Point */}
							<div class="absolute top-8 left-8 h-px w-full bg-neutral-800 lg:left-1/2 lg:-ml-[50vw]" />

							{/* Left Side (for alternating rhythm, simplified here to right-align logic for clarity) */}
							<div class="hidden pt-6 pr-12 text-right lg:block">
								<span class="font-mono text-xs text-neutral-600">NODE_0{index + 1}</span>
							</div>

							{/* Node Content */}
							<div class="hover:border-primary-500 group relative z-10 rounded-lg border border-neutral-800 bg-neutral-900 p-6 transition-colors">
								<div class="mb-4 flex items-center gap-4">
									<div class="group-hover:bg-primary-500 h-3 w-3 rounded-full bg-neutral-700 transition-colors" />
									<h2 class="text-xl font-bold tracking-wider text-white uppercase">{item.text}</h2>
									{item.href && (
										<span class="rounded bg-neutral-950 px-2 py-1 font-mono text-xs text-neutral-500">
											{item.href}
										</span>
									)}
								</div>

								{/* Dropdown Children */}
								{"dropdown" in item && (
									<div class="space-y-4 border-l border-neutral-800 pl-7">
										{item.dropdown.map((subItem) => (
											<div class="relative">
												{/* Hori Line */}
												<div class="absolute top-3 -left-7 h-px w-6 bg-neutral-800" />
												<div class="group/sub flex items-baseline justify-between">
													<a
														href={subItem.href}
														class="block font-mono text-sm text-neutral-300 hover:text-white"
													>
														{subItem.text}
													</a>
													<span class="font-mono text-xs text-neutral-600 opacity-0 transition-opacity group-hover/sub:opacity-100">
														{subItem.href}
													</span>
												</div>
											</div>
										))}
									</div>
								)}

								{/* Special Case: Projects (Expand dynamic list) */}
								{item.text === "Projects" && (
									<div class="mt-6 space-y-2 border-l border-neutral-800 pl-7">
										<div class="mb-2 text-xs font-bold tracking-widest text-neutral-500 uppercase">
											Dynamic Collection ({sortedProjects.length})
										</div>
										{sortedProjects.map((p) => (
											<a
												href={`/projects/${p.slug}`}
												class="hover:text-primary-400 block truncate font-mono text-xs text-neutral-400"
											>
												{p.data.title}
											</a>
										))}
									</div>
								)}
							</div>
						</div>
					))
				}
			</div>
		</div>

		<!-- Legend / Key -->
		<div class="mt-20 flex gap-8 border-t border-neutral-800 pt-8">
			<div class="flex items-center gap-2">
				<div class="bg-primary-500 h-3 w-3 rounded-full"></div>
				<span class="font-mono text-xs text-neutral-400">ACTIVE SIGNAL</span>
			</div>
			<div class="flex items-center gap-2">
				<div class="h-3 w-3 rounded-full bg-neutral-700"></div>
				<span class="font-mono text-xs text-neutral-400">STATIC NODE</span>
			</div>
			<div class="flex items-center gap-2">
				<div class="h-px w-3 bg-neutral-600"></div>
				<span class="font-mono text-xs text-neutral-400">BUS LINE</span>
			</div>
		</div>
	</div>
</BaseLayout>
