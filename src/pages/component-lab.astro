---
import Layout from "@layouts/BaseLayout.astro";
import ZigzagGrid from "@components/MDX/ZigzagGrid.astro";
import ProcessStrip from "@components/MDX/ProcessStrip.astro";
import ModelViewer from "@components/MDX/ModelViewer.astro";
import Chip from "@components/DLS/Chip.astro";
import Wire from "@components/DLS/Wire.astro";
import ScrambleText from "@components/Effects/ScrambleText";
import Admonition from "@components/Admonition/Admonition.astro";

const title = "Component Laboratory";
const description = "Live testing ground for Quantum Visual Taxonomy components.";
---

<Layout title={title} description={description} type="general">
	<section class="pt-32 pb-12">
		<div class="site-container">
			<h1 class="mb-4 text-4xl font-bold text-neutral-900 dark:text-white">
				{title}
			</h1>
			<p class="mb-12 text-neutral-500">
				A verification suite for all visual components available via VS Code snippets.
			</p>

			<div class="prose prose-neutral dark:prose-invert max-w-none space-y-16">
				{/* 1. ZIGZAG GRID */}
				<div>
					<h2>1. Zigzag Grid (qq-zigzag)</h2>
					<ZigzagGrid
						items={[
							{
								title: "View 1",
								text: "Description of the first angle.",
								image: "https://placehold.co/800x600/101010/FFFFFF/png",
							},
							{
								title: "View 2",
								text: "Description of the second angle.",
								image: "https://placehold.co/800x600/202020/FFFFFF/png",
							},
						]}
					/>
				</div>

				<Wire />

				{/* 2. PROCESS STRIP */}
				<div>
					<h2>2. Process Strip (qq-process)</h2>
					<ProcessStrip
						steps={[
							{
								label: "Ideation",
								image: "https://placehold.co/600x400/101010/FFFFFF/png",
								description: "Phase 1",
							},
							{
								label: "Prototyping",
								image: "https://placehold.co/600x400/202020/FFFFFF/png",
								description: "Phase 2",
							},
							{
								label: "Production",
								image: "https://placehold.co/600x400/303030/FFFFFF/png",
								description: "Phase 3",
							},
						]}
					/>
				</div>

				<Wire />

				{/* 3. MODEL VIEWER */}
				<div>
					<h2>3. Model Viewer (qq-model)</h2>
					<div
						class="not-prose relative h-[400px] w-full overflow-hidden rounded-xl border border-neutral-800 bg-neutral-900"
					>
						<ModelViewer src="/assets/r2/project-name/model.glb" alt="Interactive 3D View" />
					</div>
				</div>

				<Wire />

				{/* 4. ADMONITIONS */}
				<div>
					<h2>4. Admonitions (qq-admonition)</h2>
					<div class="space-y-4">
						<Admonition variant="info">
							<strong>Info:</strong> Use this for general notes.
						</Admonition>
						<Admonition variant="tip">
							<strong>Tip:</strong> Use this for optimization hacks.
						</Admonition>
						<Admonition variant="caution">
							<strong>Caution:</strong> Use this for warnings.
						</Admonition>
						<Admonition variant="danger">
							<strong>Danger:</strong> Use this for critical errors.
						</Admonition>
					</div>
				</div>

				<Wire />

				{/* 5. CHIPS */}
				<div>
					<h2>5. Chips (qq-chip)</h2>
					<div class="flex gap-4">
						<Chip variant="production" text="PRODUCTION" />
						<Chip variant="prototype" text="PROTOTYPE" />
						<Chip variant="concept" text="CONCEPT" />
					</div>
				</div>

				<Wire />

				{/* 6. SCRAMBLE TEXT */}
				<div>
					<h2>6. Scramble Text (qq-scramble)</h2>
					<div class="text-3xl font-bold">
						<ScrambleText client:visible text="SYSTEM_VERIFIED" />
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>
