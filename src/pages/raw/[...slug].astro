---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const prerender = true;

export async function getStaticPaths() {
	const projects = await getCollection("projects");
	return projects.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
---

<BaseLayout title={`RAW // ${entry.data.title}`} description="Raw Content View" type="general">
	<div class="site-container pt-32 pb-20">
		<div class="mb-8 flex items-center justify-between">
			<h1 class="text-primary font-mono text-xl tracking-widest uppercase">
				RAW_SOURCE // {entry.id}
			</h1>
			<a href={`/projects/${entry.id}`} class="font-mono text-xs text-neutral-500 hover:text-white">
				← RETURN TO VISUAL INTERFACE
			</a>
		</div>

		<div class="overflow-x-auto rounded-lg border border-white/10 bg-neutral-900/50 p-6 md:p-8">
			<pre
				class="font-mono text-xs whitespace-pre-wrap text-neutral-400 md:text-sm">{entry.body}</pre>
		</div>
	</div>
</BaseLayout>
