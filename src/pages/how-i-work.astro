---
/**
 * /how-i-work — the method pillar.
 *
 * Ruled a NEW PILLAR (operator, 2026-07-29), not a colophon rewrite: domain
 * expertise and areas of experience, rendered with the same constraint-field
 * instrument as /about and populated with how-I-work examples. The colophon
 * remains available as a source and as the "how the site works" surface; it is
 * not this page.
 *
 * The argument this page makes: a competencies list is a set of assertions
 * nobody can check. Here every capability ships with one concrete instance and
 * a link to the page documenting it. Claim and evidence travel together.
 *
 * DRAFT STATUS: prose and node selection are agent-assembled from verified
 * corpus numbers (see the sourcing rule in src/config/method_nodes.ts) and
 * require operator ratification before this is treated as settled copy.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import ConstraintField, { type FieldNode } from "@components/DataViz/ConstraintField";
import { DOMAINS, blendDomainColors } from "@config/domains";
import { METHOD_NODES, PRACTICES } from "@config/method_nodes";

export const prerender = true;

const fieldNodes: FieldNode[] = METHOD_NODES.map((node) => ({
	id: node.id,
	name: node.name,
	kind: "bio",
	domains: node.domains,
	value: node.value,
	color: blendDomainColors(node.domains),
	href: node.href,
	blurb: node.blurb,
}));

const byPractice = PRACTICES.map((practice) => ({
	...practice,
	nodes: METHOD_NODES.filter((node) => node.practice === practice.id),
}));
---

<BaseLayout
	title="How I Work"
	description="The method behind thirty years of shipped hardware: domain expertise and areas of experience, each one attached to a documented instance rather than asserted."
>
	<article class="method-page">
		<header class="method-hero site-container">
			<p class="method-eyebrow">/// How I Work</p>
			<h1>A competency list proves nothing. Here is the same claim with receipts attached.</h1>
			<p class="method-lede">
				Every capability below carries one instance from the work — a part number, a measured delta,
				a decision and what it cost — and links to the page that documents it. Where a number cannot
				be pinned to an artifact, it is not on this page. Arranged by the physics each practice
				governs, the same four domains used to arrange the work itself.
			</p>
		</header>

		<aside
			class="method-pulse site-container"
			data-pulse-entry
			aria-labelledby="method-pulse-title"
		>
			<div>
				<p class="method-pulse-kicker">/// Operating discipline, measured</p>
				<h2 id="method-pulse-title">The Pulse</h2>
				<p>
					A dated record of issue flow, change traceability, and durable practice - with
					definitions, methods, and evidence lifecycle visible.
				</p>
			</div>
			<a href="/colophon/the-pulse/">
				Open the static record <span aria-hidden="true">→</span>
			</a>
		</aside>

		<section class="method-field" aria-labelledby="method-field-heading">
			<h2 id="method-field-heading" class="sr-only">The method field</h2>
			{
				/* client:load for the same reason as /about — the island renders with
			    `display: contents`, so client:visible never fires. */
			}
			<ConstraintField client:load nodes={fieldNodes} />
			<p class="method-field-caption site-container">
				{METHOD_NODES.length} practices · hover to identify · click to open the evidence
			</p>
		</section>

		<section class="method-domains site-container" aria-label="Domains">
			{
				DOMAINS.map((domain) => (
					<div class="method-domain">
						<span class="method-domain-swatch" style={`--swatch:${domain.color}`} />
						<div>
							<h3>{domain.label}</h3>
							<p class="method-domain-sub">{domain.subtitle}</p>
							<p class="method-domain-blurb">{domain.blurb}</p>
						</div>
					</div>
				))
			}
		</section>

		<section class="method-practices site-container" aria-label="Practices">
			{
				byPractice.map((practice) => (
					<div class="method-practice">
						<header class="method-practice-head">
							<h2>{practice.label}</h2>
							<p class="method-practice-line">{practice.line}</p>
						</header>
						<ul class="method-list">
							{practice.nodes.map((node) => (
								<li class="method-item">
									<h3>
										<a href={node.href}>{node.name}</a>
									</h3>
									<p>{node.blurb}</p>
									<a class="method-evidence" href={node.href}>
										Evidence: {node.evidence} <span aria-hidden="true">→</span>
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</section>

		<section class="method-close site-container">
			<h2>The part that is not on the résumé</h2>
			<p>
				The record is the deliverable. A fix that lives in someone's memory is a fix that gets
				re-discovered by the next team at full price — so the vertical-hang cure fixture became an
				ECO, the geometric contracts became a released drawing set, and the honest compromise on
				clamp force got written down as a compromise. That habit is why there is thirty years of
				this to show at all.
			</p>
			<p>
				The same discipline now runs the infrastructure behind this site: raw program archives
				compiled into one sourced record, projected to these pages as a read-only render target so a
				page cannot drift from its evidence. That machinery is documented in the
				<a href="/colophon/">colophon</a>. It is the instrument, not the product.
			</p>
			<a class="method-cta" href="/contact/"
				>Tell me what's breaking <span aria-hidden="true">→</span></a
			>
		</section>
	</article>
</BaseLayout>

<style>
	.method-page {
		padding-block: clamp(4rem, 12vh, 7rem) 5rem;
		display: flex;
		flex-direction: column;
		gap: clamp(3rem, 8vh, 5rem);
	}

	.method-eyebrow {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--color-primary-500);
		margin-bottom: 1rem;
	}

	.method-hero h1 {
		font-family: var(--font-header);
		font-size: clamp(2rem, 5.5vw, 3.75rem);
		line-height: 1.05;
		text-transform: uppercase;
		max-width: 22ch;
		margin-bottom: 1.5rem;
	}

	.method-lede {
		max-width: 62ch;
		font-size: clamp(1rem, 1.4vw, 1.125rem);
		line-height: 1.7;
		color: var(--color-base-400, #9ca3af);
	}

	.method-pulse {
		align-items: end;
		background: var(--card);
		border: 1px solid var(--border);
		display: grid;
		gap: 1.5rem;
		grid-template-columns: minmax(0, 1fr);
		padding-block: 1.25rem;
	}

	.method-pulse-kicker {
		color: var(--info);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		margin: 0 0 0.5rem;
		text-transform: uppercase;
	}

	.method-pulse h2 {
		font-family: var(--font-header);
		font-size: clamp(1.5rem, 3vw, 2.25rem);
		line-height: 1;
		margin: 0;
		text-transform: uppercase;
	}

	.method-pulse div > p:last-child {
		color: var(--muted-foreground);
		font-size: 0.875rem;
		line-height: 1.6;
		margin: 0.75rem 0 0;
		max-width: 60ch;
	}

	.method-pulse > a {
		color: var(--primary);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.method-pulse > a:hover,
	.method-pulse > a:focus-visible {
		color: var(--info);
	}

	@media (min-width: 768px) {
		.method-pulse {
			grid-template-columns: minmax(0, 1fr) auto;
		}
	}

	.method-field-caption {
		margin-top: 1rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-base-600, #4b5563);
	}

	.method-domains {
		display: grid;
		gap: 1.75rem;
		grid-template-columns: 1fr;
	}

	@media (min-width: 768px) {
		.method-domains {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.method-domain {
		display: flex;
		gap: 0.9rem;
		align-items: flex-start;
	}

	.method-domain-swatch {
		width: 0.75rem;
		height: 0.75rem;
		margin-top: 0.35rem;
		flex: none;
		border-radius: 2px;
		background: var(--swatch);
	}

	.method-domain h3 {
		font-family: var(--font-header);
		font-size: 1.125rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.method-domain-sub {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-base-600, #4b5563);
		margin-top: 0.15rem;
	}

	.method-domain-blurb {
		margin-top: 0.5rem;
		font-size: 0.875rem;
		line-height: 1.65;
		color: var(--color-base-400, #9ca3af);
	}

	.method-practices {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	.method-practice-head {
		border-top: 1px solid rgb(255 255 255 / 0.12);
		padding-top: 1.25rem;
		margin-bottom: 1.75rem;
	}

	.method-practice-head h2 {
		font-family: var(--font-header);
		font-size: clamp(1.5rem, 3vw, 2.25rem);
		text-transform: uppercase;
	}

	.method-practice-line {
		margin-top: 0.4rem;
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--color-primary-500);
	}

	.method-list {
		display: grid;
		gap: 2rem;
		grid-template-columns: 1fr;
		list-style: none;
		padding: 0;
	}

	@media (min-width: 768px) {
		.method-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.method-item h3 {
		font-size: 1rem;
		font-weight: 700;
		margin-bottom: 0.5rem;
	}

	.method-item h3 a {
		color: inherit;
		text-decoration: none;
	}

	.method-item h3 a:hover,
	.method-item h3 a:focus-visible {
		color: var(--color-primary-500);
	}

	.method-item p {
		font-size: 0.9375rem;
		line-height: 1.7;
		color: var(--color-base-400, #9ca3af);
	}

	.method-evidence {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin-top: 0.65rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-base-600, #4b5563);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.method-evidence:hover,
	.method-evidence:focus-visible {
		color: var(--color-primary-500);
	}

	.method-close {
		border-top: 1px solid rgb(255 255 255 / 0.12);
		padding-top: 2rem;
		max-width: 68ch;
	}

	.method-close h2 {
		font-family: var(--font-header);
		font-size: clamp(1.5rem, 3vw, 2.25rem);
		text-transform: uppercase;
		margin-bottom: 1rem;
	}

	.method-close p {
		font-size: 1rem;
		line-height: 1.75;
		color: var(--color-base-400, #9ca3af);
		margin-bottom: 1.25rem;
	}

	.method-close a {
		color: var(--color-primary-500);
	}

	.method-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		text-decoration: none;
		transition: gap 0.2s ease;
	}

	.method-cta:hover,
	.method-cta:focus-visible {
		gap: 1rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.method-evidence,
		.method-cta {
			transition: none;
		}
	}
</style>
