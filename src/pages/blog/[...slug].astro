---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import { formatDate } from "@/js/textUtils";
import { Image } from "astro:assets";

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}

type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description} image={post.data.heroImage}>
	<article class="site-container pt-32 pb-24 md:pt-44">
		<div class="mx-auto max-w-3xl">
			<header class="mb-12 text-center">
				<div
					class="text-muted-foreground mb-6 flex items-center justify-center gap-4 font-mono text-sm"
				>
					<time datetime={post.data.pubDate.toISOString()}>
						{formatDate(post.data.pubDate)}
					</time>
					{
						post.data.tags && (
							<>
								<span>•</span>
								<div class="flex gap-2">
									{post.data.tags.map((tag) => (
										<span>#{tag}</span>
									))}
								</div>
							</>
						)
					}
				</div>
				<h1 class="h1 mb-6">{post.data.title}</h1>
				<p class="text-muted-foreground text-xl">{post.data.description}</p>
			</header>

			{
				post.data.heroImage && (
					<div class="border-border bg-muted mb-16 overflow-hidden rounded-xl border">
						<Image
							src={post.data.heroImage}
							alt={post.data.title}
							class="w-full object-cover"
							width={1200}
							height={600}
						/>
					</div>
				)
			}

			<div class="markdown-content">
				<Content />
			</div>

			<div class="border-border mt-16 border-t pt-8 text-center">
				<a
					href="/blog/"
					class="text-muted-foreground hover:text-primary inline-flex items-center gap-2 text-sm font-medium transition-colors"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="16"
						height="16"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg
					>
					Back to Field Notes
				</a>
			</div>
		</div>
	</article>
</BaseLayout>
