---
import Layout from "@layouts/BaseLayout.astro";
import DatasheetTable from "@components/About/DatasheetTable.astro";
import ScrollCoordinator from "@components/Effects/ScrollCoordinator.astro";

// VIZ COMPONENTS
import LivingGantt from "@components/DataViz/LivingGantt";
import SkillsGraph from "@components/DataViz/SkillsGraph";
import RadialTaxonomy from "@components/DataViz/RadialTaxonomy";

// DATA
import workHistoryRaw from "@/data/work_history.json";
import skillsData from "@/data/skills.json";
import { getCollection } from "astro:content";

// --- DATA PREP (Copied from Projects Index for Compatibility) ---
const allProjects = await getCollection(
	"projects",
	({ data }) => !data.draft && data.statusLabel !== "NO_DATA" && (data as any).impact !== "NO_DATA",
);
const projects = allProjects.sort(
	(a, b) => new Date(b.data.date || 0).getTime() - new Date(a.data.date || 0).getTime(),
);

// Hierarchy Generation for Radial Taxonomy
const hierarchyData = {
	name: "Erik Norris",
	children: [] as any[],
};
const findOrCreate = (parent: any[], name: string) => {
	let node = parent.find((n) => n.name === name);
	if (!node) {
		node = { name, children: [] };
		parent.push(node);
	}
	return node;
};
projects.forEach((p) => {
	const employer = p.data.employer || p.data.client[0] || "Independent";
	const employerNode = findOrCreate(hierarchyData.children, employer);

	let segment = p.data.industry;
	// Use patched logic if still missing (though we fixed JSON, this is ASTRO data)
	// Actually, Project Collections are Markdown, Multiverse is JSON.
	// We should trust the Markdown data here or fallback to category.
	if (!segment || segment === "Other") {
		segment = p.data.category || "Uncategorized";
	}
	const industryNode = findOrCreate(employerNode.children, segment);

	industryNode.children.push({
		name: p.data.title,
		id: p.id,
		value: 10,
		group: employer,
	});
});

// History Data for Corporate View
interface Job {
	company: string;
	title: string;
	start: string;
	end: string;
	color: string;
	description: string;
	is_consulting: boolean;
	duration_years?: number;
}
const workHistory = workHistoryRaw as Job[];
const hasHistory = Array.isArray(workHistory) && workHistory.length > 0;
function getHash(str: string) {
	let hash = 0;
	for (let i = 0; i < str.length; i++) {
		hash = (hash << 5) - hash + str.charCodeAt(i);
		hash |= 0;
	}
	return Math.abs(hash).toString(16).substring(0, 7);
}
---

<Layout title="About / Specs" description="Technical Specifications and System Telemetry">
	<section class="site-container min-h-screen py-12 md:py-24">
		<div class="mx-auto max-w-7xl">
			<!-- HEADER & TABS -->
			<div
				class="mb-12 flex flex-col items-end justify-between gap-6 border-b border-neutral-800 pb-6 md:flex-row"
			>
				<div>
					<h1 class="h1 mb-2">Technical Specifications</h1>
					<p class="max-w-2xl text-xl text-neutral-400">
						Operating parameters, performance metrics, and system visualization.
					</p>
				</div>

				<!-- TAB CONTROLS -->
				<div class="flex items-center gap-1 rounded-lg border border-white/5 bg-neutral-900/50 p-1">
					<button
						id="tab-btn-corporate"
						class="tab-btn bg-primary/10 text-primary border-primary/20 rounded-md border px-6 py-2 font-mono text-xs tracking-widest uppercase shadow-[0_0_10px_rgba(46,92,255,0.2)] transition-all"
						data-target="view-corporate"
					>
						Corporate
					</button>
					<button
						id="tab-btn-system"
						class="tab-btn rounded-md border border-transparent px-6 py-2 font-mono text-xs tracking-widest text-neutral-500 uppercase transition-all hover:bg-white/5 hover:text-white"
						data-target="view-system"
					>
						Alternative
					</button>
				</div>
			</div>

			<!-- VIEW: CORPORATE (Datasheet) -->
			<div id="view-corporate" class="view-panel animate-in fade-in duration-500">
				<div class="space-y-24">
					<DatasheetTable />

					<!-- REVISION HISTORY (Log) -->
					<div>
						<div class="mb-6 flex items-center justify-between border-b border-neutral-800 pb-2">
							<h2 class="h2 flex items-center gap-3">
								<span class="text-primary">///</span> Revision History
							</h2>
							<div class="font-mono text-xs text-neutral-500">branch: main</div>
						</div>

						<div
							class="overflow-x-auto rounded-lg border border-neutral-800 bg-[#0d1117] p-6 font-mono text-sm"
						>
							{
								hasHistory ? (
									workHistory.map((job) => (
										<div class="group relative border-l border-neutral-800 py-3 pl-8 transition-colors hover:bg-neutral-900/50">
											<div
												class="absolute top-5 -left-[5px] h-2.5 w-2.5 rounded-full border border-[#0d1117]"
												style={`background-color: ${job.color}`}
											/>
											<div class="grid grid-cols-1 items-baseline gap-4 md:grid-cols-[120px_1fr_150px]">
												<div class="text-xs text-neutral-500">
													<span class="text-primary opacity-50 group-hover:opacity-100">
														{getHash(job.company)}
													</span>
													<span class="mx-2">|</span>
													<span>{new Date(job.start).getFullYear()}</span>
												</div>
												<div>
													<span class="group-hover:text-primary font-semibold text-white transition-colors">
														{job.title}
													</span>
													<span class="text-neutral-500"> @ </span>
													<span style={`color: ${job.color}`}>{job.company}</span>
													<p class="mt-1 text-xs leading-relaxed text-neutral-500 opacity-75">
														{job.description}
													</p>
												</div>
												<div class="hidden text-right text-xs text-neutral-600 md:block">
													{job.duration_years ? `${job.duration_years} yr` : "HEAD"}
												</div>
											</div>
										</div>
									))
								) : (
									<div class="text-red-500">No history found.</div>
								)
							}
							<div class="pt-4 pl-8 text-xs text-neutral-600">
								<span class="opacity-50">Initial Commit</span>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- VIEW: SYSTEM (Visualizations) -->
			<div id="view-system" class="view-panel animate-in fade-in hidden duration-500">
				<div class="space-y-12">
					<!-- 1. The Living Gantt -->
					<div class="relative overflow-hidden rounded-xl border border-white/10 bg-black/50">
						<div class="absolute top-4 left-4 z-10 font-mono text-xs text-green-500">
							> SYSTEM.TIMELINE_STREAM
						</div>
						<!-- Container height handled by LivingGantt (400vh) - Wait, we need to contain it?
                             LivingGantt is 400vh tall to drive scroll. Embedding it here might break page flow length.
                             Actually, that's Awesome. It makes this tab tall.
                        -->
						<div class="relative h-[80vh] w-full overflow-y-scroll border-b border-white/5">
							<!-- LivingGantt expects to be in the main flow. 
                                  If we put it in a container, we need to ensure it works.
                                  Let's just use it natively.
                             -->
							<div class="mb-8 w-full p-12 text-center text-neutral-500">
								<span class="i-tabler-mouse mx-auto mb-2 block animate-bounce text-2xl"></span>
								Interactive Timeline Active
							</div>
							<LivingGantt client:visible />
						</div>
					</div>

					<!-- 2. Skills & Taxonomy Grid -->
					<div class="grid grid-cols-1 gap-8 md:grid-cols-2">
						<!-- Skills -->
						<div
							class="relative h-[600px] overflow-hidden rounded-xl border border-white/10 bg-black/50 p-4"
						>
							<div class="text-primary absolute top-4 left-4 z-10 font-mono text-xs">
								> SYSTEM.SKILL_MATRIX
							</div>
							<SkillsGraph client:visible skillsData={skillsData} projects={projects} />
						</div>

						<!-- Taxonomy -->
						<div
							class="relative h-[600px] overflow-hidden rounded-xl border border-white/10 bg-black/50 p-4"
						>
							<div class="absolute top-4 left-4 z-10 font-mono text-xs text-purple-400">
								> SYSTEM.TAXONOMY_TREE
							</div>
							<RadialTaxonomy client:visible data={hierarchyData} />
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
	<ScrollCoordinator />

	<script>
		// TAB LOGIC
		const tabs = document.querySelectorAll(".tab-btn");
		const panels = document.querySelectorAll(".view-panel");

		tabs.forEach((btn) => {
			btn.addEventListener("click", () => {
				const targetId = btn.getAttribute("data-target");

				// Toggle Buttons
				tabs.forEach((b) => {
					if (b === btn) {
						b.classList.add(
							"bg-primary/10",
							"text-primary",
							"border-primary/20",
							"shadow-[0_0_10px_rgba(46,92,255,0.2)]",
						);
						b.classList.remove("text-neutral-500", "border-transparent");
					} else {
						b.classList.remove(
							"bg-primary/10",
							"text-primary",
							"border-primary/20",
							"shadow-[0_0_10px_rgba(46,92,255,0.2)]",
						);
						b.classList.add("text-neutral-500", "border-transparent");
					}
				});

				// Toggle Panels
				panels.forEach((p) => {
					if (p.id === targetId) {
						p.classList.remove("hidden");
					} else {
						p.classList.add("hidden");
					}
				});
			});
		});
	</script>
</Layout>
