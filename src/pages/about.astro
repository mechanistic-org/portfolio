---
import Layout from "@layouts/BaseLayout.astro";
import DatasheetTable from "@components/about/DatasheetTable.astro";
import workHistory from "@/data/work_history.json";

const hasHistory = Array.isArray(workHistory) && workHistory.length > 0;

// Helper to generate fake "Commit Hash" from string
function getHash(str: string) {
  let hash = 0;
  for (let i = 0; i < str.length; i++) {
    hash = (hash << 5) - hash + str.charCodeAt(i);
    hash |= 0;
  }
  return Math.abs(hash).toString(16).substring(0, 7);
}
---

<Layout title="About / Specs" description="Technical Specifications for Erik Norris">
  <section class="site-container py-12 md:py-24">
    
    <div class="mx-auto max-w-5xl">
      <h1 class="h1 mb-6">Technical Specifications</h1>
      <p class="text-xl text-neutral-400 mb-12">
        Operating parameters, performance characteristics, and version history.
      </p>

      <div class="mb-24">
        <DatasheetTable />
      </div>

      <div>
        <div class="flex items-center justify-between mb-6 border-b border-neutral-800 pb-2">
             <h2 class="h2 flex items-center gap-3">
                <span class="text-primary">///</span> Revision History
            </h2>
            <div class="text-xs font-mono text-neutral-500">
                branch: main
            </div>
        </div>
       
        <div class="bg-[#0d1117] border border-neutral-800 rounded-lg p-6 font-mono text-sm overflow-x-auto">
            
            {hasHistory ? workHistory.map((job, index) => (
                <div class="relative pl-8 py-3 border-l border-neutral-800 hover:bg-neutral-900/50 transition-colors group">
                    
                    <div 
                        class="absolute -left-[5px] top-5 h-2.5 w-2.5 rounded-full border border-[#0d1117]"
                        style={`background-color: ${job.color}`}
                    ></div>

                    <div class="grid grid-cols-1 md:grid-cols-[120px_1fr_150px] gap-4 items-baseline">
                        
                        <div class="text-neutral-500 text-xs">
                            <span class="text-primary opacity-50 group-hover:opacity-100">{getHash(job.company)}</span>
                            <span class="mx-2">|</span>
                            <span>{new Date(job.start).getFullYear()}</span>
                        </div>

                        <div>
                            <span class="text-white font-semibold group-hover:text-primary transition-colors">
                                {job.title}
                            </span>
                            <span class="text-neutral-500"> @ </span>
                            <span style={`color: ${job.color}`}>{job.company}</span>
                            
                            <p class="text-neutral-500 mt-1 text-xs leading-relaxed opacity-75">
                                {job.description}
                            </p>
                        </div>

                        <div class="text-right text-xs text-neutral-600 hidden md:block">
                            {job.duration_years > 0 ? `${job.duration_years} yr` : "HEAD"}
                        </div>

                    </div>
                </div>
            )) : (
                <div class="text-red-500">No history found.</div>
            )}
            
            <div class="pl-8 pt-4 text-neutral-600 text-xs">
                <span class="opacity-50">Initial Commit</span>
            </div>
        </div>
      </div>

    </div>
  </section>
</Layout>