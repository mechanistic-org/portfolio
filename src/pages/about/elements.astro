---
import Layout from "@layouts/BaseLayout.astro";
import { Content as ElementsContent } from "@/data/otherPages/elements/index.mdx";
---

<Layout title="Elements / DLS" description="Design Language System and Component Library">
	<section class="site-container py-12 md:py-24">
		<div class="mx-auto max-w-4xl">
			<div class="mb-12 border-b border-neutral-800 pb-8">
				<h1 class="h1 mb-4">Design Language System</h1>
				<p class="font-mono text-xl text-neutral-400">// QUANTUM.DLS.v1.0</p>
			</div>

			<div class="prose prose-invert prose-neutral markdown-content max-w-none">
				<ElementsContent />
			</div>
		</div>
	</section>
</Layout>
