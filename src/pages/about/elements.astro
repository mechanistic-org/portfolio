---
import Layout from "@layouts/BaseLayout.astro";
import { Content as ElementsContent } from "@/data/otherPages/elements/index.mdx";
import tokens from "@/data/design_tokens.json";
import colors from "../../../data_source/Colors.csv?raw";

// Parse CSV roughly for display
const csvRows = colors
	.trim()
	.split("\n")
	.slice(1)
	.map((row) => {
		const [name, color, type] = row.split(",");
		return { name, color, type };
	});
---

<Layout title="Elements / DLS" description="Design Language System and Component Library">
	<div class="site-container py-12 md:py-24">
		{/* SECTION 1: THE MANIFESTO (Brand Protocol) */}
		<header class="mb-24 border-b border-white/10 pb-12">
			<div class="text-primary-500 mb-4 flex items-center gap-4 font-mono text-xs">
				<span class="border-primary-500/30 bg-primary-500/10 rounded border px-2 py-1"
					>V.{tokens.meta.version}</span
				>
				<span>SYSTEM status: {tokens.meta.vibe.toUpperCase()}</span>
			</div>
			<h1 class="mb-4 text-6xl font-bold tracking-tighter text-white">DESIGN LANGUAGE SYSTEM</h1>
			<p class="max-w-2xl text-xl text-neutral-400">
				The visual DNA of the data visualization engine. Strictly typed. Optimized for high-contrast
				engineering interfaces.
			</p>
		</header>

		{/* SECTION 2: THE MACHINE (Token System) */}
		<div class="mb-32">
			{/* 2.1 Core Palette */}
			<section class="mb-24">
				<div class="mb-8 flex items-end justify-between border-b border-white/5 pb-2">
					<h2 class="font-mono text-sm text-white/60">01_CORE_PALETTE</h2>
					<span class="text-primary-500 font-mono text-xs">YINMN_BLUE_DISCOVERY</span>
				</div>

				<div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
					{/* Erik Norris Blue */}
					<div
						class="group relative aspect-square overflow-hidden rounded-xl border border-white/10 bg-black"
					>
						<div
							class="bg-primary-500 absolute inset-0 opacity-100 transition-all duration-500 group-hover:scale-110"
						>
						</div>
						<div
							class="absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-black/80 to-transparent p-6"
						>
							<span class="mb-1 font-mono text-xs text-white/50">PRIMARY</span>
							<span class="mb-2 font-sans text-2xl font-bold text-white"
								>{tokens.palette.primary.name}</span
							>
							<span
								class="text-primary-300 w-fit rounded border border-white/10 bg-black/50 px-2 py-1 font-mono text-xs"
							>
								{tokens.palette.primary.base}
							</span>
						</div>
					</div>

					{/* Quantum Cyan */}
					<div
						class="group relative aspect-square overflow-hidden rounded-xl border border-white/10 bg-black"
					>
						<div
							class="absolute inset-0"
							style={`background-color: ${tokens.palette.secondary.base}`}
						>
						</div>
						<div
							class="absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-black/80 to-transparent p-6"
						>
							<span class="mb-1 font-mono text-xs text-white/50">SECONDARY</span>
							<span class="mb-2 font-sans text-2xl font-bold text-white"
								>{tokens.palette.secondary.name}</span
							>
							<span
								class="w-fit rounded border border-white/10 bg-black/50 px-2 py-1 font-mono text-xs text-white"
							>
								{tokens.palette.secondary.base}
							</span>
						</div>
					</div>

					{/* Usage Info */}
					<div
						class="col-span-2 flex flex-col justify-center rounded-xl border border-white/10 bg-white/5 p-8"
					>
						<h3 class="mb-4 font-mono text-sm text-white">/// USAGE PROTOCOL</h3>
						<ul class="space-y-4 font-mono text-xs text-neutral-400">
							<li class="flex gap-4">
								<span class="text-primary-500">01</span>
								<span
									>Primary Blue is reserved for active states, key data points, and primary actions.</span
								>
							</li>
							<li class="flex gap-4">
								<span style={`color: ${tokens.palette.secondary.base}`}>02</span>
								<span
									>Cyan is used for secondary data streams and high-frequency noise visualization.</span
								>
							</li>
							<li class="flex gap-4">
								<span class="text-white">03</span>
								<span>All structural elements must remain monochromatic (Grey/Slate).</span>
							</li>
						</ul>
					</div>
				</div>
			</section>

			{/* 2.2 Neutral Scale */}
			<section class="mb-24">
				<div class="mb-8 flex items-end justify-between border-b border-white/5 pb-2">
					<h2 class="font-mono text-sm text-white/60">02_NEUTRAL_SCALE</h2>
					<span class="font-mono text-xs text-white/40">TITANIUM_TO_CARBON</span>
				</div>

				<div class="grid grid-cols-2 gap-4 md:grid-cols-6">
					{
						Object.entries(tokens.palette.neutral).map(([name, hex]) => (
							<div class="flex flex-col gap-2">
								<div
									class="group relative h-24 w-full rounded border border-white/10"
									style={`background-color: ${hex}`}
								>
									<div class="absolute inset-0 bg-white/10 opacity-0 transition-opacity group-hover:opacity-100" />
								</div>
								<div class="flex flex-col">
									<span class="font-mono text-xs text-white capitalize">{name}</span>
									<span class="font-mono text-[10px] text-neutral-500 uppercase">{hex}</span>
								</div>
							</div>
						))
					}
				</div>
			</section>

			{/* 2.3 Data Mapping */}
			<section>
				<div class="mb-8 flex items-end justify-between border-b border-white/5 pb-2">
					<h2 class="font-mono text-sm text-white/60">03_DATA_MAPPING</h2>
					<span class="font-mono text-xs text-white/40">LEGACY_COMPATIBILITY_LAYER</span>
				</div>

				<div class="w-full overflow-x-auto">
					<table class="w-full text-left font-mono text-xs">
						<thead>
							<tr class="border-b border-white/10 text-neutral-500">
								<th class="py-4 font-normal">ENTITY_NAME</th>
								<th class="py-4 font-normal">TYPE</th>
								<th class="py-4 font-normal">MAPPED_TOKEN</th>
								<th class="py-4 text-right font-normal">HEX</th>
							</tr>
						</thead>
						<tbody>
							{
								csvRows.map((row) => (
									<tr class="group border-b border-white/5 transition-colors hover:bg-white/5">
										<td class="py-3 text-white">{row.name}</td>
										<td class="py-3 text-neutral-500">{row.type}</td>
										<td class="py-3">
											<div class="flex items-center gap-2">
												<div
													class="h-3 w-3 rounded-full border border-white/20"
													style={`background-color: ${row.color}`}
												/>
												<span class="text-neutral-400 transition-colors group-hover:text-white">
													{row.color === tokens.palette.primary.base
														? "Primary"
														: row.color === tokens.palette.secondary.base
															? "Secondary"
															: "Neutral"}
												</span>
											</div>
										</td>
										<td class="group-hover:text-primary-400 py-3 text-right font-mono text-neutral-600">
											{row.color?.substring(0, 7)}
										</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>
			</section>
		</div>

		{/* SECTION 3: THE COMPONENT LIBRARY */}
		<div class="mx-auto max-w-4xl border-t border-dashed border-white/10 pt-24">
			<div class="mb-12 border-b border-neutral-800 pb-8">
				<h2 class="h1 mb-4">Component Library</h2>
				<p class="font-mono text-xl text-neutral-400">// UI_PRIMITIVES</p>
			</div>

			<div class="prose prose-invert prose-neutral markdown-content max-w-none">
				<ElementsContent />
			</div>
		</div>
	</div>
</Layout>
