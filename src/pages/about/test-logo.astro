---
import BaseLayout from "@layouts/BaseLayout.astro";

import { getAssetUrl } from "../../utils/assets";

const MODEL_URL = getAssetUrl(`/assets/r2/_site/en_logo.glb?v=${Date.now()}`);
---

<BaseLayout title="Logo Test Lab" description="Debug environment for 3D assets">
	<div class="site-container pt-32 pb-20">
		<h1 class="h1 mb-8 text-neutral-100">3D Asset Lab [DEBUG MODE]</h1>

		<div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
			<!-- Main Viewer (2/3 Width) -->
			<div class="space-y-4 lg:col-span-2">
				<div class="flex justify-end space-x-4">
					<select
						id="model-select"
						class="rounded border border-neutral-700 bg-neutral-900 px-3 py-1 font-mono text-sm text-white"
					>
						<option value="en_logo.glb">Carbon Logo (Main)</option>
						<option value="en_logo.glb">Forged Carbon (New)</option>
					</select>
				</div>
				<div
					class="relative z-60 h-[60vh] w-full overflow-hidden rounded-xl border border-neutral-800 bg-neutral-900"
				>
					<model-viewer
						id="erik-viewer"
						src={MODEL_URL}
						alt="Erik Norris Matte Carbon Logo"
						camera-controls
						orientation="0deg 0deg -90deg"
						touch-action="pan-y"
						shadow-intensity="1"
						exposure="1"
						shadow-softness="0"
						tone-mapping="neutral"
						environment-image="neutral"
						class="h-full w-full"
						style="background: radial-gradient(circle at center, #333 0%, #000 100%);"
					>
					</model-viewer>
				</div>
				<!-- Console Log for Model Data -->
				<div
					class="h-64 overflow-y-auto rounded border border-neutral-800 bg-neutral-950 p-4 font-mono text-xs text-green-400"
					id="debug-console"
				>
					<div
						class="fixed top-0 left-0 z-60 w-full border-b border-white/10 bg-black/80 px-4 py-2 backdrop-blur-md"
					>
						SYSTEM LOG // WAITING FOR MODEL...
					</div>
				</div>
			</div>

			<!-- Controls Panel (1/3 Width) -->
			<div class="space-y-6 rounded-xl border border-neutral-800 bg-neutral-900/50 p-6">
				<h2 class="border-b border-neutral-800 pb-2 font-sans text-lg font-bold text-white">
					Environment Controls
				</h2>

				<div class="space-y-4">
					<div class="space-y-2">
						<label class="block font-mono text-xs text-neutral-400 uppercase"
							>Exposure <span id="val-exposure" class="text-white">1.0</span></label
						>
						<input
							type="range"
							id="ctrl-exposure"
							min="0"
							max="4"
							step="0.1"
							value="1"
							class="w-full cursor-pointer accent-green-500"
						/>
					</div>

					<div class="space-y-2">
						<label class="block font-mono text-xs text-neutral-400 uppercase"
							>Shadow Intensity <span id="val-shadow" class="text-white">1.0</span></label
						>
						<input
							type="range"
							id="ctrl-shadow"
							min="0"
							max="2"
							step="0.1"
							value="1"
							class="w-full cursor-pointer accent-green-500"
						/>
					</div>

					<div class="space-y-2">
						<label class="block font-mono text-xs text-neutral-400 uppercase"
							>Env Intensity <span id="val-env-int" class="text-white">1.0</span></label
						>
						<input
							type="range"
							id="ctrl-env-int"
							min="0"
							max="3"
							step="0.1"
							value="1"
							class="w-full cursor-pointer accent-green-500"
						/>
					</div>

					<div class="space-y-2 border-t border-neutral-800 pt-4">
						<label class="mb-2 block font-mono text-xs text-neutral-400 uppercase"
							>Lighting Environment</label
						>
						<div class="grid grid-cols-2 gap-2">
							<button
								class="env-btn active rounded border border-green-500 bg-green-500/10 px-3 py-2 font-mono text-xs text-green-500 transition-colors"
								data-env="neutral">Neutral</button
							>
							<button
								class="env-btn rounded border border-neutral-700 px-3 py-2 font-mono text-xs text-neutral-400 transition-colors hover:text-white"
								data-env="legacy">Legacy</button
							>
							<button
								class="env-btn rounded border border-neutral-700 px-3 py-2 font-mono text-xs text-neutral-400 transition-colors hover:text-white"
								data-env="">None</button
							>
						</div>
					</div>

					<div class="space-y-2 border-t border-neutral-800 pt-4">
						<label class="mb-2 block font-mono text-xs text-neutral-400 uppercase"
							>Tone Mapping</label
						>
						<div class="grid grid-cols-2 gap-2">
							<button
								class="tm-btn rounded border border-neutral-700 px-3 py-2 font-mono text-xs text-neutral-400 transition-colors hover:text-white"
								data-tm="aces">ACES</button
							>
							<button
								class="tm-btn rounded border border-neutral-700 px-3 py-2 font-mono text-xs text-neutral-400 transition-colors hover:text-white"
								data-tm="agx">AgX</button
							>
							<button
								class="tm-btn active rounded border border-green-500 bg-green-500/10 px-3 py-2 font-mono text-xs text-green-500 transition-colors"
								data-tm="neutral">Neutral</button
							>
							<button
								class="tm-btn rounded border border-neutral-700 px-3 py-2 font-mono text-xs text-neutral-400 transition-colors hover:text-white"
								data-tm="commerce">Commerce</button
							>
						</div>
					</div>

					<div class="space-y-2 border-t border-neutral-800 pt-4">
						<label class="mb-2 block font-mono text-xs text-neutral-400 uppercase"
							>Material Overrides</label
						>
						<div class="grid grid-cols-2 gap-2">
							<button
								class="override-btn rounded border border-neutral-700 px-3 py-2 font-mono text-xs text-neutral-400 transition-colors hover:text-white"
								id="btn-force-gloss">Force Gloss</button
							>
							<button
								class="override-btn rounded border border-neutral-700 px-3 py-2 font-mono text-xs text-neutral-400 transition-colors hover:text-white"
								id="btn-force-matte">Force Matte</button
							>
							<button
								class="override-btn rounded border border-neutral-700 px-3 py-2 font-mono text-xs text-neutral-400 transition-colors hover:text-white"
								id="btn-toggle-metal">Toggle Metal</button
							>
							<button
								class="override-btn rounded border border-red-900/30 px-3 py-2 font-mono text-xs text-red-400 transition-colors hover:bg-red-900/50 hover:text-white"
								id="btn-kill-normal">Kill Normals</button
							>
							<button
								class="override-btn rounded border border-red-900/30 px-3 py-2 font-mono text-xs text-red-400 transition-colors hover:bg-red-900/50 hover:text-white"
								id="btn-kill-orm">Kill ORM</button
							>
							<button
								class="override-btn rounded border border-red-900/30 px-3 py-2 font-mono text-xs text-red-400 transition-colors hover:bg-red-900/50 hover:text-white"
								id="btn-kill-ao">Kill AO</button
							>
							<button
								class="override-btn col-span-2 rounded border border-red-900/30 px-3 py-2 font-mono text-xs text-red-400 transition-colors hover:bg-red-900/50 hover:text-white"
								id="btn-kill-aniso">Kill Anisotropy (Revert to Standard)</button
							>
						</div>
					</div>

					<div class="space-y-2 border-t border-neutral-800 pt-4">
						<label class="mb-2 block font-mono text-xs text-neutral-400 uppercase"
							>Debug Channels</label
						>
						<div class="grid grid-cols-2 gap-2">
							<button
								class="dbg-btn rounded border border-neutral-700 px-3 py-2 font-mono text-xs text-neutral-400 transition-colors hover:text-white"
								onclick="alert('Normals visualization requires custom shader injection. Check console for texture slots.')"
								>Log Textures</button
							>
							<button
								class="dbg-btn rounded border border-neutral-700 px-3 py-2 font-mono text-xs text-neutral-400 transition-colors hover:text-white"
								id="btn-print-graph">Print Scenegraph</button
							>
							<button
								class="col-span-2 rounded border border-blue-900/50 bg-blue-900/20 px-3 py-2 font-mono text-xs text-blue-500 hover:bg-blue-900/40"
								onclick="window.forceAniso()">Force Anisotropy (1.0)</button
							>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<script>
		// Type definitions for custom element properties
		type ModelViewer = HTMLElement & {
			exposure: number;
			shadowIntensity: number;
			environmentImage: string | null;
			toneMapping: string;
			model: any;
			src: string;
		};

		const viewer = document.querySelector("#erik-viewer") as ModelViewer | null;
		const consoleDiv = document.querySelector("#debug-console") as HTMLDivElement | null;
		const modelSelect = document.querySelector("#model-select") as HTMLSelectElement | null;

		function log(msg: string, type: "info" | "warn" | "error" | "success" = "info") {
			if (!consoleDiv) return;
			const div = document.createElement("div");
			div.innerText = `> ${msg}`;
			if (type === "warn") div.style.color = "#fbbf24";
			if (type === "error") div.style.color = "#ef4444";
			if (type === "success") div.style.color = "#4ade80";
			consoleDiv.appendChild(div);
			consoleDiv.scrollTop = consoleDiv.scrollHeight;
		}

		if (modelSelect && viewer) {
			modelSelect.addEventListener("change", (e) => {
				const target = e.target as HTMLSelectElement;
				const newSrc = `/assets/r2/_site/${target.value}?v=${Date.now()}`;
				log(`Swapping model to: ${target.value}`);
				viewer.src = newSrc;
			});
		}

		// Controls
		const ctrlExposure = document.querySelector("#ctrl-exposure") as HTMLInputElement | null;
		const ctrlShadow = document.querySelector("#ctrl-shadow") as HTMLInputElement | null;
		const ctrlEnvInt = document.querySelector("#ctrl-env-int") as HTMLInputElement | null;
		const envBtns = document.querySelectorAll(".env-btn");
		const tmBtns = document.querySelectorAll(".tm-btn");
		const btnPrintGraph = document.querySelector("#btn-print-graph");
		const btnLogTextures = document.querySelector(".dbg-btn");

		if (viewer && ctrlExposure && ctrlShadow && ctrlEnvInt) {
			// UI Updaters
			ctrlExposure.addEventListener("input", (e) => {
				const target = e.target as HTMLInputElement;
				const val = Number(target.value);
				viewer.exposure = val;
				const display = document.querySelector("#val-exposure") as HTMLElement | null;
				if (display) display.innerText = val.toFixed(1);
			});

			ctrlExposure.addEventListener("change", (e) => {
				log(`Exposure set to: ${viewer.exposure}`);
			});

			ctrlShadow.addEventListener("input", (e) => {
				const target = e.target as HTMLInputElement;
				const val = Number(target.value);
				viewer.shadowIntensity = val;
				const display = document.querySelector("#val-shadow") as HTMLElement | null;
				if (display) display.innerText = val.toFixed(1);
			});

			ctrlShadow.addEventListener("change", (e) => {
				log(`Shadow Intensity set to: ${viewer.shadowIntensity}`);
			});

			ctrlEnvInt.addEventListener("input", (e) => {
				log(`Usage Tip: Adjust Exposure for overall brightness.`);
			});

			envBtns.forEach((btn) => {
				btn.addEventListener("click", () => {
					const button = btn as HTMLElement;
					envBtns.forEach((b) => {
						b.classList.remove("border-green-500", "text-green-500", "bg-green-500/10");
						b.classList.add("border-neutral-700", "text-neutral-400");
					});
					button.classList.add("border-green-500", "text-green-500", "bg-green-500/10");
					button.classList.remove("border-neutral-700", "text-neutral-400");

					const env = button.dataset.env || null;
					log(`Switching Environment to: ${env || "Default (None)"}`);
					viewer.environmentImage = env;
				});
			});

			tmBtns.forEach((btn) => {
				btn.addEventListener("click", () => {
					const button = btn as HTMLElement;
					tmBtns.forEach((b) => {
						b.classList.remove("border-green-500", "text-green-500", "bg-green-500/10");
						b.classList.add("border-neutral-700", "text-neutral-400");
					});
					button.classList.add("border-green-500", "text-green-500", "bg-green-500/10");
					button.classList.remove("border-neutral-700", "text-neutral-400");

					const tm = button.dataset.tm || "neutral";
					log(`Tone Mapping set to: ${tm}`);
					viewer.toneMapping = tm;
				});
			});

			// Diagnostic Function
			const runDiagnostics = () => {
				log("=== RUNNING DIAGNOSTICS ===");
				if (!viewer.model) {
					log("No model loaded.", "error");
					return;
				}

				const mat = viewer.model.materials[0];

				// Deep Inspection (Prototype Aware)
				const getKeys = (obj) => {
					const keys = [];
					let curr = obj;
					while (curr) {
						for (const key of Object.getOwnPropertyNames(curr)) {
							// Include functions now to find setters
							if (!keys.includes(key) && !key.startsWith("_")) keys.push(key);
						}
						curr = Object.getPrototypeOf(curr);
						if (curr === Object.prototype) break;
					}
					return keys.sort();
				};

				log(
					"Mat Props: " +
						getKeys(mat)
							.filter((k) => {
								try {
									return typeof mat[k] !== "function";
								} catch (e) {
									return false;
								}
							})
							.join(", "),
				);
				log(
					"Mat Methods: " +
						getKeys(mat)
							.filter((k) => {
								try {
									return typeof mat[k] === "function";
								} catch (e) {
									return false;
								}
							})
							.join(", "),
				);

				if (typeof mat.setAnisotropyStrength === "function")
					log("Found method: setAnisotropyStrength", "success");
				else log("Missing method: setAnisotropyStrength", "warn");

				// Specific Checks
				if ("anisotropy" in mat) log("Found 'anisotropy' property: " + mat.anisotropy);
				if ("extensions" in mat) log("Found 'extensions' property");

				log(`Material: ${mat.name}`);

				// Force helper
				window.forceAniso = () => {
					try {
						if (mat.setAnisotropyStrength) {
							mat.setAnisotropyStrength(1.0);
							log("Forced Anisotropy Strength to 1.0 (via Setter)");
						} else {
							mat.anisotropyStrength = 1.0;
							log("Forced Anisotropy Strength to 1.0 (via Property)");
						}
					} catch (e) {
						log("Force failed: " + e);
					}
				};

				// PBR Check
				const pbr = mat.pbrMetallicRoughness;
				const hasBase = !!pbr.baseColorTexture;
				const hasMR = !!pbr.metallicRoughnessTexture;
				const hasNormal = !!mat.normalTexture;

				if (hasBase) log("[PASS] Base Color Map Found", "success");
				else log("[FAIL] Base Color Map Missing", "error");
				if (hasMR) log("[PASS] ORM Map Found", "success");
				else log("[FAIL] ORM Map Missing", "error");
				if (hasNormal) log("[PASS] Normal Map Found", "success");
				else log("[FAIL] Normal Map Found", "error");

				// Emissive Check (The suspected culprit)
				const emissiveFactor = mat.emissiveFactor;
				log(`Emissive Factor: ${emissiveFactor}`);
				if (emissiveFactor[0] > 0 || emissiveFactor[1] > 0 || emissiveFactor[2] > 0) {
					log("[CRITICAL] Model has Emissive Factor > 0! It will glow.", "error");
				}

				// Roughness Value Check
				log(`Roughness Factor: ${pbr.roughnessFactor}`);
				if (pbr.roughnessFactor === 1 && !hasMR) {
					log("[WARN] Roughness is 1.0 and No Map! Material will be matte.", "warn");
				}

				// Anisotropy Check (The Flash)
				const anisoTex = mat.anisotropyTexture;
				if (anisoTex) {
					log("[PASS] Anisotropy Texture Found (The Flash lives!)", "success");
					const strength = mat.anisotropyStrength;
					log(`Anisotropy Strength: ${strength ?? "Unknown"}`);
					if (strength === 0) log("[WARN] Strength is 0! Use Force Button.", "warn");
				} else {
					log("[FAIL] No Anisotropy Extension Data Found.", "error");
				}

				// Interference Check (Clearcoat/Transmission)
				if (mat.clearcoatFactor > 0) {
					log(
						`Clearcoat Active: ${mat.clearcoatFactor} (Roughness: ${mat.clearcoatRoughnessFactor})`,
						"warn",
					);
				}
				if (mat.transmissionFactor > 0) {
					log(`Transmission Active: ${mat.transmissionFactor} (Glass Effect)`, "warn");
				}

				log("----------------------");
			};

			// Material Overrides
			document.querySelector("#btn-force-gloss")?.addEventListener("click", () => {
				if (!viewer.model) return;
				const mat = viewer.model.materials[0];
				mat.pbrMetallicRoughness.setRoughnessFactor(0.0);
				log("Force Gloss: Roughness set to 0.0", "warn");
			});

			document.querySelector("#btn-force-matte")?.addEventListener("click", () => {
				if (!viewer.model) return;
				const mat = viewer.model.materials[0];
				mat.pbrMetallicRoughness.setRoughnessFactor(1.0);
				log("Force Matte: Roughness set to 1.0", "warn");
			});

			document.querySelector("#btn-toggle-metal")?.addEventListener("click", () => {
				if (!viewer.model) return;
				const mat = viewer.model.materials[0];
				const current = mat.pbrMetallicRoughness.metallicFactor;
				const next = current > 0.5 ? 0.0 : 1.0;
				mat.pbrMetallicRoughness.setMetallicFactor(next);
				log(`Toggle Metal: Factor set to ${next}`, "warn");
			});

			document.querySelector("#btn-kill-normal")?.addEventListener("click", () => {
				if (!viewer.model) return;
				const mat = viewer.model.materials[0];
				mat.normalTexture.setTexture(null);
				log("Kill Normals: Normal Map REMOVED.", "error");
			});

			document.querySelector("#btn-kill-orm")?.addEventListener("click", () => {
				if (!viewer.model) return;
				const mat = viewer.model.materials[0];
				mat.pbrMetallicRoughness.metallicRoughnessTexture.setTexture(null);
				log("Kill ORM: Metallic/Roughness Map REMOVED.", "error");
			});

			document.querySelector("#btn-kill-ao")?.addEventListener("click", () => {
				if (!viewer.model) return;
				const mat = viewer.model.materials[0];
				mat.occlusionTexture.setTexture(null);
				log("Kill AO: Occlusion Map REMOVED.", "error");
			});

			document.querySelector("#btn-kill-aniso")?.addEventListener("click", () => {
				if (!viewer.model) return;
				const mat = viewer.model.materials[0];
				mat.anisotropyTexture.setTexture(null);
				mat.setAnisotropyStrength(0);
				log(
					"Kill Anisotropy: Extension DISABLED. (Should revert to standard plastic/metal)",
					"error",
				);
			});

			btnPrintGraph?.addEventListener("click", runDiagnostics);
			if (btnLogTextures) {
				btnLogTextures.addEventListener("click", runDiagnostics);
			}

			viewer.addEventListener("load", () => {
				log("Model Loaded Successfully.", "success");
				// Verify exposure
				log(`Current Exposure: ${viewer.exposure}`);
				setTimeout(runDiagnostics, 500); // Auto-run on load
			});

			viewer.addEventListener("error", (e) => {
				const event = e as unknown as CustomEvent;
				log(`Error loading model: ${event.detail.type}`, "error");
			});
		}
	</script>
</BaseLayout>
