---
import Layout from "@layouts/OuroborosLayout.astro";
import ConstellationEngine from "@components/Constellation/ConstellationEngine";
import sitemapData from "../data/sitemap.json";

// Filter for SPECS nodes and the central anchor
const specsNodes = sitemapData.nodes.filter(
	(n) => n.category === "SPECS" || n.id === "realm-specs",
);

// Re-map realm-specs to be the CORE for this specific view
const filteredData = {
	nodes: specsNodes.map((n) => {
		if (n.id === "realm-specs") {
			return { ...n, category: "CORE", name: "SPECS SECTOR" };
		}
		return n;
	}),
};
---

<Layout title="Specs Constellation | Ouroboros">
	<main class="relative h-screen w-full overflow-hidden bg-black">
		<ConstellationEngine client:only="react" data={filteredData} />

		<div class="pointer-events-none absolute top-8 left-8 z-10">
			<h1 class="font-mono text-2xl tracking-widest text-white opacity-50">SECTOR_VIEW // SPECS</h1>
			<p class="mt-2 font-mono text-xs text-[#FBBF24] uppercase">
				The Digital Brain / Technical Architecture
			</p>
		</div>

		<nav class="absolute right-8 bottom-8 z-10">
			<a
				href="/"
				class="border border-white/10 bg-black/40 px-4 py-2 font-mono text-xs text-white/30 backdrop-blur-md transition-colors hover:text-white"
			>
				RETURN TO HUB
			</a>
		</nav>
	</main>
</Layout>
