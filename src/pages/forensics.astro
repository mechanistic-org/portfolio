---
import Layout from "../layouts/BaseLayout.astro";
import ScheduleVolatilityChart from "../components/react/ScheduleVolatilityChart";
---

<Layout title="Schedule Forensics" description="Forensic analysis of schedule volatility.">
	<main class="min-h-screen bg-black p-12 text-slate-200">
		<div class="mx-auto max-w-4xl space-y-12">
			<header>
				<h1
					class="mb-4 bg-linear-to-r from-amber-400 to-pink-600 bg-clip-text text-4xl font-bold text-transparent"
				>
					Forensic Schedule Analysis
				</h1>
				<p class="text-xl text-slate-400">
					"The Cone of Uncertainty" &mdash; Visualizing project slippage and approval chaos in the
					Curtis Project (2006-2008).
				</p>
			</header>

			<section>
				<ScheduleVolatilityChart client:load />
			</section>

			<section class="prose prose-invert max-w-none">
				<h3>Key Findings</h3>
				<ul>
					<li>
						<strong>Marketing Approval</strong> was the most volatile task, with <span
							class="font-bold text-pink-500">87 revisions</span
						>.
					</li>
					<li>
						<strong>PCB Layout</strong> suffered the most churn, with <span
							class="font-bold text-amber-500">715 internal edits</span
						>.
					</li>
					<li>
						<strong>Project Finish</strong> slipped by over <span class="font-bold text-cyan-500"
							>365 days</span
						> from the initial plan.
					</li>
				</ul>
			</section>
		</div>
	</main>
</Layout>
